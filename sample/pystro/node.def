// pystro — Python subset on the ASTro framework.
//
// Tree-walking interpreter; `def` builds a closure object (body + env);
// calls open a new heap frame and run the body via EVAL.  Non-local
// control flow (return / raise / break / continue) is propagated up
// the seq / if / while / for / try chain via `c->state` rather than
// longjmp, so the same machinery handles function exits and exception
// propagation.

// ---------------------------------------------------------------------------
// Constants.
// ---------------------------------------------------------------------------

NODE_DEF
node_const_int(CTX * restrict c, NODE * restrict n, int32_t v)
{
    (void)c; (void)n;
    return PYS_FIX(v);
}

NODE_DEF
node_const_int64(CTX * restrict c, NODE * restrict n, uint64_t v)
{
    (void)c; (void)n;
    return (VALUE)v;
}

// `s` is a textual decimal literal — used when the integer doesn't
// fit into a fixnum at parse time.  Constructed once at allocator time
// (cached in @ref slot would be cleaner, but for now we re-parse each
// dispatch — bignum literals in hot paths are rare).
NODE_DEF
node_const_bignum(CTX * restrict c, NODE * restrict n, const char *s)
{
    (void)n;
    mpz_t z;
    mpz_init_set_str(z, s, 10);
    VALUE v = pys_make_bignum(z);
    mpz_clear(z);
    return v;
}

NODE_DEF
node_const_float(CTX * restrict c, NODE * restrict n, uint64_t bits)
{
    (void)n;
    union { uint64_t u; double d; } pun = { .u = bits };
    return pys_make_float(pun.d);
}

NODE_DEF
node_const_imag(CTX * restrict c, NODE * restrict n, uint64_t bits)
{
    (void)c; (void)n;
    union { uint64_t u; double d; } pun = { .u = bits };
    extern VALUE pys_make_complex(double re, double im);
    return pys_make_complex(0.0, pun.d);
}

NODE_DEF
node_const_str(CTX * restrict c, NODE * restrict n, const char *s)
{
    (void)n;
    return pys_make_str(s, strlen(s));
}

NODE_DEF
node_const_bytes(CTX * restrict c, NODE * restrict n, const char *s, uint32_t len)
{
    (void)c; (void)n;
    return pys_make_bytes(s, (size_t)len);
}

NODE_DEF
node_const_none(CTX * restrict c, NODE * restrict n)
{
    (void)c; (void)n;
    return PYS_NONE;
}

NODE_DEF
node_const_true(CTX * restrict c, NODE * restrict n)
{
    (void)c; (void)n;
    return PYS_TRUE;
}

NODE_DEF
node_const_false(CTX * restrict c, NODE * restrict n)
{
    (void)c; (void)n;
    return PYS_FALSE;
}

// List / tuple / dict literals — items live in the global PYS_NODE_TABLE
// side array (the parser packs them in left-to-right at parse time).
NODE_DEF @noinline
node_make_list(CTX * restrict c, NODE * restrict n, uint32_t items_idx, uint32_t nitems)
{
    (void)n;
VALUE *items = (VALUE *)alloca(sizeof(VALUE) * (nitems ? nitems : 1));
    for (uint32_t i = 0; i < nitems; i++) {
        NODE *e = PYS_NODE_TABLE[items_idx + i];
        if (UNLIKELY(!(items[i] = (*e->head.dispatcher)(c, e)))) return 0;
    }
    return pys_make_list(items, nitems);
}

NODE_DEF @noinline
node_make_tuple(CTX * restrict c, NODE * restrict n, uint32_t items_idx, uint32_t nitems)
{
    (void)n;
VALUE *items = (VALUE *)alloca(sizeof(VALUE) * (nitems ? nitems : 1));
    for (uint32_t i = 0; i < nitems; i++) {
        NODE *e = PYS_NODE_TABLE[items_idx + i];
        if (UNLIKELY(!(items[i] = (*e->head.dispatcher)(c, e)))) return 0;
    }
    return pys_make_tuple(items, nitems);
}

NODE_DEF @noinline
node_make_set(CTX * restrict c, NODE * restrict n, uint32_t items_idx, uint32_t nitems)
{
    (void)n;
    VALUE s = pys_make_set();
    for (uint32_t i = 0; i < nitems; i++) {
        NODE *e = PYS_NODE_TABLE[items_idx + i];
        VALUE v = (*e->head.dispatcher)(c, e);
        if (UNLIKELY(!v)) return 0;
        pys_dict_set(c, s, v, PYS_NONE);
    }
    return s;
}

// Dict: `pairs_idx` points to 2*npairs NODE* (key0, val0, key1, val1, ...).
NODE_DEF @noinline
node_make_dict(CTX * restrict c, NODE * restrict n, uint32_t pairs_idx, uint32_t npairs)
{
    (void)n;
VALUE d = pys_make_dict();
    for (uint32_t i = 0; i < npairs; i++) {
        NODE *kn = PYS_NODE_TABLE[pairs_idx + 2*i];
        NODE *vn = PYS_NODE_TABLE[pairs_idx + 2*i + 1];
        VALUE k = (*kn->head.dispatcher)(c, kn);
        if (UNLIKELY(!k)) return 0;
        VALUE v = (*vn->head.dispatcher)(c, vn);
        if (UNLIKELY(!v)) return 0;
        pys_dict_set(c, d, k, v);
    }
    return d;
}

// ---------------------------------------------------------------------------
// Variables.
// ---------------------------------------------------------------------------

NODE_DEF
node_lref(CTX * restrict c, NODE * restrict n, uint32_t idx)
{
    (void)n;
    VALUE v = c->env->slots[idx];
    // VALUE 0 is the "deleted" sentinel — `del NAME` writes 0 and a
    // subsequent read should raise NameError (matches Python's
    // UnboundLocalError after del).  Real values can never be 0
    // (fixnums set bit 0; pointers are non-NULL).
    if (UNLIKELY(v == 0))
        PYS_RAISE_EXC(c, c->EXC_NameError, "local variable referenced after del");
    return v;
}

// Set slot to the "deleted" sentinel — emitted by parse_del.
NODE_DEF
node_lunbind(CTX * restrict c, NODE * restrict n, uint32_t idx)
{
    (void)n;
    c->env->slots[idx] = (VALUE)0;
    return PYS_NONE;
}

NODE_DEF
node_lset(CTX * restrict c, NODE * restrict n, uint32_t idx, NODE *val)
{
    (void)n;
    VALUE v = EVAL_ARG(c, val);
    if (UNLIKELY(!v)) return 0;
    c->env->slots[idx] = v;
    return PYS_NONE;
}

// Closure-captured local reference: walk `depth` parent links to reach
// the captured outer frame, then index `idx`.  Parser emits this for
// any NAME reference in a nested function whose binding lives in an
// enclosing function's scope.
NODE_DEF
node_lref_up(CTX * restrict c, NODE * restrict n, uint32_t depth, uint32_t idx)
{
    (void)n;
    struct pysframe *e = c->env;
    for (uint32_t i = 0; i < depth; i++) e = e->parent;
    return e->slots[idx];
}

NODE_DEF
node_lset_up(CTX * restrict c, NODE * restrict n, uint32_t depth, uint32_t idx, NODE *val)
{
    (void)n;
    VALUE v = EVAL_ARG(c, val);
    if (UNLIKELY(!v)) return 0;
    struct pysframe *e = c->env;
    for (uint32_t i = 0; i < depth; i++) e = e->parent;
    e->slots[idx] = v;
    return PYS_NONE;
}

NODE_DEF
node_gref(CTX * restrict c, NODE * restrict n, const char *name, struct gref_cache *cache@ref)
{
    (void)n;
    // Fast path: cache valid → direct array index.
    if (LIKELY(cache->serial == c->globals->serial))
        return c->globals->entries[cache->idx].value;
    extern int pys_global_resolve(CTX *c, const char *name);
    int idx = pys_global_resolve(c, name);
    if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
    cache->serial = c->globals->serial;
    cache->idx = idx;
    return c->globals->entries[idx].value;
}

NODE_DEF
node_gset(CTX * restrict c, NODE * restrict n, const char *name, NODE *val, struct gref_cache *cache@ref)
{
    (void)n;
    VALUE v = EVAL_ARG(c, val);
    if (UNLIKELY(!v)) return 0;
    // Cache holds (serial, idx).  Hot path: cache valid → direct write,
    // no serial bump (the bump only fires on structural change inside
    // pys_global_define when a new slot is allocated).
    if (LIKELY(cache->serial == c->globals->serial)) {
        c->globals->entries[cache->idx].value = v;
        return PYS_NONE;
    }
    pys_global_define(c, name, v);
    extern int pys_global_resolve(CTX *c, const char *name);
    cache->idx = pys_global_resolve(c, name);
    cache->serial = c->globals->serial;
    return PYS_NONE;
}

// ---------------------------------------------------------------------------
// Unary.
// ---------------------------------------------------------------------------

NODE_DEF
node_neg(CTX * restrict c, NODE * restrict n, NODE *a)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av))) {
        int64_t r;
        if (LIKELY(!__builtin_sub_overflow((int64_t)0, (int64_t)PYS_FIXVAL(av), &r) &&
                   r >= PYS_FIXNUM_MIN && r <= PYS_FIXNUM_MAX))
            return PYS_FIX(r);
    }
    return pys_neg(c, av);
}

NODE_DEF
node_not(CTX * restrict c, NODE * restrict n, NODE *a)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    return pys_is_truthy(av) ? PYS_FALSE : PYS_TRUE;
}

NODE_DEF
node_bit_inv(CTX * restrict c, NODE * restrict n, NODE *a)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    return pys_bit_inv(c, av);
}

// ---------------------------------------------------------------------------
// Binary arithmetic.  Fixnum fast path inline; mixed / overflow / non-int
// operands route through the helpers in main.c.
// ---------------------------------------------------------------------------

// Helper: hot-path IC for instance binops.  When LHS is a user-class
// instance and the cache is hot for that class, calls the cached
// __op__ directly — no MRO walk, no strcmp.  Returns 0 on miss /
// NotImplemented (caller falls through to pys_add slow path).
//
// On cache miss the lookup uses an interned name (intern_name once
// per literal) so pys_class_lookup_method_pub can pointer-compare
// against the class's stored method names instead of strcmp.
static inline VALUE
pys_node_binop_ic(CTX *c, struct binop_cache *cache, VALUE av, VALUE bv, const char *name_lit, const char **interned_slot)
{
    if (UNLIKELY(!(PYS_IS_PTR(av) && PYS_PTR(av)->type == PYS_T_INSTANCE)))
        return (VALUE)0;
    void *cls = (void *)PYS_PTR(av)->inst.cls;
    VALUE m;
    if (LIKELY(cache->cls_ptr == cls && cache->fn)) {
        m = (VALUE)(intptr_t)cache->fn;
    } else {
        extern VALUE pys_class_lookup_method_pub(VALUE cls_v, const char *name);
        extern const char *intern_name(const char *s, size_t len);
        if (UNLIKELY(!*interned_slot))
            *interned_slot = intern_name(name_lit, strlen(name_lit));
        m = pys_class_lookup_method_pub(PYS_OBJ_VAL(PYS_PTR(av)->inst.cls), *interned_slot);
        if (m == PYS_NONE) return (VALUE)0;
        if (PYS_IS_PTR(m) && PYS_PTR(m)->type == PYS_T_FUNC) {
            cache->cls_ptr = cls;
            cache->fn = (void *)(intptr_t)m;
        }
    }
    VALUE av2[2] = { av, bv };
    VALUE r = pys_apply(c, m, 2, av2);
    if (PYS_IS_PTR(r) && PYS_PTR(r)->type == PYS_T_NOTIMPL) return (VALUE)0;
    return r;
}
static const char *PYS_BINOP_INTERNED_add, *PYS_BINOP_INTERNED_sub, *PYS_BINOP_INTERNED_mul;

NODE_DEF
node_add(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b, struct binop_cache *cache@ref)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    // Tagged-fixnum addition: (a-1) + b = (a'<<1) + (b'<<1|1) = (a'+b')<<1|1.
    // Skips the SAR + SAR + SHL + OR untag/retag sequence.  __builtin_add_overflow
    // on the tagged values catches int64 overflow, which equals fixnum range
    // overflow exactly because tagged-MAX = 2^63-1 / tagged-MIN = -2^63+1.
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv))) {
        int64_t r;
        if (LIKELY(!__builtin_add_overflow((int64_t)av - 1, (int64_t)bv, &r)))
            return (VALUE)r;
    }
    if (LIKELY(PYS_IS_FLONUM(av) & PYS_IS_FLONUM(bv)))
        return pys_make_float(pys_flonum_to_double(av) + pys_flonum_to_double(bv));
    { VALUE r = pys_node_binop_ic(c, cache, av, bv, "__add__", &PYS_BINOP_INTERNED_add); if (r) return r; }
    return pys_add(c, av, bv);
}

// Python `+=` on list mutates in place (CPython's `__iadd__`).  pystro
// previously desugared `a += b` to `a = a + b`, which allocated a fresh
// list every iteration — pyaes's `_remaining_counter += [...]` driver
// loop was thus O(N²) and dominated memmove (12% of total).  This node
// preserves the parser's `lset(name, iadd(lref(name), rhs))` shape but
// does in-place extend when both sides are list, falling back to add().
NODE_DEF
node_iadd(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b, struct binop_cache *cache@ref)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv))) {
        int64_t r;
        if (LIKELY(!__builtin_add_overflow((int64_t)av - 1, (int64_t)bv, &r)))
            return (VALUE)r;
    }
    if (LIKELY(PYS_IS_FLONUM(av) & PYS_IS_FLONUM(bv)))
        return pys_make_float(pys_flonum_to_double(av) + pys_flonum_to_double(bv));
    if (LIKELY(PYS_IS_PTR(av) && PYS_PTR(av)->type == PYS_T_LIST)) {
        struct pysobj *la = PYS_PTR(av);
        if (PYS_IS_PTR(bv) && (PYS_PTR(bv)->type == PYS_T_LIST || PYS_PTR(bv)->type == PYS_T_TUPLE)) {
            struct pysobj *lb = PYS_PTR(bv);
            size_t add = lb->list.len;
            size_t need = la->list.len + add;
            if (need > la->list.capa) {
                size_t cap = la->list.capa ? la->list.capa : 4;
                while (cap < need) cap *= 2;
                VALUE *items = (VALUE *)GC_malloc(sizeof(VALUE) * cap);
                if (la->list.len) memcpy(items, la->list.items, sizeof(VALUE) * la->list.len);
                la->list.items = items;
                la->list.capa = cap;
            }
            // memcpy is safe even when av == bv (self-extend) only if
            // capa already covered len*2 — we just realloc'd, so source
            // pointer is the (possibly old) la->list.items.  When av ==
            // bv, lb == la and we read from the freshly allocated items
            // (which were just memcpy'd).  Read after the realloc.
            memcpy(la->list.items + la->list.len, lb->list.items, sizeof(VALUE) * add);
            la->list.len += add;
            return av;
        }
    }
    { VALUE r = pys_node_binop_ic(c, cache, av, bv, "__add__", &PYS_BINOP_INTERNED_add); if (r) return r; }
    return pys_add(c, av, bv);
}

NODE_DEF
node_sub(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b, struct binop_cache *cache@ref)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    // Tagged-fixnum subtraction: a - (b-1) = (a'<<1|1) - (b'<<1) = (a'-b')<<1|1.
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv))) {
        int64_t r;
        if (LIKELY(!__builtin_sub_overflow((int64_t)av, (int64_t)bv - 1, &r)))
            return (VALUE)r;
    }
    if (LIKELY(PYS_IS_FLONUM(av) & PYS_IS_FLONUM(bv)))
        return pys_make_float(pys_flonum_to_double(av) - pys_flonum_to_double(bv));
    { VALUE r = pys_node_binop_ic(c, cache, av, bv, "__sub__", &PYS_BINOP_INTERNED_sub); if (r) return r; }
    return pys_sub(c, av, bv);
}

NODE_DEF
node_mul(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b, struct binop_cache *cache@ref)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    // Tagged-fixnum multiplication: (a>>1) * (b-1) = a' * (b'<<1) = (a'*b')<<1.
    // OR 1 sets the tag.  The shift on `av` is one SAR instead of two (we
    // skip the second untag).  Overflow analysis: if a' * 2*b' overflows
    // int64, fixnum range is exceeded; otherwise the |1 tag preserves it.
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv))) {
        int64_t r;
        if (LIKELY(!__builtin_mul_overflow((int64_t)av >> 1, (int64_t)bv - 1, &r)))
            return (VALUE)(r | 1);
    }
    if (LIKELY(PYS_IS_FLONUM(av) & PYS_IS_FLONUM(bv)))
        return pys_make_float(pys_flonum_to_double(av) * pys_flonum_to_double(bv));
    { VALUE r = pys_node_binop_ic(c, cache, av, bv, "__mul__", &PYS_BINOP_INTERNED_mul); if (r) return r; }
    return pys_mul(c, av, bv);
}

NODE_DEF
node_matmul(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    extern VALUE pys_matmul(CTX *c, VALUE a, VALUE b);
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    return pys_matmul(c, av, bv);
}

NODE_DEF
node_truediv(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FLONUM(av) & PYS_IS_FLONUM(bv))) {
        double d = pys_flonum_to_double(bv);
        if (LIKELY(d != 0.0))
            return pys_make_float(pys_flonum_to_double(av) / d);
    }
    return pys_truediv(c, av, bv);
}

NODE_DEF
node_floordiv(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    // Fixnum // fixnum: Python floor division (rounds toward -inf).  GMP
    // path was 1.6% on pyaes for `i // 4` / `i // 16` shape ops; inline.
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv))) {
        int64_t bi = PYS_FIXVAL(bv);
        if (LIKELY(bi != 0)) {
            int64_t ai = PYS_FIXVAL(av);
            int64_t q = ai / bi;
            int64_t r = ai - q * bi;
            if ((r != 0) && ((r < 0) != (bi < 0))) q -= 1;
            return PYS_FIX(q);
        }
    }
    return pys_fdiv(c, av, bv);
}

NODE_DEF
node_mod(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    // Fixnum % fixnum: Python mod has same sign as divisor.  pyaes uses
    // `i % 4` heavily in AES round transforms; was 1.7% via GMP.
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv))) {
        int64_t bi = PYS_FIXVAL(bv);
        if (LIKELY(bi != 0)) {
            int64_t ai = PYS_FIXVAL(av);
            int64_t r = ai % bi;
            if ((r != 0) && ((r < 0) != (bi < 0))) r += bi;
            return PYS_FIX(r);
        }
    }
    return pys_mod(c, av, bv);
}

NODE_DEF
node_pow(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    return pys_pow(c, av, bv);
}

// Fixnum fast paths for bit ops.  Without these, every `a & b` /
// `a ^ b` etc. went through pys_bit_xor → pys_to_mpz → mpz_xor →
// pys_normalise_int even when both sides fit in a single fixnum.
// pyaes (AES bytes XOR / AND on 8-bit values) had `pys_bit_xor` 1.5%
// + `pys_bit_and` 1.4% + GMP `__gmpz_init_set_si` 3% in the profile.
// fixnum path: inline single instruction, GMP path 撤去。

NODE_DEF
node_bit_and(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv)))
        return PYS_FIX(PYS_FIXVAL(av) & PYS_FIXVAL(bv));
    return pys_bit_and(c, av, bv);
}

NODE_DEF
node_bit_or(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv)))
        return PYS_FIX(PYS_FIXVAL(av) | PYS_FIXVAL(bv));
    return pys_bit_or(c, av, bv);
}

NODE_DEF
node_bit_xor(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv)))
        return PYS_FIX(PYS_FIXVAL(av) ^ PYS_FIXVAL(bv));
    return pys_bit_xor(c, av, bv);
}

NODE_DEF
node_lshift(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv))) {
        int64_t x = PYS_FIXVAL(av);
        int64_t y = PYS_FIXVAL(bv);
        // `<< 0..62` での fixnum 内 overflow をチェック (符号付き 63 bit)
        if (LIKELY(y >= 0 && y < 62)) {
            int64_t r = x << y;
            // overflow detect: ((x << y) >> y) == x で確認
            if (LIKELY((r >> y) == x &&
                       r >= PYS_FIXNUM_MIN && r <= PYS_FIXNUM_MAX))
                return PYS_FIX(r);
        }
    }
    return pys_lshift(c, av, bv);
}

NODE_DEF
node_rshift(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv))) {
        int64_t x = PYS_FIXVAL(av);
        int64_t y = PYS_FIXVAL(bv);
        if (LIKELY(y >= 0 && y < 63))
            return PYS_FIX(x >> y);
    }
    return pys_rshift(c, av, bv);
}

// ---------------------------------------------------------------------------
// Comparisons.
// ---------------------------------------------------------------------------

NODE_DEF
node_lt(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv)))
        return ((int64_t)PYS_FIXVAL(av) < (int64_t)PYS_FIXVAL(bv)) ? PYS_TRUE : PYS_FALSE;
    if (LIKELY(PYS_IS_FLONUM(av) & PYS_IS_FLONUM(bv)))
        return pys_flonum_to_double(av) < pys_flonum_to_double(bv) ? PYS_TRUE : PYS_FALSE;
    {
        // For set / frozenset subclass instances, unwrap to primary so
        // `class S(frozenset): pass; S({1}) < S({1,2})` works.
        VALUE auw = (PYS_IS_PTR(av) && PYS_PTR(av)->type == PYS_T_INSTANCE
                     && PYS_PTR(av)->inst.primary) ? PYS_PTR(av)->inst.primary : av;
        VALUE buw = (PYS_IS_PTR(bv) && PYS_PTR(bv)->type == PYS_T_INSTANCE
                     && PYS_PTR(bv)->inst.primary) ? PYS_PTR(bv)->inst.primary : bv;
        if (pys_is_any_set(auw) && pys_is_any_set(buw)) {
            extern int pys_set_cmp_partial(CTX *c, VALUE a, VALUE b);
            int r = pys_set_cmp_partial(c, auw, buw);
            return r == -1 ? PYS_TRUE : PYS_FALSE;
        }
    }
    // Try b.__gt__(a) before falling into pys_cmp's hard-coded TypeError —
    // CPython rich comparison: `set < instance` consults instance.__gt__.
    // Try b.__gt__(a) — CPython rich comparison fallback for `set < instance`.
    if (PYS_IS_PTR(bv) && PYS_PTR(bv)->type == PYS_T_INSTANCE) {
        extern VALUE pys_class_lookup_method(VALUE cls, const char *name);
        VALUE bcls = PYS_OBJ_VAL(PYS_PTR(bv)->inst.cls);
        VALUE m = pys_class_lookup_method(bcls, "__gt__");
        if (m != PYS_NONE) {
            VALUE av_arr[2] = { bv, av };
            VALUE r = pys_apply(c, m, 2, av_arr);
            if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
            if (!(PYS_IS_PTR(r) && PYS_PTR(r)->type == PYS_T_NOTIMPL))
                return pys_is_truthy(r) ? PYS_TRUE : PYS_FALSE;
        }
    }
    {
        int r = pys_cmp(c, av, bv);
        if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
        return r < 0 ? PYS_TRUE : PYS_FALSE;
    }
}

NODE_DEF
node_le(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv)))
        return ((int64_t)PYS_FIXVAL(av) <= (int64_t)PYS_FIXVAL(bv)) ? PYS_TRUE : PYS_FALSE;
    if (LIKELY(PYS_IS_FLONUM(av) & PYS_IS_FLONUM(bv)))
        return pys_flonum_to_double(av) <= pys_flonum_to_double(bv) ? PYS_TRUE : PYS_FALSE;
    {
        VALUE auw = (PYS_IS_PTR(av) && PYS_PTR(av)->type == PYS_T_INSTANCE
                     && PYS_PTR(av)->inst.primary) ? PYS_PTR(av)->inst.primary : av;
        VALUE buw = (PYS_IS_PTR(bv) && PYS_PTR(bv)->type == PYS_T_INSTANCE
                     && PYS_PTR(bv)->inst.primary) ? PYS_PTR(bv)->inst.primary : bv;
        if (pys_is_any_set(auw) && pys_is_any_set(buw)) {
            extern int pys_set_cmp_partial(CTX *c, VALUE a, VALUE b);
            int r = pys_set_cmp_partial(c, auw, buw);
            return (r == -1 || r == 0) ? PYS_TRUE : PYS_FALSE;
        }
    }
    if (PYS_IS_PTR(bv) && PYS_PTR(bv)->type == PYS_T_INSTANCE) {
        extern VALUE pys_class_lookup_method(VALUE cls, const char *name);
        VALUE m = pys_class_lookup_method(PYS_OBJ_VAL(PYS_PTR(bv)->inst.cls), "__ge__");
        if (m != PYS_NONE) {
            VALUE av_arr[2] = { bv, av };
            VALUE r = pys_apply(c, m, 2, av_arr);
            if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
            if (!(PYS_IS_PTR(r) && PYS_PTR(r)->type == PYS_T_NOTIMPL))
                return pys_is_truthy(r) ? PYS_TRUE : PYS_FALSE;
        }
    }
    {
        int r = pys_cmp(c, av, bv);
        if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
        return r <= 0 ? PYS_TRUE : PYS_FALSE;
    }
}

NODE_DEF
node_gt(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv)))
        return ((int64_t)PYS_FIXVAL(av) > (int64_t)PYS_FIXVAL(bv)) ? PYS_TRUE : PYS_FALSE;
    if (LIKELY(PYS_IS_FLONUM(av) & PYS_IS_FLONUM(bv)))
        return pys_flonum_to_double(av) > pys_flonum_to_double(bv) ? PYS_TRUE : PYS_FALSE;
    {
        VALUE auw = (PYS_IS_PTR(av) && PYS_PTR(av)->type == PYS_T_INSTANCE
                     && PYS_PTR(av)->inst.primary) ? PYS_PTR(av)->inst.primary : av;
        VALUE buw = (PYS_IS_PTR(bv) && PYS_PTR(bv)->type == PYS_T_INSTANCE
                     && PYS_PTR(bv)->inst.primary) ? PYS_PTR(bv)->inst.primary : bv;
        if (pys_is_any_set(auw) && pys_is_any_set(buw)) {
            extern int pys_set_cmp_partial(CTX *c, VALUE a, VALUE b);
            int r = pys_set_cmp_partial(c, auw, buw);
            return r == 1 ? PYS_TRUE : PYS_FALSE;
        }
    }
    if (PYS_IS_PTR(bv) && PYS_PTR(bv)->type == PYS_T_INSTANCE) {
        extern VALUE pys_class_lookup_method(VALUE cls, const char *name);
        VALUE m = pys_class_lookup_method(PYS_OBJ_VAL(PYS_PTR(bv)->inst.cls), "__lt__");
        if (m != PYS_NONE) {
            VALUE av_arr[2] = { bv, av };
            VALUE r = pys_apply(c, m, 2, av_arr);
            if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
            if (!(PYS_IS_PTR(r) && PYS_PTR(r)->type == PYS_T_NOTIMPL))
                return pys_is_truthy(r) ? PYS_TRUE : PYS_FALSE;
        }
    }
    {
        int r = pys_cmp(c, av, bv);
        if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
        return r > 0 ? PYS_TRUE : PYS_FALSE;
    }
}

NODE_DEF
node_ge(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv)))
        return ((int64_t)PYS_FIXVAL(av) >= (int64_t)PYS_FIXVAL(bv)) ? PYS_TRUE : PYS_FALSE;
    if (LIKELY(PYS_IS_FLONUM(av) & PYS_IS_FLONUM(bv)))
        return pys_flonum_to_double(av) >= pys_flonum_to_double(bv) ? PYS_TRUE : PYS_FALSE;
    {
        VALUE auw = (PYS_IS_PTR(av) && PYS_PTR(av)->type == PYS_T_INSTANCE
                     && PYS_PTR(av)->inst.primary) ? PYS_PTR(av)->inst.primary : av;
        VALUE buw = (PYS_IS_PTR(bv) && PYS_PTR(bv)->type == PYS_T_INSTANCE
                     && PYS_PTR(bv)->inst.primary) ? PYS_PTR(bv)->inst.primary : bv;
        if (pys_is_any_set(auw) && pys_is_any_set(buw)) {
            extern int pys_set_cmp_partial(CTX *c, VALUE a, VALUE b);
            int r = pys_set_cmp_partial(c, auw, buw);
            return (r == 1 || r == 0) ? PYS_TRUE : PYS_FALSE;
        }
    }
    if (PYS_IS_PTR(bv) && PYS_PTR(bv)->type == PYS_T_INSTANCE) {
        extern VALUE pys_class_lookup_method(VALUE cls, const char *name);
        VALUE m = pys_class_lookup_method(PYS_OBJ_VAL(PYS_PTR(bv)->inst.cls), "__le__");
        if (m != PYS_NONE) {
            VALUE av_arr[2] = { bv, av };
            VALUE r = pys_apply(c, m, 2, av_arr);
            if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
            if (!(PYS_IS_PTR(r) && PYS_PTR(r)->type == PYS_T_NOTIMPL))
                return pys_is_truthy(r) ? PYS_TRUE : PYS_FALSE;
        }
    }
    {
        int r = pys_cmp(c, av, bv);
        if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
        return r >= 0 ? PYS_TRUE : PYS_FALSE;
    }
}

NODE_DEF
node_eq(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv)))
        return av == bv ? PYS_TRUE : PYS_FALSE;
    return pys_eq(c, av, bv);
}

NODE_DEF
node_ne(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    if (LIKELY(PYS_IS_FIXNUM(av) & PYS_IS_FIXNUM(bv)))
        return av != bv ? PYS_TRUE : PYS_FALSE;
    return pys_eq(c, av, bv) == PYS_TRUE ? PYS_FALSE : PYS_TRUE;
}

NODE_DEF
node_is(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)c; (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    return av == bv ? PYS_TRUE : PYS_FALSE;
}

NODE_DEF
node_is_not(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)c; (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    return av != bv ? PYS_TRUE : PYS_FALSE;
}

NODE_DEF
node_in(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    bool r = pys_contains(c, bv, av);
    if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
    return r ? PYS_TRUE : PYS_FALSE;
}

NODE_DEF
node_not_in(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    VALUE bv = EVAL_ARG(c, b);
    if (UNLIKELY(!bv)) return 0;
    bool r = pys_contains(c, bv, av);
    if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
    return r ? PYS_FALSE : PYS_TRUE;
}

// ---------------------------------------------------------------------------
// Logical (short-circuit).
// ---------------------------------------------------------------------------

NODE_DEF
node_and(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    if (!pys_is_truthy(av)) return av;
    return EVAL_ARG(c, b);
}

NODE_DEF
node_or(CTX * restrict c, NODE * restrict n, NODE *a, NODE *b)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (UNLIKELY(!av)) return 0;
    if (pys_is_truthy(av)) return av;
    return EVAL_ARG(c, b);
}

// ---------------------------------------------------------------------------
// Subscript / slice / attribute.
// ---------------------------------------------------------------------------

NODE_DEF
node_subscript_get(CTX * restrict c, NODE * restrict n, NODE *seq, NODE *idx)
{
    (void)n;
    VALUE sv = EVAL_ARG(c, seq);
    if (UNLIKELY(!sv)) return 0;
    VALUE iv = EVAL_ARG(c, idx);
    if (UNLIKELY(!iv)) return 0;
    // Fixnum index on list/tuple/bytes/bytearray fast path.  pyaes
    // does heavy bytes-arr[i] indexing for AES round transforms;
    // pys_list_get's full dispatch was ~3% of total runtime.
    if (LIKELY(PYS_IS_FIXNUM(iv) && PYS_IS_PTR(sv))) {
        int t = PYS_PTR(sv)->type;
        int64_t i = PYS_FIXVAL(iv);
        if (t == PYS_T_LIST || t == PYS_T_TUPLE) {
            struct pysobj *o = PYS_PTR(sv);
            if (UNLIKELY(i < 0)) i += (int64_t)o->list.len;
            if (LIKELY((uint64_t)i < (uint64_t)o->list.len))
                return o->list.items[i];
        } else if (t == PYS_T_BYTES || t == PYS_T_BYTEARRAY) {
            struct pysobj *o = PYS_PTR(sv);
            if (UNLIKELY(i < 0)) i += (int64_t)o->str.len;
            if (LIKELY((uint64_t)i < (uint64_t)o->str.len))
                return PYS_FIX((unsigned char)o->str.chars[i]);
        }
    }
    return pys_list_get(c, sv, iv);
}

NODE_DEF
node_subscript_set(CTX * restrict c, NODE * restrict n, NODE *seq, NODE *idx, NODE *val)
{
    (void)n;
    VALUE sv = EVAL_ARG(c, seq);
    if (UNLIKELY(!sv)) return 0;
    VALUE iv = EVAL_ARG(c, idx);
    if (UNLIKELY(!iv)) return 0;
    VALUE vv = EVAL_ARG(c, val);
    if (UNLIKELY(!vv)) return 0;
    // Fast path: list[fixnum] = v.
    if (LIKELY(pys_is_list(sv) && PYS_IS_FIXNUM(iv))) {
        struct pysobj *o = PYS_PTR(sv);
        int64_t i = PYS_FIXVAL(iv);
        if (i < 0) i += (int64_t)o->list.len;
        if (LIKELY(i >= 0 && i < (int64_t)o->list.len)) {
            o->list.items[i] = vv;
            return PYS_NONE;
        }
    }
    pys_list_set(c, sv, iv, vv);
    return PYS_NONE;
}

NODE_DEF
node_slice(CTX * restrict c, NODE * restrict n, NODE *seq, NODE *start, NODE *stop, NODE *step)
{
    (void)n;
    VALUE sv = EVAL_ARG(c, seq);
    if (UNLIKELY(!sv)) return 0;
    VALUE a = EVAL_ARG(c, start);
    if (UNLIKELY(!a)) return 0;
    VALUE b = EVAL_ARG(c, stop);
    if (UNLIKELY(!b)) return 0;
    VALUE s = EVAL_ARG(c, step);
    if (UNLIKELY(!s)) return 0;
    return pys_list_slice(c, sv, a, b, s);
}

NODE_DEF
node_slice_set(CTX * restrict c, NODE * restrict n, NODE *seq, NODE *start, NODE *stop, NODE *step, NODE *val)
{
    (void)n;
    extern void pys_list_slice_set(CTX *c, VALUE seq, VALUE start, VALUE stop, VALUE step, VALUE val);
    VALUE sv = EVAL_ARG(c, seq);
    if (UNLIKELY(!sv)) return 0;
    VALUE a  = EVAL_ARG(c, start);
    VALUE b  = EVAL_ARG(c, stop);
    VALUE s  = EVAL_ARG(c, step);
    VALUE vv = EVAL_ARG(c, val);
    if (UNLIKELY(!vv)) return 0;
    pys_list_slice_set(c, sv, a, b, s, vv);
    return PYS_NONE;
}

NODE_DEF
node_attr_get(CTX * restrict c, NODE * restrict n, NODE *obj, const char *name, struct attr_cache *cache@ref)
{
    (void)n;
    VALUE ov = EVAL_ARG(c, obj);
    if (UNLIKELY(!ov)) return 0;
    // Inline cache fast path: same class + same attrs dict identity →
    // load the cached entry directly.  attrs_id encodes the backing-
    // storage identity (realloc bumps it via the new pointer cast), so
    // a match guarantees `eidx` still indexes the same slot for the
    // cached name.  Only check the key isn't DELETED; the previous
    // `is_str + strlen + memcmp` was redundant since the cache was
    // only stamped after pys_getattr resolved the name.
    //
    // Note: the cache match itself proves obj evaluated cleanly — a
    // raised call would have left ov == PYS_NONE which can never match
    // a class-matching cls_ptr.  So the state check is only needed on
    // cache miss (slow path).
    if (LIKELY(PYS_IS_PTR(ov) && PYS_PTR(ov)->type == PYS_T_INSTANCE)) {
        struct pysobj *o = PYS_PTR(ov);
        if (LIKELY(o->inst.attrs)) {
            void *cls = (void *)o->inst.cls;
            uint32_t sv = o->inst.cls->cls.shape_version;
            // 4-way polymorphic scan; on hit verify eidx is in range
            // and the key slot still alive, then return the value.
            int eidx = -1;
            if (LIKELY(cache->u_cls[0] == cls && cache->u_sv[0] == sv)) eidx = cache->u_eidx[0];
            else if (cache->u_cls[1] == cls && cache->u_sv[1] == sv)    eidx = cache->u_eidx[1];
            else if (cache->u_cls[2] == cls && cache->u_sv[2] == sv)    eidx = cache->u_eidx[2];
            else if (cache->u_cls[3] == cls && cache->u_sv[3] == sv)    eidx = cache->u_eidx[3];
            if (LIKELY(eidx >= 0 && (size_t)eidx < o->inst.attrs->elen)) {
                VALUE k = o->inst.attrs->entries[eidx].key;
                if (LIKELY(k != 0 && k != DICT_DELETED_KEY))
                    return o->inst.attrs->entries[eidx].value;
            }
        }
        // Instance-receiver class-attr fast path (`aes.T1`, `self.S` ..):
        // attribute lives on the class, not the instance dict.  When the
        // class is unchanged since stamping, the cached value is still
        // current.  Monomorphic single slot (the hot pyaes / raytrace
        // sites are call-site monomorphic).
        if (cache->inst_ca_cls == (void *)o->inst.cls
            && cache->inst_ca_val
            && cache->inst_ca_sv == o->inst.cls->cls.shape_version) {
            return (VALUE)(intptr_t)cache->inst_ca_val;
        }
    } else if (PYS_IS_PTR(ov) && PYS_PTR(ov)->type == PYS_T_CLASS) {
        // Class data attr (`Strength.WEAKEST`, `Cls.classmethod`).  Cache
        // the resolved value monomorphically — class shape_version
        // invalidates on method add.  Saves MRO walk + strcmp in
        // pys_class_lookup_method on every access.
        if (LIKELY(cache->cls_recv == (void *)PYS_PTR(ov)
                   && cache->class_value
                   && cache->cls_recv_sv == PYS_PTR(ov)->cls.shape_version)) {
            return (VALUE)(intptr_t)cache->class_value;
        }
    }
    // Propagate raise from the receiver expression — without this,
    // chained `raiser().attr` would silently consult `None.attr`.
    if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
    VALUE r = pys_getattr(c, ov, name);
    if (UNLIKELY(!r)) return 0;
    // Stamp class-data attr cache.
    if (PYS_IS_PTR(ov) && PYS_PTR(ov)->type == PYS_T_CLASS && r != PYS_NONE) {
        cache->cls_recv = (void *)PYS_PTR(ov);
        cache->class_value = (void *)(intptr_t)r;
        cache->cls_recv_sv = PYS_PTR(ov)->cls.shape_version;
    }
    // Stamp the cache for next time.
    if (PYS_IS_PTR(ov) && PYS_PTR(ov)->type == PYS_T_INSTANCE && r != PYS_NONE) {
        struct pysobj *o = PYS_PTR(ov);
        int32_t found_eidx = -1;
        if (o->inst.attrs) {
            for (size_t i = 0; i < o->inst.attrs->elen; i++) {
                VALUE k = o->inst.attrs->entries[i].key;
                if (k != 0 && k != DICT_DELETED_KEY
                    && pys_is_str(k) && PYS_PTR(k)->str.len == strlen(name)
                    && memcmp(PYS_PTR(k)->str.chars, name, PYS_PTR(k)->str.len) == 0) {
                    found_eidx = (int32_t)i;
                    break;
                }
            }
        }
        if (found_eidx >= 0) {
            void *cls = (void *)o->inst.cls;
            uint32_t sv = o->inst.cls->cls.shape_version;
            // Find an existing slot for this cls; on miss, shift
            // entries down (LRU eviction of slot 3) and insert at 0.
            int found = -1;
            for (int s = 0; s < PYS_ATTR_PIC_WAYS; s++)
                if (cache->u_cls[s] == cls) { found = s; break; }
            if (found < 0) {
                for (int s = PYS_ATTR_PIC_WAYS - 1; s > 0; s--) {
                    cache->u_cls [s] = cache->u_cls [s - 1];
                    cache->u_eidx[s] = cache->u_eidx[s - 1];
                    cache->u_sv  [s] = cache->u_sv  [s - 1];
                }
                cache->u_cls[0] = cls;
            }
            int slot = (found >= 0) ? found : 0;
            cache->u_eidx[slot] = found_eidx;
            cache->u_sv  [slot] = sv;
        } else {
            // Instance-receiver class-attr stamp: only when the value
            // is stable data (not a bound method, descriptor, or
            // property — those depend on receiver / re-evaluate).
            bool stamp = false;
            if (PYS_IS_PTR(r)) {
                int t = PYS_PTR(r)->type;
                if (t == PYS_T_LIST || t == PYS_T_TUPLE || t == PYS_T_DICT
                    || t == PYS_T_STR || t == PYS_T_BYTES || t == PYS_T_BYTEARRAY
                    || t == PYS_T_SET || t == PYS_T_FROZENSET
                    || t == PYS_T_BIGNUM || t == PYS_T_RANGE
                    || t == PYS_T_CLASS)
                    stamp = true;
            } else {
                stamp = true;   // immediate fixnum / flonum / None / bool
            }
            if (stamp) {
                cache->inst_ca_cls = (void *)o->inst.cls;
                cache->inst_ca_val = (void *)(intptr_t)r;
                cache->inst_ca_sv  = o->inst.cls->cls.shape_version;
            }
        }
    }
    return r;
}

NODE_DEF
node_attr_set(CTX * restrict c, NODE * restrict n, NODE *obj, const char *name, NODE *val, struct attr_cache *cache@ref)
{
    (void)n;
    VALUE ov = EVAL_ARG(c, obj);
    if (UNLIKELY(!ov)) return 0;
    VALUE vv = EVAL_ARG(c, val);
    if (UNLIKELY(!vv)) return 0;
    // Fast path: same class + same attrs dict + cached entry index +
    // class has no __setattr__/data-descriptor/__slots__ overrides.
    // The cache match proves both ov and vv evaluated cleanly — a
    // raise would have left them as PYS_NONE which can't match.  So
    // state check is deferred to slow path.
    if (LIKELY(PYS_IS_PTR(ov) && PYS_PTR(ov)->type == PYS_T_INSTANCE)) {
        struct pysobj *o = PYS_PTR(ov);
        void *cls = (void *)o->inst.cls;
        uint32_t sv = o->inst.cls->cls.shape_version;
        // Find matching slot — class + shape_version must agree.
        int matched_slot = -1;
        if (LIKELY(cache->u_cls[0] == cls && cache->u_sv[0] == sv)) matched_slot = 0;
        else if (cache->u_cls[1] == cls && cache->u_sv[1] == sv)    matched_slot = 1;
        else if (cache->u_cls[2] == cls && cache->u_sv[2] == sv)    matched_slot = 2;
        else if (cache->u_cls[3] == cls && cache->u_sv[3] == sv)    matched_slot = 3;
        if (LIKELY(matched_slot >= 0)) {
            // Already verified: no __setattr__ / data-descriptor / __slots__
            // overrides for this (cls, sv) pair (those bump shape_version).
            // Allocate attrs lazily here if NULL — saves a slow-path round
            // trip through pys_setattr for every fresh instance attribute.
            extern struct pysdict *pydict_new(void);
            extern int32_t pydict_set_h(CTX *c, struct pysdict *d, VALUE key, uint64_t h, VALUE val);
            if (UNLIKELY(!o->inst.attrs)) o->inst.attrs = pydict_new();
            int eidx = cache->u_eidx[matched_slot];
            if (LIKELY(eidx >= 0 && (size_t)eidx < o->inst.attrs->elen)) {
                VALUE k = o->inst.attrs->entries[eidx].key;
                if (LIKELY(k != 0 && k != DICT_DELETED_KEY)) {
                    o->inst.attrs->entries[eidx].value = vv;
                    return PYS_NONE;
                }
            }
            // Attrs exists but the entry isn't there yet (fresh
            // instance, first write at this site).  Insert via the
            // generic dict setter and update the cache slot.  No
            // descriptor check needed — same (cls, sv) means same
            // semantics as a previous successful stamp.
            //
            // Reuse the per-call-site cached (key, hash) when present —
            // raytrace's Vector __init__ creates fresh attrs dicts for
            // every instance, so the 2nd + 3rd attr_set went through
            // pys_make_str + pys_hash repeatedly even though the name
            // is identical to last call at this source line.
            VALUE key = (VALUE)(intptr_t)cache->key_val;
            uint64_t h;
            if (UNLIKELY(!key)) {
                key = pys_make_str(name, strlen(name));
                h = pys_hash(c, key);
                cache->key_val  = (void *)(intptr_t)key;
                cache->key_hash = h;
            } else {
                h = cache->key_hash;
            }
            int32_t new_eidx = pydict_set_h(c, o->inst.attrs, key, h, vv);
            if (LIKELY(new_eidx >= 0)) cache->u_eidx[matched_slot] = new_eidx;
            return PYS_NONE;
        }
    }
    if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
    pys_setattr(c, ov, name, vv);
    // Stamp the cache only if the class has none of the overrides that
    // the fast path skips (__setattr__, data descriptor for `name`,
    // __slots__).  Otherwise leave the cache disabled so subsequent
    // calls keep going through pys_setattr.
    if (PYS_IS_PTR(ov) && PYS_PTR(ov)->type == PYS_T_INSTANCE) {
        struct pysobj *o = PYS_PTR(ov);
        if (o->inst.attrs) {
            void *cls_p = (void *)o->inst.cls;
            uint32_t sv = o->inst.cls->cls.shape_version;
            // Idempotent stamp: if any slot already has (cls_p, sv), the
            // descriptor / __setattr__ checks were done previously — just
            // refresh eidx (which can change as attrs grows).  This
            // eliminates a 2.75M-call pys_class_lookup_method_pub
            // hot path on raytrace where new Vector instances each
            // re-stamp 3 times in __init__.
            int existing_slot = -1;
            for (int s = 0; s < PYS_ATTR_PIC_WAYS; s++) {
                if (cache->u_cls[s] == cls_p && cache->u_sv[s] == sv) {
                    existing_slot = s;
                    break;
                }
            }
            if (existing_slot >= 0) {
                // Re-find eidx for `name` in this instance's attrs.
                for (size_t i = 0; i < o->inst.attrs->elen; i++) {
                    VALUE k = o->inst.attrs->entries[i].key;
                    if (k != 0 && k != DICT_DELETED_KEY
                        && pys_is_str(k) && PYS_PTR(k)->str.len == strlen(name)
                        && memcmp(PYS_PTR(k)->str.chars, name, PYS_PTR(k)->str.len) == 0) {
                        cache->u_eidx[existing_slot] = (int32_t)i;
                        break;
                    }
                }
                return PYS_NONE;
            }
            VALUE cls = PYS_OBJ_VAL(o->inst.cls);
            extern VALUE pys_class_lookup_method_pub(VALUE cls, const char *name);
            extern bool pys_class_has_slots_anywhere(VALUE cls);
            extern const char *PYS_INTERN_setattr;
            VALUE sm = pys_class_lookup_method_pub(cls, PYS_INTERN_setattr);
            bool has_setattr_override = (sm != PYS_NONE
                && !(PYS_IS_PTR(sm) && PYS_PTR(sm)->type == PYS_T_BUILTIN));
            if (!has_setattr_override
                && !pys_class_has_slots_anywhere(cls)) {
                VALUE m = pys_class_lookup_method_pub(cls, name);
                bool has_descriptor = false;
                if (m != PYS_NONE && PYS_IS_PTR(m)) {
                    int t = PYS_PTR(m)->type;
                    has_descriptor = (t == PYS_T_PROPERTY || t == PYS_T_INSTANCE);
                }
                if (!has_descriptor) {
                    for (size_t i = 0; i < o->inst.attrs->elen; i++) {
                        VALUE k = o->inst.attrs->entries[i].key;
                        if (k != 0 && k != DICT_DELETED_KEY
                            && pys_is_str(k) && PYS_PTR(k)->str.len == strlen(name)
                            && memcmp(PYS_PTR(k)->str.chars, name, PYS_PTR(k)->str.len) == 0) {
                            void *cls_p = (void *)o->inst.cls;
                            uint32_t sv = o->inst.cls->cls.shape_version;
                            int found = -1;
                            for (int s = 0; s < PYS_ATTR_PIC_WAYS; s++)
                                if (cache->u_cls[s] == cls_p) { found = s; break; }
                            if (found < 0) {
                                for (int s = PYS_ATTR_PIC_WAYS - 1; s > 0; s--) {
                                    cache->u_cls [s] = cache->u_cls [s - 1];
                                    cache->u_eidx[s] = cache->u_eidx[s - 1];
                                    cache->u_sv  [s] = cache->u_sv  [s - 1];
                                }
                                cache->u_cls[0] = cls_p;
                            }
                            int slot = (found >= 0) ? found : 0;
                            cache->u_eidx[slot] = (int32_t)i;
                            cache->u_sv  [slot] = sv;
                            break;
                        }
                    }
                }
            }
        }
    }
    return PYS_NONE;
}

// ---------------------------------------------------------------------------
// Control flow.
// ---------------------------------------------------------------------------

NODE_DEF
node_if(CTX * restrict c, NODE * restrict n, NODE *cond, NODE *thn, NODE *els)
{
    (void)n;
    VALUE cv = EVAL_ARG(c, cond);
    if (UNLIKELY(!cv)) return 0;
    if (pys_is_truthy(cv)) return EVAL_ARG(c, thn);
    return EVAL_ARG(c, els);
}

NODE_DEF
node_seq(CTX * restrict c, NODE * restrict n, NODE *first, NODE *rest)
{
    (void)n;
    if (UNLIKELY(!EVAL_ARG(c, first))) return 0;
    return EVAL_ARG(c, rest);
}

NODE_DEF
node_nop(CTX * restrict c, NODE * restrict n)
{
    (void)c; (void)n;
    return PYS_NONE;
}

NODE_DEF
node_while(CTX * restrict c, NODE * restrict n, NODE *cond, NODE *body, NODE *else_body)
{
    (void)n;
    for (;;) {
        VALUE cv = EVAL_ARG(c, cond);
        if (UNLIKELY(!cv)) return 0;
        if (!pys_is_truthy(cv)) {
            if (UNLIKELY(!EVAL_ARG(c, else_body))) return 0;
            return PYS_NONE;
        }
        EVAL_ARG(c, body);
        if (UNLIKELY(c->state != PYS_STATE_NORMAL)) {
            if (c->state == PYS_STATE_BREAK)    { c->state = PYS_STATE_NORMAL; return PYS_NONE; }
            if (c->state == PYS_STATE_CONTINUE) { c->state = PYS_STATE_NORMAL; continue; }
            return 0;   // RETURN / RAISE — propagate via state + 0
        }
    }
}

NODE_DEF
node_break(CTX * restrict c, NODE * restrict n)
{
    (void)n;
    c->state = PYS_STATE_BREAK;
    return 0;
}

NODE_DEF
node_continue(CTX * restrict c, NODE * restrict n)
{
    (void)n;
    c->state = PYS_STATE_CONTINUE;
    return 0;
}

// `for x in iter: body else: else_body` over local target.  The
// `else` clause runs when the loop terminates normally (no `break`).
NODE_DEF
node_for_local(CTX * restrict c, NODE * restrict n, uint32_t slot, NODE *iter, NODE *body, NODE *else_body)
{
    (void)n;
    VALUE it = EVAL_ARG(c, iter);
    if (UNLIKELY(!it)) return 0;
    struct pys_iter st;
    pys_iter_init(c, &st, it);
    if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
    VALUE elt;
    while (pys_iter_next_inline(c, &st, &elt)) {
        if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
        c->env->slots[slot] = elt;
        EVAL_ARG(c, body);
        if (UNLIKELY(c->state != PYS_STATE_NORMAL)) {
            if (c->state == PYS_STATE_BREAK)    { c->state = PYS_STATE_NORMAL; return PYS_NONE; }
            if (c->state == PYS_STATE_CONTINUE) { c->state = PYS_STATE_NORMAL; continue; }
            return 0;   // RETURN / RAISE — propagate via state + 0
        }
    }
    // pys_iter_next_inline returns false on both natural exhaustion AND
    // when __next__ raised — propagate the raise rather than entering
    // the else-clause.
    if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
    if (UNLIKELY(!EVAL_ARG(c, else_body))) return 0;
    return PYS_NONE;
}

NODE_DEF
node_for_global(CTX * restrict c, NODE * restrict n, const char *name, NODE *iter, NODE *body, NODE *else_body, struct gref_cache *cache@ref)
{
    (void)n;
    VALUE it = EVAL_ARG(c, iter);
    if (UNLIKELY(!it)) return 0;
    struct pys_iter st;
    pys_iter_init(c, &st, it);
    if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
    if (cache->serial != c->globals->serial) {
        extern int pys_global_resolve_or_alloc(CTX *c, const char *name);
        cache->idx = pys_global_resolve_or_alloc(c, name);
        cache->serial = c->globals->serial;
    }
    int idx = cache->idx;
    VALUE elt;
    while (pys_iter_next_inline(c, &st, &elt)) {
        if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
        c->globals->entries[idx].value = elt;
        c->globals->entries[idx].defined = true;
        EVAL_ARG(c, body);
        if (UNLIKELY(c->state != PYS_STATE_NORMAL)) {
            if (c->state == PYS_STATE_BREAK)    { c->state = PYS_STATE_NORMAL; return PYS_NONE; }
            if (c->state == PYS_STATE_CONTINUE) { c->state = PYS_STATE_NORMAL; continue; }
            return 0;   // RETURN / RAISE — propagate via state + 0
        }
    }
    if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
    if (UNLIKELY(!EVAL_ARG(c, else_body))) return 0;
    return PYS_NONE;
}

NODE_DEF
node_return(CTX * restrict c, NODE * restrict n, NODE *val)
{
    (void)n;
    VALUE v = EVAL_ARG(c, val);
    if (UNLIKELY(!v)) return 0;
    c->state = PYS_STATE_RETURN;
    c->state_value = v;
    return 0;
}

NODE_DEF
node_raise(CTX * restrict c, NODE * restrict n, NODE *exc)
{
    (void)n;
    VALUE v = EVAL_ARG(c, exc);
    if (UNLIKELY(!v)) return 0;
    // Allow `raise SomeClass` (auto-instantiate with no args) or a
    // ready-made instance.
    if (pys_is_class(v)) {
        v = pys_apply(c, v, 0, NULL);
        if (UNLIKELY(!v && c->state != PYS_STATE_RAISE)) return 0;
    } else if (!pys_is_instance(v) || !PYS_PTR(v)->inst.cls
               || !PYS_PTR(v)->inst.cls->cls.is_exception) {
        PYS_RAISE_EXC(c, c->EXC_TypeError,
                     "exceptions must derive from BaseException");
    }
    // Stash a traceback snapshot on the raised instance, if not set yet.
    // Build a chain of TracebackType-like instances (tb.tb_frame.f_code...)
    // so CPython introspection (`traceback.extract_tb`) walks the stack.
    if (pys_is_instance(v) && c->call_top > 0 && c->TYPE_traceback != 0) {
        VALUE existing = pys_getattr_optional(c, v, "__traceback__");
        if (!existing || existing == PYS_NONE) {
            c->state = PYS_STATE_NORMAL;
            VALUE next = PYS_NONE;
            for (int i = 0; i < c->call_top; i++) {
                const char *fn = c->call_stack[i] ? c->call_stack[i] : "<anon>";
                VALUE frame = pys_make_instance(c->TYPE_frame);
                VALUE code  = pys_make_instance(c->TYPE_object);
                pys_setattr(c, code, "co_name", pys_make_str(fn, strlen(fn)));
                pys_setattr(c, code, "co_filename", pys_make_str("<pystro>", 8));
                pys_setattr(c, code, "co_firstlineno", PYS_FIX(0));
                pys_setattr(c, frame, "f_code", code);
                pys_setattr(c, frame, "f_lineno", PYS_FIX(0));
                pys_setattr(c, frame, "f_lasti", PYS_FIX(-1));
                pys_setattr(c, frame, "f_globals", pys_make_dict());
                pys_setattr(c, frame, "f_locals", pys_make_dict());
                pys_setattr(c, frame, "f_back", PYS_NONE);
                pys_setattr(c, frame, "f_trace", PYS_NONE);
                VALUE tb = pys_make_instance(c->TYPE_traceback);
                pys_setattr(c, tb, "tb_frame", frame);
                pys_setattr(c, tb, "tb_lineno", PYS_FIX(0));
                pys_setattr(c, tb, "tb_lasti", PYS_FIX(-1));
                pys_setattr(c, tb, "tb_next", next);
                next = tb;
            }
            pys_setattr(c, v, "__traceback__", next);
        }
    }
    // Implicit __context__: when raising inside an except handler, the
    // currently-handled exception becomes the new exception's context
    // — unless the user already explicitly set __cause__ via 'raise X
    // from Y' (in which case __suppress_context__ is True).
    if (pys_is_instance(v) && c->current_handling_exc
        && c->current_handling_exc != PYS_NONE && c->current_handling_exc != v) {
        VALUE existing = pys_getattr_optional(c, v, "__context__");
        if (!existing || existing == PYS_NONE) {
            c->state = PYS_STATE_NORMAL;
            pys_setattr(c, v, "__context__", c->current_handling_exc);
        }
    }
    c->state = PYS_STATE_RAISE;
    c->state_value = v;
    return 0;
}

NODE_DEF
node_raise_bare(CTX * restrict c, NODE * restrict n)
{
    (void)n;
    if (c->state_value == 0 || c->state_value == PYS_NONE) {
        PYS_RAISE_EXC(c, c->EXC_RuntimeError, "No active exception to re-raise");
    }
    c->state = PYS_STATE_RAISE;
    return 0;
}

// `yield expr` — stash the value on c->current_gen and swap back to
// the caller of next() / iter().  The body resumes here when next()
// is called again.  Returns the value passed to .send() (or PYS_NONE
// if next()).
NODE_DEF @noinline
node_yield(CTX * restrict c, NODE * restrict n, NODE *val)
{
    (void)n;
    extern VALUE pys_gen_yield(CTX *c, VALUE v);
    VALUE v = EVAL_ARG(c, val);
    if (UNLIKELY(!v)) return 0;
    return pys_gen_yield(c, v);
}

// try / except / else / finally.  Defers to a host function whose
// frame holds the `setjmp` (EVAL_xxx is `always_inline` so we can't
// put setjmp directly in a NODE_DEF body).
NODE_DEF @noinline
node_try(CTX * restrict c, NODE * restrict n, NODE *body, uint32_t handlers_idx, uint32_t nhandlers, NODE *else_body, NODE *finally_body)
{
    (void)n;
    extern VALUE pys_run_try(CTX *c, NODE *body, uint32_t handlers_idx, uint32_t nhandlers, NODE *else_body, NODE *finally_body);
    return pys_run_try(c, body, handlers_idx, nhandlers, else_body, finally_body);
}

// `with` runner — evaluates `cm_expr` to get the (already-entered) CM,
// runs `body`, then calls __exit__ with proper exception protocol
// (suppressing if __exit__ returns truthy).  __enter__ is called by the
// surrounding desugar, not here.
NODE_DEF @noinline
node_with(CTX * restrict c, NODE * restrict n, NODE *cm_expr, NODE *body, uint32_t as_slot, uint32_t has_as)
{
    (void)n; (void)as_slot; (void)has_as;
    VALUE cm = EVAL_ARG(c, cm_expr);
    if (UNLIKELY(!cm)) return 0;
    extern VALUE pys_run_with(CTX *c, VALUE cm, NODE *body);
    return pys_run_with(c, cm, body);
}

// `def` allocates a closure object and stores it as a global by name
// (or as a method on c->current_class while a class body is running).
// Default values come from PYS_NODE_TABLE[defaults_idx..idx+ndefaults].
// Build the function value.  Adds the func to `c->current_class` as a
// side effect if a class body is being evaluated; the caller (parser)
// stores the returned value via make_store for top-level / nested-def
// bindings.
//
// If the body starts with a bare string literal, capture it as the
// function's __doc__ (CPython compatibility).
NODE_DEF @noinline
node_def(CTX * restrict c, NODE * restrict n, const char *name, uint32_t nparams, uint32_t n_pos_named, uint32_t nlocals, uint32_t ndefaults, uint32_t defaults_idx, uint32_t leaf, uint32_t names_idx, uint32_t flags, uint32_t is_gen, NODE *body)
{
    (void)n;
    VALUE *dv = NULL;
    if (nparams > 0) {
        dv = (VALUE *)alloca(sizeof(VALUE) * nparams);
        for (uint32_t i = 0; i < nparams; i++) dv[i] = (VALUE)0;
        for (uint32_t i = 0; i < ndefaults; i++) {
            struct pysdefault *d = &PYS_DEFAULTS[defaults_idx + i];
            dv[d->slot] = (*d->expr->head.dispatcher)(c, d->expr);
            if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
        }
    }
    const char **pn = nparams > 0 ? &PYS_NAME_TABLE[names_idx] : NULL;
    bool has_va = (flags & 1) != 0;
    bool has_kw = (flags & 2) != 0;
    bool is_async = (flags & 4) != 0;
    int n_pos_only = (int)((flags >> 8) & 0xFF);
    VALUE fn = pys_make_func(body, c->env, name, (int)nparams, (int)n_pos_named,
                            (int)nlocals, dv, leaf != 0, pn, has_va, has_kw,
                            is_gen != 0);
    PYS_PTR(fn)->func.n_pos_only = n_pos_only;
    PYS_PTR(fn)->func.is_async = is_async;
    // Docstring: if body's leftmost-spine leaf is a const_str, stash
    // it as `__doc__` on the func.
    {
        extern const struct NodeKind kind_node_seq;
        extern const struct NodeKind kind_node_const_str;
        extern void pys_func_set_doc(CTX *c, VALUE fn, const char *s);
        NODE *first = body;
        while (first && first->head.kind == &kind_node_seq)
            first = first->u.node_seq.first;
        if (first && first->head.kind == &kind_node_const_str)
            pys_func_set_doc(c, fn, first->u.node_const_str.s);
    }
    if (c->current_class != PYS_NONE)
        pys_class_add_method(c, c->current_class, name, fn);
    return fn;
}

// `class Name(base): body` — body is a sequence of `def` statements (and
// optional class-level attribute assignments, but parser only emits defs
// for now).  Setting current_class redirects nested node_def to add into
// the class instead of globals.
// Helpers for `@dec`-on-method inside a class body: decorator wraps
// the just-defined method by reading it back from `c->current_class`
// and re-storing the wrapped value.
NODE_DEF
node_class_method_get(CTX * restrict c, NODE * restrict n, const char *name)
{
    (void)n;
    if (c->current_class == PYS_NONE)
        PYS_RAISE_EXC(c, c->EXC_RuntimeError, "method get outside class body");
    extern VALUE pys_class_lookup_method_pub(VALUE cls, const char *name);
    return pys_class_lookup_method_pub(c->current_class, name);
}

NODE_DEF
node_class_method_set(CTX * restrict c, NODE * restrict n, const char *name, NODE *val)
{
    (void)n;
    if (c->current_class == PYS_NONE)
        PYS_RAISE_EXC(c, c->EXC_RuntimeError, "method set outside class body");
    VALUE v = EVAL_ARG(c, val);
    if (UNLIKELY(!v)) return 0;
    pys_class_add_method(c, c->current_class, name, v);
    return PYS_NONE;
}

// Class-body name load: look up `name` first in the enclosing class's
// own method table (so `@x.setter` after `def x` sees the property),
// then fall back to module globals.  CPython's class body does NOT
// traverse base classes — name lookup must skip the MRO so that
// e.g. `class S(_Base): _select = select.select` resolves `select`
// to the imported module rather than to a same-named method on _Base.
NODE_DEF
node_class_body_load(CTX * restrict c, NODE * restrict n, const char *name)
{
    (void)n;
    if (c->current_class != PYS_NONE && pys_is_class(c->current_class)) {
        struct pysclass *cd = &PYS_PTR(c->current_class)->cls;
        for (int j = 0; j < cd->nmethods; j++) {
            const char *mn = cd->methods[j].name;
            if (mn == name || strcmp(mn, name) == 0)
                return cd->methods[j].value;
        }
    }
    extern int pys_global_resolve(CTX *c, const char *name);
    int idx = pys_global_resolve(c, name);
    return c->globals->entries[idx].value;
}

// Wrap a class definition with a metaclass: after the inner class body
// has populated `cls`, collect its methods into a dict and call
// `metaclass(name, (base,), attrs)` — the standard 3-arg type form.
NODE_DEF @noinline
node_class_with_meta(CTX * restrict c, NODE * restrict n, NODE *cls_node, NODE *meta_node, const char *cname)
{
    (void)n;
    extern VALUE pys_class_meta_apply(CTX *c, VALUE cls, VALUE meta, const char *name);
    VALUE cls = EVAL_ARG(c, cls_node);
    if (UNLIKELY(!cls)) return 0;
    VALUE meta = EVAL_ARG(c, meta_node);
    if (UNLIKELY(!meta)) return 0;
    return pys_class_meta_apply(c, cls, meta, cname);
}

// Multi-base form: bases live in PYS_NODE_TABLE[bases_idx..nbases].
// Otherwise same shape as node_class.
NODE_DEF @noinline
node_class_multi(CTX * restrict c, NODE * restrict n, const char *name, uint32_t bases_idx, uint32_t nbases, NODE *body)
{
    (void)n;
    extern void pys_class_set_bases(VALUE cls, VALUE *bases, int n);
    VALUE *bvs = (VALUE *)alloca(sizeof(VALUE) * (nbases ? nbases : 1));
    for (uint32_t i = 0; i < nbases; i++) {
        NODE *bn = PYS_NODE_TABLE[bases_idx + i];
        if (UNLIKELY(!(bvs[i] = (*bn->head.dispatcher)(c, bn)))) return 0;
    }
    VALUE cls = pys_make_class(name, nbases ? bvs[0] : PYS_NONE, false);
    pys_class_set_bases(cls, bvs, (int)nbases);
    VALUE saved = c->current_class;
    c->current_class = cls;
    EVAL_ARG(c, body);
    c->current_class = saved;
    if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
    extern void pys_class_extract_slots(CTX *c, VALUE cls);
    pys_class_extract_slots(c, cls);
    // Inherited metaclass: if any base has a `__metaclass__` attribute
    // (set by an explicit metaclass=M on the base or its ancestors),
    // apply it now.
    extern VALUE pys_class_inherit_metaclass(CTX *c, VALUE cls, VALUE *bases, int nbases, const char *name);
    return pys_class_inherit_metaclass(c, cls, bvs, (int)nbases, name);
}

// Build the class object: evaluate base, allocate the class, evaluate
// the body with `c->current_class` set so nested `def`s register
// themselves as methods.  Returns the class object — the caller
// (parser) emits the surrounding store node for the binding.
NODE_DEF @noinline
node_class(CTX * restrict c, NODE * restrict n, const char *name, NODE *base, NODE *body)
{
    (void)n;
    VALUE base_v = EVAL_ARG(c, base);
    if (UNLIKELY(!base_v)) return 0;
    bool is_exc = (base_v != PYS_NONE) && pys_is_class(base_v) && PYS_PTR(base_v)->cls.is_exception;
    VALUE cls = pys_make_class(name, base_v, is_exc);
    VALUE saved = c->current_class;
    c->current_class = cls;
    EVAL_ARG(c, body);
    c->current_class = saved;
    if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
    extern void pys_class_extract_slots(CTX *c, VALUE cls);
    pys_class_extract_slots(c, cls);
    extern VALUE pys_class_inherit_metaclass(CTX *c, VALUE cls, VALUE *bases, int nbases, const char *name);
    VALUE bases1[1] = { base_v };
    return pys_class_inherit_metaclass(c, cls, bases1, base_v != PYS_NONE ? 1 : 0, name);
}

NODE_DEF @noinline
node_lambda(CTX * restrict c, NODE * restrict n, uint32_t nparams, uint32_t nlocals, uint32_t ndefaults, uint32_t defaults_idx, uint32_t leaf, uint32_t names_idx, NODE *body)
{
    (void)n;
    VALUE *dv = NULL;
    if (nparams > 0) {
        dv = (VALUE *)alloca(sizeof(VALUE) * nparams);
        for (uint32_t i = 0; i < nparams; i++) dv[i] = (VALUE)0;
        for (uint32_t i = 0; i < ndefaults; i++) {
            struct pysdefault *d = &PYS_DEFAULTS[defaults_idx + i];
            dv[d->slot] = (*d->expr->head.dispatcher)(c, d->expr);
            if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
        }
    }
    const char **pn = nparams > 0 ? &PYS_NAME_TABLE[names_idx] : NULL;
    bool leaf_b = (leaf & 1) != 0;
    bool is_gen = (leaf & 2) != 0;
    bool has_va = (leaf & 4) != 0;
    bool has_kw = (leaf & 8) != 0;
    int n_pos_named;
    if (has_va || has_kw) {
        // Bits 16..23 hold n_pos_named.  Bit 24 = "n_pos_named was set".
        n_pos_named = (int)((leaf >> 16) & 0xFF);
    } else {
        n_pos_named = (int)nparams;
    }
    const char *fname = is_gen ? "<genexpr>" : "<lambda>";
    return pys_make_func(body, c->env, fname, (int)nparams, n_pos_named,
                        (int)nlocals, dv, leaf_b, pn, has_va, has_kw, is_gen);
}

// ---------------------------------------------------------------------------
// Calls.
// ---------------------------------------------------------------------------

NODE_DEF
node_call_0(CTX * restrict c, NODE * restrict n, NODE *fn)
{
    (void)n;
    VALUE f = EVAL_ARG(c, fn);
    if (UNLIKELY(!f)) return 0;
    return pys_apply(c, f, 0, NULL);
}

NODE_DEF
node_call_1(CTX * restrict c, NODE * restrict n, NODE *fn, NODE *a0)
{
    (void)n;
    VALUE f = EVAL_ARG(c, fn);
    if (UNLIKELY(!f)) return 0;
    VALUE av[1];
    av[0] = EVAL_ARG(c, a0);
    return pys_apply(c, f, 1, av);
}

NODE_DEF
node_call_2(CTX * restrict c, NODE * restrict n, NODE *fn, NODE *a0, NODE *a1)
{
    (void)n;
    VALUE f = EVAL_ARG(c, fn);
    if (UNLIKELY(!f)) return 0;
    VALUE av[2];
    av[0] = EVAL_ARG(c, a0);
    av[1] = EVAL_ARG(c, a1);
    return pys_apply(c, f, 2, av);
}

NODE_DEF
node_call_3(CTX * restrict c, NODE * restrict n, NODE *fn, NODE *a0, NODE *a1, NODE *a2)
{
    (void)n;
    VALUE f = EVAL_ARG(c, fn);
    if (UNLIKELY(!f)) return 0;
    VALUE av[3];
    av[0] = EVAL_ARG(c, a0);
    av[1] = EVAL_ARG(c, a1);
    av[2] = EVAL_ARG(c, a2);
    return pys_apply(c, f, 3, av);
}

NODE_DEF @noinline
node_call_n(CTX * restrict c, NODE * restrict n, NODE *fn, uint32_t args_idx, uint32_t argc)
{
    (void)n;
    VALUE f = EVAL_ARG(c, fn);
    if (UNLIKELY(!f)) return 0;
    VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc ? argc : 1));
    for (uint32_t i = 0; i < argc; i++) {
        NODE *arg = PYS_NODE_TABLE[args_idx + i];
        if (UNLIKELY(!(av[i] = (*arg->head.dispatcher)(c, arg)))) return 0;
    }
    return pys_apply(c, f, (int)argc, av);
}

// Call with `*list` / `**dict` expansion.  Walks PYS_SPREADS,
// expanding spread entries into the positional / keyword arg lists.
NODE_DEF @noinline
node_call_spread(CTX * restrict c, NODE * restrict n, NODE *fn, uint32_t spreads_idx, uint32_t nspreads)
{
    (void)n;
    extern VALUE pys_apply_kw(CTX *c, VALUE fn, int argc, VALUE *argv, int kwc, const char **kwnames, VALUE *kwvalues);
    VALUE f = EVAL_ARG(c, fn);
    if (UNLIKELY(!f)) return 0;
    // First pass: count.
    size_t cap_pos = 4, cap_kw = 4;
    VALUE *av = (VALUE *)GC_malloc(sizeof(VALUE) * cap_pos);
    int argc = 0;
    const char **kn = (const char **)GC_malloc(sizeof(char *) * cap_kw);
    VALUE       *kv = (VALUE *)GC_malloc(sizeof(VALUE) * cap_kw);
    int kwc = 0;
    for (uint32_t i = 0; i < nspreads; i++) {
        struct pyspread_arg *sa = &PYS_SPREADS[spreads_idx + i];
        VALUE v = (*sa->node->head.dispatcher)(c, sa->node);
        if (UNLIKELY(!v)) return 0;
        if (sa->kind == 0) {
            if (argc == (int)cap_pos) { cap_pos *= 2; av = (VALUE *)GC_realloc(av, sizeof(VALUE) * cap_pos); }
            av[argc++] = v;
        } else if (sa->kind == 1) {
            // *iterable
            struct pys_iter it; pys_iter_init(c, &it, v);
            if (c->state != PYS_STATE_NORMAL) return PYS_NONE;
            VALUE x;
            while (pys_iter_next(c, &it, &x)) {
                if (argc == (int)cap_pos) { cap_pos *= 2; av = (VALUE *)GC_realloc(av, sizeof(VALUE) * cap_pos); }
                av[argc++] = x;
            }
        } else if (sa->kind == 2) {
            if (kwc == (int)cap_kw) {
                cap_kw *= 2;
                kn = (const char **)GC_realloc(kn, sizeof(char *) * cap_kw);
                kv = (VALUE *)GC_realloc(kv, sizeof(VALUE) * cap_kw);
            }
            kn[kwc] = sa->name;
            kv[kwc] = v;
            kwc++;
        } else if (sa->kind == 3) {
            // **dict
            if (!pys_is_dict(v)) PYS_RAISE_EXC(c, c->EXC_TypeError, "argument after ** must be a dict");
            struct pysdict *d = PYS_PTR(v)->dict;
            for (size_t j = 0; j < d->elen; j++) {
                VALUE _k_chk = d->entries[j].key;
                if (_k_chk != 0 && _k_chk != DICT_DELETED_KEY) {
                    if (!pys_is_str(d->entries[j].key))
                        PYS_RAISE_EXC(c, c->EXC_TypeError, "** keys must be strings");
                    if (kwc == (int)cap_kw) {
                        cap_kw *= 2;
                        kn = (const char **)GC_realloc(kn, sizeof(char *) * cap_kw);
                        kv = (VALUE *)GC_realloc(kv, sizeof(VALUE) * cap_kw);
                    }
                    kn[kwc] = PYS_PTR(d->entries[j].key)->str.chars;
                    kv[kwc] = d->entries[j].value;
                    kwc++;
                }
            }
        }
    }
    return pys_apply_kw(c, f, argc, av, kwc, kn, kv);
}

// Call with keyword arguments (and possibly positional too).
// Positional from PYS_NODE_TABLE[args_idx..argc], kwargs from
// PYS_KWARGS[kwargs_idx..kwc].  No `*list` / `**dict` expansion at
// the call site for v0.
NODE_DEF @noinline
node_call_kw(CTX * restrict c, NODE * restrict n, NODE *fn, uint32_t args_idx, uint32_t argc, uint32_t kwargs_idx, uint32_t kwc)
{
    (void)n;
    extern VALUE pys_apply_kw(CTX *c, VALUE fn, int argc, VALUE *argv, int kwc, const char **kwnames, VALUE *kwvalues);
    VALUE f = EVAL_ARG(c, fn);
    if (UNLIKELY(!f)) return 0;
    VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc ? argc : 1));
    for (uint32_t i = 0; i < argc; i++) {
        NODE *arg = PYS_NODE_TABLE[args_idx + i];
        if (UNLIKELY(!(av[i] = (*arg->head.dispatcher)(c, arg)))) return 0;
    }
    const char **kwn = (const char **)alloca(sizeof(char *) * (kwc ? kwc : 1));
    VALUE       *kwv = (VALUE *)alloca(sizeof(VALUE) * (kwc ? kwc : 1));
    for (uint32_t i = 0; i < kwc; i++) {
        kwn[i] = PYS_KWARGS[kwargs_idx + i].name;
        NODE *vn = PYS_KWARGS[kwargs_idx + i].value;
        if (UNLIKELY(!(kwv[i] = (*vn->head.dispatcher)(c, vn)))) return 0;
    }
    return pys_apply_kw(c, f, (int)argc, av, (int)kwc, kwn, kwv);
}

// Method call: `o.m(args)`.  Inline-cached: when `recv`'s type-tag
// matches `cache->type_tag` we call the cached raw builtin fn with
// `recv` prepended to argv — no bound-method heap allocation, no
// strcmp scan through the per-type method registry.  Cache miss (new
// type, instance method, etc.) falls through to pys_method_resolve +
// pys_apply, which also re-stamps the cache for the hot tag.
extern VALUE pys_method_resolve(CTX *c, VALUE recv, const char *name, struct method_cache *cache);

// Two cache-fast-path layouts coexist (discriminated by cache->cls_ptr):
//   builtin (cls_ptr == NULL): cache->type_tag is the recv type, cache->fn
//     is a `pys_builtin_fn` invoked directly on [self, args].
//   user-class instance (cls_ptr != NULL): cache->cls_ptr is
//     PYS_PTR(recv->inst.cls).  Cache stores the resolved method VALUE in
//     cache->fn and we call pys_apply on it with [self, args] — bypasses
//     bound-method allocation and the MRO walk + strcmp.

// Polymorphic IC scan helper.  Returns method VALUE on hit, 0 on miss.
// Inlined into each node_method_* fast path; compiler unrolls the
// 4-iter loop and folds the hits.
static inline VALUE
pys_pic_lookup(struct method_cache *cache, void *cls)
{
    if (cache->u_cls[0] == cls) return (VALUE)(intptr_t)cache->u_fn[0];
    if (cache->u_cls[1] == cls) return (VALUE)(intptr_t)cache->u_fn[1];
    if (cache->u_cls[2] == cls) return (VALUE)(intptr_t)cache->u_fn[2];
    if (cache->u_cls[3] == cls) return (VALUE)(intptr_t)cache->u_fn[3];
    return 0;
}

NODE_DEF
node_method_0(CTX * restrict c, NODE * restrict n, NODE *obj, const char *name, struct method_cache *cache@ref)
{
    (void)n;
    VALUE o = EVAL_ARG(c, obj);
    if (UNLIKELY(!o)) return 0;
    if (LIKELY(PYS_IS_PTR(o)) && PYS_PTR(o)->type == cache->type_tag) {
        int t = PYS_PTR(o)->type;
        if (t == PYS_T_INSTANCE) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o)->inst.cls);
            if (LIKELY(fn)) {
                VALUE av[1] = { o };
                return pys_apply(c, fn, 1, av);
            }
            // Primary-builtin case (e.g. OrderedCollection.append):
            // checked after user-class PIC so common path stays cheap.
            if (cache->fn && cache->u_cls[0] == (void *)PYS_PTR(o)->inst.cls) {
                VALUE primary = PYS_PTR(o)->inst.primary;
                if (LIKELY(primary)) {
                    VALUE av[1] = { primary };
                    return ((pys_builtin_fn)cache->fn)(c, 1, av);
                }
            }
        } else if (t == PYS_T_MODULE) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o));
            if (LIKELY(fn)) return pys_apply(c, fn, 0, NULL);
        } else if (t == PYS_T_CLASS) {
            // `Cls.classmethod()` — IC stamps the wrapped function and
            // we synthesise the cls-as-first-arg call directly.
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o));
            if (LIKELY(fn)) {
                VALUE av[1] = { o };
                return pys_apply(c, fn, 1, av);
            }
        } else if (cache->fn) {
            VALUE av[1] = { o };
            return ((pys_builtin_fn)cache->fn)(c, 1, av);
        }
    }
    VALUE m = pys_method_resolve(c, o, name, cache);
    return pys_apply(c, m, 0, NULL);
}

NODE_DEF
node_method_1(CTX * restrict c, NODE * restrict n, NODE *obj, const char *name, NODE *a0, struct method_cache *cache@ref)
{
    (void)n;
    VALUE o = EVAL_ARG(c, obj);
    if (UNLIKELY(!o)) return 0;
    if (LIKELY(PYS_IS_PTR(o)) && PYS_PTR(o)->type == cache->type_tag) {
        int t = PYS_PTR(o)->type;
        if (t == PYS_T_INSTANCE) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o)->inst.cls);
            if (LIKELY(fn)) {
                VALUE av[2];
                av[0] = o;
                av[1] = EVAL_ARG(c, a0);
                return pys_apply(c, fn, 2, av);
            }
            if (cache->fn && cache->u_cls[0] == (void *)PYS_PTR(o)->inst.cls) {
                VALUE primary = PYS_PTR(o)->inst.primary;
                if (LIKELY(primary)) {
                    VALUE av[2];
                    av[0] = primary;
                    av[1] = EVAL_ARG(c, a0);
                    if (UNLIKELY(!av[1])) return 0;
                    return ((pys_builtin_fn)cache->fn)(c, 2, av);
                }
            }
        } else if (t == PYS_T_MODULE) {
            // Module method (e.g., `math.sqrt(x)`): no self prepend.
            // Cache stamps (module_ptr, resolved_method).  raytrace was
            // doing strcmp through math's globals on every call.
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o));
            if (LIKELY(fn)) {
                VALUE av[1];
                av[0] = EVAL_ARG(c, a0);
                return pys_apply(c, fn, 1, av);
            }
        } else if (t == PYS_T_CLASS) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o));
            if (LIKELY(fn)) {
                VALUE av[2];
                av[0] = o;
                av[1] = EVAL_ARG(c, a0);
                return pys_apply(c, fn, 2, av);
            }
        } else if (cache->fn) {
            VALUE av[2];
            av[0] = o;
            av[1] = EVAL_ARG(c, a0);
            if (UNLIKELY(!av[1])) return 0;
            return ((pys_builtin_fn)cache->fn)(c, 2, av);
        }
    }
    VALUE m = pys_method_resolve(c, o, name, cache);
    VALUE av[1];
    av[0] = EVAL_ARG(c, a0);
    return pys_apply(c, m, 1, av);
}

NODE_DEF
node_method_2(CTX * restrict c, NODE * restrict n, NODE *obj, const char *name, NODE *a0, NODE *a1, struct method_cache *cache@ref)
{
    (void)n;
    VALUE o = EVAL_ARG(c, obj);
    if (UNLIKELY(!o)) return 0;
    if (LIKELY(PYS_IS_PTR(o)) && PYS_PTR(o)->type == cache->type_tag) {
        int t = PYS_PTR(o)->type;
        if (t == PYS_T_INSTANCE) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o)->inst.cls);
            if (LIKELY(fn)) {
                VALUE av[3];
                av[0] = o;
                av[1] = EVAL_ARG(c, a0);
                if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
                av[2] = EVAL_ARG(c, a1);
                return pys_apply(c, fn, 3, av);
            }
            if (cache->fn && cache->u_cls[0] == (void *)PYS_PTR(o)->inst.cls) {
                VALUE primary = PYS_PTR(o)->inst.primary;
                if (LIKELY(primary)) {
                    VALUE av[3];
                    av[0] = primary;
                    av[1] = EVAL_ARG(c, a0);
                    if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
                    av[2] = EVAL_ARG(c, a1);
                    if (UNLIKELY(!av[2])) return 0;
                    return ((pys_builtin_fn)cache->fn)(c, 3, av);
                }
            }
        } else if (t == PYS_T_MODULE) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o));
            if (LIKELY(fn)) {
                VALUE av[2];
                av[0] = EVAL_ARG(c, a0);
                if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
                av[1] = EVAL_ARG(c, a1);
                return pys_apply(c, fn, 2, av);
            }
        } else if (t == PYS_T_CLASS) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o));
            if (LIKELY(fn)) {
                VALUE av[3];
                av[0] = o;
                av[1] = EVAL_ARG(c, a0);
                if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
                av[2] = EVAL_ARG(c, a1);
                return pys_apply(c, fn, 3, av);
            }
        } else if (cache->fn) {
            VALUE av[3];
            av[0] = o;
            av[1] = EVAL_ARG(c, a0);
            if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
            av[2] = EVAL_ARG(c, a1);
            if (UNLIKELY(!av[2])) return 0;
            return ((pys_builtin_fn)cache->fn)(c, 3, av);
        }
    }
    VALUE m = pys_method_resolve(c, o, name, cache);
    VALUE av[2];
    av[0] = EVAL_ARG(c, a0);
    if (UNLIKELY(c->state == PYS_STATE_RAISE)) return 0;
    av[1] = EVAL_ARG(c, a1);
    return pys_apply(c, m, 2, av);
}

NODE_DEF @noinline
node_method_n(CTX * restrict c, NODE * restrict n, NODE *obj, const char *name, uint32_t args_idx, uint32_t argc, struct method_cache *cache@ref)
{
    (void)n;
    VALUE o = EVAL_ARG(c, obj);
    if (UNLIKELY(!o)) return 0;
    if (LIKELY(PYS_IS_PTR(o)) && PYS_PTR(o)->type == cache->type_tag) {
        int t = PYS_PTR(o)->type;
        if (t == PYS_T_INSTANCE) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o)->inst.cls);
            if (LIKELY(fn)) {
                VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc + 1));
                av[0] = o;
                for (uint32_t i = 0; i < argc; i++) {
                    NODE *arg = PYS_NODE_TABLE[args_idx + i];
                    av[i + 1] = (*arg->head.dispatcher)(c, arg);
                    if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
                }
                return pys_apply(c, fn, (int)argc + 1, av);
            }
            if (cache->fn && cache->u_cls[0] == (void *)PYS_PTR(o)->inst.cls) {
                VALUE primary = PYS_PTR(o)->inst.primary;
                if (LIKELY(primary)) {
                    VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc + 1));
                    av[0] = primary;
                    for (uint32_t i = 0; i < argc; i++) {
                        NODE *arg = PYS_NODE_TABLE[args_idx + i];
                        av[i + 1] = (*arg->head.dispatcher)(c, arg);
                        if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
                    }
                    return ((pys_builtin_fn)cache->fn)(c, (int)argc + 1, av);
                }
            }
        } else if (t == PYS_T_MODULE) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o));
            if (LIKELY(fn)) {
                VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc ? argc : 1));
                for (uint32_t i = 0; i < argc; i++) {
                    NODE *arg = PYS_NODE_TABLE[args_idx + i];
                    if (UNLIKELY(!(av[i] = (*arg->head.dispatcher)(c, arg)))) return 0;
                }
                return pys_apply(c, fn, (int)argc, av);
            }
        } else if (t == PYS_T_CLASS) {
            VALUE fn = pys_pic_lookup(cache, (void *)PYS_PTR(o));
            if (LIKELY(fn)) {
                VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc + 1));
                av[0] = o;
                for (uint32_t i = 0; i < argc; i++) {
                    NODE *arg = PYS_NODE_TABLE[args_idx + i];
                    av[i + 1] = (*arg->head.dispatcher)(c, arg);
                    if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
                }
                return pys_apply(c, fn, (int)argc + 1, av);
            }
        } else if (cache->fn) {
            VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc + 1));
            av[0] = o;
            for (uint32_t i = 0; i < argc; i++) {
                NODE *arg = PYS_NODE_TABLE[args_idx + i];
                av[i + 1] = (*arg->head.dispatcher)(c, arg);
                if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
            }
            return ((pys_builtin_fn)cache->fn)(c, (int)argc + 1, av);
        }
    }
    VALUE m = pys_method_resolve(c, o, name, cache);
    VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc ? argc : 1));
    for (uint32_t i = 0; i < argc; i++) {
        NODE *arg = PYS_NODE_TABLE[args_idx + i];
        if (UNLIKELY(!(av[i] = (*arg->head.dispatcher)(c, arg)))) return 0;
    }
    return pys_apply(c, m, (int)argc, av);
}

// `super(C, self).method(args)` — explicit form.  Walks self.__class__'s
// MRO starting after C.  No reliance on c->method_class.
NODE_DEF @noinline
node_super_method_explicit(CTX * restrict c, NODE * restrict n, NODE *cls_expr, NODE *self_expr, const char *method_name, uint32_t args_idx, uint32_t argc)
{
    (void)n;
    extern VALUE pys_super_lookup(CTX *c, VALUE self, VALUE start_after_cls, const char *name);
    VALUE cls = EVAL_ARG(c, cls_expr);
    if (UNLIKELY(!cls)) return 0;
    VALUE self = EVAL_ARG(c, self_expr);
    if (UNLIKELY(!self)) return 0;
    if (!pys_is_class(cls))     PYS_RAISE_EXC(c, c->EXC_TypeError, "super(): first arg must be class");
    // Second arg can be instance OR a class that's a subclass of cls
    // (used when calling classmethods via super, e.g. metaclass methods
    // and `super(partial, cls).__new__(cls)`).
    if (!pys_is_instance(self) && !pys_is_class(self))
        PYS_RAISE_EXC(c, c->EXC_TypeError, "super(): second arg must be instance or class");
    VALUE m = pys_super_lookup(c, self, cls, method_name);
    if (m == PYS_NONE) PYS_RAISE_EXC(c, c->EXC_AttributeError,
                                   "'super' object has no attribute '%s'", method_name);
    // Unwrap @classmethod / @staticmethod descriptors found via the MRO walk.
    bool was_classmethod = false;
    bool was_staticmethod = false;
    if (PYS_IS_PTR(m)) {
        if (PYS_PTR(m)->type == PYS_T_CLASSMETHOD) {
            m = PYS_PTR(m)->wrap.wrapped; was_classmethod = true;
        } else if (PYS_PTR(m)->type == PYS_T_STATICMETHOD) {
            m = PYS_PTR(m)->wrap.wrapped; was_staticmethod = true;
        }
    }
    extern bool pys_is_bound_builtin(VALUE v);
    // __new__ is implicitly static; staticmethod also has no implicit self.
    bool skip_self_super = (strcmp(method_name, "__new__") == 0) || was_staticmethod;
    if (was_classmethod) {
        // First arg is the class — derive from self.
        VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc + 1));
        av[0] = pys_is_class(self) ? self : PYS_OBJ_VAL(PYS_PTR(self)->inst.cls);
        for (uint32_t i = 0; i < argc; i++) {
            NODE *arg = PYS_NODE_TABLE[args_idx + i];
            av[i + 1] = (*arg->head.dispatcher)(c, arg);
            if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
        }
        return pys_apply(c, m, (int)argc + 1, av);
    }
    if (pys_is_bound_builtin(m) || skip_self_super) {
        VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc ? argc : 1));
        for (uint32_t i = 0; i < argc; i++) {
            NODE *arg = PYS_NODE_TABLE[args_idx + i];
            if (UNLIKELY(!(av[i] = (*arg->head.dispatcher)(c, arg)))) return 0;
        }
        return pys_apply(c, m, (int)argc, av);
    }
    VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc + 1));
    av[0] = self;
    for (uint32_t i = 0; i < argc; i++) {
        NODE *arg = PYS_NODE_TABLE[args_idx + i];
        av[i + 1] = (*arg->head.dispatcher)(c, arg);
        if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
    }
    return pys_apply(c, m, (int)argc + 1, av);
}

// `super().method(args)` — cooperative MRO walk.  Walks the actual
// `super()` returning a bound super proxy as a value.
// Walks the actual instance's class MRO starting just after the
// lexical defining class (c->method_class).
NODE_DEF @noinline
node_super_obj(CTX * restrict c, NODE * restrict n)
{
    (void)n;
    extern VALUE pys_make_super(VALUE start_cls, VALUE self);
    if (!c->env || c->env->nslots < 1)
        PYS_RAISE_EXC(c, c->EXC_RuntimeError, "super() outside of method");
    VALUE self = c->env->slots[0];
    VALUE start = c->method_class;
    return pys_make_super(start, self);
}

// `super(C, self)` explicit form returning a proxy.
NODE_DEF @noinline
node_super_obj_explicit(CTX * restrict c, NODE * restrict n, NODE *cls_expr, NODE *self_expr)
{
    (void)n;
    extern VALUE pys_make_super(VALUE start_cls, VALUE self);
    VALUE cls = EVAL_ARG(c, cls_expr);
    if (UNLIKELY(!cls)) return 0;
    VALUE self = EVAL_ARG(c, self_expr);
    if (UNLIKELY(!self)) return 0;
    return pys_make_super(cls, self);
}

// instance's class MRO starting just after the lexical defining class
// (read from c->method_class set by pys_apply when entering a method).
// Falls back to `base_v` only if method_class is not set (e.g. when
// called outside a method).
NODE_DEF @noinline
node_super_method(CTX * restrict c, NODE * restrict n, NODE *base, const char *method_name, uint32_t args_idx, uint32_t argc)
{
    (void)n;
    extern VALUE pys_class_lookup_method_pub(VALUE cls, const char *name);
    extern VALUE pys_super_lookup(CTX *c, VALUE self, VALUE start_after_cls, const char *name);
    if (!c->env || c->env->nslots < 1)
        PYS_RAISE_EXC(c, c->EXC_RuntimeError, "super() outside of method");
    VALUE self = c->env->slots[0];
    VALUE start = c->method_class;
    VALUE m = PYS_NONE;
    if (start != PYS_NONE && pys_is_instance(self)) {
        m = pys_super_lookup(c, self, start, method_name);
    } else if (start != PYS_NONE && pys_is_class(self)) {
        // self is a class (e.g. __new__ / classmethod): walk past start
        // in self's own MRO and look for the method.
        struct pysclass *cd = &PYS_PTR(self)->cls;
        int i = 0;
        while (i < cd->nmro && cd->mro[i] != start) i++;
        for (int j = i + 1; j < cd->nmro; j++) {
            struct pysclass *kd = &PYS_PTR(cd->mro[j])->cls;
            for (int k = 0; k < kd->nmethods; k++) {
                if (strcmp(kd->methods[k].name, method_name) == 0) {
                    m = kd->methods[k].value; break;
                }
            }
            if (m != PYS_NONE) break;
        }
    }
    if (m == PYS_NONE) {
        // Fallback: use the parser-captured base.
        VALUE base_v = EVAL_ARG(c, base);
        if (UNLIKELY(!base_v)) return 0;
        if (!pys_is_class(base_v)) PYS_RAISE_EXC(c, c->EXC_TypeError, "super(): base is not a class");
        m = pys_class_lookup_method_pub(base_v, method_name);
    }
    if (m == PYS_NONE) PYS_RAISE_EXC(c, c->EXC_AttributeError,
                                   "'super' object has no attribute '%s'", method_name);
    // Unwrap @classmethod / @staticmethod descriptors found via the MRO walk.
    bool was_classmethod = false;
    bool was_staticmethod = false;
    if (PYS_IS_PTR(m)) {
        if (PYS_PTR(m)->type == PYS_T_CLASSMETHOD) {
            m = PYS_PTR(m)->wrap.wrapped; was_classmethod = true;
        } else if (PYS_PTR(m)->type == PYS_T_STATICMETHOD) {
            m = PYS_PTR(m)->wrap.wrapped; was_staticmethod = true;
        }
    }
    extern bool pys_is_bound_builtin(VALUE v);
    // __new__ is implicitly static; staticmethod also has no implicit self.
    bool skip_self_super = (strcmp(method_name, "__new__") == 0) || was_staticmethod;
    if (was_classmethod) {
        // First arg is the class — derive from self.
        VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc + 1));
        av[0] = pys_is_class(self) ? self : PYS_OBJ_VAL(PYS_PTR(self)->inst.cls);
        for (uint32_t i = 0; i < argc; i++) {
            NODE *arg = PYS_NODE_TABLE[args_idx + i];
            av[i + 1] = (*arg->head.dispatcher)(c, arg);
            if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
        }
        return pys_apply(c, m, (int)argc + 1, av);
    }
    if (pys_is_bound_builtin(m) || skip_self_super) {
        VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc ? argc : 1));
        for (uint32_t i = 0; i < argc; i++) {
            NODE *arg = PYS_NODE_TABLE[args_idx + i];
            if (UNLIKELY(!(av[i] = (*arg->head.dispatcher)(c, arg)))) return 0;
        }
        return pys_apply(c, m, (int)argc, av);
    }
    VALUE *av = (VALUE *)alloca(sizeof(VALUE) * (argc + 1));
    av[0] = self;
    for (uint32_t i = 0; i < argc; i++) {
        NODE *arg = PYS_NODE_TABLE[args_idx + i];
        av[i + 1] = (*arg->head.dispatcher)(c, arg);
        if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
    }
    return pys_apply(c, m, (int)argc + 1, av);
}

// `match SUBJECT: case PAT (if GUARD): BODY ...`
//
// PYS_CASES[cases_idx..idx+ncases] are the cases; each case carries
// a root pattern index + optional guard + body.  The pattern tree is
// in PYS_PATTERNS.  Pattern matching may bind names — those are
// always evaluated as `make_store` operations during the walk.
NODE_DEF @noinline
node_match(CTX * restrict c, NODE * restrict n, NODE *subject, uint32_t cases_idx, uint32_t ncases)
{
    (void)n;
    extern bool pys_pat_match(CTX *c, int pat_idx, VALUE v);
    VALUE sv = EVAL_ARG(c, subject);
    if (UNLIKELY(!sv)) return 0;
    for (uint32_t i = 0; i < ncases; i++) {
        struct pyscase *cs = &PYS_CASES[cases_idx + i];
        if (!pys_pat_match(c, cs->pat_idx, sv)) continue;
        if (UNLIKELY(c->state != PYS_STATE_NORMAL)) return 0;
        if (cs->guard) {
            VALUE g = EVAL(c, cs->guard);
            if (c->state != PYS_STATE_NORMAL) return PYS_NONE;
            if (!pys_is_truthy(g)) continue;
        }
        EVAL(c, cs->body);
        return PYS_NONE;
    }
    return PYS_NONE;
}

// Tuple/list unpacking assignment: `a, b, c = expr`.  The targets live
// in PYS_UNPACK_TARGETS[targets_idx..idx+ntargets]; each target
// records (is_local, slot|name).
NODE_DEF @noinline
node_unpack_assign(CTX * restrict c, NODE * restrict n, uint32_t targets_idx, uint32_t ntargets, NODE *rhs)
{
    (void)n;
    extern struct pyunpack_target *PYS_UNPACK_TARGETS;
    extern void pys_unpack_assign(CTX *c, struct pyunpack_target *t, uint32_t n, VALUE rhs);
    VALUE r = EVAL_ARG(c, rhs);
    if (UNLIKELY(!r)) return 0;
    pys_unpack_assign(c, &PYS_UNPACK_TARGETS[targets_idx], ntargets, r);
    return PYS_NONE;
}
