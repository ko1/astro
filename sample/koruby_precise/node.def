// -*- mode: c -*-
// koruby AST nodes.
// All dispatchers return RESULT (VALUE + state bits).  EVAL_ARG_UNWRAP() unwraps a
// child's RESULT to VALUE and early-returns the raw RESULT on non-NORMAL.
// Phase 8d (2026-05-29): c->state side-channel removed from node.def.

#define EVAL_ARG_UNWRAP(c, n) UNWRAP(EVAL_ARG(c, n))
#define CHECK_STATE(c) do { if (UNLIKELY((c)->state != KORB_NORMAL)) return RESULT_OK(Qnil); } while (0)

// ---------------- literals ----------------

NODE_DEF
node_num(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, int32_t v)
{
    return RESULT_OK(INT2FIX(v));
}

NODE_DEF
node_int_lit(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, intptr_t v)
{
    /* literal that fits in a fixnum */
    return RESULT_OK((VALUE)((uintptr_t)v << 1) | FIXNUM_FLAG);
}

NODE_DEF
node_bignum_lit(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *str)
{
    return RESULT_OK(korb_bignum_new_str(c, c->sp_top, str, 10));
}

NODE_DEF
node_float_lit(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, double v)
{
    return RESULT_OK(korb_float_new(c, c->sp_top, v));
}

NODE_DEF
node_str_lit(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *str, uint32_t len)
{
    return RESULT_OK(korb_str_new(c, c->sp_top, str, len));
}

NODE_DEF
node_frozen_str_lit(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *str, uint32_t len)
{
    VALUE s = korb_str_new(c, c->sp_top, str, len);
    if (!SPECIAL_CONST_P(s)) RBASIC(s)->head.flags |= FL_FROZEN;
    return RESULT_OK(s);
}

NODE_DEF
node_chilled_str_lit(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *str, uint32_t len)
{
    VALUE s = korb_str_new(c, c->sp_top, str, len);
    if (!SPECIAL_CONST_P(s)) RBASIC(s)->head.flags |= FL_CHILLED;
    return RESULT_OK(s);
}

NODE_DEF
node_sym_lit(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID id)
{
    return RESULT_OK(korb_id2sym(id));
}

NODE_DEF
node_true(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    return RESULT_OK(Qtrue);
}

NODE_DEF
node_false(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    return RESULT_OK(Qfalse);
}

NODE_DEF
node_nil(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    return RESULT_OK(Qnil);
}

NODE_DEF
node_self(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    return RESULT_OK(c->current_frame->self);
}

// ---------------- variables ----------------

/* `index` is dual-purpose, patched by koruby_bake_sp_offsets (node.c):
 *   - negative (int32_t) → sp-relative offset (= original_idx - scope_size).
 *     `sp` points to frame TOP (= fp + scope_size), so `sp[off]` reads
 *     the original frame slot.  Baked at parse-end for lvars resolved
 *     inside their owning method/block scope.
 *   - non-negative → original frame index; fall back to `c->current_frame->fp[index]`.
 *     Used when bake pass can't resolve (eval'd code, outer-scope refs
 *     inside blocks where the baked sp_offset would be positive). */
NODE_DEF
node_lvar_get(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t index)
{
    int32_t off = (int32_t)index;
    if (off < 0) return RESULT_OK(sp[off]);
    return RESULT_OK(c->current_frame->fp[index]);
}

NODE_DEF
node_lvar_set(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t index, NODE *rhs)
{
    VALUE v = EVAL_ARG_UNWRAP(c, rhs);
    int32_t off = (int32_t)index;
    if (off < 0) sp[off] = v;
    else c->current_frame->fp[index] = v;
    return RESULT_OK(v);
}

NODE_DEF
node_ivar_get(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, struct ivar_cache *cache@ref)
{
    return RESULT_OK(korb_ivar_get_ic(c->current_frame->self, name, cache));
}

NODE_DEF
node_ivar_set(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *rhs, struct ivar_cache *cache@ref)
{
    VALUE v = EVAL_ARG_UNWRAP(c, rhs);
    CHECK(korb_ivar_set_ic(c, c->current_frame->self, name, v, cache));
    return RESULT_OK(v);
}

NODE_DEF
node_gvar_get(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name)
{
    /* $@ — `current exception`.backtrace, or nil if no current exc. */
    if (name == korb_intern("$@")) {
        VALUE exc = korb_gvar_get(korb_intern("$!"));
        if (NIL_P(exc) || SPECIAL_CONST_P(exc)) return RESULT_OK(Qnil);
        RESULT _bt = korb_funcall(c, exc, korb_intern("backtrace"), 0, NULL);
        return RESULT_OK((_bt.state == KORB_NORMAL) ? _bt.value : Qnil);
    }
    return RESULT_OK(korb_gvar_get(name));
}

NODE_DEF
node_gvar_set(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *rhs)
{
    VALUE v = EVAL_ARG_UNWRAP(c, rhs);
    /* Validation for special globals. */
    const char *nm = korb_id_name(name);
    if (nm && nm[0] == '$' && nm[1]) {
        bool string_only = false;
        bool read_only = false;
        if (!nm[2]) {
            char c2 = nm[1];
            if (c2 == '/' || c2 == '\\' || c2 == ',' || c2 == ';') string_only = true;
            if (c2 == ':' || c2 == '"' || c2 == '!' || c2 == '?' ||
                c2 == '<') read_only = true;
        } else if (nm[1] == '-' && nm[2] == '0' && !nm[3]) {
            string_only = true;
        } else if (nm[1] == '-' && (nm[2] == 'a' || nm[2] == 'l' ||
                                     nm[2] == 'p' || nm[2] == 'i' ||
                                     nm[2] == 'F') && !nm[3]) {
            read_only = true;
        } else if (strcmp(nm, "$LOAD_PATH") == 0 ||
                   strcmp(nm, "$LOADED_FEATURES") == 0 ||
                   strcmp(nm, "$FILENAME") == 0) {
            read_only = true;
        }
        if (read_only) {
            VALUE eN = korb_const_get(KORB_VM(c)->object_class, korb_intern("NameError"));
            return korb_raise(c, (struct korb_class *)eN,
                       "%s is a read-only variable", nm);
        }
        if (string_only && !NIL_P(v) &&
            (SPECIAL_CONST_P(v) || BUILTIN_TYPE(v) != T_STRING)) {
            VALUE eT = korb_const_get(KORB_VM(c)->object_class, korb_intern("TypeError"));
            return korb_raise(c, (struct korb_class *)eT,
                       "value of %s must be String", nm);
        }
        /* $stdout / $stderr / $stdin must respond to #write (or #read for stdin). */
        if (strcmp(nm, "$stdout") == 0 || strcmp(nm, "$stderr") == 0) {
            RESULT _rt_w = korb_funcall(c, v, korb_intern("respond_to?"), 1,
                                    (VALUE[]){ korb_id2sym(korb_intern("write")) });
            VALUE rt = (_rt_w.state == KORB_NORMAL) ? _rt_w.value : Qfalse;
            if (!RTEST(rt)) {
                VALUE eT = korb_const_get(KORB_VM(c)->object_class, korb_intern("TypeError"));
                struct korb_class *klass = korb_class_of_class(v);
                return korb_raise(c, (struct korb_class *)eT,
                           "%s must have write method, %s given",
                           nm,
                           klass && klass->name ? korb_id_name(klass->name) : "?");
            }
        }
        /* $. should call #to_int.  Returned value must be Integer; if
         * #to_int gives non-Integer, raise TypeError. */
        if (strcmp(nm, "$.") == 0) {
            if (SPECIAL_CONST_P(v) ? !FIXNUM_P(v) : BUILTIN_TYPE(v) != T_BIGNUM) {
                RESULT _rt_t = korb_funcall(c, v, korb_intern("respond_to?"), 1,
                                        (VALUE[]){ korb_id2sym(korb_intern("to_int")) });
                VALUE rt = (_rt_t.state == KORB_NORMAL) ? _rt_t.value : Qfalse;
                if (RTEST(rt)) {
                    v = UNWRAP(korb_funcall(c, v, korb_intern("to_int"), 0, NULL));
                    bool is_int = SPECIAL_CONST_P(v) ? FIXNUM_P(v)
                                                     : BUILTIN_TYPE(v) == T_BIGNUM;
                    if (!is_int) {
                        VALUE eT = korb_const_get(KORB_VM(c)->object_class, korb_intern("TypeError"));
                        return korb_raise(c, (struct korb_class *)eT,
                                   "can't convert to Integer (#to_int returned non-Integer)");
                    }
                } else {
                    VALUE eT = korb_const_get(KORB_VM(c)->object_class, korb_intern("TypeError"));
                    return korb_raise(c, (struct korb_class *)eT,
                               "no implicit conversion to Integer");
                }
            }
        }
        /* $/ <-> $-0 sync: assigning to one updates the other. */
        if (!nm[2] && nm[1] == '/') {
            korb_gvar_set(korb_intern("$-0"), v);
        } else if (nm[1] == '-' && nm[2] == '0' && !nm[3]) {
            korb_gvar_set(korb_intern("$/"), v);
        }
        /* $VERBOSE: nil/false/true (truthy → true).  $-v / $-w aliases. */
        if (strcmp(nm, "$VERBOSE") == 0 || strcmp(nm, "$-v") == 0 ||
            strcmp(nm, "$-w") == 0 || strcmp(nm, "$-W") == 0) {
            VALUE canon = NIL_P(v) ? Qnil : (RTEST(v) ? Qtrue : Qfalse);
            korb_gvar_set(korb_intern("$VERBOSE"), canon);
            korb_gvar_set(korb_intern("$-v"),      canon);
            korb_gvar_set(korb_intern("$-w"),      canon);
            korb_gvar_set(korb_intern("$-W"),      canon);
            return RESULT_OK(canon);
        }
        /* $DEBUG / $-d aliases. */
        if (strcmp(nm, "$DEBUG") == 0 || strcmp(nm, "$-d") == 0) {
            VALUE canon = RTEST(v) ? Qtrue : Qfalse;
            korb_gvar_set(korb_intern("$DEBUG"), canon);
            korb_gvar_set(korb_intern("$-d"),    canon);
            return RESULT_OK(canon);
        }
        /* $@ — sets backtrace on the current exception ($!).  Raises
         * ArgumentError "$! not set" if no exception is in flight. */
        if (strcmp(nm, "$@") == 0) {
            VALUE exc = korb_gvar_get(korb_intern("$!"));
            if (NIL_P(exc) || SPECIAL_CONST_P(exc)) {
                VALUE eA = korb_const_get(KORB_VM(c)->object_class, korb_intern("ArgumentError"));
                return korb_raise(c, (struct korb_class *)eA, "$! not set");
            }
            korb_funcall(c, exc, korb_intern("set_backtrace"), 1, &v);
            return RESULT_OK(v);
        }
        /* $0 / $PROGRAM_NAME aliases — must coerce to String. */
        if (strcmp(nm, "$0") == 0 || strcmp(nm, "$PROGRAM_NAME") == 0) {
            if (SPECIAL_CONST_P(v) || BUILTIN_TYPE(v) != T_STRING) {
                VALUE eT = korb_const_get(KORB_VM(c)->object_class, korb_intern("TypeError"));
                return korb_raise(c, (struct korb_class *)eT,
                           "$0 must be a String");
            }
            korb_gvar_set(korb_intern("$0"), v);
            korb_gvar_set(korb_intern("$PROGRAM_NAME"), v);
            return RESULT_OK(v);
        }
    }
    korb_gvar_set(name, v);
    return RESULT_OK(v);
}

NODE_DEF
node_gvar_defined_p(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name)
{
    return RESULT_OK(KORB_BOOL(korb_gvar_defined(name)));
}

/* defined?(A::B) helper — like node_const_path_get but returns Qfalse
 * instead of dispatching const_missing or raising NameError on miss.
 * defined? must not invoke const_missing (CRuby semantics). */
NODE_DEF
node_const_path_defined(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *parent, ID name)
{
    extern bool korb_const_is_private(const struct korb_class *, ID);
    VALUE p = EVAL_ARG_UNWRAP(c, parent);
    if (BUILTIN_TYPE(p) != T_CLASS && BUILTIN_TYPE(p) != T_MODULE) return RESULT_OK(Qfalse);
    if (korb_const_is_private((struct korb_class *)p, name)) {
        bool in_scope = false;
        for (struct korb_cref *cr = c->current_frame->cref; cr; cr = cr->prev) {
            /* Skip the implicit top-level Object entry (prev=NULL,
             * klass=Object) — it represents "default file scope", not
             * being inside `class Object`.  Object's private constants
             * are inaccessible from there per CRuby. */
            if (cr->klass == KORB_VM(c)->object_class && cr->prev == NULL) continue;
            if ((VALUE)cr->klass == p) { in_scope = true; break; }
        }
        if (!in_scope) return RESULT_OK(Qfalse);
    }
    VALUE v = korb_const_get_inherited_stop_at_object((struct korb_class *)p, name);
    return RESULT_OK(UNDEF_P(v) ? Qfalse : Qtrue);
}

/* defined? for bare CONST — walks lexical scope (cref) and superclass
 * chain.  Mirrors korb_const_lookup but returns Qfalse instead of
 * raising NameError on miss.  Respects private_constant: matches what
 * the actual `CONST` read would resolve.  Inside lexical scope, private
 * constants are visible to defined?; outside, they're hidden. */
/* defined?(super) — true iff a super-method exists for the running
 * method (block-aware: inside a block, target the block's defining
 * method, mirroring node_super_forward).  Same lookup as super, but
 * never raises and never invokes. */
NODE_DEF
node_super_defined_p(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    if (!c->current_frame || !c->current_frame->method) return RESULT_OK(Qfalse);
    
    struct korb_method *m = (c->running_block && c->running_block->defining_method)
                              ? c->running_block->defining_method
                              : c->current_frame->method;
    if (!m || !m->defining_class) return RESULT_OK(Qfalse);
    struct korb_class *recv_klass = korb_class_of_class(c->current_frame->self);
    extern struct korb_method *korb_class_find_super_method_n(
        const struct korb_class *, const struct korb_class *, ID,
        uint16_t, uint16_t *);
    uint16_t skip = c->current_frame->method == m ? c->current_frame->super_skip_n : 0;
    uint16_t out;
    struct korb_method *sm = korb_class_find_super_method_n(recv_klass,
        m->defining_class, m->name, skip, &out);
    return RESULT_OK(sm ? Qtrue : Qfalse);
}

NODE_DEF
node_const_defined_lex(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name)
{
    extern bool korb_const_is_private(const struct korb_class *, ID);
    for (struct korb_cref *cr = c->current_frame->cref; cr; cr = cr->prev) {
        if (korb_const_has(cr->klass, name)) return RESULT_OK(Qtrue);
        for (int32_t i = (int32_t)cr->klass->includes_cnt - 1; i >= 0; i--) {
            if (korb_const_has(cr->klass->includes[i], name)) return RESULT_OK(Qtrue);
        }
    }
    struct korb_class *k = korb_host_class(c);
    if (k && k->super) {
        VALUE v = korb_const_get_inherited(k->super, name);
        if (!UNDEF_P(v)) {
            if (korb_const_is_private(k->super, name)) return RESULT_OK(Qfalse);
            return RESULT_OK(Qtrue);
        }
    }
    VALUE v = korb_const_get_inherited(KORB_VM(c)->object_class, name);
    if (!UNDEF_P(v)) {
        if (korb_const_is_private(KORB_VM(c)->object_class, name)) return RESULT_OK(Qfalse);
        return RESULT_OK(Qtrue);
    }
    return RESULT_OK(Qfalse);
}

NODE_DEF
node_last_line_get(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    return RESULT_OK(korb_last_line_get(c));
}

NODE_DEF
node_last_line_set(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *rhs)
{
    VALUE v = EVAL_ARG_UNWRAP(c, rhs);
    korb_last_line_set(c, v);
    return RESULT_OK(v);
}

NODE_DEF
node_last_match_get(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    return RESULT_OK(korb_last_match_get(c));
}

NODE_DEF
node_last_match_set(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *rhs)
{
    VALUE v = EVAL_ARG_UNWRAP(c, rhs);
    korb_last_match_set(c, v);
    return RESULT_OK(v);
}

NODE_DEF
node_cvar_get(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name)
{
    /* Class variable: walk the cref's class up its superclass chain
     * looking for @@name; missing → NameError. */
    extern RESULT korb_cvar_get(CTX *c, ID name);
    return korb_cvar_get(c, name);
}

NODE_DEF
node_cvar_set(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *rhs)
{
    VALUE v = EVAL_ARG_UNWRAP(c, rhs);
    extern void korb_cvar_set(CTX *c, ID name, VALUE val);
    korb_cvar_set(c, name, v);
    return RESULT_OK(v);
}

NODE_DEF
node_const_get(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name)
{
    return korb_const_lookup(c, name);
}

NODE_DEF
node_const_set(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *rhs)
{
    VALUE v = EVAL_ARG_UNWRAP(c, rhs);
    struct korb_class *host = korb_host_class(c);
    korb_const_set(host, name, v);
    return RESULT_OK(v);
}

NODE_DEF
node_const_path_get(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *parent, ID name)
{
    VALUE p = EVAL_ARG_UNWRAP(c, parent);
    if (BUILTIN_TYPE(p) == T_CLASS || BUILTIN_TYPE(p) == T_MODULE) {
        /* private_constant enforcement: explicit `Mod::FOO` from
         * outside Mod's lexical scope is a NameError — but if Mod
         * defines const_missing, dispatch to that first (CRuby gives
         * the metaprogramming hook precedence over visibility error). */
        extern bool korb_const_is_private(const struct korb_class *, ID);
        if (korb_const_is_private((struct korb_class *)p, name)) {
            bool in_scope = false;
            for (struct korb_cref *cr = c->current_frame->cref; cr; cr = cr->prev) {
                if ((VALUE)cr->klass == p) { in_scope = true; break; }
            }
            if (!in_scope) {
                struct korb_class *p_meta = korb_singleton_class_of(c, c->sp_top, (struct korb_class *)p);
                if (p_meta && korb_class_find_method(p_meta, korb_intern("const_missing"))) {
                    VALUE sym = korb_id2sym(name);
                    return korb_funcall(c, p, korb_intern("const_missing"), 1, &sym);
                }
                VALUE eName = korb_const_get(KORB_VM(c)->object_class, korb_intern("NameError"));
                return korb_raise(c, (struct korb_class *)eName,
                           "private constant %s::%s referenced",
                           korb_id_name(((struct korb_class *)p)->name), korb_id_name(name));
            }
        }
        /* Walk super chain AND includes — but stop short of Object's
         * own namespace.  CRuby's `Sub::CONST` lookup does NOT find
         * top-level constants visible only via Object inheritance. */
        VALUE v = korb_const_get_inherited_stop_at_object((struct korb_class *)p, name);
        if (!UNDEF_P(v)) return RESULT_OK(v);
        /* const_missing hook: if the class defines a (singleton) method
         * named const_missing, dispatch to it with the missing name as
         * a Symbol — CRuby's protocol for autoload / lazy const lookup. */
        struct korb_class *p_class = (struct korb_class *)p;
        struct korb_class *meta = korb_singleton_class_of(c, c->sp_top, p_class);
        if (meta && korb_class_find_method(meta, korb_intern("const_missing"))) {
            VALUE sym = korb_id2sym(name);
            return korb_funcall(c, p, korb_intern("const_missing"), 1, &sym);
        }
        /* Build the error message via mod.name (or .inspect for an
         * anonymous module).  Pin eName / name_v / prefix across the
         * korb_funcall sites — each fires GC under STRESS+PURGE and a
         * stale eName C-local would crash inside korb_raise →
         * korb_exc_new → korb_object_new(c, c->sp_top, stale_class). */
        RESULT _err = RESULT_OK(Qnil);
        ARO_ROOT_SCOPE_START(c, ers, 3) {
            ers[0] = korb_const_get(KORB_VM(c)->object_class, korb_intern("NameError"));
            RESULT _name_r = korb_funcall(c, p, korb_intern("name"), 0, NULL);
            ers[1] = (_name_r.state == KORB_NORMAL) ? _name_r.value : Qnil;
            if (NIL_P(ers[1]) || (BUILTIN_TYPE(ers[1]) == T_STRING &&
                                  ((struct korb_string *)ers[1])->len == 0)) {
                RESULT _ins_r = korb_funcall(c, p, korb_intern("inspect"), 0, NULL);
                ers[2] = (_ins_r.state == KORB_NORMAL) ? _ins_r.value
                                                       : korb_str_new_cstr(c, c->sp_top, "<anonymous>");
            } else {
                ers[2] = ers[1];
            }
            const char *prefix_str = (BUILTIN_TYPE(ers[2]) == T_STRING)
                                       ? ((struct korb_string *)ers[2])->ptr : "?";
            _err = korb_raise(c, (struct korb_class *)ers[0],
                       "uninitialized constant %s::%s",
                       prefix_str, korb_id_name(name));
        } ARO_ROOT_SCOPE_END(c, ers);
        return _err;
    }
    return korb_raise_type_error(c, "%s is not a class/module",
                          NIL_P(p) ? "nil" : korb_id_name(korb_class_of_class(p)->name));
}

// ---------------- syntax / control ----------------

NODE_DEF
node_scope(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t envsize, NODE *body)
{
    VALUE *prev_fp = c->current_frame->fp;
    VALUE *prev_sp = c->sp_top;
    c->current_frame->fp += envsize;
    if (UNLIKELY(c->current_frame->fp + envsize >= c->stack_end)) {
        c->current_frame->fp = prev_fp;
        return korb_raise(c, NULL, "stack overflow");
    }
    /* Extend sp to cover the scope's locals AND zero-fill the freshly
     * exposed slots (= the working area).  Doing the zero-fill in the
     * extend-region also clears any stale heap ptrs left over from
     * previously-popped frames at the same addresses — a later
     * visit_roots walking c->stack_base..c->sp_top would otherwise treat them
     * as live roots and either double-forward (= memcpy phantom) or
     * dereference an obj that no longer lives at that address. */
    {
        VALUE *new_sp = c->current_frame->fp + envsize;
        for (VALUE *p = c->sp_top; p < new_sp; p++) *p = Qnil;
        if (new_sp > c->sp_top) c->sp_top = new_sp;
    }
    for (uint32_t i = 0; i < envsize; i++) c->current_frame->fp[i] = Qnil;
    /* sp-relative: body's `sp` parameter must point to this scope's
     * frame top (= shifted fp + envsize), since bake walker computed
     * the lvar sp_offsets relative to envsize.  EVAL_ARG would pass
     * the enclosing scope's sp, which is wrong. */
    RESULT _sr = EVAL(c, body, c->current_frame->fp + envsize);
    /* Restore sp too — otherwise the now-dead scope's slots stay in the
     * GC root-scan range and a later collect treats their values (=
     * possibly stale heap ptrs written during this scope's body) as live
     * roots, double-forwarding or memcpy'ing them.
     *
     * Also zero-fill the popped range so a sibling call's later sp-grow
     * doesn't re-expose this scope's stale local values. */
    c->current_frame->fp = prev_fp;
    for (VALUE *p = prev_sp; p < c->sp_top; p++) *p = Qnil;
    c->sp_top = prev_sp;
    return _sr;
}

NODE_DEF
node_seq(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *head, NODE *tail)
{
    EVAL_ARG_UNWRAP(c, head);
    return EVAL_ARG(c, tail);
}

NODE_DEF
node_if(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *cond, NODE *then_node, NODE *else_node)
{
    VALUE v = EVAL_ARG_UNWRAP(c, cond);
    if (RTEST(v)) {
        return EVAL_ARG(c, then_node);
    }
    else {
        return EVAL_ARG(c, else_node);
    }
}

NODE_DEF
node_while(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *cond, NODE *body)
{
    while (1) {
        VALUE v = EVAL_ARG_UNWRAP(c, cond);
        if (!RTEST(v)) break;
    redo_while:
        {
            RESULT _br = EVAL_ARG(c, body);
            if (UNLIKELY(_br.state != KORB_NORMAL)) {
                if (_br.state == KORB_BREAK && c->state_target_frame == NULL) {
                    /* break with no target frame is a local while-break. */
                    return RESULT_OK(_br.value);
                }
                else if (_br.state == KORB_NEXT) {
                    continue;
                }
                else if (_br.state == KORB_REDO) {
                    /* redo: re-eval body without re-checking condition. */
                    goto redo_while;
                }
                return _br;
            }
        }
    }
    return RESULT_OK(Qnil);
}

NODE_DEF
node_until(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *cond, NODE *body)
{
    while (1) {
        VALUE v = EVAL_ARG_UNWRAP(c, cond);
        if (RTEST(v)) break;
    redo_until:
        {
            RESULT _br = EVAL_ARG(c, body);
            if (UNLIKELY(_br.state != KORB_NORMAL)) {
                if (_br.state == KORB_BREAK && c->state_target_frame == NULL) {
                    return RESULT_OK(_br.value);
                }
                else if (_br.state == KORB_NEXT) {
                    continue;
                }
                else if (_br.state == KORB_REDO) {
                    goto redo_until;
                }
                return _br;
            }
        }
    }
    return RESULT_OK(Qnil);
}

NODE_DEF
node_return(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *value)
{
    VALUE v = EVAL_ARG_UNWRAP(c, value);
    
    /* Stale-frame check: if we're inside a non-lambda block whose
     * lexically-enclosing method has already returned, raise
     * LocalJumpError instead of a non-local return.  Two checks are
     * combined for robustness:
     *   1. Walk the live frame chain — if the target_frame pointer
     *      isn't on it, the method has popped already.
     *   2. Even if a (reused) frame at the same address shows up,
     *      its frame_id won't match the snapshot taken at block
     *      creation. */
    if (c->running_block && !c->running_block->is_lambda &&
        c->running_block->return_target_frame) {
        struct korb_frame *target = (struct korb_frame *)c->running_block->return_target_frame;
        bool target_alive = false;
        for (struct korb_frame *f = c->current_frame; f; f = f->prev) {
            if (f == target) {
                target_alive = (f->frame_id == c->running_block->enclosing_frame_id);
                break;
            }
        }
        if (!target_alive) {
            VALUE eL = korb_const_get(KORB_VM(c)->object_class, korb_intern("LocalJumpError"));
            return korb_raise(c, (struct korb_class *)eL, "unexpected return");
        }
    }
    /* state_target_frame is still propagated via c-> (cannot fit in
     * RESULT); used by node_def's body / dispatch_to_method epilogue
     * to decide whether to consume this RETURN.  See c->state_target_frame
     * lookup at frame.prev == target match points. */
    c->state_target_frame = NULL;
    if (c->running_block && !c->running_block->is_lambda &&
        c->running_block->return_target_frame) {
        c->state_target_frame = c->running_block->return_target_frame;
    }
    return (RESULT){ v, KORB_RETURN };
}

NODE_DEF
node_break(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *value)
{
    VALUE v = EVAL_ARG_UNWRAP(c, value);
    return (RESULT){ v, KORB_BREAK };
}

NODE_DEF
node_next(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *value)
{
    VALUE v = EVAL_ARG_UNWRAP(c, value);
    return (RESULT){ v, KORB_NEXT };
}

NODE_DEF
node_not(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *expr)
{
    VALUE v = EVAL_ARG_UNWRAP(c, expr);
    return RESULT_OK(RTEST(v) ? Qfalse : Qtrue);
}

NODE_DEF
node_and(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (!RTEST(l)) return RESULT_OK(l);
    return EVAL_ARG(c, rhs);
}

NODE_DEF
node_or(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (RTEST(l)) return RESULT_OK(l);
    return EVAL_ARG(c, rhs);
}

// ---------------- containers ----------------

NODE_DEF
node_ary_new(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t argc, uint32_t arg_index)
{
    /* args are pre-evaluated and stored at fp[arg_index..arg_index+argc-1] */
    VALUE ary = korb_ary_new_capa(c, c->sp_top, argc);
    for (uint32_t i = 0; i < argc; i++) {
        korb_ary_push(ary, c->current_frame->fp[arg_index + i]);
    }
    return RESULT_OK(ary);
}

NODE_DEF
node_hash_new(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t argc, uint32_t arg_index)
{
    /* argc is # of pairs * 2; flat key,value,key,value,... */
    VALUE h = korb_hash_new(c, c->sp_top);
    for (uint32_t i = 0; i + 1 < argc; i += 2) {
        VALUE k = c->current_frame->fp[arg_index + i];
        /* CRuby: hash-literal mutable String keys are deduplicated
         * (frozen copy in the hash, original mutable string left
         * alone). */
        if (!SPECIAL_CONST_P(k) && BUILTIN_TYPE(k) == T_STRING &&
            !(RBASIC(k)->head.flags & FL_FROZEN)) {
            VALUE k2 = korb_str_new(c, c->sp_top, ((struct korb_string *)k)->ptr,
                                    ((struct korb_string *)k)->len);
            RBASIC(k2)->head.flags |= FL_FROZEN;
            k = k2;
        }
        korb_hash_aset(c, h, k, c->current_frame->fp[arg_index + i + 1]);
    }
    return RESULT_OK(h);
}

NODE_DEF
node_range_new(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *begin, NODE *end, uint32_t exclude_end)
{
    VALUE b = EVAL_ARG_UNWRAP(c, begin);
    VALUE e = EVAL_ARG_UNWRAP(c, end);
    return RESULT_OK(korb_range_new(c, c->sp_top, b, e, exclude_end != 0));
}

NODE_DEF
node_str_concat(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t argc, uint32_t arg_index)
{
    /* rs[0] = result string, rs[1] = current part — both survive across
     * korb_to_s_dispatch (= can fire GC) and korb_str_concat (= libc
     * realloc, no GC).  C-locals would go stale. */
    VALUE ret = Qnil;
    ARO_ROOT_SCOPE_START(c, rs, 2) {
        rs[0] = korb_str_new(c, c->sp_top, "", 0);
        for (uint32_t i = 0; i < argc; i++) {
            rs[1] = c->current_frame->fp[arg_index + i];
            if (BUILTIN_TYPE(rs[1]) != T_STRING) {
                rs[1] = korb_to_s_dispatch(c, rs[1]);
            }
            rs[0] = korb_str_concat(c, c->sp_top, rs[0], rs[1]);
        }
        ret = rs[0];
    } ARO_ROOT_SCOPE_END(c, rs);
    return RESULT_OK(ret);
}

// ---------------- method definition / call ----------------

NODE_DEF @noinline
node_def(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *body, uint32_t params_cnt, uint32_t locals_cnt)
{
    /* Method goes on the innermost lexical class/module — same as Ruby's
     * `def foo` semantics inside a class body. */
    struct korb_class *target = korb_host_class(c);
    korb_class_add_method_ast_full_cref(c, target, name, body, params_cnt, params_cnt, -1, locals_cnt, c->current_frame->cref);
    return RESULT_OK(korb_id2sym(name));
}

NODE_DEF @noinline
node_class_def(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *super_expr, NODE *body)
{
    /* When parse.c routed `class X` (no super clause) here, super_expr is
     * still set (to a const_get(:Object)).  For mismatch checks we need
     * to know whether the user wrote `< Y` explicitly.  The trick: the
     * is_explicit flag rides on a distinct node kind — `class X` uses
     * node_class_def_implicit_super (defined below).  Here we always
     * treat super_expr as user-specified. */
    VALUE r = Qnil;
    /* rs[0] = super, rs[1] = klass — both held across alloc-can-GC sites
     * (korb_class_new, korb_funcall).  Pure C-locals would go stale. */
    ARO_ROOT_SCOPE_START(c, rs, 2) {
        rs[0] = (VALUE)KORB_VM(c)->object_class;
        if (super_expr) {
            VALUE sv = EVAL_ARG_UNWRAP(c, super_expr);
            if (BUILTIN_TYPE(sv) != T_CLASS) {
                RESULT _e = korb_raise_type_error(c, "superclass must be a Class (%s given)",
                                      korb_id_name(korb_class_of_class(sv)->name));
                ARO_ROOT_SCOPE_CANCEL(c, rs);
                return _e;
            }
            if (((struct korb_class *)sv)->basic.head.flags & FL_SINGLETON) {
                RESULT _e = korb_raise_type_error(c, "can't make subclass of singleton class");

                ARO_ROOT_SCOPE_CANCEL(c, rs);

                return _e;
            }
            rs[0] = sv;
        }
        #define HOST_K (korb_host_class(c))
        VALUE existing = korb_const_get(HOST_K, name);
        if (!UNDEF_P(existing) && (BUILTIN_TYPE(existing) == T_CLASS ||
                                    BUILTIN_TYPE(existing) == T_MODULE)) {
            rs[1] = existing;
            if (BUILTIN_TYPE(existing) == T_MODULE) {
                RESULT _e = korb_raise_type_error(c, "%s is not a class", korb_id_name(name));

                ARO_ROOT_SCOPE_CANCEL(c, rs);

                return _e;
            }
            if (super_expr && ((struct korb_class *)rs[1])->super != (struct korb_class *)rs[0]) {
                RESULT _e = korb_raise_type_error(c, "superclass mismatch for class %s",
                                      korb_id_name(name));

                ARO_ROOT_SCOPE_CANCEL(c, rs);

                return _e;
            }
        }
        else if (!UNDEF_P(existing)) {
            RESULT _e = korb_raise_type_error(c, "%s is not a class", korb_id_name(name));

            ARO_ROOT_SCOPE_CANCEL(c, rs);

            return _e;
        }
        else {
            struct korb_class *k = korb_class_new(c, c->sp_top, name, (struct korb_class *)rs[0], T_OBJECT);
            k->name = 0;
            rs[1] = (VALUE)k;
            korb_const_set(HOST_K, name, rs[1]);
            /* Fire the `inherited` hook on `super`.  korb_funcall fires
             * GC; rs[0]/rs[1] stay live via the root scope, but any
             * C-local snapshots of class pointers would go stale. */
            struct korb_class *super_meta = korb_class_of_class(rs[0]);
            if (super_meta && korb_class_find_method(super_meta, korb_intern("inherited"))) {
                VALUE child_v = rs[1];
                RESULT _ih = korb_funcall(c, rs[0], korb_intern("inherited"), 1, &child_v);
                if (_ih.state != KORB_NORMAL) {
                    ARO_ROOT_SCOPE_CANCEL(c, rs);
                    return _ih;
                }
            }
        }
        #undef HOST_K
        /* Push a synthetic frame so frame.self / current_class / cref
         * live in the frame chain (= visit_roots auto-updates them). */
        struct korb_class *klass = (struct korb_class *)rs[1];
        struct korb_cref new_cref = { .klass = klass, .prev = c->current_frame->cref };
        struct korb_frame fr = {
            .prev = c->current_frame,
            .self = (VALUE)klass,
            .fp = c->current_frame->fp,
            .current_class = klass,
            .cref = &new_cref,
            .current_file = c->current_frame->current_file,
            .last_line = Qnil,
            .last_match = Qnil,
        };
        c->current_frame = &fr;
        VALUE *fp_lo = fr.fp;
        VALUE *fp_hi = c->sp_top;
        r = body ? EVAL_ARG_UNWRAP(c, body) : Qnil;
        c->current_frame = fr.prev;
        /* Use fr.self (frame-chain tracked) not rs[1] — body eval may have
         * pulled c->sp_top below the ARO scope's bumped value. */
        korb_proc_snapshot_env_if_in_frame(fr.self, fp_lo, fp_hi + 1024);
    } ARO_ROOT_SCOPE_END(c, rs);
    return RESULT_OK(r);
}

/* `class X` with no `< Super` clause — reopen if exists (any super is
 * fine), otherwise create with Object as super.  Differs from
 * node_class_def in that a reopen with mismatched non-Object super is
 * NOT an error here. */
NODE_DEF @noinline
node_class_reopen(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *body)
{
    /* `host` / `klass` are gc-heap addresses (= korb_class_new allocates
     * on the gc arena now).  Don't cache `host`: each use re-reads
     * `c->current_frame->cref->klass` (= covered by visit_roots phase (c)) so the
     * current valid address is seen even after korb_class_new / GC.
     * `klass` is held in rs[1] across korb_class_new + korb_const_set +
     * korb_funcall, all of which can fire GC and move it. */
    VALUE r = Qnil;
    /* rs[0] = klass, held across korb_class_new + korb_funcall (= GC
     * sites) and body eval.  C-local prev_class would go stale. */
    ARO_ROOT_SCOPE_START(c, rs, 1) {
        #define HOST_K (korb_host_class(c))
        VALUE existing = korb_const_get(HOST_K, name);
        if (!UNDEF_P(existing) && BUILTIN_TYPE(existing) == T_CLASS) {
            rs[0] = existing;
        }
        else if (!UNDEF_P(existing) && BUILTIN_TYPE(existing) == T_MODULE) {
            RESULT _e = korb_raise_type_error(c, "%s is not a class", korb_id_name(name));

            ARO_ROOT_SCOPE_CANCEL(c, rs);

            return _e;
        }
        else if (!UNDEF_P(existing)) {
            RESULT _e = korb_raise_type_error(c, "%s is not a class", korb_id_name(name));

            ARO_ROOT_SCOPE_CANCEL(c, rs);

            return _e;
        }
        else {
            struct korb_class *k = korb_class_new(c, c->sp_top, name, KORB_VM(c)->object_class, T_OBJECT);
            k->name = 0;
            rs[0] = (VALUE)k;
            korb_const_set(HOST_K, name, rs[0]);
            struct korb_class *super_meta = korb_class_of_class((VALUE)KORB_VM(c)->object_class);
            if (super_meta && korb_class_find_method(super_meta, korb_intern("inherited"))) {
                VALUE child_v = rs[0];
                RESULT _ih = korb_funcall(c, (VALUE)KORB_VM(c)->object_class, korb_intern("inherited"), 1, &child_v);
                if (_ih.state != KORB_NORMAL) {
                    ARO_ROOT_SCOPE_CANCEL(c, rs);
                    return _ih;
                }
            }
        }
        #undef HOST_K
        /* Push a synthetic frame so frame.self / current_class / cref
         * live in the frame chain (= visit_roots auto-updates).  No
         * C-local prev_class stale issue. */
        struct korb_class *klass = (struct korb_class *)rs[0];
        struct korb_cref new_cref = { .klass = klass, .prev = c->current_frame->cref };
        struct korb_frame fr = {
            .prev = c->current_frame,
            .self = (VALUE)klass,
            .fp = c->current_frame->fp,
            .current_class = klass,
            .cref = &new_cref,
            .current_file = c->current_frame->current_file,
            .last_line = Qnil,
            .last_match = Qnil,
        };
        c->current_frame = &fr;
        VALUE *fp_lo = fr.fp;
        VALUE *fp_hi = c->sp_top;
        r = body ? EVAL_ARG_UNWRAP(c, body) : Qnil;
        c->current_frame = fr.prev;
        /* Use fr.self (frame-chain tracked) not rs[0] — same reason as
         * the @< clause variant above. */
        korb_proc_snapshot_env_if_in_frame(fr.self, fp_lo, fp_hi + 1024);
    } ARO_ROOT_SCOPE_END(c, rs);
    return RESULT_OK(r);
}

NODE_DEF @noinline
node_module_def(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *body)
{
    VALUE r = Qnil;
    /* sp[0] = result module (= klass), held across korb_module_new
     * (= GC) and the body eval.  We do NOT poke c->sp_top from this
     * caller — alloc helpers (korb_module_new etc.) do their own
     * `c->sp_top = sp` right before the GC trigger.  We just pass `sp + 1`
     * so they know sp[0] is held live and their scratch starts at
     * sp[1]. */
    sp[0] = 0;
    {
        #define HOST_K (korb_host_class(c))
        VALUE existing = korb_const_get(HOST_K, name);
        if (!UNDEF_P(existing) && BUILTIN_TYPE(existing) == T_MODULE) {
            sp[0] = existing;
        }
        else if (!UNDEF_P(existing)) {
            RESULT _e = korb_raise_type_error(c, "%s is not a module", korb_id_name(name));
            return _e;
        }
        else {
            struct korb_class *m = korb_module_new(c, sp + 1, name);
            m->name = 0;
            sp[0] = (VALUE)m;
            korb_const_set(HOST_K, name, sp[0]);
        }
        #undef HOST_K
        /* Push a synthetic frame for the module body so frame.self /
         * current_class / cref live in the frame chain (visit_roots
         * walks them auto).  No C-local prev_class stale issue. */
        struct korb_class *klass = (struct korb_class *)sp[0];
        struct korb_cref new_cref = { .klass = klass, .prev = c->current_frame->cref };
        struct korb_frame fr = {
            .prev = c->current_frame,
            .self = (VALUE)klass,
            .fp = c->current_frame->fp,
            .current_class = klass,
            .cref = &new_cref,
            .current_file = c->current_frame->current_file,
            .last_line = Qnil,
            .last_match = Qnil,
        };
        c->current_frame = &fr;
        VALUE *fp_lo = fr.fp;
        VALUE *fp_hi = c->sp_top;
        r = body ? EVAL_ARG_UNWRAP(c, body) : Qnil;
        c->current_frame = fr.prev;
        /* Read klass from fr.self (= frame-chain-tracked) instead of
         * sp[0]: the body eval may have pulled c->sp_top below sp[0],
         * exposing it to GC moves it can't forward.  fr.self stays
         * fresh because visit_roots walks the frame chain while &fr
         * is current_frame. */
        korb_proc_snapshot_env_if_in_frame(fr.self, fp_lo, fp_hi + 1024);
    }
    return RESULT_OK(r);
}

/* dispatch helpers (declared in node.h via include) */

NODE_DEF
node_func_call(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, uint32_t argc, uint32_t arg_index, struct method_cache *mc)
{
    /* implicit-self call — _cached version inlines the IC + prologue
     * dispatch directly into the SD body, so a hot self-call (e.g.
     * `render_pixel` from the per-frame loop) avoids a function-pointer
     * jump per call. */
    return korb_dispatch_call_cached(c, n, c->current_frame->self, name, argc, arg_index, NULL, mc);
}

NODE_DEF
node_method_call(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv, ID name, uint32_t argc, uint32_t arg_index, struct method_cache *mc)
{
    /* recv evaluation: GC inside the EVAL is responsible for syncing
     * its own c->sp_top.  Once recv is back as a C-local, it's already
     * forwarded — no further GC fires between assignment and the
     * dispatch call's recv argument. */
    VALUE r = EVAL_ARG_UNWRAP(c, recv);
    return korb_dispatch_call_cached(c, n, r, name, argc, arg_index, NULL, mc);
}

/* Case/when's `===` dispatch: bypass visibility because CRuby calls
 * the matcher's `===` even when private (the matcher's intent is to
 * be called by case/when).  Argument is staged at arg_index. */
NODE_DEF
node_case_eqq_call(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv, uint32_t arg_index)
{
    VALUE r = EVAL_ARG_UNWRAP(c, recv);
    VALUE arg = c->current_frame->fp[arg_index];
    return korb_funcall(c, r, korb_intern("==="), 1, &arg);
}

NODE_DEF
node_method_call_block(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv, ID name, uint32_t argc, uint32_t arg_index, NODE *blk, struct method_cache *mc)
{
    /* Reserve 2 slots: sp[0] = r, sp[1] = block.  Zero-fill before
     * bumping c->sp_top so visit_roots doesn't see stale leftovers. */
    sp[0] = 0; sp[1] = 0;
    c->sp_top = sp + 2;
    sp[0] = EVAL_ARG_UNWRAP(c, recv);
    sp[1] = blk ? EVAL_ARG_UNWRAP(c, blk) : Qnil;
    VALUE r = sp[0];
    VALUE block = sp[1];
    RESULT _ret = korb_dispatch_call_cached(c, n, r, name, argc, arg_index, block == Qnil ? NULL : (struct korb_proc *)block, mc);
    c->sp_top = sp;
    return _ret;
}

NODE_DEF
node_func_call_block(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, uint32_t argc, uint32_t arg_index, NODE *blk, struct method_cache *mc)
{
    /* Reserve 2 slots: sp[0] = recv (= self snapshot), sp[1] = block.
     * Reading c->current_frame->self at the dispatch call site picks
     * up a stale value when GC moved main_obj and the frame.self slot
     * wasn't walked (root_scan timing window).  Pinning it in sp here
     * keeps it current even if frame.self lags. */
    sp[0] = 0; sp[1] = 0;
    c->sp_top = sp + 2;
    sp[0] = c->current_frame->self;
    sp[1] = blk ? EVAL_ARG_UNWRAP(c, blk) : Qnil;
    VALUE recv = sp[0];
    VALUE block = sp[1];
    RESULT _ret = korb_dispatch_call_cached(c, n, recv, name, argc, arg_index, block == Qnil ? NULL : (struct korb_proc *)block, mc);
    c->sp_top = sp;
    return _ret;
}

NODE_DEF @noinline
node_block_literal(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *body, uint32_t params_cnt, uint32_t param_base, uint32_t env_size, uint32_t creates_proc)
{
    VALUE p = korb_proc_new_with_cref(c, c->sp_top, body, c->current_frame->fp, env_size, params_cnt, param_base, c->current_frame->self, false, c->current_frame->cref);
    if (creates_proc) ((struct korb_proc *)p)->creates_proc = true;
    /* Capture enclosing-method's fp for non-local return targeting. */
    /* Capture the lexically-enclosing method's frame for non-local
     * `return` targeting.  When this block_literal is itself inside
     * another block's body (c->running_block != NULL), inherit that
     * outer block's target — they share the same lexical method.
     * Only when no block is running do we capture the current frame. */
    ((struct korb_proc *)p)->return_target_frame =
        c->running_block ? c->running_block->return_target_frame : c->current_frame;
    ((struct korb_proc *)p)->enclosing_frame_id =
        c->running_block ? c->running_block->enclosing_frame_id
                      : (c->current_frame ? c->current_frame->frame_id : 0);
    /* Lexical method capture: the method active when this block is
     * created.  super inside the block uses this method's
     * defining_class.  When this block_literal is itself inside another
     * block, inherit the outer's defining_method. */
    ((struct korb_proc *)p)->defining_method =
        c->running_block ? c->running_block->defining_method
                      : (c->current_frame ? c->current_frame->method : NULL);
    ((struct korb_proc *)p)->lexical_parent_block = c->running_block;
    return RESULT_OK(p);
}

/* Variant with an explicit *rest slot.  rest_slot is the absolute slot
 * the proc binds *rest into; -1 means "no rest". */
NODE_DEF @noinline
node_block_literal_rest(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *body, uint32_t params_cnt, uint32_t param_base, uint32_t env_size, int32_t rest_slot, uint32_t creates_proc)
{
    VALUE p = korb_proc_new_with_cref(c, c->sp_top, body, c->current_frame->fp, env_size, params_cnt, param_base, c->current_frame->self, false, c->current_frame->cref);
    ((struct korb_proc *)p)->rest_slot = rest_slot;
    if (creates_proc) ((struct korb_proc *)p)->creates_proc = true;
    ((struct korb_proc *)p)->return_target_frame =
        c->running_block ? c->running_block->return_target_frame : c->current_frame;
    ((struct korb_proc *)p)->enclosing_frame_id =
        c->running_block ? c->running_block->enclosing_frame_id
                      : (c->current_frame ? c->current_frame->frame_id : 0);
    ((struct korb_proc *)p)->defining_method =
        c->running_block ? c->running_block->defining_method
                      : (c->current_frame ? c->current_frame->method : NULL);
    ((struct korb_proc *)p)->lexical_parent_block = c->running_block;
    return RESULT_OK(p);
}

/* Block literal with both *rest_slot AND kwh_save_slot.  Used when the
 * block declares keyword params; proc_call uses kwh_save_slot to peel
 * the trailing Hash argument. */
NODE_DEF @noinline
node_block_literal_kw(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *body, uint32_t params_cnt, uint32_t param_base, uint32_t env_size, int32_t rest_slot, int32_t kwh_save_slot, uint32_t creates_proc)
{
    VALUE p = korb_proc_new_with_cref(c, c->sp_top, body, c->current_frame->fp, env_size, params_cnt, param_base, c->current_frame->self, false, c->current_frame->cref);
    ((struct korb_proc *)p)->rest_slot = rest_slot;
    ((struct korb_proc *)p)->kwh_save_slot = kwh_save_slot;
    if (creates_proc) ((struct korb_proc *)p)->creates_proc = true;
    ((struct korb_proc *)p)->return_target_frame =
        c->running_block ? c->running_block->return_target_frame : c->current_frame;
    ((struct korb_proc *)p)->enclosing_frame_id =
        c->running_block ? c->running_block->enclosing_frame_id
                      : (c->current_frame ? c->current_frame->frame_id : 0);
    ((struct korb_proc *)p)->defining_method =
        c->running_block ? c->running_block->defining_method
                      : (c->current_frame ? c->current_frame->method : NULL);
    ((struct korb_proc *)p)->lexical_parent_block = c->running_block;
    return RESULT_OK(p);
}

/* Set a Proc's opt_cnt — used by parse.c to plumb the count of
 * optional positional params for blocks/lambdas built with default-
 * value parameters.  Wraps the block_literal node in a sequence so
 * proc_call can fill missing optional slots with Qundef and trigger
 * the body's default-init prologue. */
NODE_DEF @noinline
node_proc_set_opt_cnt(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *blk_node, uint32_t opt_cnt)
{
    VALUE p = EVAL_ARG_UNWRAP(c, blk_node);
    if (LIKELY(!SPECIAL_CONST_P(p) && BUILTIN_TYPE(p) == T_PROC)) {
        ((struct korb_proc *)p)->opt_cnt = opt_cnt;
    }
    return RESULT_OK(p);
}

/* Set a Proc's `&blk` slot — proc_call binds the caller's block (or nil)
 * into this slot before evaluating the body. */
NODE_DEF @noinline
node_proc_set_block_slot(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *blk_node, int32_t block_slot)
{
    VALUE p = EVAL_ARG_UNWRAP(c, blk_node);
    if (LIKELY(!SPECIAL_CONST_P(p) && BUILTIN_TYPE(p) == T_PROC)) {
        ((struct korb_proc *)p)->block_slot = block_slot;
    }
    return RESULT_OK(p);
}

/* Set a Proc's post_cnt — required params after *rest. */
NODE_DEF @noinline
node_proc_set_post_cnt(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *blk_node, uint32_t post_cnt)
{
    VALUE p = EVAL_ARG_UNWRAP(c, blk_node);
    if (LIKELY(!SPECIAL_CONST_P(p) && BUILTIN_TYPE(p) == T_PROC)) {
        ((struct korb_proc *)p)->post_cnt = post_cnt;
    }
    return RESULT_OK(p);
}

/* Mark a Proc as having `|a, |` style implicit-rest (trailing comma).
 * Lambda arity check uses this to enforce strict arity even though
 * rest_slot is non-negative (we still allocate a discardable slot to
 * absorb extras for proc-style autosplat / yield). */
NODE_DEF @noinline
node_proc_set_implicit_rest(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *blk_node)
{
    VALUE p = EVAL_ARG_UNWRAP(c, blk_node);
    if (LIKELY(!SPECIAL_CONST_P(p) && BUILTIN_TYPE(p) == T_PROC)) {
        ((struct korb_proc *)p)->implicit_rest = true;
    }
    return RESULT_OK(p);
}

/* Flip a freshly-created Proc into a lambda.  Used by `-> { ... }` so
 * the literal becomes a lambda without dispatching Kernel#lambda
 * (which a class inheriting from BasicObject can't reach). */
NODE_DEF @noinline
node_proc_make_lambda(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *blk_node)
{
    VALUE p = EVAL_ARG_UNWRAP(c, blk_node);
    if (LIKELY(!SPECIAL_CONST_P(p) && BUILTIN_TYPE(p) == T_PROC)) {
        ((struct korb_proc *)p)->is_lambda = true;
    }
    return RESULT_OK(p);
}

/* Mark a Hash with FL_KWARGS so dispatch peels it as kwargs at the
 * call site.  Used by `m(k: v)` / `m(**h)` lowering. */
NODE_DEF
node_hash_mark_kwargs(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *hash_expr)
{
    VALUE h = EVAL_ARG_UNWRAP(c, hash_expr);
    if (!SPECIAL_CONST_P(h) && BUILTIN_TYPE(h) == T_HASH) {
        ((struct RBasic *)h)->head.flags |= FL_KWARGS;
    }
    return RESULT_OK(h);
}

NODE_DEF
node_yield(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t argc, uint32_t arg_index)
{
    return korb_yield(c, argc, &c->current_frame->fp[arg_index]);
}

/* `yield *arr` (or `yield a, *b, c`) — args were materialized into a
 * single Array at slot `arr_slot`; call yield with the array's elements
 * as a variadic argv. */
NODE_DEF
node_yield_splat(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t arr_slot)
{
    VALUE arr = c->current_frame->fp[arr_slot];
    if (SPECIAL_CONST_P(arr) || BUILTIN_TYPE(arr) != T_ARRAY) {
        return korb_yield(c, 0, NULL);
    }
    struct korb_array *a = (struct korb_array *)arr;
    return korb_yield(c, (uint32_t)a->len, a->ptr);
}

// ---------------- arithmetic (generic + fixnum fast path) ----------------
// Each EVAL_node_<binop> records `n` into c->last_cfunc_callsite at the
// point where it falls into a slow / raise path.  korb_raise reads that
// for backtrace line numbers; without it, raises from arithmetic land
// with line=0 and the backtrace shows the caller's call site instead of
// the failing op.  Fast paths skip the store entirely.

NODE_DEF
node_plus(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    /* Fixnum fast path: l is immediate (= value-type, no GC risk),
     * so we can eval rhs without protecting l. */
    if (LIKELY(FIXNUM_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (LIKELY(FIXNUM_P(r) && !korb_g_basic_op_redefined)) {
            long a = FIX2LONG(l), b = FIX2LONG(r), s;
            if (LIKELY(!__builtin_add_overflow(a, b, &s) && FIXABLE(s))) return RESULT_OK(INT2FIX(s));
            return RESULT_OK(korb_int_plus(l, r));
        }
        c->last_cfunc_callsite = n;
        return korb_node_plus_slow(c, l, r, arg_index);
    }
    /* l is a heap object (string / array / float / etc.).  Park it in a
     * synthetic frame's last_line slot so visit_roots scans &fr.last_line
     * across rhs's GC fires (= via the frame chain, NOT via sp[] which
     * would conflict with sub-call arg staging that may overlap our
     * scope's stack area).  CRITICAL: fr.self MUST inherit the caller's
     * self — using `l` here breaks ivar lookups inside rhs (e.g.
     * `"begin" + " (#{@x})"` would read @x off the literal "begin"
     * instead of the surrounding receiver, yielding nil). */
    struct korb_frame fr = {
        .prev      = c->current_frame,
        .self      = c->current_frame->self,
        .fp        = c->current_frame->fp,
        .cref      = c->current_frame->cref,
        .current_class = c->current_frame->current_class,
        .current_file = c->current_frame->current_file,
        .last_line = l,
        .last_match= Qnil,
    };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    if (LIKELY(FLONUM_P(l) && FLONUM_P(r) && !korb_g_basic_op_redefined)) {
        return RESULT_OK(korb_float_new(c, c->sp_top, korb_flonum_to_double(l) + korb_flonum_to_double(r)));
    }
    c->last_cfunc_callsite = n;
    return korb_node_plus_slow(c, l, r, arg_index);
}

NODE_DEF
node_minus(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (LIKELY(FIXNUM_P(l) || FLONUM_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) {
            long a = FIX2LONG(l), b = FIX2LONG(r), s;
            if (LIKELY(!__builtin_sub_overflow(a, b, &s) && FIXABLE(s))) return RESULT_OK(INT2FIX(s));
            return RESULT_OK(korb_int_minus(l, r));
        }
        if (LIKELY(FLONUM_P(l) && FLONUM_P(r) && !korb_g_basic_op_redefined)) {
            return RESULT_OK(korb_float_new(c, c->sp_top, korb_flonum_to_double(l) - korb_flonum_to_double(r)));
        }
        c->last_cfunc_callsite = n;
        return korb_node_minus_slow(c, l, r, arg_index);
    }
    struct korb_frame fr = { .prev = c->current_frame, .self = c->current_frame->self,
        .fp = c->current_frame->fp, .cref = c->current_frame->cref,
        .current_class = c->current_frame->current_class, .current_file = c->current_frame->current_file,
        .last_line = l, .last_match = Qnil };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    c->last_cfunc_callsite = n;
    return korb_node_minus_slow(c, l, r, arg_index);
}

NODE_DEF
node_mul(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (LIKELY(FIXNUM_P(l) || FLONUM_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) {
            long a = FIX2LONG(l), b = FIX2LONG(r), s;
            if (LIKELY(!__builtin_mul_overflow(a, b, &s) && FIXABLE(s))) return RESULT_OK(INT2FIX(s));
            return RESULT_OK(korb_int_mul(l, r));
        }
        if (LIKELY(FLONUM_P(l) && FLONUM_P(r) && !korb_g_basic_op_redefined)) {
            return RESULT_OK(korb_float_new(c, c->sp_top, korb_flonum_to_double(l) * korb_flonum_to_double(r)));
        }
        c->last_cfunc_callsite = n;
        return korb_node_mul_slow(c, l, r, arg_index);
    }
    struct korb_frame fr = { .prev = c->current_frame, .self = c->current_frame->self,
        .fp = c->current_frame->fp, .cref = c->current_frame->cref,
        .current_class = c->current_frame->current_class, .current_file = c->current_frame->current_file,
        .last_line = l, .last_match = Qnil };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    c->last_cfunc_callsite = n;
    return korb_node_mul_slow(c, l, r, arg_index);
}

NODE_DEF
node_div(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) {
        long a = FIX2LONG(l), b = FIX2LONG(r);
        if (UNLIKELY(b == 0)) {
            c->last_cfunc_callsite = n;
            VALUE eZ = korb_const_get(KORB_VM(c)->object_class, korb_intern("ZeroDivisionError"));
            return korb_raise(c, (struct korb_class *)eZ, "divided by 0");
        }
        long q = a / b;
        if ((a % b) != 0 && ((a ^ b) < 0)) q--;
        if (FIXABLE(q)) return RESULT_OK(INT2FIX(q));
        return RESULT_OK(korb_int_div(l, r));
    }
    if (LIKELY(FLONUM_P(l) && FLONUM_P(r) && !korb_g_basic_op_redefined)) {
        return RESULT_OK(korb_float_new(c, c->sp_top, korb_flonum_to_double(l) / korb_flonum_to_double(r)));
    }
    c->last_cfunc_callsite = n;
    return korb_node_div_slow(c, l, r, arg_index);
}

NODE_DEF
node_mod(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) {
        long a = FIX2LONG(l), b = FIX2LONG(r);
        if (UNLIKELY(b == 0)) {
            c->last_cfunc_callsite = n;
            VALUE eZ = korb_const_get(KORB_VM(c)->object_class, korb_intern("ZeroDivisionError"));
            return korb_raise(c, (struct korb_class *)eZ, "divided by 0");
        }
        long m = a % b;
        if (m != 0 && ((a ^ b) < 0)) m += b;
        return RESULT_OK(INT2FIX(m));
    }
    c->last_cfunc_callsite = n;
    return korb_node_mod_slow(c, l, r, arg_index);
}

NODE_DEF
node_uminus(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *operand, uint32_t arg_index)
{
    VALUE v = EVAL_ARG_UNWRAP(c, operand);
    if (LIKELY(FIXNUM_P(v) && !korb_g_basic_op_redefined)) {
        long a = FIX2LONG(v), s;
        if (!__builtin_sub_overflow(0L, a, &s) && FIXABLE(s)) return RESULT_OK(INT2FIX(s));
    }
    c->last_cfunc_callsite = n;
    return korb_node_uminus_slow(c, v);
}

// ---------------- bit ops ----------------

NODE_DEF
node_bit_and(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(l & r);
    c->last_cfunc_callsite = n;
    return korb_node_band_slow(c, l, r, arg_index);
}

NODE_DEF
node_bit_or(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(l | r);
    c->last_cfunc_callsite = n;
    return korb_node_bor_slow(c, l, r, arg_index);
}

NODE_DEF
node_bit_xor(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK((l ^ r) | FIXNUM_FLAG);
    c->last_cfunc_callsite = n;
    return korb_node_bxor_slow(c, l, r, arg_index);
}

NODE_DEF
node_lshift(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (LIKELY(FIXNUM_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (LIKELY(FIXNUM_P(r) && !korb_g_basic_op_redefined)) {
            long a = FIX2LONG(l), b = FIX2LONG(r);
            if (b >= 0 && b < 62) {
                long s = a << b;
                if ((s >> b) == a && FIXABLE(s)) return RESULT_OK(INT2FIX(s));
            }
            return RESULT_OK(korb_int_lshift(l, r));
        }
        c->last_cfunc_callsite = n;
        return korb_node_lshift_slow(c, l, r, arg_index);
    }
    /* l is a heap obj — pin via synthetic-frame's last_line slot
     * (see node_plus for the same pattern + rationale) so rhs eval's
     * GC doesn't leave a moved-out C-local.  fr.self must inherit
     * caller's self to avoid hijacking @ivar lookups inside rhs. */
    struct korb_frame fr = {
        .prev      = c->current_frame,
        .self      = c->current_frame->self,
        .fp        = c->current_frame->fp,
        .cref      = c->current_frame->cref,
        .current_class = c->current_frame->current_class,
        .current_file = c->current_frame->current_file,
        .last_line = l,
        .last_match= Qnil,
    };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    /* Array#<< — push and return self.  Hot in optcarrot's
     * render_pixel (`@output_pixels << ...` runs once per pixel). */
    if (LIKELY(!SPECIAL_CONST_P(l) && BUILTIN_TYPE(l) == T_ARRAY && !korb_g_array_op_redefined)) {
        CHECK_FROZEN_R(c, l);
        korb_ary_push(l, r);
        return RESULT_OK(l);
    }
    c->last_cfunc_callsite = n;
    return korb_node_lshift_slow(c, l, r, arg_index);
}

NODE_DEF
node_rshift(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) {
        long a = FIX2LONG(l), b = FIX2LONG(r);
        if (b >= 0 && b < 62) return RESULT_OK(INT2FIX(a >> b));
        return RESULT_OK(korb_int_rshift(l, r));
    }
    c->last_cfunc_callsite = n;
    return korb_node_rshift_slow(c, l, r, arg_index);
}

// ---------------- comparisons ----------------

NODE_DEF
node_lt(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (LIKELY(FIXNUM_P(l) || FLONUM_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(KORB_BOOL((intptr_t)l < (intptr_t)r));
        if (LIKELY(FLONUM_P(l) && FLONUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(KORB_BOOL(korb_flonum_to_double(l) < korb_flonum_to_double(r)));
        c->last_cfunc_callsite = n;
        return korb_node_lt_slow(c, l, r, arg_index);
    }
    /* Pin l across rhs GC fire — see node_plus. */
    struct korb_frame fr = { .prev = c->current_frame, .self = c->current_frame->self,
        .fp = c->current_frame->fp, .cref = c->current_frame->cref,
        .current_class = c->current_frame->current_class, .current_file = c->current_frame->current_file,
        .last_line = l, .last_match = Qnil };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    c->last_cfunc_callsite = n;
    return korb_node_lt_slow(c, l, r, arg_index);
}

NODE_DEF
node_le(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (LIKELY(FIXNUM_P(l) || FLONUM_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(KORB_BOOL((intptr_t)l <= (intptr_t)r));
        if (LIKELY(FLONUM_P(l) && FLONUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(KORB_BOOL(korb_flonum_to_double(l) <= korb_flonum_to_double(r)));
        c->last_cfunc_callsite = n;
        return korb_node_le_slow(c, l, r, arg_index);
    }
    struct korb_frame fr = { .prev = c->current_frame, .self = c->current_frame->self,
        .fp = c->current_frame->fp, .cref = c->current_frame->cref,
        .current_class = c->current_frame->current_class, .current_file = c->current_frame->current_file,
        .last_line = l, .last_match = Qnil };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    c->last_cfunc_callsite = n;
    return korb_node_le_slow(c, l, r, arg_index);
}

NODE_DEF
node_gt(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (LIKELY(FIXNUM_P(l) || FLONUM_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(KORB_BOOL((intptr_t)l > (intptr_t)r));
        if (LIKELY(FLONUM_P(l) && FLONUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(KORB_BOOL(korb_flonum_to_double(l) > korb_flonum_to_double(r)));
        c->last_cfunc_callsite = n;
        return korb_node_gt_slow(c, l, r, arg_index);
    }
    struct korb_frame fr = { .prev = c->current_frame, .self = c->current_frame->self,
        .fp = c->current_frame->fp, .cref = c->current_frame->cref,
        .current_class = c->current_frame->current_class, .current_file = c->current_frame->current_file,
        .last_line = l, .last_match = Qnil };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    c->last_cfunc_callsite = n;
    return korb_node_gt_slow(c, l, r, arg_index);
}

NODE_DEF
node_ge(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (LIKELY(FIXNUM_P(l) || FLONUM_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (LIKELY(FIXNUM_P(l) && FIXNUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(KORB_BOOL((intptr_t)l >= (intptr_t)r));
        if (LIKELY(FLONUM_P(l) && FLONUM_P(r) && !korb_g_basic_op_redefined)) return RESULT_OK(KORB_BOOL(korb_flonum_to_double(l) >= korb_flonum_to_double(r)));
        c->last_cfunc_callsite = n;
        return korb_node_ge_slow(c, l, r, arg_index);
    }
    struct korb_frame fr = { .prev = c->current_frame, .self = c->current_frame->self,
        .fp = c->current_frame->fp, .cref = c->current_frame->cref,
        .current_class = c->current_frame->current_class, .current_file = c->current_frame->current_file,
        .last_line = l, .last_match = Qnil };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    c->last_cfunc_callsite = n;
    return korb_node_ge_slow(c, l, r, arg_index);
}

NODE_DEF
node_eq(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    /* FIXNUM/FLONUM/SPECIAL fast-path: no GC concern, l never moves. */
    if (LIKELY(FIXNUM_P(l) || FLONUM_P(l) || SPECIAL_CONST_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (UNLIKELY(korb_g_basic_op_redefined)) {
            c->current_frame->fp[arg_index+1] = r;
            return korb_dispatch_binop(c, l, korb_intern("=="), 1, &c->current_frame->fp[arg_index+1]);
        }
        if (FIXNUM_P(l) && FIXNUM_P(r)) return RESULT_OK(KORB_BOOL(l == r));
        if (FLONUM_P(l) && FLONUM_P(r)) return RESULT_OK(KORB_BOOL(l == r));
        if (SPECIAL_CONST_P(l) && !FIXNUM_P(l) && !FLONUM_P(l)) {
            return RESULT_OK(KORB_BOOL(l == r));
        }
        c->current_frame->fp[arg_index+1] = r;
        return korb_dispatch_binop(c, l, korb_intern("=="), 1, &c->current_frame->fp[arg_index+1]);
    }
    /* l is a heap obj — pin via synthetic frame's last_line slot
     * (same pattern as node_plus / node_lshift) so rhs eval's GC
     * doesn't leave a moved-out C-local.  fr.self inherits caller's
     * self to avoid hijacking @ivar lookups inside rhs. */
    struct korb_frame fr = {
        .prev      = c->current_frame,
        .self      = c->current_frame->self,
        .fp        = c->current_frame->fp,
        .cref      = c->current_frame->cref,
        .current_class = c->current_frame->current_class,
        .current_file = c->current_frame->current_file,
        .last_line = l,
        .last_match= Qnil,
    };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    c->current_frame->fp[arg_index+1] = r;
    return korb_dispatch_binop(c, l, korb_intern("=="), 1, &c->current_frame->fp[arg_index+1]);
}

NODE_DEF
node_neq(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs, uint32_t arg_index)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    if (LIKELY(FIXNUM_P(l) || FLONUM_P(l) || SPECIAL_CONST_P(l))) {
        VALUE r = EVAL_ARG_UNWRAP(c, rhs);
        if (UNLIKELY(korb_g_basic_op_redefined)) {
            c->current_frame->fp[arg_index+1] = r;
            VALUE eq = UNWRAP(korb_dispatch_binop(c, l, korb_intern("=="), 1, &c->current_frame->fp[arg_index+1]));
            return RESULT_OK(KORB_BOOL(!RTEST(eq)));
        }
        if (FIXNUM_P(l) && FIXNUM_P(r)) return RESULT_OK(KORB_BOOL(l != r));
        if (FLONUM_P(l) && FLONUM_P(r)) return RESULT_OK(KORB_BOOL(l != r));
        if ((SPECIAL_CONST_P(l) && !FIXNUM_P(l) && !FLONUM_P(l)) ||
            (SPECIAL_CONST_P(r) && !FIXNUM_P(r) && !FLONUM_P(r))) {
            return RESULT_OK(KORB_BOOL(l != r));
        }
        c->current_frame->fp[arg_index+1] = r;
        VALUE eq = UNWRAP(korb_dispatch_binop(c, l, korb_intern("=="), 1, &c->current_frame->fp[arg_index+1]));
        return RESULT_OK(KORB_BOOL(!RTEST(eq)));
    }
    /* l is a heap obj — pin via synthetic frame's last_line.  See
     * node_plus / node_lshift / node_eq. */
    struct korb_frame fr = {
        .prev      = c->current_frame,
        .self      = c->current_frame->self,
        .fp        = c->current_frame->fp,
        .cref      = c->current_frame->cref,
        .current_class = c->current_frame->current_class,
        .current_file = c->current_frame->current_file,
        .last_line = l,
        .last_match= Qnil,
    };
    c->current_frame = &fr;
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    c->current_frame = fr.prev;
    l = fr.last_line;
    c->current_frame->fp[arg_index+1] = r;
    VALUE eq = UNWRAP(korb_dispatch_binop(c, l, korb_intern("=="), 1, &c->current_frame->fp[arg_index+1]));
    return RESULT_OK(KORB_BOOL(!RTEST(eq)));
}

// ---------------- subscript [] / []= ----------------

NODE_DEF
node_aref(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv, NODE *idx, uint32_t arg_index)
{
    /* Pin r + i via ARO_ROOT_SCOPE (= uses c->sp_top as slot base, always on
     * the value stack).  Don't use sp[N] directly: when running inside an
     * escaped proc's body, the sp parameter points into the proc's
     * libc-allocated env, while c->sp_top stays on the value stack.  Setting
     * c->sp_top = sp + N would give visit_roots an invalid linear range. */
    VALUE ret;
    ARO_ROOT_SCOPE_START(c, rs, 2) {
        rs[0] = EVAL_ARG_UNWRAP(c, recv);
        rs[1] = EVAL_ARG_UNWRAP(c, idx);
        VALUE r = rs[0];
        VALUE i = rs[1];
        if (LIKELY(!korb_g_basic_op_redefined)) {
            if (FIXNUM_P(r) && FIXNUM_P(i)) {
                long b = FIX2LONG(i);
                if (b < 0 || b >= 63) { ret = INT2FIX(0); goto aref_done; }
                ret = INT2FIX((FIX2LONG(r) >> b) & 1);
                goto aref_done;
            }
            if (LIKELY(!SPECIAL_CONST_P(r))) {
                if (BUILTIN_TYPE(r) == T_ARRAY && FIXNUM_P(i)) { ret = korb_ary_aref(r, FIX2LONG(i)); goto aref_done; }
                if (BUILTIN_TYPE(r) == T_HASH && NIL_P(((struct korb_hash *)r)->default_proc) &&
                    korb_class_of_class(r) == KORB_VM(c)->hash_class) {
                    /* Subclasses might override #default — skip the fast
                     * path so hash_aref's slow path can dispatch the
                     * subclass method on miss. */
                    ret = korb_hash_aref(c, r, i);
                    goto aref_done;
                }
                if (BUILTIN_TYPE(r) == T_STRING && FIXNUM_P(i)) {
                    /* Fast path only safe for ASCII strings; for any
                     * non-ASCII byte the UTF-8 codepoint walk is needed
                     * (handled by str_aref via the slow path).  Detect
                     * by checking whether any byte has the high bit set —
                     * cheap for typical short strings. */
                    struct korb_string *s = (struct korb_string *)r;
                    bool all_ascii = true;
                    for (long k = 0; k < s->len; k++) {
                        if ((unsigned char)s->ptr[k] >= 0x80) { all_ascii = false; break; }
                    }
                    if (all_ascii) {
                        long pos = FIX2LONG(i);
                        if (pos < 0) pos += s->len;
                        if (pos < 0 || pos >= s->len) { ret = Qnil; goto aref_done; }
                        ret = korb_str_new(c, c->sp_top, s->ptr + pos, 1);
                        goto aref_done;
                    }
                    /* else: fall through to slow path */
                }
            }
        }
        c->last_cfunc_callsite = n;
        ret = UNWRAP(korb_node_aref_slow(c, r, i, arg_index));
      aref_done: ;
    } ARO_ROOT_SCOPE_END(c, rs);
    return RESULT_OK(ret);
}

NODE_DEF
node_aset(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv, NODE *idx, NODE *val, uint32_t arg_index)
{
    /* Reserve 2 slots: sp[0] = r, sp[1] = i.  Zero-fill before
     * bumping c->sp_top.  Body uses sp[0]/sp[1] across EVAL_ARG_UNWRAP(val). */
    sp[0] = 0; sp[1] = 0;
    c->sp_top = sp + 2;
    sp[0] = EVAL_ARG_UNWRAP(c, recv);
    sp[1] = EVAL_ARG_UNWRAP(c, idx);
    VALUE v = EVAL_ARG_UNWRAP(c, val);
    VALUE r = sp[0];
    VALUE i = sp[1];
    c->sp_top = sp;
    if (LIKELY(!SPECIAL_CONST_P(r) && !korb_g_basic_op_redefined)) {
        if (BUILTIN_TYPE(r) == T_ARRAY && FIXNUM_P(i)) {
            CHECK_FROZEN_R(c, r);
            long ii = FIX2LONG(i);
            struct korb_array *aa = (struct korb_array *)r;
            if (ii < 0 && ii + aa->len < 0) {
                VALUE eIE = korb_const_get(KORB_VM(c)->object_class, korb_intern("IndexError"));
                return korb_raise(c, (struct korb_class *)eIE,
                           "index %ld too small for array; minimum: -%ld",
                           ii, aa->len);
            }
            if (ii >= (long)(LONG_MAX / sizeof(VALUE))) {
                VALUE eIE = korb_const_get(KORB_VM(c)->object_class, korb_intern("IndexError"));
                return korb_raise(c, (struct korb_class *)eIE, "index %ld too big", ii);
            }
            korb_ary_aset(r, ii, v); return RESULT_OK(v);
        }
        if (BUILTIN_TYPE(r) == T_HASH) {
            CHECK_FROZEN_R(c, r);
            korb_hash_aset(c, r, i, v); return RESULT_OK(v);
        }
    }
    c->last_cfunc_callsite = n;
    return korb_node_aset_slow(c, r, i, v, arg_index);
}

/* `obj[*args] = v` — splat-key form.  splat must be a node_splat_to_ary
 * (so EA returns Array).  Spread its elements into c->current_frame->fp slots, append
 * v, dispatch []=, return v.  Reserves up to 16 slots at parse time;
 * runtime falls back to xmalloc if more keys. */
NODE_DEF @noinline
node_aset_splat(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv, NODE *splat, NODE *val, uint32_t arg_index)
{
    VALUE r = EVAL_ARG_UNWRAP(c, recv);
    VALUE arr = EVAL_ARG_UNWRAP(c, splat);
    VALUE v = EVAL_ARG_UNWRAP(c, val);
    long n_keys = 0;
    VALUE *argv;
    VALUE inline_argv[17];
    VALUE *heap_argv = NULL;
    if (BUILTIN_TYPE(arr) == T_ARRAY) {
        struct korb_array *aa = (struct korb_array *)arr;
        n_keys = aa->len;
        if (n_keys + 1 <= 17) {
            for (long i = 0; i < n_keys; i++) inline_argv[i] = aa->ptr[i];
            inline_argv[n_keys] = v;
            argv = inline_argv;
        } else {
            heap_argv = korb_xmalloc(sizeof(VALUE) * (size_t)(n_keys + 1));
            for (long i = 0; i < n_keys; i++) heap_argv[i] = aa->ptr[i];
            heap_argv[n_keys] = v;
            argv = heap_argv;
        }
    } else {
        inline_argv[0] = v;
        argv = inline_argv;
    }
    c->last_cfunc_callsite = n;
    korb_dispatch_binop(c, r, id_op_aset, (int)(n_keys + 1), argv);
    if (heap_argv) korb_xfree(heap_argv);
    return RESULT_OK(v);
}

// ---------------- exception ----------------

NODE_DEF @noinline
node_rescue(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *body, NODE *rescue_body, uint32_t exception_lvar_index)
{
retry:;
    VALUE prev_bang = korb_gvar_get(korb_intern("$!"));
    RESULT _br = EVAL_ARG(c, body);
    VALUE v = _br.value;
    if (_br.state == KORB_RAISE && rescue_body) {
        VALUE exc = _br.value;
        c->current_frame->fp[exception_lvar_index] = exc;
        /* $! reflects the current exception throughout the rescue body. */
        korb_gvar_set(korb_intern("$!"), exc);
        RESULT _rr = EVAL_ARG(c, rescue_body);
        v = _rr.value;
        /* If a NEW exception was raised inside the rescue body, link
         * the original (currently-rescued) exception in as #cause —
         * Exception#cause returns it.  Skip when re-raising the same
         * one (`raise` with no args). */
        if (_rr.state == KORB_RAISE && _rr.value &&
            !SPECIAL_CONST_P(_rr.value) && _rr.value != exc) {
            VALUE cur_cause = korb_ivar_get(_rr.value, korb_intern("@cause"));
            if (UNDEF_P(cur_cause) || NIL_P(cur_cause)) {
                korb_ivar_set(_rr.value, korb_intern("@cause"), exc);
            }
        }
        /* `retry` inside the rescue body re-evaluates the begin body. */
        if (_rr.state == KORB_RETRY) {
            korb_gvar_set(korb_intern("$!"), prev_bang);
            goto retry;
        }
        /* If rescue body re-raised (or raised a new exception), $! is
         * the new exception — leave it as-is.  Only restore prev_bang
         * when rescue completed normally. */
        if (_rr.state != KORB_RAISE) {
            korb_gvar_set(korb_intern("$!"), prev_bang);
        }
        /* Propagate non-NORMAL (other than handled RAISE) up. */
        if (_rr.state != KORB_NORMAL) return _rr;
        return RESULT_OK(v);
    }
    /* Body did not raise (or no rescue body): propagate body's RESULT. */
    if (_br.state != KORB_NORMAL) return _br;
    return RESULT_OK(v);
}

NODE_DEF
node_retry(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    return (RESULT){ Qnil, KORB_RETRY };
}

/* `begin body; rescue ...; else else_body; end` — else runs iff body
 * completed without raising and no rescue was triggered.  Same retry
 * semantics as node_rescue. */
NODE_DEF
node_rescue_else(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *body, NODE *rescue_body, NODE *else_body, uint32_t exception_lvar_index)
{
retry_re:;
    bool rescued = false;
    VALUE prev_bang = korb_gvar_get(korb_intern("$!"));
    RESULT _br = EVAL_ARG(c, body);
    VALUE v = _br.value;
    uint8_t cur_state = _br.state;
    if (_br.state == KORB_RAISE && rescue_body) {
        rescued = true;
        VALUE exc = _br.value;
        c->current_frame->fp[exception_lvar_index] = exc;
        korb_gvar_set(korb_intern("$!"), exc);
        RESULT _rr = EVAL_ARG(c, rescue_body);
        v = _rr.value;
        cur_state = _rr.state;
        if (_rr.state == KORB_RAISE && _rr.value &&
            !SPECIAL_CONST_P(_rr.value) && _rr.value != exc) {
            VALUE cur_cause = korb_ivar_get(_rr.value, korb_intern("@cause"));
            if (UNDEF_P(cur_cause) || NIL_P(cur_cause)) {
                korb_ivar_set(_rr.value, korb_intern("@cause"), exc);
            }
        }
        if (_rr.state == KORB_RETRY) {
            korb_gvar_set(korb_intern("$!"), prev_bang);
            goto retry_re;
        }
        if (_rr.state != KORB_RAISE) {
            korb_gvar_set(korb_intern("$!"), prev_bang);
        }
    }
    /* No rescue was triggered → else body replaces the result. */
    if (!rescued && cur_state == KORB_NORMAL && else_body) {
        RESULT _er = EVAL_ARG(c, else_body);
        v = _er.value;
        cur_state = _er.state;
    }
    if (cur_state != KORB_NORMAL) return (RESULT){ v, cur_state };
    return RESULT_OK(v);
}

NODE_DEF
node_redo(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    return (RESULT){ Qnil, KORB_REDO };
}

NODE_DEF
node_raise(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *exc_expr)
{
    VALUE e;
    if (exc_expr) {
        e = EVAL_ARG_UNWRAP(c, exc_expr);
        if (BUILTIN_TYPE(e) == T_STRING) {
            e = korb_exc_new(c, c->sp_top, NULL, korb_str_cstr(e));
        }
    }
    else {
        e = korb_exc_new(c, c->sp_top, NULL, "unhandled exception");
    }
    korb_exc_set_backtrace(c, sp, e, n ? n->head.line : 0);
    /* Exception#cause: when we're already inside a rescue body, $! holds
     * the currently-rescued exception.  Link it as #cause on the new
     * one (skip when re-raising the same exception). */
    if (!SPECIAL_CONST_P(e) && BUILTIN_TYPE(e) == T_OBJECT) {
        VALUE current = korb_gvar_get(korb_intern("$!"));
        if (!NIL_P(current) && current != e) {
            VALUE existing = korb_ivar_get(e, korb_intern("@cause"));
            if (UNDEF_P(existing) || NIL_P(existing)) {
                korb_ivar_set(e, korb_intern("@cause"), current);
            }
        }
    }
    return (RESULT){ e, KORB_RAISE };
}

// ---------------- multi-assign helpers ----------------

/* Multi-assign RHS coercion: CRuby uses to_ary (NOT to_a) for the
 * single-RHS-value case `a, b = obj`.  obj.to_ary must return Array
 * (else TypeError); if obj doesn't respond to to_ary, the RHS is
 * wrapped in [obj]. */
NODE_DEF
node_to_ary_for_mlhs(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *expr)
{
    VALUE v = EVAL_ARG_UNWRAP(c, expr);
    if (BUILTIN_TYPE(v) == T_ARRAY) return RESULT_OK(v);
    if (NIL_P(v)) {
        VALUE a = korb_ary_new_capa(c, c->sp_top, 1);
        korb_ary_push(a, v);
        return RESULT_OK(a);
    }
    /* respond_to?(:to_ary)? */
    RESULT _rt_a = korb_funcall(c, v, korb_intern("respond_to?"), 1,
                            (VALUE[]){ korb_id2sym(korb_intern("to_ary")) });
    VALUE rt = (_rt_a.state == KORB_NORMAL) ? _rt_a.value : Qfalse;
    if (RTEST(rt)) {
        VALUE r = UNWRAP(korb_funcall(c, v, korb_intern("to_ary"), 0, NULL));
        if (NIL_P(r)) {
            /* CRuby: to_ary returning nil wraps in [v]. */
            VALUE a = korb_ary_new_capa(c, c->sp_top, 1);
            korb_ary_push(a, v);
            return RESULT_OK(a);
        }
        if (BUILTIN_TYPE(r) != T_ARRAY) {
            VALUE eT = korb_const_get(KORB_VM(c)->object_class, korb_intern("TypeError"));
            return korb_raise(c, (struct korb_class *)eT,
                       "can't convert to Array (#to_ary gave non-Array)");
        }
        return RESULT_OK(r);
    }
    /* No to_ary: wrap. */
    VALUE a = korb_ary_new_capa(c, c->sp_top, 1);
    korb_ary_push(a, v);
    return RESULT_OK(a);
}

NODE_DEF
node_splat_to_ary(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *expr)
{
    VALUE v = EVAL_ARG_UNWRAP(c, expr);
    /* CRuby splat: nil → [] (no elements). */
    if (NIL_P(v)) return RESULT_OK(korb_ary_new(c, c->sp_top));
    if (BUILTIN_TYPE(v) == T_ARRAY) return RESULT_OK(v);
    if (BUILTIN_TYPE(v) == T_RANGE) {
        /* convert Range to Array for splat */
        struct korb_range *r = (struct korb_range *)v;
        if (FIXNUM_P(r->begin) && FIXNUM_P(r->end)) {
            long b = FIX2LONG(r->begin), e = FIX2LONG(r->end);
            if (r->exclude_end) e--;
            if (e < b) return RESULT_OK(korb_ary_new(c, c->sp_top));
            VALUE a = korb_ary_new_capa(c, c->sp_top, e - b + 1);
            for (long i = b; i <= e; i++) korb_ary_push(a, INT2FIX(i));
            return RESULT_OK(a);
        }
    }
    /* CRuby: if value responds to to_a, call it.  to_a must return Array.
     * For BasicObject (which has no #respond_to?) and similar minimal
     * classes, fall back to a direct method-table lookup so a singleton
     * `def obj.to_a` is still detected. */
    {
        bool has_to_a = false;
        if (!SPECIAL_CONST_P(v)) {
            struct korb_class *vk = (struct korb_class *)((struct RBasic *)v)->klass;
            has_to_a = vk && korb_class_find_method(vk, korb_intern("to_a")) != NULL;
        }
        VALUE rt = Qfalse;
        if (!has_to_a) {
            RESULT _rt_a = korb_funcall(c, v, korb_intern("respond_to?"), 1,
                              (VALUE[]){ korb_id2sym(korb_intern("to_a")) });
            rt = (_rt_a.state == KORB_NORMAL) ? _rt_a.value : Qfalse;
        }
        if (has_to_a || RTEST(rt)) {
            VALUE r = UNWRAP(korb_funcall(c, v, korb_intern("to_a"), 0, NULL));
            if (BUILTIN_TYPE(r) == T_ARRAY) return RESULT_OK(r);
            /* CRuby: if to_a returns nil, treat the value as a single
             * element array.  Other non-Array results are TypeError. */
            if (NIL_P(r)) {
                VALUE a = korb_ary_new_capa(c, c->sp_top, 1);
                korb_ary_push(a, v);
                return RESULT_OK(a);
            }
            VALUE eT = korb_const_get(KORB_VM(c)->object_class, korb_intern("TypeError"));
            return korb_raise(c, (struct korb_class *)eT,
                       "can't convert to Array (returned non-Array)");
        }
    }
    VALUE a = korb_ary_new_capa(c, c->sp_top, 1);
    korb_ary_push(a, v);
    return RESULT_OK(a);
}

NODE_DEF
node_ary_aget(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *ary_node, uint32_t idx)
{
    VALUE a = EVAL_ARG_UNWRAP(c, ary_node);
    if (BUILTIN_TYPE(a) != T_ARRAY) return RESULT_OK(Qnil);
    return RESULT_OK(korb_ary_aref(a, idx));
}

/* For multi-assign splat: ary[ary.len - neg_offset]; nil if out of range. */
NODE_DEF
node_ary_aget_neg(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *ary_node, uint32_t neg_offset)
{
    VALUE a = EVAL_ARG_UNWRAP(c, ary_node);
    if (BUILTIN_TYPE(a) != T_ARRAY) return RESULT_OK(Qnil);
    long len = korb_ary_len(a);
    long idx = len - (long)neg_offset;
    if (idx < 0) return RESULT_OK(Qnil);
    return RESULT_OK(korb_ary_aref(a, idx));
}

/* For multi-assign trailing target with rest: rights[i] = ary[max(lefts + i,
 * len - rights + i)]; nil if past end.  Matches CRuby semantics where
 * rights fill from the left (after lefts) when there aren't enough
 * elements to satisfy lefts + rights.  Without this, `*a, b, c = [1]`
 * would assign c=1, b=nil — CRuby gives b=1, c=nil. */
NODE_DEF
node_ary_aget_right(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *ary_node, uint32_t lefts, uint32_t rights, uint32_t i)
{
    VALUE a = EVAL_ARG_UNWRAP(c, ary_node);
    if (BUILTIN_TYPE(a) != T_ARRAY) return RESULT_OK(Qnil);
    long len = korb_ary_len(a);
    long left_based = (long)lefts + (long)i;
    long right_based = len - (long)rights + (long)i;
    long idx = left_based > right_based ? left_based : right_based;
    if (idx < 0 || idx >= len) return RESULT_OK(Qnil);
    return RESULT_OK(korb_ary_aref(a, idx));
}

/* For multi-assign middle splat: ary[leading .. (len - trailing - 1)] as a new Array. */
NODE_DEF
node_ary_slice_middle(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *ary_node, uint32_t leading, uint32_t trailing)
{
    VALUE a = EVAL_ARG_UNWRAP(c, ary_node);
    if (BUILTIN_TYPE(a) != T_ARRAY) return RESULT_OK(korb_ary_new(c, c->sp_top));
    long len = korb_ary_len(a);
    long start = (long)leading;
    long end_excl = len - (long)trailing;
    if (start > len) start = len;
    if (end_excl > len) end_excl = len;
    if (end_excl < start) end_excl = start;
    long n_take = end_excl - start;
    VALUE r = korb_ary_new_capa(c, c->sp_top, n_take);
    for (long i = 0; i < n_take; i++) korb_ary_push(r, korb_ary_aref(a, start + i));
    return RESULT_OK(r);
}

NODE_DEF
node_str_to_sym(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *str_node)
{
    VALUE s = EVAL_ARG_UNWRAP(c, str_node);
    if (BUILTIN_TYPE(s) != T_STRING) return RESULT_OK(Qnil);
    return RESULT_OK(korb_str_to_sym(s));
}

NODE_DEF
node_super(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t argc, uint32_t arg_index)
{
    /* When `super` runs inside a block body, the lexically-enclosing
     * method drives the super lookup — not whichever method called
     * `yield` to invoke the block.  c->running_block->defining_method
     * was captured at proc creation time. */
    
    struct korb_method *m = (c->running_block && c->running_block->defining_method)
                              ? c->running_block->defining_method
                              : (c->current_frame ? c->current_frame->method : NULL);
    if (!m) {
        return korb_raise(c, NULL, "super called outside of method");
    }
    uint16_t super_skip_n = (c->current_frame && c->current_frame->method == m)
                              ? c->current_frame->super_skip_n : 0;
    /* Walk the receiver's class MRO past the current method's defining
     * class — handles `super` from a prepended module's method.  Pass
     * the calling frame's super_skip_n so that when a module is both
     * prepended and included on the same class, super lands past the
     * right occurrence. */
    struct korb_class *recv_klass = korb_class_of_class(c->current_frame->self);
    extern struct korb_method *korb_class_find_super_method_n(
        const struct korb_class *, const struct korb_class *, ID,
        uint16_t, uint16_t *);
    uint16_t new_skip_n = 0;
    struct korb_method *sm = m->defining_class
        ? korb_class_find_super_method_n(recv_klass, m->defining_class, m->name,
                                          super_skip_n, &new_skip_n)
        : NULL;
    if (!sm) {
        VALUE eNoMethod = korb_const_get(KORB_VM(c)->object_class, korb_intern("NoMethodError"));
        return korb_raise(c, (struct korb_class *)eNoMethod,
                   "super: no superclass method '%s'", korb_id_name(m->name));
    }
    if (sm->type == KORB_METHOD_CFUNC) {
        /* All cfuncs use func_r ABI. */
        VALUE *sp_top = c->sp_top;
        sp_top[0] = c->current_frame->self;
        for (int i = 0; i < (int)argc; i++) sp_top[1 + i] = c->current_frame->fp[arg_index + i];
        return sm->u.cfunc.func_r(c, (int)argc, sp_top + 1 + argc);
    }
    if (sm->type == KORB_METHOD_PROC) {
        /* Super to a define_method'd proc — dispatch via proc_call so
         * its env / closure is preserved. */
        extern RESULT proc_call(CTX *c, int argc, VALUE *sp);
        VALUE *sp = c->sp_top;
        sp[0] = (VALUE)sm->u.proc.proc;
        for (uint32_t i = 0; i < argc; i++) sp[1 + i] = c->current_frame->fp[arg_index + i];
        RESULT _rr = proc_call(c, (int)argc, sp + 1 + argc);
        if (UNLIKELY(_rr.state != KORB_NORMAL)) {
            return _rr;
        }
        return RESULT_OK(_rr.value);
    }
    VALUE *prev_fp = c->current_frame->fp;
    VALUE *prev_sp = c->sp_top;
    VALUE *new_fp = prev_fp + arg_index;
    if (new_fp + sm->u.ast.locals_cnt >= c->stack_end) { return korb_raise(c, NULL, "stack overflow"); }
    { VALUE *_ns = new_fp + sm->u.ast.locals_cnt; if (_ns > c->sp_top) { for (VALUE *p = c->sp_top; p < _ns; p++) *p = Qnil; c->sp_top = _ns; } }
    for (uint32_t i = argc; i < sm->u.ast.locals_cnt; i++) new_fp[i] = Qnil;
    c->current_frame->fp = new_fp;
    /* Push a frame so a nested `super` inside sm sees sm as its method
     * (otherwise current_frame still points to the calling method and
     * super recurses into the same target — stack overflow). */
    struct korb_frame frame;
    frame.prev = c->current_frame;
    frame.method = sm;
    frame.self = c->current_frame->self;
    frame.block = c->current_block;
    frame.caller_node = n;
    frame.fp = new_fp;
    frame.cref = c->current_frame->cref;
    frame.current_class = c->current_frame->current_class;
    frame.current_file = c->current_frame->current_file;
    frame.locals_cnt = sm->u.ast.locals_cnt;
    frame.super_skip_n = new_skip_n;
    frame.last_line = Qnil;
    frame.last_match = Qnil;
    
    frame.caller_running_block = c->running_block;
    c->current_frame = &frame;
    struct korb_proc *prev_running = c->running_block;
    c->running_block = NULL;
    RESULT _bres = EVAL(c, sm->u.ast.body, new_fp + sm->u.ast.locals_cnt);
    c->current_frame = frame.prev;
    c->running_block = prev_running;
    c->current_frame->fp = prev_fp;
    c->sp_top = prev_sp;
    if (_bres.state == KORB_RETURN &&
        (c->state_target_frame == NULL || c->state_target_frame == &frame)) {
        c->state_target_frame = NULL;
        return RESULT_OK(_bres.value);
    }
    return _bres;
}

/* Variant of node_super that accepts an explicit block expression
 * (`super(args, &blk)`).  blk_expr evaluates to a Proc (or nil meaning
 * no block); the chosen block is what the super method's `yield` /
 * `block_given?` sees.  The runtime semantics otherwise match
 * node_super. */
NODE_DEF @noinline
node_super_block(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t argc, uint32_t arg_index, NODE *blk_expr)
{
    
    struct korb_method *m = (c->running_block && c->running_block->defining_method)
                              ? c->running_block->defining_method
                              : (c->current_frame ? c->current_frame->method : NULL);
    if (!m) {
        return korb_raise(c, NULL, "super called outside of method");
    }
    struct korb_class *recv_klass = korb_class_of_class(c->current_frame->self);
    extern struct korb_method *korb_class_find_super_method_n(
        const struct korb_class *, const struct korb_class *, ID,
        uint16_t, uint16_t *);
    uint16_t new_skip_n = 0;
    struct korb_method *sm = m->defining_class
        ? korb_class_find_super_method_n(recv_klass, m->defining_class, m->name,
                                          c->current_frame->super_skip_n, &new_skip_n)
        : NULL;
    if (!sm) {
        VALUE eNoMethod = korb_const_get(KORB_VM(c)->object_class, korb_intern("NoMethodError"));
        return korb_raise(c, (struct korb_class *)eNoMethod,
                   "super: no superclass method '%s'", korb_id_name(m->name));
    }
    /* Evaluate the explicit block.  nil → no block. */
    VALUE blk_v = blk_expr ? EVAL_ARG_UNWRAP(c, blk_expr) : Qnil;
    struct korb_proc *blk_proc = (!NIL_P(blk_v) && !SPECIAL_CONST_P(blk_v) &&
                                   BUILTIN_TYPE(blk_v) == T_PROC)
                                  ? (struct korb_proc *)blk_v : NULL;
    if (sm->type == KORB_METHOD_CFUNC) {
        struct korb_proc *prev_block = c->current_block;
        c->current_block = blk_proc;
        /* All cfuncs use func_r ABI. */
        VALUE *sp_top = c->sp_top;
        sp_top[0] = c->current_frame->self;
        for (int i = 0; i < (int)argc; i++) sp_top[1 + i] = c->current_frame->fp[arg_index + i];
        RESULT _r = sm->u.cfunc.func_r(c, (int)argc, sp_top + 1 + argc);
        c->current_block = prev_block;
        return _r;
    }
    VALUE *prev_fp = c->current_frame->fp;
    VALUE *prev_sp = c->sp_top;
    VALUE *new_fp = prev_fp + arg_index;
    if (new_fp + sm->u.ast.locals_cnt >= c->stack_end) { return korb_raise(c, NULL, "stack overflow"); }
    { VALUE *_ns = new_fp + sm->u.ast.locals_cnt; if (_ns > c->sp_top) { for (VALUE *p = c->sp_top; p < _ns; p++) *p = Qnil; c->sp_top = _ns; } }
    for (uint32_t i = argc; i < sm->u.ast.locals_cnt; i++) new_fp[i] = Qnil;
    c->current_frame->fp = new_fp;
    struct korb_frame frame;
    frame.prev = c->current_frame;
    frame.method = sm;
    frame.self = c->current_frame->self;
    frame.block = blk_proc;  /* explicit block overrides caller's */
    frame.caller_node = n;
    frame.fp = new_fp;
    frame.cref = c->current_frame->cref;
    frame.current_class = c->current_frame->current_class;
    frame.current_file = c->current_frame->current_file;
    frame.locals_cnt = sm->u.ast.locals_cnt;
    frame.super_skip_n = new_skip_n;
    frame.last_line = Qnil;
    frame.last_match = Qnil;
    
    frame.caller_running_block = c->running_block;
    extern uint64_t korb_g_next_frame_id;
    frame.frame_id = ++korb_g_next_frame_id;
    c->current_frame = &frame;
    struct korb_proc *prev_running = c->running_block;
    c->running_block = NULL;
    struct korb_proc *prev_current_block = c->current_block;
    c->current_block = blk_proc;
    /* Bind the &block parameter (if any) to the explicit block — the
     * normal prologue would do this but we skipped it. */
    if (sm->u.ast.block_slot >= 0) {
        new_fp[sm->u.ast.block_slot] = blk_proc ? (VALUE)blk_proc : Qnil;
    }
    RESULT _bres = EVAL(c, sm->u.ast.body, new_fp + sm->u.ast.locals_cnt);
    c->current_block = prev_current_block;
    c->current_frame = frame.prev;
    c->running_block = prev_running;
    c->current_frame->fp = prev_fp;
    c->sp_top = prev_sp;
    if (_bres.state == KORB_RETURN &&
        (c->state_target_frame == NULL || c->state_target_frame == &frame)) {
        c->state_target_frame = NULL;
        return RESULT_OK(_bres.value);
    }
    return _bres;
}

/* `super { block }` (forwarding form): evaluate the block, swap
 * c->current_block, then route through DISPATCH_node_super_forward
 * (a lightweight wrapper around EVAL_node_super_forward that has
 * external linkage so we can call it across the TU boundary).
 * The dispatcher reads from `n` so we synthesize a node-shaped
 * argument by reusing our own node — node_super_forward doesn't
 * read any specific fields, only `c->current_frame`. */
NODE_DEF @noinline
node_super_forward_block(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *blk_expr)
{
    
    VALUE blk_v = blk_expr ? EVAL_ARG_UNWRAP(c, blk_expr) : Qnil;
    struct korb_proc *blk_proc = (!NIL_P(blk_v) && !SPECIAL_CONST_P(blk_v) &&
                                   BUILTIN_TYPE(blk_v) == T_PROC)
                                  ? (struct korb_proc *)blk_v : NULL;
    /* Allocate a synthetic node_super_forward and dispatch into it so
     * we don't have to copy 100 lines of forward logic.  We do this
     * via the public ALLOC_node_super_forward entry. */
    extern struct Node *ALLOC_node_super_forward(void);
    struct Node *fwd = ALLOC_node_super_forward();
    struct korb_proc *prev = c->current_block;
    c->current_block = blk_proc;
    RESULT _fr = ((korb_dispatcher_t)fwd->head.dispatcher)(c, fwd, sp);
    c->current_block = prev;
    return _fr;
}

NODE_DEF
node_super_forward(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    if (!c->current_frame || !c->current_frame->method) {
        return korb_raise(c, NULL, "super called outside of method");
    }
    /* Inside a block body, `super` targets the block's lexical method
     * (captured at proc creation), not the dynamic frame's method. */
    
    struct korb_method *m = (c->running_block && c->running_block->defining_method)
                              ? c->running_block->defining_method
                              : c->current_frame->method;
    struct korb_class *recv_klass = korb_class_of_class(c->current_frame->self);
    extern struct korb_method *korb_class_find_super_method_n(
        const struct korb_class *, const struct korb_class *, ID,
        uint16_t, uint16_t *);
    uint16_t fwd_new_skip_n = 0;
    struct korb_method *sm = m->defining_class
        ? korb_class_find_super_method_n(recv_klass, m->defining_class, m->name,
                                          c->current_frame->super_skip_n, &fwd_new_skip_n)
        : NULL;
    if (!sm) {
        /* CRuby: when super misses (no ancestor method, or blocked by
         * undef), dispatch method_missing on the receiver if it has
         * a user-defined one — receiving the original method's name
         * as the first arg. */
        struct korb_method *mm = korb_class_find_method(recv_klass, korb_intern("method_missing"));
        if (mm && mm->defining_class != KORB_VM(c)->object_class) {
            VALUE name_sym = korb_id2sym(m->name);
            return korb_funcall(c, c->current_frame->self, korb_intern("method_missing"), 1, &name_sym);
        }
        VALUE eNoMethod = korb_const_get(KORB_VM(c)->object_class, korb_intern("NoMethodError"));
        return korb_raise(c, (struct korb_class *)eNoMethod,
                   "super: no superclass method '%s'", m && m->name ? korb_id_name(m->name) : "?");
    }
    /* Forward all positionals: required + optional + (splatted *rest if
     * any) + post + (kwh hash if both this method and the super accept
     * kwargs).  The slot layout is:
     *   [req] [opt] [*rest] [post]   (kwh elsewhere)
     * Where rest_slot, when present, sits at required+optional. */
    VALUE forward_buf[64];
    int argc = 0;
    if (m->type == KORB_METHOD_AST) {
        uint32_t req = m->u.ast.required_params_cnt;
        uint32_t post = m->u.ast.post_params_cnt;
        int rs = m->u.ast.rest_slot;
        /* opt count = total - req - post - (1 if rest else 0).  Don't
         * subtract kwh — kwh_save_slot is outside total_params_cnt. */
        long total = (long)m->u.ast.total_params_cnt;
        long opt = total - (long)req - (long)post - (rs >= 0 ? 1 : 0);
        if (opt < 0) opt = 0;
        for (uint32_t i = 0; i < req && argc < 64; i++) {
            forward_buf[argc++] = c->current_frame->fp[i];
        }
        for (long i = 0; i < opt && argc < 64; i++) {
            forward_buf[argc++] = c->current_frame->fp[req + i];
        }
        if (rs >= 0) {
            VALUE rest = c->current_frame->fp[rs];
            if (!SPECIAL_CONST_P(rest) && BUILTIN_TYPE(rest) == T_ARRAY) {
                struct korb_array *a = (struct korb_array *)rest;
                for (long i = 0; i < a->len && argc < 64; i++) {
                    forward_buf[argc++] = a->ptr[i];
                }
            } else if (!NIL_P(rest)) {
                /* Reassigned rest with a non-Array scalar — CRuby wraps
                 * the value into a single-element array for forwarding. */
                if (argc < 64) forward_buf[argc++] = rest;
            }
        }
        /* Post params live at the very end of the params region. */
        for (uint32_t i = 0; i < post && argc < 64; i++) {
            forward_buf[argc++] = c->current_frame->fp[total - post + i];
        }
        /* If this method captured kwargs and super accepts them, append
         * the kwh hash as the last positional — the super's prologue
         * will peel it back off. */
        if (m->u.ast.kwh_save_slot >= 0 &&
            sm->type == KORB_METHOD_AST && sm->u.ast.kwh_save_slot >= 0 &&
            argc < 64) {
            forward_buf[argc++] = c->current_frame->fp[m->u.ast.kwh_save_slot];
        }
    }
    if (sm->type == KORB_METHOD_CFUNC) {
        /* All cfuncs use func_r ABI: stage [self, args...] above c->sp_top and dispatch. */
        VALUE *sp_top = c->sp_top;
        sp_top[0] = c->current_frame->self;
        for (int i = 0; i < argc; i++) sp_top[1 + i] = forward_buf[i];
        return sm->u.cfunc.func_r(c, argc, sp_top + 1 + argc);
    }
    VALUE *prev_fp = c->current_frame->fp;
    VALUE *prev_sp = c->sp_top;
    VALUE *new_fp = prev_fp + (m->type == KORB_METHOD_AST ? m->u.ast.locals_cnt : 0);
    if (new_fp + sm->u.ast.locals_cnt >= c->stack_end) { return korb_raise(c, NULL, "stack overflow"); }
    /* Peel kwh from forward_buf's tail if the super accepts kwargs. */
    VALUE peeled_kwh = Qundef;
    if (sm->u.ast.kwh_save_slot >= 0) {
        if (argc > 0 && !SPECIAL_CONST_P(forward_buf[argc - 1]) &&
            BUILTIN_TYPE(forward_buf[argc - 1]) == T_HASH) {
            peeled_kwh = forward_buf[argc - 1];
            argc--;
        } else {
            peeled_kwh = korb_hash_new(c, c->sp_top);
        }
    }
    for (int i = 0; i < argc; i++) new_fp[i] = forward_buf[i];
    for (uint32_t i = argc; i < sm->u.ast.locals_cnt; i++) new_fp[i] = Qnil;
    /* If the super method itself has *rest, gather extras and shift
     * post args to their proper slots (right after rest_slot). */
    if (sm->u.ast.rest_slot >= 0) {
        long fixed_pre  = (long)sm->u.ast.required_params_cnt;
        long fixed_post = (long)sm->u.ast.post_params_cnt;
        long total      = (long)sm->u.ast.total_params_cnt;
        long opt        = total - fixed_pre - fixed_post - 1;
        if (opt < 0) opt = 0;
        long after_required = (long)argc - fixed_pre - fixed_post;
        if (after_required < 0) after_required = 0;
        long opt_filled = after_required < opt ? after_required : opt;
        long extra = after_required - opt_filled;
        if (extra < 0) extra = 0;
        /* Post sits at the tail of forward_buf — snapshot before any
         * slot reshuffling. */
        VALUE post_buf[16];
        VALUE *post_ptr = post_buf;
        VALUE *post_heap = NULL;
        if (fixed_post > 16) {
            post_heap = korb_xmalloc(sizeof(VALUE) * fixed_post);
            post_ptr = post_heap;
        }
        for (long i = 0; i < fixed_post; i++) {
            post_ptr[i] = forward_buf[argc - fixed_post + i];
        }
        VALUE rest_arr = korb_ary_new_capa(c, c->sp_top, extra);
        for (long i = 0; i < extra; i++) {
            korb_ary_push(rest_arr, forward_buf[fixed_pre + opt_filled + i]);
        }
        new_fp[sm->u.ast.rest_slot] = rest_arr;
        /* Clear unfilled opt slots so the body's default_init runs. */
        for (long i = opt_filled; i < opt; i++) {
            new_fp[fixed_pre + i] = Qundef;
        }
        for (long i = 0; i < fixed_post; i++) {
            new_fp[sm->u.ast.rest_slot + 1 + i] = post_ptr[i];
        }
        if (post_heap) korb_xfree(post_heap);
    } else if (sm->u.ast.post_params_cnt > 0) {
        /* No rest in super, but post params present.  After the straight
         * copy, post args sit at [argc-post..argc); the body expects
         * them at [total-post..total). */
        long fixed_pre  = (long)sm->u.ast.required_params_cnt;
        long fixed_post = (long)sm->u.ast.post_params_cnt;
        long total = (long)sm->u.ast.total_params_cnt;
        long opt = total - fixed_pre - fixed_post;
        long after_required = (long)argc - fixed_pre - fixed_post;
        if (after_required < 0) after_required = 0;
        long opt_filled = after_required < opt ? after_required : opt;
        VALUE post_buf[16];
        VALUE *post_ptr = post_buf;
        VALUE *post_heap = NULL;
        if (fixed_post > 16) {
            post_heap = korb_xmalloc(sizeof(VALUE) * fixed_post);
            post_ptr = post_heap;
        }
        for (long i = 0; i < fixed_post; i++) {
            post_ptr[i] = forward_buf[fixed_pre + opt_filled + i];
        }
        for (long i = 0; i < fixed_post; i++) {
            new_fp[total - fixed_post + i] = post_ptr[i];
        }
        if (post_heap) korb_xfree(post_heap);
    }
    if (sm->u.ast.kwh_save_slot >= 0 && !UNDEF_P(peeled_kwh)) {
        new_fp[sm->u.ast.kwh_save_slot] = peeled_kwh;
    }
    /* Bind the &block parameter on sm to c->current_block (= the caller's
     * block we're forwarding through super).  Without this, sm's body
     * sees its &block lvar as nil even though c->current_block is set. */
    if (sm->u.ast.block_slot >= 0) {
        new_fp[sm->u.ast.block_slot] = c->current_block ? (VALUE)c->current_block : Qnil;
    }
    c->current_frame->fp = new_fp;
    { VALUE *_ns = c->current_frame->fp + sm->u.ast.locals_cnt; if (_ns > c->sp_top) { for (VALUE *p = c->sp_top; p < _ns; p++) *p = Qnil; c->sp_top = _ns; } }
    /* Push frame so nested super inside sm sees sm's defining_class. */
    struct korb_frame frame;
    frame.prev = c->current_frame;
    frame.method = sm;
    frame.self = c->current_frame->self;
    frame.block = c->current_block;
    frame.caller_node = n;
    frame.fp = new_fp;
    frame.cref = c->current_frame->cref;
    frame.current_class = c->current_frame->current_class;
    frame.current_file = c->current_frame->current_file;
    frame.locals_cnt = sm->u.ast.locals_cnt;
    frame.super_skip_n = fwd_new_skip_n;
    frame.last_line = Qnil;
    frame.last_match = Qnil;
    
    frame.caller_running_block = c->running_block;
    c->current_frame = &frame;
    struct korb_proc *prev_running = c->running_block;
    c->running_block = NULL;
    RESULT _bres = EVAL(c, sm->u.ast.body, new_fp + sm->u.ast.locals_cnt);
    c->current_frame = frame.prev;
    c->running_block = prev_running;
    c->current_frame->fp = prev_fp;
    c->sp_top = prev_sp;
    if (_bres.state == KORB_RETURN &&
        (c->state_target_frame == NULL || c->state_target_frame == &frame)) {
        c->state_target_frame = NULL;
        return RESULT_OK(_bres.value);
    }
    return _bres;
}

NODE_DEF
node_ensure(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *body, NODE *ensure_body)
{
    VALUE prev_bang = korb_gvar_get(korb_intern("$!"));
    /* Run body — capture its RESULT (we'll always run the ensure clause,
     * then propagate the saved state). */
    RESULT _br = EVAL_ARG(c, body);
    if (_br.state == KORB_RAISE) {
        /* $! reflects in-flight exception during ensure body. */
        korb_gvar_set(korb_intern("$!"), _br.value);
    }
    RESULT _er = EVAL_ARG(c, ensure_body);
    /* If the ensure body itself raised / broke / returned, it wins.
     * Otherwise propagate the body's RESULT (including its state). */
    if (_er.state != KORB_NORMAL) {
        return _er;
    }
    /* Body's $! handling: restore if no in-flight raise survives. */
    if (_br.state != KORB_RAISE) {
        korb_gvar_set(korb_intern("$!"), prev_bang);
    }
    return _br;
}

NODE_DEF @noinline
node_singleton_def(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *body, uint32_t required_cnt, uint32_t total_cnt, int32_t rest_slot, int32_t block_slot, uint32_t locals_cnt)
{
    /* def self.foo — install on c->current_frame->self's singleton class. */
    struct korb_class *target;
    if (BUILTIN_TYPE(c->current_frame->self) == T_CLASS || BUILTIN_TYPE(c->current_frame->self) == T_MODULE) {
        if (korb_obj_frozen_p(c->current_frame->self)) {
            VALUE eF = korb_const_get(KORB_VM(c)->object_class, korb_intern("FrozenError"));
            return korb_raise(c, (struct korb_class *)eF,
                       "can't modify frozen %s",
                       ((struct korb_class *)c->current_frame->self)->name
                         ? korb_id_name(((struct korb_class *)c->current_frame->self)->name) : "Class");
        }
        target = korb_singleton_class_of(c, c->sp_top, (struct korb_class *)c->current_frame->self);
    } else if (!SPECIAL_CONST_P(c->current_frame->self) && BUILTIN_TYPE(c->current_frame->self) == T_OBJECT) {
        /* Top-level `def self.foo`: target the receiver's singleton
         * class.  CRuby installs on main's singleton at top level. */
        if (korb_obj_frozen_p(c->current_frame->self)) {
            VALUE eF = korb_const_get(KORB_VM(c)->object_class, korb_intern("FrozenError"));
            return korb_raise(c, (struct korb_class *)eF, "can't modify frozen object");
        }
        extern struct korb_class *korb_singleton_class_of_value(CTX *c, VALUE *sp, VALUE v);
        struct korb_class *meta = korb_singleton_class_of_value(c, sp, c->current_frame->self);
        target = meta ? meta : korb_class_of_class(c->current_frame->self);
    } else {
        return korb_raise(c, NULL, "def self.* outside of class/module");
    }
    korb_class_add_method_ast_full_cref(c, target, name, body, required_cnt, total_cnt, rest_slot, locals_cnt, c->current_frame->cref);
    if (block_slot >= 0) korb_class_set_method_block_slot(target, name, block_slot);
    ID *names = korb_body_local_names(body);
    if (names) korb_class_set_method_local_names(target, name, names);
    {
        int *phs = korb_body_param_holder_slots(body);
        if (phs) korb_class_set_method_param_holder_slots(target, name, phs);
    }
    return RESULT_OK(korb_id2sym(name));
}

/* `def self.foo(a, *r, b, c)` — like node_singleton_def but additionally
 * records post_params_cnt so the prologue routes args correctly. */
NODE_DEF @noinline
node_singleton_def_post(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *body, uint32_t required_cnt, uint32_t total_cnt, int32_t rest_slot, int32_t block_slot, uint32_t locals_cnt, uint32_t post_cnt)
{
    struct korb_class *target;
    if (BUILTIN_TYPE(c->current_frame->self) == T_CLASS || BUILTIN_TYPE(c->current_frame->self) == T_MODULE) {
        target = korb_singleton_class_of(c, c->sp_top, (struct korb_class *)c->current_frame->self);
    } else if (!SPECIAL_CONST_P(c->current_frame->self) && BUILTIN_TYPE(c->current_frame->self) == T_OBJECT) {
        extern struct korb_class *korb_singleton_class_of_value(CTX *c, VALUE *sp, VALUE v);
        struct korb_class *meta = korb_singleton_class_of_value(c, sp, c->current_frame->self);
        target = meta ? meta : korb_class_of_class(c->current_frame->self);
    } else {
        return korb_raise(c, NULL, "def self.* outside of class/module");
    }
    korb_class_add_method_ast_full_cref(c, target, name, body, required_cnt, total_cnt, rest_slot, locals_cnt, c->current_frame->cref);
    if (block_slot >= 0) korb_class_set_method_block_slot(target, name, block_slot);
    if (post_cnt > 0)    korb_class_set_method_post_params_cnt(target, name, post_cnt);
    ID *names = korb_body_local_names(body);
    if (names) korb_class_set_method_local_names(target, name, names);
    {
        int *phs = korb_body_param_holder_slots(body);
        if (phs) korb_class_set_method_param_holder_slots(target, name, phs);
    }
    return RESULT_OK(korb_id2sym(name));
}

NODE_DEF @noinline
node_obj_singleton_def(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv_expr, ID name, NODE *body, uint32_t required_cnt, uint32_t total_cnt, int32_t rest_slot, int32_t block_slot, uint32_t locals_cnt)
{
    /* def obj.foo — install on the value of `recv_expr`'s singleton
     * class.  For T_OBJECT we lazily allocate one; for T_CLASS /
     * T_MODULE we use the metaclass via korb_singleton_class_of.
     * Pin recv at sp[0] across korb_const_get / korb_intern /
     * korb_raise / korb_singleton_class_of_value — all GC sites. */
    extern struct korb_class *korb_singleton_class_of_value(CTX *c, VALUE *sp, VALUE v);
    sp[0] = EVAL_ARG_UNWRAP(c, recv_expr);
    c->sp_top = sp + 1;
    if (!SPECIAL_CONST_P(sp[0]) && korb_obj_frozen_p(sp[0])) {
        VALUE eF = korb_const_get(KORB_VM(c)->object_class, korb_intern("FrozenError"));
        const char *kind = "object";
        if (BUILTIN_TYPE(sp[0]) == T_CLASS) kind = "Class";
        else if (BUILTIN_TYPE(sp[0]) == T_MODULE) kind = "Module";
        RESULT _e = korb_raise(c, (struct korb_class *)eF, "can't modify frozen %s", kind);
        c->sp_top = sp;
        return _e;
    }
    struct korb_class *meta = korb_singleton_class_of_value(c, sp, sp[0]);
    if (!meta) {
        RESULT _e = korb_raise(c, NULL, "cannot define singleton method on this value");
        c->sp_top = sp;
        return _e;
    }
    korb_class_add_method_ast_full_cref(c, meta, name, body, required_cnt, total_cnt, rest_slot, locals_cnt, c->current_frame->cref);
    if (block_slot >= 0) korb_class_set_method_block_slot(meta, name, block_slot);
    ID *names = korb_body_local_names(body);
    if (names) korb_class_set_method_local_names(meta, name, names);
    int *phs = korb_body_param_holder_slots(body);
    if (phs) korb_class_set_method_param_holder_slots(meta, name, phs);
    c->sp_top = sp;
    return RESULT_OK(korb_id2sym(name));
}

/* `def obj.foo(a, *r, b, c)` — variant with post_params_cnt. */
NODE_DEF @noinline
node_obj_singleton_def_post(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv_expr, ID name, NODE *body, uint32_t required_cnt, uint32_t total_cnt, int32_t rest_slot, int32_t block_slot, uint32_t locals_cnt, uint32_t post_cnt)
{
    extern struct korb_class *korb_singleton_class_of_value(CTX *c, VALUE *sp, VALUE v);
    VALUE recv = EVAL_ARG_UNWRAP(c, recv_expr);
    if (!SPECIAL_CONST_P(recv) && korb_obj_frozen_p(recv)) {
        VALUE eF = korb_const_get(KORB_VM(c)->object_class, korb_intern("FrozenError"));
        const char *kind = "object";
        if (BUILTIN_TYPE(recv) == T_CLASS) kind = "Class";
        else if (BUILTIN_TYPE(recv) == T_MODULE) kind = "Module";
        return korb_raise(c, (struct korb_class *)eF, "can't modify frozen %s", kind);
    }
    struct korb_class *meta = korb_singleton_class_of_value(c, sp, recv);
    if (!meta) {
        return korb_raise(c, NULL, "cannot define singleton method on this value");
    }
    korb_class_add_method_ast_full_cref(c, meta, name, body, required_cnt, total_cnt, rest_slot, locals_cnt, c->current_frame->cref);
    if (block_slot >= 0) korb_class_set_method_block_slot(meta, name, block_slot);
    if (post_cnt > 0)    korb_class_set_method_post_params_cnt(meta, name, post_cnt);
    ID *names = korb_body_local_names(body);
    if (names) korb_class_set_method_local_names(meta, name, names);
    {
        int *phs = korb_body_param_holder_slots(body);
        if (phs) korb_class_set_method_param_holder_slots(meta, name, phs);
    }
    return RESULT_OK(korb_id2sym(name));
}

NODE_DEF @noinline
node_singleton_class_body(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv_expr, NODE *body)
{
    /* `class << obj; body; end` — evaluate body with self set to obj's
     * singleton class so `def name` lands there. */
    extern struct korb_class *korb_singleton_class_of_value(CTX *c, VALUE *sp, VALUE v);
    VALUE recv = EVAL_ARG_UNWRAP(c, recv_expr);
    struct korb_class *meta = korb_singleton_class_of_value(c, sp, recv);
    if (!meta) {
        /* Numeric, Symbol etc. — CRuby raises TypeError "no class to make
         * a singleton class for ..." */
        return korb_raise_type_error(c, "no class to make singleton class for %s",
                              korb_id_name(korb_class_of_class(recv)->name));
    }
    VALUE prev_self = c->current_frame->self;
    struct korb_class *prev_class = c->current_frame->current_class;
    struct korb_cref *prev_cref = c->current_frame->cref;
    struct korb_cref new_cref = { .klass = meta, .prev = c->current_frame->cref };
    c->current_frame->self = (VALUE)meta;
    c->current_frame->current_class = meta;
    c->current_frame->cref = &new_cref;
    VALUE r = EVAL_ARG_UNWRAP(c, body);
    c->current_frame->self = prev_self;
    c->current_frame->current_class = prev_class;
    c->current_frame->cref = prev_cref;
    return RESULT_OK(r);
}

NODE_DEF
node_default_init(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t slot, NODE *default_expr)
{
    /* If c->current_frame->fp[slot] is Qundef (= caller did not supply this optional arg),
     * evaluate the default and store it.  Pre-init the slot to Qnil so a
     * circular self-reference (`|a=a|`) sees nil instead of Qundef leaking
     * into user code (CRuby 3.4+ semantics). */
    if (c->current_frame->fp[slot] == Qundef) {
        c->current_frame->fp[slot] = Qnil;
        VALUE v = EVAL_ARG_UNWRAP(c, default_expr);
        c->current_frame->fp[slot] = v;
    }
    return RESULT_OK(Qnil);
}

NODE_DEF @noinline
node_def_full(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *body, uint32_t required_cnt, uint32_t total_cnt, int32_t rest_slot, int32_t block_slot, uint32_t locals_cnt)
{
    struct korb_class *target = korb_host_class(c);
    /* CRuby: top-level `def` (the implicit "main" lexical scope) installs
     * the method as private on Object by default.  Top-level here means:
     * cref is just [Object] AND NOT inside a method body.  But the user
     * may have called `public` / `private` / `module_function` to change
     * the local visibility — those modify Object's default_visibility,
     * so we honor that: only force private when default_visibility is
     * still the initial PUBLIC and we're top-level.
     *
     * This relies on a distinction we don't currently track between
     * "PUBLIC by default" and "PUBLIC because user said public".  As a
     * compromise, we use a per-frame "top_level_explicit_public" flag
     * threaded via Object's default_visibility being set ABOVE PUBLIC
     * (we encode "explicit PUBLIC at top-level" by toggling). */
    /* Special methods that are private regardless of where defined. */
    bool always_private =
        (name == korb_intern("initialize") ||
         name == korb_intern("initialize_copy") ||
         name == korb_intern("initialize_dup") ||
         name == korb_intern("initialize_clone") ||
         name == korb_intern("respond_to_missing?"));
    bool top_level = (c->current_frame->cref && c->current_frame->cref->klass == KORB_VM(c)->object_class &&
                      c->current_frame->cref->prev == NULL && target == KORB_VM(c)->object_class &&
                      c->current_frame == NULL);
    /* g_top_level_default_private toggles when `private`/`public` is
     * called at top-level.  Initial state: true (private by default). */
    extern bool g_top_level_default_private;
    korb_class_add_method_ast_full_cref(c, target, name, body, required_cnt, total_cnt, rest_slot, locals_cnt, c->current_frame->cref);
    if (always_private || (top_level && g_top_level_default_private)) {
        struct korb_method *m = korb_class_find_method(target, name);
        if (m) m->visibility = KORB_VIS_PRIVATE;
    }
    if (block_slot >= 0) korb_class_set_method_block_slot(target, name, block_slot);
    /* If parse.c stashed a slot→name table for this body, attach it so
     * Kernel#binding can iterate the live frame to emit lvars. */
    ID *names = korb_body_local_names(body);
    if (names) korb_class_set_method_local_names(target, name, names);
    {
        int *phs = korb_body_param_holder_slots(body);
        if (phs) korb_class_set_method_param_holder_slots(target, name, phs);
    }
    /* If user redefined something on a basic class, EVAL_node_* fast
     * paths must stop short-circuiting through C-side arithmetic. */
    korb_check_basic_op_redef(target, name);
    /* Fire `method_added` (a class method on `target`) so userland
     * can react to method definitions.  Skip silently when the class
     * doesn't define the hook. */
    {
        struct korb_class *meta = korb_class_of_class((VALUE)target);
        if (meta && korb_class_find_method(meta, korb_intern("method_added"))) {
            VALUE name_sym = korb_id2sym(name);
            korb_funcall(c, (VALUE)target, korb_intern("method_added"), 1, &name_sym);
        }
    }
    return RESULT_OK(korb_id2sym(name));
}

/* Like node_def_full but with post_params_cnt for `def f(a, *r, b, c)`. */
NODE_DEF @noinline
node_def_post(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, NODE *body, uint32_t required_cnt, uint32_t total_cnt, int32_t rest_slot, int32_t block_slot, uint32_t locals_cnt, uint32_t post_cnt)
{
    struct korb_class *target = korb_host_class(c);
    korb_class_add_method_ast_full_cref(c, target, name, body, required_cnt, total_cnt, rest_slot, locals_cnt, c->current_frame->cref);
    if (block_slot >= 0) korb_class_set_method_block_slot(target, name, block_slot);
    if (post_cnt > 0)    korb_class_set_method_post_params_cnt(target, name, post_cnt);
    ID *names = korb_body_local_names(body);
    if (names) korb_class_set_method_local_names(target, name, names);
    {
        int *phs = korb_body_param_holder_slots(body);
        if (phs) korb_class_set_method_param_holder_slots(target, name, phs);
    }
    korb_check_basic_op_redef(target, name);
    return RESULT_OK(korb_id2sym(name));
}

/* Set the kwh_save_slot on the most-recently-registered method `name`
 * on the current cref/class.  Emitted right after node_def_full when
 * the def declares keyword params. */
NODE_DEF @noinline
node_set_kwh_save_slot(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, ID name, int32_t slot)
{
    struct korb_class *target = korb_host_class(c);
    korb_class_set_method_kwh_save_slot(target, name, (int)slot);
    return RESULT_OK(Qnil);
}

/* `alias new_name old_name` — keyword form, lexical scope.  Goes
 * directly to korb_class_alias_method on the cref's class so a
 * redefinition of Module#alias_method has no effect (`alias` is a
 * keyword, not a method call). */
NODE_DEF @noinline
node_alias_method(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *new_name, NODE *old_name)
{
    VALUE new_v = EVAL_ARG_UNWRAP(c, new_name);
    VALUE old_v = EVAL_ARG_UNWRAP(c, old_name);
    if (!SYMBOL_P(new_v) || !SYMBOL_P(old_v)) {
        return korb_raise(c, NULL, "alias requires symbol names");
    }
    ID new_id = korb_sym2id(new_v);
    ID old_id = korb_sym2id(old_v);
    struct korb_class *target = korb_host_class(c);
    struct korb_method *m = korb_class_find_method(target, old_id);
    if (!m) {
        VALUE eN = korb_const_get(KORB_VM(c)->object_class, korb_intern("NameError"));
        return korb_raise(c, (struct korb_class *)eN,
                   "undefined method '%s' for %s",
                   korb_id_name(old_id),
                   target->name ? korb_id_name(target->name) : "?");
    }
    korb_class_alias_method(target, new_id, m);
    return RESULT_OK(korb_id2sym(new_id));
}

NODE_DEF
node_ary_concat(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG_UNWRAP(c, lhs);
    VALUE r = EVAL_ARG_UNWRAP(c, rhs);
    if (BUILTIN_TYPE(l) != T_ARRAY) return RESULT_OK(l);
    if (BUILTIN_TYPE(r) != T_ARRAY) return RESULT_OK(l);
    struct korb_array *la = (struct korb_array *)l;
    struct korb_array *ra = (struct korb_array *)r;
    VALUE out = korb_ary_new_capa(c, c->sp_top, la->len + ra->len);
    for (long i = 0; i < la->len; i++) korb_ary_push(out, la->ptr[i]);
    for (long i = 0; i < ra->len; i++) korb_ary_push(out, ra->ptr[i]);
    return RESULT_OK(out);
}

NODE_DEF
node_apply_call(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *recv, ID name, NODE *args_node, uint32_t arg_index, NODE *blk, uint32_t is_method, struct method_cache *mc)
{
    /* Reserve 3 slots: sp[0] = recv, sp[1] = args, sp[2] = block.
     * Zero-fill before bumping c->sp_top so visit_roots doesn't see
     * stale heap-ptr leftover.  Each EA can fire many GCs under
     * STRESS+PURGE — slots pin the values across the cascade. */
    sp[0] = 0; sp[1] = 0; sp[2] = 0;
    c->sp_top = sp + 3;
    sp[0] = is_method ? EVAL_ARG_UNWRAP(c, recv) : c->current_frame->self;
    sp[1] = EVAL_ARG_UNWRAP(c, args_node);
    long n_args = 0;
    if (BUILTIN_TYPE(sp[1]) == T_ARRAY) {
        struct korb_array *aa = (struct korb_array *)sp[1];
        n_args = aa->len;
        for (long i = 0; i < n_args; i++) {
            c->current_frame->fp[arg_index + i] = aa->ptr[i];
        }
    }
    sp[2] = blk ? EVAL_ARG_UNWRAP(c, blk) : Qnil;
    VALUE r = sp[0];
    struct korb_proc *block = (BUILTIN_TYPE(sp[2]) == T_PROC) ? (struct korb_proc *)sp[2] : NULL;
    RESULT _ret = korb_dispatch_call(c, n, r, name, (uint32_t)n_args, arg_index, block, mc);
    c->sp_top = sp;
    return _ret;
}

NODE_DEF @noinline
node_class_def_in_strict(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *parent_expr, ID name, NODE *super_expr, NODE *body, uint32_t enforce_super_match)
{
    /* Pin parent_v / super / klass across korb_const_get / korb_class_new /
     * korb_const_set — same root-cause as node_class_def_in. */
    VALUE r = Qnil;
    ARO_ROOT_SCOPE_START(c, rs, 3) {
        rs[0] = EVAL_ARG_UNWRAP(c, parent_expr);  /* parent_v */
        if (BUILTIN_TYPE(rs[0]) != T_CLASS && BUILTIN_TYPE(rs[0]) != T_MODULE) {
            RESULT _e = korb_raise_type_error(c, "%s is not a class/module",
                                  korb_id_name(korb_class_of_class(rs[0])->name));
            ARO_ROOT_SCOPE_CANCEL(c, rs);
            return _e;
        }
        {
            extern bool korb_const_is_private(const struct korb_class *, ID);
            if (korb_const_is_private((struct korb_class *)rs[0], name)) {
                bool in_scope = false;
                for (struct korb_cref *cr = c->current_frame->cref; cr; cr = cr->prev) {
                    if (cr->klass == KORB_VM(c)->object_class && cr->prev == NULL) continue;
                    if (cr->klass == (struct korb_class *)rs[0]) { in_scope = true; break; }
                }
                if (!in_scope) {
                    VALUE eName = korb_const_get(KORB_VM(c)->object_class, korb_intern("NameError"));
                    struct korb_class *parent = (struct korb_class *)rs[0];
                    RESULT _e = korb_raise(c, (struct korb_class *)eName,
                               "private constant %s::%s referenced",
                               parent->name ? korb_id_name(parent->name) : "?",
                               korb_id_name(name));

                    ARO_ROOT_SCOPE_CANCEL(c, rs);

                    return _e;
                }
            }
        }
        rs[1] = (VALUE)KORB_VM(c)->object_class;  /* super */
        if (super_expr) {
            VALUE sv = EVAL_ARG_UNWRAP(c, super_expr);
            if (BUILTIN_TYPE(sv) == T_CLASS) {
                if (((struct korb_class *)sv)->basic.head.flags & FL_SINGLETON) {
                    RESULT _e = korb_raise_type_error(c, "can't make subclass of singleton class");

                    ARO_ROOT_SCOPE_CANCEL(c, rs);

                    return _e;
                }
                rs[1] = sv;
            } else if (enforce_super_match) {
                RESULT _e = korb_raise_type_error(c, "superclass must be a Class (%s given)",
                                      korb_id_name(korb_class_of_class(sv)->name));
                ARO_ROOT_SCOPE_CANCEL(c, rs);
                return _e;
            }
        }
        VALUE existing = korb_const_get((struct korb_class *)rs[0], name);
        if (!UNDEF_P(existing) && BUILTIN_TYPE(existing) == T_CLASS) {
            rs[2] = existing;
            if (enforce_super_match && ((struct korb_class *)rs[2])->super != (struct korb_class *)rs[1]) {
                RESULT _e = korb_raise_type_error(c, "superclass mismatch for class %s",
                                      korb_id_name(name));

                ARO_ROOT_SCOPE_CANCEL(c, rs);

                return _e;
            }
        } else if (!UNDEF_P(existing) && enforce_super_match) {
            RESULT _e = korb_raise_type_error(c, "%s is not a class", korb_id_name(name));

            ARO_ROOT_SCOPE_CANCEL(c, rs);

            return _e;
        } else {
            rs[2] = (VALUE)korb_class_new(c, c->sp_top, name, (struct korb_class *)rs[1], T_OBJECT);
            ((struct korb_class *)rs[2])->name = 0;
            korb_const_set((struct korb_class *)rs[0], name, rs[2]);
        }
        struct korb_class *klass = (struct korb_class *)rs[2];
        struct korb_class *prev_class = c->current_frame->current_class;
        VALUE prev_self = c->current_frame->self;
        struct korb_cref new_cref = { .klass = klass, .prev = c->current_frame->cref };
        struct korb_cref *prev_cref = c->current_frame->cref;
        c->current_frame->current_class = klass;
        c->current_frame->self = (VALUE)klass;
        c->current_frame->cref = &new_cref;
        VALUE *fp_lo = c->current_frame->fp; VALUE *fp_hi = c->sp_top;
        r = body ? EVAL_ARG_UNWRAP(c, body) : Qnil;
        /* Read forwarded klass from frame->self BEFORE restoring it —
         * visit_roots tracks current_frame->self through body's GCs. */
        VALUE klass_tracked = c->current_frame->self;
        c->current_frame->current_class = prev_class;
        c->current_frame->self = prev_self;
        c->current_frame->cref = prev_cref;
        korb_proc_snapshot_env_if_in_frame(klass_tracked, fp_lo, fp_hi + 1024);
    } ARO_ROOT_SCOPE_END(c, rs);
    return RESULT_OK(r);
}

NODE_DEF @noinline
node_class_def_in(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *parent_expr, ID name, NODE *super_expr, NODE *body)
{
    /* Non-strict variant: same shape as _strict with enforce_super_match
     * = 0.  Inlined here to avoid the per-arg dispatcher plumbing the
     * generated EVAL wrappers expect.
     *
     * Pin parent_v / super / klass across korb_const_get / korb_class_new /
     * korb_const_set — each fires GC under STRESS+PURGE and a stale C-local
     * would crash inside korb_const_set(stale_klass, ...). */
    VALUE r = Qnil;
    ARO_ROOT_SCOPE_START(c, rs, 3) {
        rs[0] = EVAL_ARG_UNWRAP(c, parent_expr);  /* parent_v */
        if (BUILTIN_TYPE(rs[0]) != T_CLASS && BUILTIN_TYPE(rs[0]) != T_MODULE) {
            RESULT _e = korb_raise_type_error(c, "%s is not a class/module",
                                  korb_id_name(korb_class_of_class(rs[0])->name));
            ARO_ROOT_SCOPE_CANCEL(c, rs);
            return _e;
        }
        {
            extern bool korb_const_is_private(const struct korb_class *, ID);
            if (korb_const_is_private((struct korb_class *)rs[0], name)) {
                bool in_scope = false;
                for (struct korb_cref *cr = c->current_frame->cref; cr; cr = cr->prev) {
                    if (cr->klass == KORB_VM(c)->object_class && cr->prev == NULL) continue;
                    if (cr->klass == (struct korb_class *)rs[0]) { in_scope = true; break; }
                }
                if (!in_scope) {
                    VALUE eName = korb_const_get(KORB_VM(c)->object_class, korb_intern("NameError"));
                    struct korb_class *parent = (struct korb_class *)rs[0];
                    RESULT _e = korb_raise(c, (struct korb_class *)eName,
                               "private constant %s::%s referenced",
                               parent->name ? korb_id_name(parent->name) : "?",
                               korb_id_name(name));

                    ARO_ROOT_SCOPE_CANCEL(c, rs);

                    return _e;
                }
            }
        }
        rs[1] = (VALUE)KORB_VM(c)->object_class;  /* super */
        if (super_expr) {
            VALUE sv = EVAL_ARG_UNWRAP(c, super_expr);
            if (BUILTIN_TYPE(sv) == T_CLASS) rs[1] = sv;
        }
        VALUE existing = korb_const_get((struct korb_class *)rs[0], name);
        if (!UNDEF_P(existing) && BUILTIN_TYPE(existing) == T_CLASS) {
            rs[2] = existing;
        } else {
            rs[2] = (VALUE)korb_class_new(c, c->sp_top, name, (struct korb_class *)rs[1], T_OBJECT);
            ((struct korb_class *)rs[2])->name = 0;
            korb_const_set((struct korb_class *)rs[0], name, rs[2]);
        }
        struct korb_class *klass = (struct korb_class *)rs[2];
        struct korb_class *prev_class = c->current_frame->current_class;
        VALUE prev_self = c->current_frame->self;
        struct korb_cref new_cref = { .klass = klass, .prev = c->current_frame->cref };
        struct korb_cref *prev_cref = c->current_frame->cref;
        c->current_frame->current_class = klass;
        c->current_frame->self = (VALUE)klass;
        c->current_frame->cref = &new_cref;
        VALUE *fp_lo = c->current_frame->fp; VALUE *fp_hi = c->sp_top;
        r = body ? EVAL_ARG_UNWRAP(c, body) : Qnil;
        /* Read forwarded klass from frame->self BEFORE restoring it. */
        VALUE klass_tracked = c->current_frame->self;
        c->current_frame->current_class = prev_class;
        c->current_frame->self = prev_self;
        c->current_frame->cref = prev_cref;
        korb_proc_snapshot_env_if_in_frame(klass_tracked, fp_lo, fp_hi + 1024);
    } ARO_ROOT_SCOPE_END(c, rs);
    return RESULT_OK(r);
}

NODE_DEF @noinline
node_module_def_in(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *parent_expr, ID name, NODE *body)
{
    /* Pin parent_v at sp[0] (= survives korb_const_get / korb_module_new /
     * korb_const_set under STRESS+PURGE).  mod also pinned at sp[1] so
     * subsequent allocs (= synthetic frame, body EVAL) keep it fresh. */
    sp[0] = 0; sp[1] = 0;
    c->sp_top = sp + 2;
    sp[0] = EVAL_ARG_UNWRAP(c, parent_expr);
    if (BUILTIN_TYPE(sp[0]) != T_CLASS && BUILTIN_TYPE(sp[0]) != T_MODULE) {
        RESULT _e = korb_raise_type_error(c, "%s is not a class/module",
                              korb_id_name(korb_class_of_class(sp[0])->name));
        c->sp_top = sp;
        return _e;
    }
    {
        extern bool korb_const_is_private(const struct korb_class *, ID);
        if (korb_const_is_private((struct korb_class *)sp[0], name)) {
            bool in_scope = false;
            for (struct korb_cref *cr = c->current_frame->cref; cr; cr = cr->prev) {
                if (cr->klass == KORB_VM(c)->object_class && cr->prev == NULL) continue;
                if (cr->klass == (struct korb_class *)sp[0]) { in_scope = true; break; }
            }
            if (!in_scope) {
                VALUE eName = korb_const_get(KORB_VM(c)->object_class, korb_intern("NameError"));
                struct korb_class *p = (struct korb_class *)sp[0];
                RESULT _e = korb_raise(c, (struct korb_class *)eName,
                           "private constant %s::%s referenced",
                           p->name ? korb_id_name(p->name) : "?",
                           korb_id_name(name));
                c->sp_top = sp;
                return _e;
            }
        }
    }
    VALUE existing = korb_const_get((struct korb_class *)sp[0], name);
    if (!UNDEF_P(existing) && BUILTIN_TYPE(existing) == T_MODULE) {
        sp[1] = existing;
    } else if (!UNDEF_P(existing)) {
        RESULT _e = korb_raise_type_error(c, "%s is not a module",
                              korb_id_name(name));
        c->sp_top = sp;
        return _e;
    } else {
        sp[1] = (VALUE)korb_module_new(c, c->sp_top, name);
        ((struct korb_class *)sp[1])->name = 0;
        korb_const_set((struct korb_class *)sp[0], name, sp[1]);
    }
    struct korb_class *prev_class = c->current_frame->current_class;
    VALUE prev_self = c->current_frame->self;
    struct korb_cref new_cref = { .klass = (struct korb_class *)sp[1], .prev = c->current_frame->cref };
    struct korb_cref *prev_cref = c->current_frame->cref;
    c->current_frame->current_class = (struct korb_class *)sp[1];
    c->current_frame->self = sp[1];
    c->current_frame->cref = &new_cref;
    VALUE *fp_lo = c->current_frame->fp; VALUE *fp_hi = c->sp_top;
    VALUE r = body ? EVAL_ARG_UNWRAP(c, body) : Qnil;
    /* Read forwarded value from frame->self BEFORE restoring it. */
    VALUE singleton_tracked = c->current_frame->self;
    c->current_frame->current_class = prev_class;
    c->current_frame->self = prev_self;
    c->current_frame->cref = prev_cref;
    korb_proc_snapshot_env_if_in_frame(singleton_tracked, fp_lo, fp_hi + 1024);
    c->sp_top = sp;
    return RESULT_OK(r);
}

NODE_DEF
node_do_while(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *cond, NODE *body)
{
    /* begin; body; end while cond */
    do {
    redo_do_while:
        {
            RESULT _br = EVAL_ARG(c, body);
            if (UNLIKELY(_br.state != KORB_NORMAL)) {
                if (_br.state == KORB_BREAK && c->state_target_frame == NULL) {
                    return RESULT_OK(_br.value);
                }
                if (_br.state == KORB_NEXT) {
                    /* go back to cond check */
                }
                else if (_br.state == KORB_REDO) {
                    goto redo_do_while;
                }
                else return _br;
            }
        }
        VALUE v = EVAL_ARG_UNWRAP(c, cond);
        if (!RTEST(v)) break;
    } while (1);
    return RESULT_OK(Qnil);
}

NODE_DEF
node_do_until(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *cond, NODE *body)
{
    do {
    redo_do_until:
        {
            RESULT _br = EVAL_ARG(c, body);
            if (UNLIKELY(_br.state != KORB_NORMAL)) {
                if (_br.state == KORB_BREAK && c->state_target_frame == NULL) {
                    return RESULT_OK(_br.value);
                }
                if (_br.state == KORB_NEXT) {
                    /* go back to cond check */
                }
                else if (_br.state == KORB_REDO) {
                    goto redo_do_until;
                }
                else return _br;
            }
        }
        VALUE v = EVAL_ARG_UNWRAP(c, cond);
        if (RTEST(v)) break;
    } while (1);
    return RESULT_OK(Qnil);
}
