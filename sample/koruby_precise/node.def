// koruby_precise v2 — node.def (M0 node set).
//
// ABI (docs/v2_design.md): every dispatcher is
//     RESULT DISPATCH_xxx(CTX *c, NODE *n, VALUE *slots)
// where `slots` is the first free slot (top).  Staged @child results live
// at negative offsets below it; korb_alloc is the only slots_top publish
// point.  @child forms: `VALUE_REF x@child` = staged + rooted,
// `VALUE x@child` = register (last child only).
//
// Lazy operands (condition branches, loop bodies, &&/|| rhs) stay NODE *
// and are evaluated via EVAL_ARG inside the body.

// ---- literals --------------------------------------------------------------

// Immediate literal (fixnum / symbol / nil / true / false).  Heap literals
// (String) have their own node — a VALUE operand must stay immediate so the
// SD bake (hex literal) is valid across runs.
NODE_DEF @nogc
node_lit(CTX *c, NODE *n, VALUE *slots, VALUE v)
{
    (void)c; (void)n; (void)slots;
    return RESULT_OK(v);
}

// String literal: a fresh KorbString per evaluation (Ruby semantics).
// `bytes` may contain NULs (the specializer emits a runtime reference,
// never a baked C literal — see koruby_gen.rb).
NODE_DEF
node_str(CTX *c, NODE *n, VALUE *slots, const char *bytes, uint32_t len)
{
    (void)n;
    return korb_str_new(c, slots, bytes, len);
}

// `# frozen_string_literal: true` — the literal yields a frozen String.  Each
// evaluation still builds one (CRuby also deduplicates; identity is the only
// difference), so mutation attempts raise exactly as they should.
NODE_DEF
node_str_frozen(CTX *c, NODE *n, VALUE *slots, const char *bytes, uint32_t len)
{
    (void)n;
    const RESULT r = korb_str_new(c, slots, bytes, len);
    if (LIKELY(r.state == KORB_NORMAL)) ((AroObjectHeader *)(uintptr_t)r.value)->flags |= KORB_FL_FROZEN;
    return r;
}

// Same, for a source file whose `# encoding:` magic comment is not UTF-8: the
// literal carries the file's encoding tag (`enc` is a KORB_ENC_* index).
NODE_DEF
node_str_enc(CTX *c, NODE *n, VALUE *slots, const char *bytes, uint32_t len, uint32_t enc)
{
    (void)n;
    const RESULT r = korb_str_new(c, slots, bytes, len);
    if (LIKELY(r.state == KORB_NORMAL)) KORB_STR_ENC_SET(r.value, enc);
    return r;
}

// Integer literal beyond Fixnum range (e.g. 10**100 written literally).  The
// VALUE (a heap Bignum) can't be baked into an SD, so we bake the source digits
// (`digits`, base 0 = auto-detect 0x/0b/0o/_) and rebuild the Bignum each eval.
NODE_DEF
node_bignum(CTX *c, NODE *n, VALUE *slots, const char *digits, uint32_t len)
{
    (void)n;
    VALUE out;
    if (UNLIKELY(!korb_str_to_int(c, slots, digits, len, 0, &out)))
        return korb_raise(c, slots, KORB_E_RUNTIME, 0, "invalid integer literal");
    return RESULT_OK(out);
}

// Regexp literal `/pat/` — fresh Regexp(source, flags) per evaluation.
// `flags` carries the prism regex bits (IGNORE_CASE=4/EXTENDED=8/MULTI_LINE=16).
NODE_DEF
node_regexp(CTX *c, NODE *n, VALUE *slots, const char *bytes, uint32_t len, uint32_t flags)
{
    (void)n;
    VALUE src = UNWRAP(korb_str_new(c, slots, bytes, len));
    slots[0] = src;
    return korb_regexp_new(c, slots + 1, slots[0], flags);
}

// Interpolated Regexp `/...#{ }.../` — the source String is built at runtime by
// the child (a dstr), then compiled to a fresh Regexp with the baked flags.
NODE_DEF
node_regexp_dyn(CTX *c, NODE *n, VALUE *slots, uint32_t flags, VALUE src@child)
{
    (void)n;
    return korb_regexp_new(c, slots, src, flags);
}

// Special regex global reads: $1..$9 (kind 100+n), $& (0), $` (1), $' (2), $+ (3).
// Reads the last MatchData ($~) and returns the corresponding piece (or nil).
NODE_DEF
node_backref(CTX *c, NODE *n, VALUE *slots, uint32_t kind)
{
    (void)n;
    return korb_backref(c, slots, (int)kind);
}

// Float literal (immediate flonum when representable, else heap-boxed).
NODE_DEF
node_float(CTX *c, NODE *n, VALUE *slots, double v)
{
    (void)n;
    const VALUE imm = korb_d2flo(v);                 /* flonum-representable → immediate (no alloc) */
    if (LIKELY(imm)) return RESULT_OK(imm);
    return RESULT_OK(korb_flit_get(c, slots, v));    /* non-flonum (2.0/-2.0/±0.0/huge) → pooled box, not re-boxed each eval */
}

// Rational literal `2r` / `1.5r` → a fresh Rational(num/den) per evaluation.
NODE_DEF
node_rational(CTX *c, NODE *n, VALUE *slots, uint64_t num, uint64_t den)
{
    (void)n;
    return korb_rat_new(c, slots, (korb_sword_t)num, (korb_sword_t)den);
}

// Rational literal whose numerator/denominator exceed Fixnum (e.g. 999...r):
// the VALUEs can't be baked, so bake the decimal digit strings + rebuild.
NODE_DEF
node_rational_big(CTX *c, NODE *n, VALUE *slots, const char *num, uint32_t nlen, const char *den, uint32_t dlen)
{
    (void)n;
    VALUE nv, dv;
    if (UNLIKELY(!korb_str_to_int(c, slots, num, nlen, 10, &nv)))
        return korb_raise(c, slots, KORB_E_RUNTIME, 0, "invalid rational literal");
    slots[0] = nv;                                       /* root num across den parse (bignum alloc) */
    if (UNLIKELY(!korb_str_to_int(c, slots + 1, den, dlen, 10, &dv)))
        return korb_raise(c, slots, KORB_E_RUNTIME, 0, "invalid rational literal");
    return korb_rat_new_v(c, slots + 1, slots[0], dv);
}

// Imaginary literal `3i` / `1.5i` / `2ri` → Complex(0, <numeric>) per evaluation.
NODE_DEF
node_imaginary(CTX *c, NODE *n, VALUE *slots, VALUE_REF im@child)
{
    (void)n;
    return korb_cpx_new(c, slots, LONG2FIX(0), VALUE_REF_GET(im));
}

// Parse-time-unsupported construct (M0 subset boundary): the file still
// parses and runs up to this point, then raises NotImplementedError —
// rubyharness then scores every line before it (a parse-time exit would
// zero the whole file).
NODE_DEF
node_unsupported(CTX *c, NODE *n, VALUE *slots, const char *what, uint32_t line)
{
    (void)n;
    return korb_raise(c, slots, KORB_E_NOTIMPL, line, "M0 unsupported: %s", what);
}

// `$@` — the current exception's backtrace (nil when `$!` is nil).
NODE_DEF
node_errinfo_bt(CTX *c, NODE *n, VALUE *slots, int32_t unused)
{
    (void)n; (void)unused;
    const VALUE e = korb_errinfo_top(c);
    if (!KORB_EXC_P(e)) return RESULT_OK(KORB_NIL);
    slots[0] = e;
    return korb_send(c, slots + 1, korb_intern(c->vm, "backtrace", 9), 0, 0);
}

// `$@ = v` — set the current exception's backtrace (RuntimeError when `$!` is
// nil, exactly as CRuby reports it).
NODE_DEF
node_errinfo_bt_set(CTX *c, NODE *n, VALUE *slots, VALUE val@child)
{
    (void)n;
    const VALUE e = korb_errinfo_top(c);
    if (!KORB_EXC_P(e)) return korb_raise(c, slots, KORB_E_ARGUMENT, 0, "$! not set");
    slots[0] = e;
    slots[1] = val;
    CHECK(korb_send(c, slots + 2, korb_intern(c->vm, "set_backtrace", 13), 0, 1));
    return RESULT_OK(slots[1]);
}

// A read-only global (`$&`, `$1`, `$!`, … or an alias of one) on the left of an
// assignment: CRuby reports it as a NameError naming the variable as written.
NODE_DEF
node_readonly_gvar(CTX *c, NODE *n, VALUE *slots, const char *name, uint32_t line)
{
    (void)n;
    return korb_raise(c, slots, KORB_E_NAME, line, "%s is a read-only variable", name);
}

// ---- sequencing ------------------------------------------------------------

NODE_DEF
node_seq(CTX *c, NODE *n, VALUE *slots, NODE *a, NODE *b)
{
    (void)n;
    CHECK(EVAL_ARG(c, a));
    return EVAL_ARG(c, b);
}

// ---- local variables (one-stack model, v2_design §7.8) ---------------------
//
// `off` is parse-time baked: index - locals_cnt - staging_depth, i.e. a
// negative offset from the cursor at this program point.

NODE_DEF @nogc
node_lget(CTX *c, NODE *n, VALUE *slots, int32_t off)
{
    (void)c; (void)n;
    return RESULT_OK(slots[off]);
}

// Sole @child + @nogc body: rval rides a register, no staging slot exists,
// so the v1 "lset destination aliases the staging slot" problem is gone
// by construction (v2_design §7.4).
NODE_DEF @nogc
node_lset(CTX *c, NODE *n, VALUE *slots, int32_t off, VALUE rval@child)
{
    (void)c; (void)n;
    slots[off] = rval;
    return RESULT_OK(rval);
}

// Multiple assignment to local targets: `a, b = rhs`.  rhs (the @child) is
// evaluated to a value; if it's an Array its elements distribute to the targets
// (nil-padded), else target[0]=rhs and the rest are nil.  No allocation — the
// rhs array (e.g. the literal built for `a, b = b, a`) snapshots both sides
// first, so swaps work.  `offsets` is a baked int32[] of frame-slot offsets.
NODE_DEF @noinline
node_massign(CTX *c, NODE *n, VALUE *slots, void *offsets, uint32_t ntargets, VALUE rval@child)
{
    (void)n;
    const int32_t *const offs = (const int32_t *)offsets;
    slots[0] = rval;                                       /* keep the original RHS at slots[0] (rooted, below the cursor) */
    slots[1] = rval;
    CHECK(korb_massign_coerce(c, slots + 1));              /* non-Array rhs → #to_ary (into slots[1]); its send uses slots[2]+ */
    if (KORB_ARRAY_P(slots[1])) {
        const KorbArray *const a = VAL2ARY(slots[1]);      /* no alloc below → pointer stays valid */
        for (uint32_t i = 0; i < ntargets; i++)
            slots[offs[i]] = i < a->len ? korb_items_data(a->items)[i] : KORB_NIL;
    } else {
        for (uint32_t i = 0; i < ntargets; i++)
            slots[offs[i]] = (i == 0) ? slots[1] : KORB_NIL;
    }
    return RESULT_OK(slots[0]);                            /* massign yields the original RHS, not the coerced Array */
}

// Multiple assignment to heterogeneous targets (no splat): each target is a
// local (kind 0, data=slot offset), instance var (kind 1, data=ivar name sym),
// or constant (kind 2, data=const name sym).  rhs parked in slots[0] across the
// ivar-set allocs.  Returns the rhs (Array or scalar).
NODE_DEF @noinline
node_massign_het(CTX *c, NODE *n, VALUE *slots, void *descs, uint32_t nt, int32_t self_off, VALUE rval@child)
{
    (void)n;
    const struct { int32_t kind; int32_t data; } *const d = descs;
    slots[0] = rval;                                       /* keep the original RHS at slots[0] (rooted) to return */
    slots[1] = rval;
    CHECK(korb_massign_coerce(c, slots + 1));              /* non-Array rhs → #to_ary (into slots[1]); its send uses slots[2]+ */
    const bool is_ary = KORB_ARRAY_P(slots[1]);
    for (uint32_t i = 0; i < nt; i++) {
        const VALUE v = is_ary
            ? (i < VAL2ARY(slots[1])->len ? korb_items_data(VAL2ARY(slots[1])->items)[i] : KORB_NIL)
            : (i == 0 ? slots[1] : KORB_NIL);
        switch (d[i].kind) {
          case 0: slots[d[i].data] = v; break;                              /* local */
          case 1:                                                            /* @ivar */
            slots[2] = v;                                                    /* root across alloc (slots[1] keeps the coerced Array) */
            CHECK(korb_ivar_set(c, slots + 3, VALUE_REF_AT(&slots[self_off]), ID2SYM((uint32_t)d[i].data), slots[2]));
            break;
          case 2: korb_const_define(c, (uint32_t)d[i].data, v); break;       /* CONST */
        }
    }
    return RESULT_OK(slots[0]);                            /* massign yields the original RHS, not the coerced Array */
}

// Multiple assignment with a splat target: `pre..., *splat, post... = rhs`.
// `offsets` = npre pre-offsets, then the splat offset, then npost post-offsets.
// The splat collects the middle elements into a fresh Array (a GC point — rhs is
// parked in slots[0] across the alloc; ELEM treats a non-Array rhs as [rhs]).
NODE_DEF @noinline
node_massign_splat(CTX *c, NODE *n, VALUE *slots, void *offsets, uint32_t npre, uint32_t npost, VALUE rval@child)
{
    (void)n;
    const int32_t *const offs = (const int32_t *)offsets;
    slots[0] = rval;                                       /* keep the original RHS at slots[0] (rooted) to return */
    slots[1] = rval;
    CHECK(korb_massign_coerce(c, slots + 1));              /* non-Array rhs → #to_ary (into slots[1]); its send uses slots[2]+ */
    const bool is_ary = KORB_ARRAY_P(slots[1]);
    const uint32_t len = is_ary ? VAL2ARY(slots[1])->len : 1u;
    const uint32_t splat_cnt = len > npre + npost ? len - npre - npost : 0u;
#define MA_ELEM(i) (is_ary ? ((i) < VAL2ARY(slots[1])->len ? korb_items_data(VAL2ARY(slots[1])->items)[(i)] : KORB_NIL) \
                            : ((i) == 0 ? slots[1] : KORB_NIL))
    for (uint32_t i = 0; i < npre; i++) slots[offs[i]] = MA_ELEM(i);
    slots[2] = UNWRAP(korb_ary_new(c, slots + 2, splat_cnt));   /* splat Array at slots[2] (slots[1] keeps the coerced RHS) */
    VALUE_REF sp = VALUE_REF_AT(&slots[2]);
    for (uint32_t k = 0; k < splat_cnt; k++)
        CHECK(korb_ary_push_val(c, slots + 3, sp, MA_ELEM(npre + k)));
    slots[offs[npre]] = VALUE_REF_GET(sp);
    /* posts follow the pre + splat elements (npre + splat_cnt); when there aren't
     * enough values (splat_cnt == 0 and len < npre+npost) this fills left-to-right
     * with nil padding, as CRuby does — `len - npost` would underflow. */
    for (uint32_t i = 0; i < npost; i++) slots[offs[npre + 1 + i]] = MA_ELEM(npre + splat_cnt + i);
#undef MA_ELEM
    return RESULT_OK(slots[0]);                            /* massign yields the original RHS, not the coerced Array */
}

// ---- arithmetic ------------------------------------------------------------
//
// lhs is VALUE_REF (staged: rhs evaluation may GC), rhs is the last child
// (register).  Slow paths re-root what they need (v2_design §4.5).

NODE_DEF
node_plus(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, "+", 1), n->u.node_plus.line, 1); }
    VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs))) {
        /* tagged add: l=2x+1, rhs-1=2y → l+(rhs-1)=2(x+y)+1 is already the tagged
         * result, no FIX2LONG/LONG2FIX shifts.  64-bit signed overflow ⟺ x+y is
         * not FIXABLE (the tag bit makes the tagged range == the fixnum range),
         * so __builtin_add_overflow subsumes the explicit FIXABLE check. */
        korb_sword_t s;
        if (LIKELY(!__builtin_add_overflow((korb_sword_t)l, (korb_sword_t)rhs - 1, &s)))
            return RESULT_OK((VALUE)s);
        return korb_int_arith(c, slots, l, rhs, 0, n->u.node_plus.line);
    }
    if ((KORB_BIGNUM_P(l) || KORB_BIGNUM_P(rhs)) && KORB_INTEGER_P(l) && KORB_INTEGER_P(rhs))
        return korb_int_arith(c, slots, l, rhs, 0, n->u.node_plus.line);
    if (KORB_FLOAT_P(l) && KORB_FLOAT_P(rhs))                /* Float+Float inline (skip korb_num_arith dispatch) */
        return korb_flo(c, slots, korb_float_val(l) + korb_float_val(rhs));
    if (KORB_FLOAT_P(l) && FIXNUM_P(rhs))                    /* Float+Integer inline */
        return korb_flo(c, slots, korb_float_val(l) + (double)FIX2LONG(rhs));
    if (FIXNUM_P(l) && KORB_FLOAT_P(rhs))                    /* Integer+Float inline */
        return korb_flo(c, slots, (double)FIX2LONG(l) + korb_float_val(rhs));
    return korb_plus_slow(c, slots, lhs, rhs, n->u.node_plus.line);
}

NODE_DEF
node_minus(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, "-", 1), n->u.node_minus.line, 1); }
    VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs))) {
        /* tagged sub: l - (rhs-1) = (2x+1) - 2y = 2(x-y)+1, already tagged.
         * 64-bit signed overflow ⟺ x-y not FIXABLE (see node_plus). */
        korb_sword_t s;
        if (LIKELY(!__builtin_sub_overflow((korb_sword_t)l, (korb_sword_t)rhs - 1, &s)))
            return RESULT_OK((VALUE)s);
        return korb_int_arith(c, slots, l, rhs, 1, n->u.node_minus.line);
    }
    if ((KORB_BIGNUM_P(l) || KORB_BIGNUM_P(rhs)) && KORB_INTEGER_P(l) && KORB_INTEGER_P(rhs))
        return korb_int_arith(c, slots, l, rhs, 1, n->u.node_minus.line);
    if (KORB_FLOAT_P(l) && KORB_FLOAT_P(rhs))                /* Float-Float inline */
        return korb_flo(c, slots, korb_float_val(l) - korb_float_val(rhs));
    if (KORB_FLOAT_P(l) && FIXNUM_P(rhs))                    /* Float-Integer inline */
        return korb_flo(c, slots, korb_float_val(l) - (double)FIX2LONG(rhs));
    if (FIXNUM_P(l) && KORB_FLOAT_P(rhs))                    /* Integer-Float inline */
        return korb_flo(c, slots, (double)FIX2LONG(l) - korb_float_val(rhs));
    return korb_minus_slow(c, slots, lhs, rhs, n->u.node_minus.line);   /* complex/rat/array/user/raise out-of-line → small SD */
}

NODE_DEF
node_mul(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, "*", 1), n->u.node_mul.line, 1); }
    VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs))) {
        /* tagged mul: x*(rhs-1) = x*2y = 2xy, then |1 → 2xy+1 (tagged xy).  Only
         * lhs needs decoding (one sar); 64-bit overflow of 2xy ⟺ xy not FIXABLE. */
        korb_sword_t p;
        if (LIKELY(!__builtin_mul_overflow(FIX2LONG(l), (korb_sword_t)rhs - 1, &p)))
            return RESULT_OK((VALUE)(p | 1));
        return korb_int_arith(c, slots, l, rhs, 2, n->u.node_mul.line);
    }
    if ((KORB_BIGNUM_P(l) || KORB_BIGNUM_P(rhs)) && KORB_INTEGER_P(l) && KORB_INTEGER_P(rhs))
        return korb_int_arith(c, slots, l, rhs, 2, n->u.node_mul.line);
    if (KORB_FLOAT_P(l) && KORB_FLOAT_P(rhs))                /* Float*Float inline */
        return korb_flo(c, slots, korb_float_val(l) * korb_float_val(rhs));
    if (KORB_FLOAT_P(l) && FIXNUM_P(rhs))                    /* Float*Integer inline */
        return korb_flo(c, slots, korb_float_val(l) * (double)FIX2LONG(rhs));
    if (FIXNUM_P(l) && KORB_FLOAT_P(rhs))                    /* Integer*Float inline */
        return korb_flo(c, slots, (double)FIX2LONG(l) * korb_float_val(rhs));
    return korb_mul_slow(c, slots, lhs, rhs, n->u.node_mul.line);
}

// CRuby floor semantics for / and % (sign follows the divisor).
NODE_DEF
node_div(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, "/", 1), n->u.node_div.line, 1); }
    VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs))) {
        korb_sword_t a = FIX2LONG(l), b = FIX2LONG(rhs);
        if (UNLIKELY(b == 0))
            return korb_raise(c, slots, KORB_E_ZERODIV, n->u.node_div.line, "divided by 0");
        korb_sword_t q = a / b;
        if ((a % b != 0) && ((a ^ b) < 0)) q--;
        if (UNLIKELY(!FIXABLE(q)))
            return korb_int_arith(c, slots, l, rhs, 3, n->u.node_div.line);
        return RESULT_OK(LONG2FIX(q));
    }
    if ((KORB_BIGNUM_P(l) || KORB_BIGNUM_P(rhs)) && KORB_INTEGER_P(l) && KORB_INTEGER_P(rhs))
        return korb_int_arith(c, slots, l, rhs, 3, n->u.node_div.line);
    if (KORB_COMPLEX_P(l) || KORB_COMPLEX_P(rhs)) return korb_cpx_arith(c, slots, l, rhs, 3);   /* before Float (a Complex/Float must not fall into korb_num_arith) */
    if (KORB_FLOAT_P(l) && KORB_FLOAT_P(rhs))                /* Float/Float inline */
        return korb_flo(c, slots, korb_float_val(l) / korb_float_val(rhs));
    if (KORB_FLOAT_P(l) && FIXNUM_P(rhs))                    /* Float/Integer inline */
        return korb_flo(c, slots, korb_float_val(l) / (double)FIX2LONG(rhs));
    if (FIXNUM_P(l) && KORB_FLOAT_P(rhs))                    /* Integer/Float inline */
        return korb_flo(c, slots, (double)FIX2LONG(l) / korb_float_val(rhs));
    if (KORB_FLOAT_P(l) || KORB_FLOAT_P(rhs)) return korb_num_arith(c, slots, l, rhs, 3, n->u.node_div.line);
    if (KORB_RATIONAL_P(l) || KORB_RATIONAL_P(rhs)) return korb_rat_arith(c, slots, l, rhs, 3);
    if (KORB_INTEGER_P(l)) {                            /* Fixnum or Bignum: coerce protocol, else TypeError */
        bool h; RESULT cr = korb_try_coerce(c, slots, l, rhs, "/", n->u.node_div.line, &h);
        if (h) return cr;
        return korb_raise(c, slots, KORB_E_TYPE, n->u.node_div.line, "%s can't be coerced into Integer", korb_type_name(rhs));
    }
    { bool h; RESULT ur = korb_user_binop(c, slots, l, rhs, "/", &h); if (h) return ur; }
    return korb_raise(c, slots, KORB_E_NOMETHOD, n->u.node_div.line, "undefined method '/' for %s", korb_a_type_name(l));
}

NODE_DEF
node_mod(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, "%", 1), n->u.node_mod.line, 1); }
    VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs))) {
        korb_sword_t a = FIX2LONG(l), b = FIX2LONG(rhs);
        if (UNLIKELY(b == 0))
            return korb_raise(c, slots, KORB_E_ZERODIV, n->u.node_mod.line, "divided by 0");
        korb_sword_t r = a % b;
        if (r != 0 && ((r ^ b) < 0)) r += b;
        return RESULT_OK(LONG2FIX(r));
    }
    if ((KORB_BIGNUM_P(l) || KORB_BIGNUM_P(rhs)) && KORB_INTEGER_P(l) && KORB_INTEGER_P(rhs))
        return korb_int_arith(c, slots, l, rhs, 4, n->u.node_mod.line);
    if (KORB_STRING_P(l)) return korb_str_mod(c, slots, lhs, rhs);   /* "fmt" % args */
    if ((KORB_INTEGER_P(l) || KORB_FLOAT_P(l)) && (KORB_FLOAT_P(l) || KORB_FLOAT_P(rhs)) && !KORB_OBJECT_P(rhs)) {   /* numeric l (incl. Bignum), float involved (a user-object rhs → the % method, which coerces) */
        double rd;
        if (korb_num_to_d(rhs, &rd) && rd == 0.0)       /* Float modulo by zero → ZeroDivisionError (not NaN) */
            return korb_raise(c, slots, KORB_E_ZERODIV, n->u.node_mod.line, "divided by 0");
        return korb_num_arith(c, slots, l, rhs, 4, n->u.node_mod.line);
    }
    if (KORB_INTEGER_P(l) && !KORB_OBJECT_P(rhs))       /* Integer % non-object (nil/true/...) → TypeError, not NoMethodError */
        return korb_raise(c, slots, KORB_E_TYPE, n->u.node_mod.line, "%s can't be coerced into Integer", korb_type_name(rhs));
    slots[0] = l; slots[1] = rhs;                       /* Integer#% (coerces obj#coerce) / Range#% / user-defined % via dispatch */
    return korb_send(c, slots + 2, korb_intern(c->vm, "%", 1), n->u.node_mod.line, 1);
}

// ---- bitwise / shift -------------------------------------------------------
// Fixnum-pair fast path inline; everything else (Array#<< / String#<< / Set ops
// / bignum / bool & | ^ / user-defined) dispatches.  Integer# redefinition of a
// bit op sets basic_op_redefined (see korb_check_basic_op_redef), forcing send.
NODE_DEF
node_band(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    const VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(!c->vm->basic_op_redefined && FIXNUM_P(l) && FIXNUM_P(rhs)))
        return RESULT_OK(LONG2FIX(FIX2LONG(l) & FIX2LONG(rhs)));
    slots[0] = rhs;   /* recv already rooted at slots[-1] (lhs); stage only the arg */
    return korb_send(c, slots + 1, c->vm->mid_band, n->u.node_band.line, 1);
}

NODE_DEF
node_bor(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    const VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(!c->vm->basic_op_redefined && FIXNUM_P(l) && FIXNUM_P(rhs)))
        return RESULT_OK(LONG2FIX(FIX2LONG(l) | FIX2LONG(rhs)));
    slots[0] = rhs;   /* recv already rooted at slots[-1] (lhs); stage only the arg */
    return korb_send(c, slots + 1, c->vm->mid_bor, n->u.node_bor.line, 1);
}

NODE_DEF
node_bxor(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    const VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(!c->vm->basic_op_redefined && FIXNUM_P(l) && FIXNUM_P(rhs)))
        return RESULT_OK(LONG2FIX(FIX2LONG(l) ^ FIX2LONG(rhs)));
    slots[0] = rhs;   /* recv already rooted at slots[-1] (lhs); stage only the arg */
    return korb_send(c, slots + 1, c->vm->mid_bxor, n->u.node_bxor.line, 1);
}

NODE_DEF
node_shl(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line, struct korb_inlcache *ic@ref)
{
    (void)line;   /* line read lazily from n on the cold (non-fixnum) path only */
    const VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(!c->vm->basic_op_redefined && FIXNUM_P(l) && FIXNUM_P(rhs))) {
        const korb_sword_t a = FIX2LONG(l), sh = FIX2LONG(rhs);
        if (LIKELY(sh >= 0 && sh < 62)) {
            const korb_sword_t r = a << sh;
            if (LIKELY((r >> sh) == a && FIXABLE(r))) return RESULT_OK(LONG2FIX(r));   /* no overflow */
        }
        /* overflow / wide / negative shift → Integer#<< (bignum promote, or >>) */
    }
    if (LIKELY(KORB_ARRAY_P(l) && !c->vm->arr_shl_redefined)) {  /* a << x → push (skips the full send dispatch) */
        KorbArray *const arr = VAL2ARY(l);
        if (LIKELY(arr->len < arr->capa)) {                     /* room → inline store (LTO-inlinable, no grow/GC) */
            korb_ary_store_at(c, l, arr->len, rhs);
            arr->len++;
            return RESULT_OK(l);
        }
        /* len == capa: full OR frozen (freeze sets capa = len).  Frozen check on
         * this cold grow path only — keeps the hot `a << x` fast path free. */
        KORB_CHECK_FROZEN_HEAP(c, slots, l, "Array");
        return korb_ary_push_val(c, slots, lhs, rhs);           /* grow path */
    }
    slots[0] = rhs;   /* recv rooted at slots[-1] (lhs); stage only the arg */
    if (LIKELY(KORB_STRING_P(l)))   /* hot String#<< (a CFUNC) keeps its inline cache */
        return korb_send_cached(c, slots + 1, c->vm->mid_shl, n->u.node_shl.line, 1, ic, KORB_UNDEF);
    /* A user (ISEQ) `<<` needs a full call frame; node_shl's slot window is too
     * tight for korb_send_cached's direct dispatch when the operand is staged by a
     * multiple-assignment / array-literal RHS (frame collision → stack overflow),
     * so route non-String receivers through the robust uncached path. */
    return korb_send(c, slots + 1, c->vm->mid_shl, n->u.node_shl.line, 1);
}

NODE_DEF
node_shr(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    const VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(!c->vm->basic_op_redefined && FIXNUM_P(l) && FIXNUM_P(rhs))) {
        const korb_sword_t a = FIX2LONG(l), sh = FIX2LONG(rhs);
        if (LIKELY(sh >= 0 && sh < 63)) return RESULT_OK(LONG2FIX(a >> sh));   /* arithmetic shift */
        if (sh >= 63) return RESULT_OK(LONG2FIX(a < 0 ? -1 : 0));
        /* sh < 0 (= left shift) may overflow → dispatch */
    }
    slots[0] = rhs;   /* recv already rooted at slots[-1] (lhs); stage only the arg */
    return korb_send(c, slots + 1, c->vm->mid_shr, n->u.node_shr.line, 1);
}

// Unary minus.  Single child → register form.
NODE_DEF
node_neg(CTX *c, NODE *n, VALUE *slots, VALUE v@child, uint32_t line)
{
    (void)line;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = v; return korb_send(c, slots + 1, korb_intern(c->vm, "-@", 2), n->u.node_neg.line, 0); }
    if (LIKELY(FIXNUM_P(v))) {
        korb_sword_t i = -FIX2LONG(v);
        if (LIKELY(FIXABLE(i)))
            return RESULT_OK(LONG2FIX(i));
        return korb_big_neg(c, slots, v);
    }
    if (KORB_BIGNUM_P(v)) return korb_big_neg(c, slots, v);
    if (KORB_FLOAT_P(v)) return korb_flo(c, slots, -korb_float_val(v));
    slots[0] = v;                                /* String (→ frozen dup) / Rational / Complex / user-defined -@ via dispatch */
    return korb_send(c, slots + 1, korb_intern(c->vm, "-@", 2), n->u.node_neg.line, 0);
}

// ---- comparison ------------------------------------------------------------

NODE_DEF
node_lt(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;   /* line read lazily from n only on the cold paths — keeps the
                   * fixnum fast path free of the per-op `line` memory load. */
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, "<", 1), n->u.node_lt.line, 1); }
    VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs)))
        return RESULT_OK((korb_sword_t)l < (korb_sword_t)rhs ? KORB_TRUE : KORB_FALSE);
    if (KORB_FLOAT_P(l) && KORB_FLOAT_P(rhs))            /* Float<Float inline */
        return RESULT_OK(korb_float_val(l) < korb_float_val(rhs) ? KORB_TRUE : KORB_FALSE);
    return korb_cmp_slow(c, slots, l, rhs, 0, n->u.node_lt.line);
}

NODE_DEF
node_le(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, "<=", 2), n->u.node_le.line, 1); }
    VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs)))
        return RESULT_OK((korb_sword_t)l <= (korb_sword_t)rhs ? KORB_TRUE : KORB_FALSE);
    if (KORB_FLOAT_P(l) && KORB_FLOAT_P(rhs))            /* Float<=Float inline */
        return RESULT_OK(korb_float_val(l) <= korb_float_val(rhs) ? KORB_TRUE : KORB_FALSE);
    return korb_cmp_slow(c, slots, l, rhs, 1, n->u.node_le.line);
}

NODE_DEF
node_gt(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, ">", 1), n->u.node_gt.line, 1); }
    VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs)))
        return RESULT_OK((korb_sword_t)l > (korb_sword_t)rhs ? KORB_TRUE : KORB_FALSE);
    if (KORB_FLOAT_P(l) && KORB_FLOAT_P(rhs))            /* Float>Float inline */
        return RESULT_OK(korb_float_val(l) > korb_float_val(rhs) ? KORB_TRUE : KORB_FALSE);
    return korb_cmp_slow(c, slots, l, rhs, 2, n->u.node_gt.line);
}

NODE_DEF
node_ge(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child, uint32_t line)
{
    (void)line;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, ">=", 2), n->u.node_ge.line, 1); }
    VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs)))
        return RESULT_OK((korb_sword_t)l >= (korb_sword_t)rhs ? KORB_TRUE : KORB_FALSE);
    if (KORB_FLOAT_P(l) && KORB_FLOAT_P(rhs))            /* Float>=Float inline */
        return RESULT_OK(korb_float_val(l) >= korb_float_val(rhs) ? KORB_TRUE : KORB_FALSE);
    return korb_cmp_slow(c, slots, l, rhs, 3, n->u.node_ge.line);
}

// == / != : immediate identity / String content compare by default.  When a
// basic op has been redefined on Integer/Float, deopt to a real send so a
// redefined #== / #!= runs (not @nogc: the send may allocate / GC).
NODE_DEF
node_eq(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child)
{
    (void)n;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, c->vm->mid_eq, 0, 1); }
    const VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs)))    /* two fixnums: == is identity (skips korb_value_eq → korb_int_cmp PLT) */
        return RESULT_OK(l == rhs ? KORB_TRUE : KORB_FALSE);
    if (l == rhs) {   /* identity: symbol / same object — but NaN is never == itself */
        if (UNLIKELY(KORB_FLOAT_P(l))) { const double d_ = korb_float_val(l); if (d_ != d_) return RESULT_OK(KORB_FALSE); }   /* d_ != d_ ⇔ NaN */
        return RESULT_OK(KORB_TRUE);
    }
    if (KORB_OBJECT_P(l) || KORB_METHOD_P(l) || KORB_EXC_P(l) || KORB_HASH_P(l) || KORB_ARRAY_P(l)
        || KORB_REGEXP_P(l) || KORB_MATCHDATA_P(l) || KORB_PROC_P(l)) {   /* value == (user instance / Method / Hash / Array / Regexp / MatchData / Proc) → dispatch */
        slots[0] = l; slots[1] = rhs;
        return korb_send(c, slots + 2, c->vm->mid_eq, 0, 1);
    }
    if (korb_value_eq(l, rhs)) return RESULT_OK(KORB_TRUE);
    /* Numeric#== is reflexive for a non-numeric other: `5 == obj` → `obj == 5`. */
    if (KORB_OBJECT_P(rhs) &&
        (FIXNUM_P(l) || KORB_FLOAT_P(l) || KORB_BIGNUM_P(l) || KORB_RATIONAL_P(l) || KORB_COMPLEX_P(l))) {
        slots[0] = rhs; slots[1] = l;
        return korb_send(c, slots + 2, c->vm->mid_eq, 0, 1);
    }
    return RESULT_OK(KORB_FALSE);
}

NODE_DEF
node_neq(CTX *c, NODE *n, VALUE *slots, VALUE_REF lhs@child, VALUE rhs@child)
{
    (void)n;
    if (UNLIKELY(c->vm->basic_op_redefined)) { slots[0] = VALUE_REF_GET(lhs); slots[1] = rhs; return korb_send(c, slots + 2, korb_intern(c->vm, "!=", 2), 0, 1); }
    const VALUE l = VALUE_REF_GET(lhs);
    if (LIKELY(FIXNUM_P(l) && FIXNUM_P(rhs)))    /* two fixnums: != is identity */
        return RESULT_OK(l != rhs ? KORB_TRUE : KORB_FALSE);
    if (l == rhs) {   /* identity → not-equal is false — except NaN, which is != itself */
        if (UNLIKELY(KORB_FLOAT_P(l))) { const double d_ = korb_float_val(l); if (d_ != d_) return RESULT_OK(KORB_TRUE); }   /* d_ != d_ ⇔ NaN */
        return RESULT_OK(KORB_FALSE);
    }
    if (KORB_OBJECT_P(l) || KORB_EXC_P(l) || KORB_HASH_P(l) || KORB_ARRAY_P(l)
        || KORB_REGEXP_P(l) || KORB_MATCHDATA_P(l)) {      /* dispatch #!= — honours a user-defined `!=`, else Object#!= (= !(==)) */
        slots[0] = l; slots[1] = rhs;
        return korb_send(c, slots + 2, korb_intern(c->vm, "!=", 2), 0, 1);
    }
    if (korb_value_eq(l, rhs)) return RESULT_OK(KORB_FALSE);
    /* reflexive numeric != : `5 != obj` → !(obj == 5). */
    if (KORB_OBJECT_P(rhs) &&
        (FIXNUM_P(l) || KORB_FLOAT_P(l) || KORB_BIGNUM_P(l) || KORB_RATIONAL_P(l) || KORB_COMPLEX_P(l))) {
        slots[0] = rhs; slots[1] = l;
        RESULT r = korb_send(c, slots + 2, c->vm->mid_eq, 0, 1);
        if (UNLIKELY(r.state != KORB_NORMAL)) return r;
        return RESULT_OK(KORB_TRUTHY(r.value) ? KORB_FALSE : KORB_TRUE);
    }
    return RESULT_OK(KORB_TRUE);
}

// case/when subject test: `whenval === subj`.  For value-equality types
// (Fixnum/Float/Symbol/String/nil/bool/Array/Hash/Bignum) === is definitionally
// ==, so compare inline via korb_value_eq — no per-`when` method dispatch.  Only
// Range/Class/Regexp/Proc/user-object when-values (where === means membership /
// is_a? / match / call / custom) fall back to a real === send.
NODE_DEF
node_caseeq(CTX *c, NODE *n, VALUE *slots, VALUE_REF wv@child, VALUE subj@child)
{
    (void)n;
    const VALUE w = VALUE_REF_GET(wv);
    /* No identity short-circuit: for a Class/Module when-value `w === subj` is
     * is_a?, not identity (`Symbol === Symbol` is false), and NaN === NaN is false
     * even for the same boxed object — both must reach the real === / value_eq. */
    if (!AROH_IS_GC_OBJECT(w))                             /* fixnum / symbol / nil / true / false */
        return RESULT_OK(korb_value_eq(w, subj) ? KORB_TRUE : KORB_FALSE);
    switch (KORB_OBJ_TYPE(w)) {
      case KORB_OBJ_STRING: case KORB_OBJ_ARRAY: case KORB_OBJ_HASH:
      case KORB_OBJ_FLOAT:  case KORB_OBJ_BIGNUM:
        return RESULT_OK(korb_value_eq(w, subj) ? KORB_TRUE : KORB_FALSE);
      default:                                             /* Range / Class / Regexp / Proc / user obj → real === */
        slots[0] = w; slots[1] = subj;
        return korb_send(c, slots + 2, c->vm->mid_eqq, 0, 1);
    }
}

// ---- boolean ---------------------------------------------------------------

NODE_DEF @nogc
node_not(CTX *c, NODE *n, VALUE *slots, VALUE v@child)
{
    (void)c; (void)n; (void)slots;
    return RESULT_OK(KORB_TRUTHY(v) ? KORB_FALSE : KORB_TRUE);
}

// `recv&.m(...) { block }` guard: cond is the (already-evaluated) receiver; if
// it is nil the whole expression is nil, else the block-call `body` runs.  Used
// only for safe-navigation calls that carry a block (the block-less form is
// node_send_safe).  `cond` is a cheap local read (the receiver was evaluated
// once into a temp just before), so evaluating it twice is side-effect-free.
NODE_DEF @nogc
node_nil_guard(CTX *c, NODE *n, VALUE *slots, VALUE cond@child, NODE *body)
{
    (void)n;
    if (cond == KORB_NIL) return RESULT_OK(KORB_NIL);
    return EVAL_ARG(c, body);
}

// && / || — rhs is lazy (evaluated only when needed).
NODE_DEF @nogc
node_and(CTX *c, NODE *n, VALUE *slots, VALUE lhs@child, NODE *rhs)
{
    (void)n;
    if (!KORB_TRUTHY(lhs)) return RESULT_OK(lhs);
    return EVAL_ARG(c, rhs);
}

NODE_DEF @nogc
node_or(CTX *c, NODE *n, VALUE *slots, VALUE lhs@child, NODE *rhs)
{
    (void)n;
    if (KORB_TRUTHY(lhs)) return RESULT_OK(lhs);
    return EVAL_ARG(c, rhs);
}

// ---- control flow ----------------------------------------------------------

// Branches are lazy NODE *; the parser supplies node_lit(nil) for a missing
// else (NODE * operands must never be NULL — dispatcher pre-fetch).
NODE_DEF @nogc
node_if(CTX *c, NODE *n, VALUE *slots, VALUE cond@child, NODE *then_b, NODE *else_b)
{
    (void)n;
    if (KORB_TRUTHY(cond)) return EVAL_ARG(c, then_b);
    return EVAL_ARG(c, else_b);
}

// begin/rescue/ensure.  flags: bit0 has_rescue, bit1 has_ensure.  `rescues` is
// a node_rescue clause chain (lit-nil placeholder when no rescue); the chain
// reads the live exception parked at slots[0] and either handles it or, via its
// terminal node_reraise, re-propagates it.  `ensure_b` is lit-nil when absent.
// (NODE* operands must be non-NULL.)
NODE_DEF
node_begin(CTX *c, NODE *n, VALUE *slots, NODE *body, NODE *rescues, NODE *ensure_b, uint32_t flags)
{
    (void)n;
    RESULT r;
    for (;;) {                                         /* loop only re-entered by `retry` */
        r = EVAL_ARG(c, body);
        if ((flags & 1u) && r.state == KORB_RAISE) {   /* rescue clause(s) present */
            slots[0] = r.value;                        /* park the exception in scratch (rooted) */
            r = EVAL_ARG(c, rescues);                  /* clause chain handles or re-raises (same frame) */
            if (r.state == KORB_RETRY) continue;       /* `retry` → re-run body (ensure not run yet) */
        }
        break;
    }
    if (flags & 2u) {                                  /* ensure: always runs */
        /* Park the in-flight value (exception / return / normal result) at
         * slots[0] and run the ensure body ONE slot up (slots+1, baked at
         * chain+1) so a GC inside ensure forwards the parked value instead of
         * leaving the C-local `r.value` stale; re-read it afterwards. */
        slots[0] = r.value;
        /* while unwinding, `$!` is the in-flight exception for the ensure body
         * (CRuby); a normal exit leaves the enclosing $! alone. */
        const bool unwinding = (r.state == KORB_RAISE) && KORB_EXC_P(slots[0]);
        if (unwinding) korb_errinfo_push(c, slots[0]);
        RESULT er = EVAL(c, ensure_b, slots + 1);
        if (unwinding) korb_errinfo_pop(c);
        if (er.state != KORB_NORMAL) return er;         /* ensure's raise/return wins */
        r.value = slots[0];
    }
    return r;
}

// One rescue clause in a begin's rescue chain.  Runs in the begin frame with the
// live exception parked at slots[0].  Evaluates `match` (the rescue class) above
// the exception (slots+1); on korb_exc_matches it optionally binds the exception
// local (flags bit0 → slots[resc_var]) and runs `body`, otherwise delegates to
// `next` (the following clause, or node_reraise).  match/body/next are non-NULL.
// `rescue A, B => e` chains two node_rescue sharing the same body+resc_var.
NODE_DEF
node_rescue(CTX *c, NODE *n, VALUE *slots, NODE *match, NODE *body, NODE *next, int32_t resc_var, uint32_t flags)
{
    (void)n;
    RESULT cr = EVAL(c, match, slots + 1);             /* rescue class (exception stays at slots[0]) */
    if (UNLIKELY(cr.state != KORB_NORMAL)) return cr;
    if (UNLIKELY(!KORB_CLASS_P(cr.value)))             /* `rescue 42` etc. → TypeError, not a silent non-match */
        return korb_raise(c, slots + 1, KORB_E_TYPE, 0, "class or module required for rescue clause");
    if (korb_exc_matches(c, slots[0], cr.value)) {
        /* capture the unwind backtrace into the exception before user code can
         * observe it via `e.backtrace` / `$!.backtrace` (once; re-raise keeps it) */
        UNWRAP(korb_capture_backtrace(c, slots));
        if (flags & 1u) slots[resc_var] = slots[0];    /* bind `=> e` */
        /* push the exception onto the per-CTX `$!` stack for the body; pop on
         * exit (nesting + restore-to-outer fall out of push/pop, top == $!). */
        korb_errinfo_push(c, slots[0]);
        RESULT br = EVAL_ARG(c, body);                  /* same frame; may clobber slots[0] */
        korb_errinfo_pop(c);
        return br;
    }
    return EVAL_ARG(c, next);                            /* try next clause / re-raise */
}

// `rescue *list` — the matcher is a list (Array, or anything with #to_a) whose
// elements are each tried in order.  Same body/binding handling as node_rescue.
NODE_DEF @noinline
node_rescue_splat(CTX *c, NODE *n, VALUE *slots, NODE *match, NODE *body, NODE *next, int32_t resc_var, uint32_t flags)
{
    (void)n;
    RESULT cr = EVAL(c, match, slots + 1);             /* the list (exception stays at slots[0]) */
    if (UNLIKELY(cr.state != KORB_NORMAL)) return cr;
    slots[1] = cr.value;
    if (!KORB_ARRAY_P(slots[1])) {
        RESULT ar = korb_rescue_splat_list(c, slots + 2, &slots[1]);   /* #to_a, else TypeError */
        if (UNLIKELY(ar.state != KORB_NORMAL)) return ar;
    }
    const uint32_t cnt = VAL2ARY(slots[1])->len;
    for (uint32_t i = 0; i < cnt; i++) {
        const VALUE cls = korb_items_data(VAL2ARY(slots[1])->items)[i];   /* re-read: no alloc in this loop */
        if (UNLIKELY(!KORB_CLASS_P(cls)))
            return korb_raise(c, slots + 2, KORB_E_TYPE, 0, "class or module required for rescue clause");
        if (!korb_exc_matches(c, slots[0], cls)) continue;
        UNWRAP(korb_capture_backtrace(c, slots));
        if (flags & 1u) slots[resc_var] = slots[0];    /* bind `=> e` */
        korb_errinfo_push(c, slots[0]);
        RESULT br = EVAL_ARG(c, body);
        korb_errinfo_pop(c);
        return br;
    }
    return EVAL_ARG(c, next);                          /* try next clause / re-raise */
}

// Terminal of a rescue chain: no clause matched — re-propagate the exception
// parked at slots[0] by the enclosing node_begin.
NODE_DEF @nogc
node_reraise(CTX *c, NODE *n, VALUE *slots)
{
    (void)c; (void)n;
    return RESULT_RAISE_(slots[0]);
}

// `retry` — re-run the enclosing begin body from the top (valid only inside a
// rescue clause; node_begin catches KORB_RETRY).  A bare leaf, like break/next.
NODE_DEF @nogc
node_retry(CTX *c, NODE *n, VALUE *slots)
{
    (void)c; (void)n; (void)slots;
    return RESULT_RETRY_;
}

// Pre-test while (negate=0) / until (negate=1): `while cond; body; end`.
// The post-test form (`begin; body; end while cond`) is a distinct node,
// node_post_while — the pre/post split is a parse-time control-flow shape, so
// it is encoded as the node kind (no runtime `post` discriminator).  Result nil.
NODE_DEF @nogc
node_while(CTX *c, NODE *n, VALUE *slots, NODE *cond, NODE *body, uint32_t negate)
{
    (void)n;
    for (;;) {
        VALUE cv = UNWRAP(EVAL_ARG(c, cond));
        if (negate ? KORB_TRUTHY(cv) : !KORB_TRUTHY(cv)) break;
        RESULT br = EVAL_ARG(c, body);
        if (UNLIKELY(br.state != KORB_NORMAL)) {
            if (br.state == KORB_BREAK && c->break_blk == NULL) return RESULT_OK(br.value);   /* a *loop* break (an unconsumed block break belongs to an outer call) */
            if (br.state != KORB_NEXT) return br;                      /* return / raise propagate; `next` → continue */
        }
    }
    return RESULT_OK(KORB_NIL);
}

// Post-test while (negate=0) / until (negate=1): `begin; body; end while cond`
// — the body always runs at least once, the condition is tested after it.
NODE_DEF @nogc
node_post_while(CTX *c, NODE *n, VALUE *slots, NODE *cond, NODE *body, uint32_t negate)
{
    (void)n;
    for (;;) {
        RESULT br = EVAL_ARG(c, body);
        if (UNLIKELY(br.state != KORB_NORMAL)) {
            if (br.state == KORB_BREAK && c->break_blk == NULL) return RESULT_OK(br.value);   /* a *loop* break (an unconsumed block break belongs to an outer call) */
            if (br.state != KORB_NEXT) return br;                      /* return / raise propagate; `next` → continue */
        }
        VALUE cv = UNWRAP(EVAL_ARG(c, cond));
        if (negate ? KORB_TRUTHY(cv) : !KORB_TRUTHY(cv)) break;
    }
    return RESULT_OK(KORB_NIL);
}

// `for VAR in COLL; BODY; end` — no new scope: VAR and BODY's locals live in
// the enclosing frame, so BODY is transduced there (unlike a block).  The
// collection is materialized to an Array (via to_a) into a synth local, then
// iterated; `break`/`next` behave as in a while loop.  Result = the iterable.
NODE_DEF
node_for(CTX *c, NODE *n, VALUE *slots, int32_t orig_off, int32_t iter_off, int32_t var_off, NODE *coll, NODE *body)
{
    (void)n;
    RESULT cr = EVAL_ARG(c, coll);
    if (UNLIKELY(cr.state != KORB_NORMAL)) return cr;
    slots[orig_off] = cr.value;                             /* the original collection (for's value) */
    slots[iter_off] = cr.value;
    if (!KORB_ARRAY_P(slots[iter_off])) {
        slots[0] = slots[iter_off];
        if (KORB_RANGE_P(slots[iter_off])) {               /* Range: #to_a is a direct C loop and == #each */
            RESULT ta = korb_send(c, slots + 1, korb_intern(c->vm, "to_a", 4), 0, 0);
            if (UNLIKELY(ta.state != KORB_NORMAL)) return ta;
            slots[iter_off] = ta.value;
        } else {                                           /* CRuby: `for x in obj` is obj.each{|x|…} — drive #each */
            slots[1] = ID2SYM(korb_intern(c->vm, "each", 4));                              /* [recv, :each] end at base[-1] */
            RESULT en = korb_send(c, slots + 2, korb_intern(c->vm, "to_enum", 7), 0, 1);   /* enum_for(:each): respects a singleton #each */
            if (UNLIKELY(en.state != KORB_NORMAL)) return en;
            slots[0] = en.value;
            RESULT ta = korb_send(c, slots + 1, korb_intern(c->vm, "to_a", 4), 0, 0);      /* materialize (finite) */
            if (UNLIKELY(ta.state != KORB_NORMAL)) return ta;
            slots[iter_off] = ta.value;
        }
        if (UNLIKELY(!KORB_ARRAY_P(slots[iter_off])))
            return korb_raise(c, slots, KORB_E_TYPE, 0, "for: collection is not iterable");
    }
    for (uint32_t i = 0; ; i++) {
        const KorbArray *a = VAL2ARY(slots[iter_off]);     /* re-read: body may move it */
        if (i >= a->len) break;
        slots[var_off] = korb_items_data(a->items)[i];                /* assign the loop var (enclosing local) */
        RESULT br = EVAL_ARG(c, body);
        if (UNLIKELY(br.state != KORB_NORMAL)) {
            if (br.state == KORB_BREAK && c->break_blk == NULL) return RESULT_OK(br.value);
            if (br.state != KORB_NEXT) return br;           /* return/raise propagate; `next` continues */
        }
    }
    return RESULT_OK(slots[orig_off]);
}

// `break [v]` — unwind to the nearest loop (node_while) or block-call boundary.
NODE_DEF @nogc
node_break(CTX *c, NODE *n, VALUE *slots, VALUE v@child)
{
    (void)c; (void)n; (void)slots;
    return RESULT_BREAK_(v);
}

// `return v` at method top-level: a nearest-method return (target = NULL → the
// enclosing korb_invoke_method consumes it).
NODE_DEF @nogc
node_return(CTX *c, NODE *n, VALUE *slots, VALUE v@child)
{
    (void)n; (void)slots;
    c->return_target = NULL;
    return RESULT_RETURN_(v);
}

// `return v` from INSIDE a block: a non-local return aimed at the lexically
// enclosing METHOD (Ruby semantics).  `prev_off`/`depth` reach that method's
// frame base via the env chain (like node_yield_outer); set it as the return
// target so intermediate USER methods (e.g. Enumerable#find calling the
// includer's each) propagate the return instead of consuming it.  An escaped
// chain (home frame gone) falls back to nearest-method (target NULL).
NODE_DEF @nogc
node_return_outer(CTX *c, NODE *n, VALUE *slots, int32_t prev_off, uint32_t depth, VALUE v@child)
{
    (void)n;
    c->return_target = korb_outer_frame_base(slots[prev_off], depth);
    return RESULT_RETURN_(v);
}

// pattern match `expr in pattern` → true/false (binds locals as a side effect).
// @noinline: the compiled pattern descriptor (`desc`) is a per-process pointer
// (not bakeable); the runtime matcher walks the subject + writes bindings.
NODE_DEF @noinline
node_match_pred(CTX *c, NODE *n, VALUE *slots, VALUE subj@child, void *desc)
{
    (void)n;
    slots[0] = subj;                                     /* root subject */
    return korb_pat_match(c, slots, slots + 1, VALUE_REF_AT(&slots[0]), (const struct korb_pat *)desc);
}

// pattern match `expr => pattern` → nil, or raise on no match.
NODE_DEF @noinline
node_match_req(CTX *c, NODE *n, VALUE *slots, VALUE subj@child, void *desc)
{
    (void)n;
    slots[0] = subj;
    RESULT m = korb_pat_match(c, slots, slots + 1, VALUE_REF_AT(&slots[0]), (const struct korb_pat *)desc);
    if (UNLIKELY(m.state != KORB_NORMAL)) return m;
    if (m.value != KORB_TRUE) {                          /* message is the inspected subject (CRuby) */
        char *ibuf = NULL; size_t ilen = 0;
        FILE *ims = open_memstream(&ibuf, &ilen);
        if (ims) { korb_fprint_inspect(c, ims, slots[0]); fclose(ims); }
        RESULT rr = korb_raise(c, slots, KORB_E_NO_MATCHING_PATTERN, 0, "%s", ibuf ? ibuf : "");
        free(ibuf);
        return rr;
    }
    return RESULT_OK(KORB_NIL);
}

// ---- method definition and calls -------------------------------------------

// `def` registers the body in the per-CTX method table at eval time.  The
// body is its own AOT entry (call sites dispatch via body->head.dispatcher
// at runtime, which the specializer cannot constant-fold) — @noinline.
// `self_off` reads the default definee: inside a `class` body self is the
// class (def attaches to it); elsewhere self is main/an instance → global table.
NODE_DEF @noinline
node_def(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, NODE *body, uint32_t params_cnt, uint32_t req_cnt, uint32_t post_cnt, int32_t rest_slot, uint32_t locals_cnt, uint32_t uses_block, void *opt_defaults, void *kw_info, void *param_info, int32_t self_off)
{
    (void)body_dispatcher;
    VALUE definee = (c->def_definee != KORB_NIL) ? c->def_definee : slots[self_off];   /* instance_eval → singleton */
    if (UNLIKELY(!KORB_CLASS_P(definee) && c->def_definee != KORB_NIL))
        return korb_raise(c, slots, KORB_E_TYPE, 0, "can't define singleton");   /* instance_eval on a value with no singleton */
    if (KORB_CLASS_P(definee)) {
        { RESULT fr = korb_check_def_frozen(c, slots, definee); if (UNLIKELY(fr.state != KORB_NORMAL)) return fr; }   /* frozen class / metaclass-of-frozen → FrozenError */
        korb_class_def_method(c, definee, mid, body, params_cnt, req_cnt, post_cnt, rest_slot, locals_cnt, uses_block, (struct Node **)opt_defaults, kw_info, param_info);
        /* fire Module#method_added(name) — only when overridden (no default → no per-def cost). */
        const uint32_t mad = korb_intern(c->vm, "method_added", 12);
        if (UNLIKELY(korb_responds_to(c, definee, mad))) {
            slots[0] = definee; slots[1] = ID2SYM(mid);
            RESULT hr = korb_send(c, slots + 2, mad, 0, 1);
            if (UNLIKELY(hr.state != KORB_NORMAL)) return hr;
        }
    } else {
        korb_method_define(c, mid, body, params_cnt, req_cnt, post_cnt, rest_slot, locals_cnt, uses_block, (struct Node **)opt_defaults, kw_info, param_info);
    }
    return RESULT_OK(ID2SYM(mid));
}

// `def recv.name ... end` — singleton method: attach to recv's singleton class.
NODE_DEF @noinline
node_singleton_def(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, NODE *body, uint32_t params_cnt, uint32_t req_cnt, uint32_t post_cnt, int32_t rest_slot, uint32_t locals_cnt, uint32_t uses_block, void *opt_defaults, void *kw_info, void *param_info, VALUE_REF recv@child)
{
    (void)body_dispatcher;
    VALUE obj = VALUE_REF_GET(recv);
    if (UNLIKELY(!AROH_IS_GC_OBJECT(obj))) {
        /* nil/true/false have a sole instance, so a singleton def lands on their class;
         * other immediates (Integer/Float/Symbol) genuinely can't take one. */
        if (UNLIKELY(obj != KORB_NIL && obj != KORB_TRUE && obj != KORB_FALSE))
            return korb_raise(c, slots, KORB_E_TYPE, 0, "can't define singleton method for %s", korb_type_name(obj));
        korb_class_def_method(c, korb_class_obj_of(c, obj), mid, body, params_cnt, req_cnt, post_cnt, rest_slot, locals_cnt, uses_block, (struct Node **)opt_defaults, kw_info, param_info);
        return RESULT_OK(ID2SYM(mid));
    }
    KORB_CHECK_FROZEN(c, slots, obj);                    /* `def frozen_obj.m` → FrozenError */
    VALUE sing = UNWRAP(korb_obj_singleton(c, slots, obj));
    korb_class_def_method(c, sing, mid, body, params_cnt, req_cnt, post_cnt, rest_slot, locals_cnt, uses_block, (struct Node **)opt_defaults, kw_info, param_info);
    /* fire the BasicObject#singleton_method_added(name) hook — only when the
     * object actually defines it (no default → no per-def cost otherwise; and
     * since the method is added first, defining the hook fires it for itself). */
    obj = VALUE_REF_GET(recv);
    const uint32_t smad = korb_intern(c->vm, "singleton_method_added", 22);
    if (UNLIKELY(korb_responds_to(c, obj, smad))) {
        slots[0] = obj; slots[1] = ID2SYM(mid);          /* recv, arg */
        RESULT hr = korb_send(c, slots + 2, smad, 0, 1);
        if (UNLIKELY(hr.state != KORB_NORMAL)) return hr;
    }
    return RESULT_OK(ID2SYM(mid));
}

// `class Name ... end` — create/find the class + run its body with self=class.
// @noinline: body is a per-process node_entry pointer (not bakeable).
NODE_DEF @noinline
node_class(CTX *c, NODE *n, VALUE *slots, uint32_t name_sym@sym, NODE *body, int32_t self_off, uint32_t path_owner@sym, VALUE_REF super@child)
{
    (void)body_dispatcher;
    /* enclosing = the path's parent module (`class M::C`, baked const name) if
     * present, else the lexical self (`module M; class C`). */
    VALUE enclosing = path_owner ? korb_const_get(c->vm, path_owner) : slots[self_off];
    { uint32_t fs, ln;                                    /* Module#const_source_location */
      if (korb_get_srcloc(c->vm, n, &fs, &ln)) korb_const_reg_loc(c->vm, name_sym, KORB_CLASS_P(enclosing) ? enclosing : KORB_NIL, fs, ln); }
    return korb_class_body(c, slots, name_sym, body, VALUE_REF_GET(super), 0, enclosing);
}

// `class << recv ... end` — run the body with self = recv's singleton class.
// recv is staged as the child (evaluated in the enclosing scope); the body is a
// per-process node_entry pointer (not bakeable) → @noinline.
NODE_DEF @noinline
node_sclass(CTX *c, NODE *n, VALUE *slots, NODE *body, VALUE_REF recv@child)
{
    (void)body_dispatcher;
    return korb_sclass_body(c, slots, body, VALUE_REF_GET(recv));
}

// `module Name ... end` — like node_class but creates a module (no superclass,
// not instantiable; mixed into classes via `include`).
NODE_DEF @noinline
node_module(CTX *c, NODE *n, VALUE *slots, uint32_t name_sym@sym, NODE *body, int32_t self_off, uint32_t path_owner@sym)
{
    (void)body_dispatcher;
    /* enclosing = the path's parent (`module M::Inner`) if present, else lexical self. */
    VALUE enclosing = path_owner ? korb_const_get(c->vm, path_owner) : slots[self_off];
    { uint32_t fs, ln;                                    /* Module#const_source_location */
      if (korb_get_srcloc(c->vm, n, &fs, &ln)) korb_const_reg_loc(c->vm, name_sym, KORB_CLASS_P(enclosing) ? enclosing : KORB_NIL, fs, ln); }
    return korb_class_body(c, slots, name_sym, body, KORB_NIL, 1, enclosing);
}

// attr_reader/writer/accessor — defines getters/setters on self (the class).
// `descs` is a parse-time immortal array (count entries); @noinline (pointer
// operand isn't bakeable).
NODE_DEF @noinline
node_attr(CTX *c, NODE *n, VALUE *slots, int32_t self_off, void *descs, uint32_t count)
{
    (void)n;
    VALUE cls = slots[self_off];
    if (UNLIKELY(!KORB_CLASS_P(cls)))
        return korb_raise(c, slots, KORB_E_RUNTIME, 0, "attr accessor called outside a class body");
    { RESULT fr = korb_check_def_frozen(c, slots, cls); if (UNLIKELY(fr.state != KORB_NORMAL)) return fr; }   /* attr_* in a frozen class → FrozenError */
    const struct korb_attr_desc *d = (const struct korb_attr_desc *)descs;
    for (uint32_t i = 0; i < count; i++)
        korb_class_def_attr(c, cls, d[i].mid, d[i].ivar, d[i].is_writer);
    return RESULT_OK(KORB_NIL);
}

// `super` — `self_off`/`dc_off` read the frame's self + def_class cells; mid is
// the enclosing method's name (baked).  args staged like a call.
NODE_DEF
node_super0(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, int32_t dc_off)
{
    (void)n;
    return korb_super(c, slots, mid, line, 0, slots[dc_off], slots[self_off], NULL, NULL, KORB_NIL);
}

NODE_DEF
node_super1(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, int32_t dc_off, VALUE_REF a0@child)
{
    (void)n; (void)a0;
    return korb_super(c, slots, mid, line, 1, slots[dc_off], slots[self_off], NULL, NULL, KORB_NIL);
}

NODE_DEF
node_super2(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, int32_t dc_off, VALUE_REF a0@child, VALUE_REF a1@child)
{
    (void)n; (void)a0; (void)a1;
    return korb_super(c, slots, mid, line, 2, slots[dc_off], slots[self_off], NULL, NULL, KORB_NIL);
}

NODE_DEF
node_super3(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, int32_t dc_off, VALUE_REF a0@child, VALUE_REF a1@child, VALUE_REF a2@child)
{
    (void)n; (void)a0; (void)a1; (void)a2;
    return korb_super(c, slots, mid, line, 3, slots[dc_off], slots[self_off], NULL, NULL, KORB_NIL);
}

// `super(*arr)` — explicit super with splat args.  `args` is the built args
// Array; spread it above the cursor and dispatch with a runtime argc.  Stages
// one child (the array), so self_off/dc_off match node_super1's.
NODE_DEF
node_super_splat(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, int32_t dc_off, VALUE_REF args@child)
{
    (void)n; (void)args;
    const VALUE arr  = slots[-1];                         /* the staged args array */
    const VALUE dc   = slots[dc_off];
    const VALUE self = slots[self_off];
    const uint32_t N = VAL2ARY(arr)->len;
    for (uint32_t i = 0; i < N; i++) slots[i] = korb_items_data(VAL2ARY(arr)->items)[i];
    return korb_super(c, slots + N, mid, line, N, dc, self, NULL, NULL, KORB_NIL);
}

// `super(args) { block }` — explicit super with a literal block.  Args come from a
// built Array (like node_super_splat); the block + its captured env/self (the current
// frame) are threaded to korb_super (like node_send_blk).  @noinline: the block is a
// per-process NODE pointer (not bakeable).  self_off/dc_off match node_super_splat;
// def_env_off = self_off+1 (the frame's local base), tagged for the eget path.
NODE_DEF @noinline
node_super_blk(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, int32_t dc_off, NODE *block, int32_t def_env_off, VALUE_REF args@child)
{
    (void)n; (void)args; (void)block_dispatcher;
    const VALUE arr  = slots[-1];                         /* the staged args array */
    const VALUE dc   = slots[dc_off];
    const VALUE self = slots[self_off];
    const uint32_t N = VAL2ARY(arr)->len;
    for (uint32_t i = 0; i < N; i++) slots[i] = korb_items_data(VAL2ARY(arr)->items)[i];
    return korb_super(c, slots + N, mid, line, N, dc, self, block,
                      (VALUE *)((uintptr_t)&slots[def_env_off] | 1u), self);
}

// `super` / `super(args)` that forwards the CURRENT method's incoming block
// (no explicit block literal).  Args come from a built Array (like
// node_super_splat); the block is read from this frame's block trio (biseq /
// def_env / cself cells at fs-4/-3/-2, populated by korb_invoke_method) and
// threaded to korb_super so the parent method's `yield` reaches it.  A tagged
// biseq cell (|1) means a block was passed; an untagged/zero cell → no block.
NODE_DEF
node_super_fwd(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, int32_t dc_off, int32_t biseq_off, int32_t def_env_off, int32_t cself_off, VALUE_REF args@child)
{
    (void)n; (void)args;
    const VALUE arr  = slots[-1];                         /* the staged args array */
    const VALUE dc   = slots[dc_off];
    const VALUE self = slots[self_off];
    const VALUE bi   = slots[biseq_off];
    NODE *block = NULL; VALUE *def_env = NULL; VALUE cself = KORB_NIL;
    if ((uintptr_t)bi & 1u) {                             /* a block was passed to this frame */
        block   = (NODE *)((uintptr_t)bi & ~(uintptr_t)1u);
        def_env = (VALUE *)(uintptr_t)slots[def_env_off]; /* forward the block's original env verbatim */
        cself   = slots[cself_off];
    }
    const uint32_t N = VAL2ARY(arr)->len;
    for (uint32_t i = 0; i < N; i++) slots[i] = korb_items_data(VAL2ARY(arr)->items)[i];
    return korb_super(c, slots + N, mid, line, N, dc, self, block, def_env, cself);
}

// constant read (`Foo`) — classes only for now.  Inline cache: the const table
// `$!` — the current exception (top of the per-CTX errinfo stack, pushed by the
// active rescue body), nil when none.  O(1) read; no const-table involvement.
NODE_DEF
node_errinfo(CTX *c, NODE *n, VALUE *slots)
{
    (void)n; (void)slots;
    return RESULT_OK(korb_errinfo_top(c));
}

// is append-only so a name's index is permanent; cache it (idx+1, 0 = empty) and
// re-derive const_vals[idx] each read (sees reassignment + GC forwarding).
NODE_DEF
node_const(CTX *c, NODE *n, VALUE *slots, uint32_t name_sym@sym, uint32_t owner_name@sym, int32_t self_off, int32_t dc_off, struct korb_constcache *cache@ref)
{
    (void)n;
    struct korb_vm *const vm = c->vm;
    if (LIKELY(c->eval_cref == KORB_NIL)) {                    /* per-node cache (not under instance/class_eval) */
        if (LIKELY(cache->idx_plus1 != 0 && cache->serial == vm->const_serial))
            return RESULT_OK(vm->const_vals[cache->idx_plus1 - 1]);
    } else {
        /* instance_eval/class_eval(String): the eval cref (the receiver's
         * singleton / the module) and its ancestry come FIRST, and the answer is
         * context-dependent so it is never cached on the node. */
        uint32_t eidx = korb_const_index_owned(vm, name_sym, c->eval_cref);
        if (eidx == UINT32_MAX) eidx = korb_const_in_ancestry(vm, c->eval_cref, name_sym);
        if (eidx != UINT32_MAX) return RESULT_OK(vm->const_vals[eidx]);
    }
    uint32_t idx;
    if (owner_name != 0) {                            /* scoped `M::X` or bare read in a namespace */
        /* owner_name = the innermost enclosing module (bare) or the path parent
         * (M::X); walk its lexical `enclosing` chain, then fall back to flat
         * (top-level + builtin consts like Math::PI, which have owner nil). */
        idx = UINT32_MAX;
        /* An UNNAMED cref (a `class << obj` body, or a method defined in one)
         * sits between this read and the named enclosing module, and no baked
         * name can reach it — ask the runtime first. */
        if (self_off != INT32_MIN) {
            const VALUE acref = (dc_off != INT32_MIN) ? korb_cvar_cref(slots[self_off], slots[dc_off])
                                                      : (KORB_CLASS_P(slots[self_off]) ? slots[self_off] : KORB_NIL);
            if (KORB_CLASS_P(acref) && VAL2CLASS(acref)->name_sym == 0)
                idx = korb_const_index_owned(vm, name_sym, acref);
        }
        /* A baked enclosing chain (bare lexical read) resolves owner-scoped to the
         * UNIQUE innermost cref class, so a same-named class in another namespace
         * (M::C vs M::Inner::C) doesn't shadow it via a flat name lookup. */
        const VALUE cref = korb_cref_resolve(vm, cache->owner_chain, cache->chain_len, owner_name);
        /* every read that reaches here is a BARE one now (`A::B` goes through
         * node_const_path), so the lexical walk and the by-name fallback apply */
        for (VALUE o = cref; idx == UINT32_MAX && KORB_CLASS_P(o); o = VAL2CLASS(o)->enclosing) {   /* lexical scope (Module.nesting) */
            idx = korb_const_index_owned(vm, name_sym, o);
        }
        if (idx == UINT32_MAX)                                                  /* then the innermost class's ancestry (MRO order) */
            idx = korb_const_in_ancestry(vm, cref, name_sym);
        if (idx == UINT32_MAX) idx = korb_const_index_owned(vm, name_sym, KORB_NIL);   /* then top-level / builtin (owner nil) */
        /* The by-name fallback is for BARE reads only (a baked chain marks them):
         * an explicit `A::B::C` must resolve inside B, or miss — otherwise a
         * same-named constant elsewhere answers it, and a pending autoload on B
         * never gets its chance. */
        if (idx == UINT32_MAX) idx = korb_const_index(vm, name_sym);            /* finally any namespace (koruby's flat fallback) */
    } else {                                          /* bare read with no NAMED enclosing class */
        /* The cref may still exist at runtime and have no name: a `class << obj`
         * body (self IS the singleton) or a method defined in one (the method
         * entry's owner).  korb_cvar_cref answers both, the same way class
         * variables resolve their cref. */
        const VALUE cref = (self_off == INT32_MIN) ? KORB_NIL
                         : (dc_off != INT32_MIN ? korb_cvar_cref(slots[self_off], slots[dc_off])   /* method frame: entry->owner */
                                                : (KORB_CLASS_P(slots[self_off]) ? slots[self_off] : KORB_NIL));
        idx = KORB_CLASS_P(cref) ? korb_const_index_owned(vm, name_sym, cref) : UINT32_MAX;
        if (idx == UINT32_MAX && KORB_CLASS_P(cref)) idx = korb_const_in_ancestry(vm, cref, name_sym);
        /* A real top-level constant wins over a same-named nested one.  The
         * table is flat, so a plain first-match would let a prelude-defined
         * `Enumerator::Chain` answer a user's bare `Chain` just because it was
         * registered first.  The flat fallback stays: koruby still exposes
         * nested constants unqualified. */
        if (idx == UINT32_MAX) idx = korb_const_index_owned(vm, name_sym, KORB_NIL);
        if (idx == UINT32_MAX) idx = korb_const_index(vm, name_sym);
    }
    if (UNLIKELY(idx == UINT32_MAX)) {
        /* Truly absent (no table entry).  A constant whose *value* is nil
         * (`X = nil`) has a valid idx and falls through to return that nil —
         * nil is a legitimate constant value, distinct from "not defined".
         * global variables ($x) share this table but are nil (not NameError) when
         * unset; constants raise.  The interned name keeps the leading '$'. */
        if (owner_name == 0 && korb_sym_name(vm, name_sym)[0] == '$') return RESULT_OK(KORB_NIL);
        if (owner_name != 0) {
            /* Fire the const_missing hook on the owning module: <owner>.const_missing(:name).
             * The prelude default re-raises NameError (so an unhandled miss behaves as
             * before); a user override returns a value. */
            const VALUE owner_cls = korb_const_get(vm, owner_name);
            if (KORB_CLASS_P(owner_cls)) {
                slots[0] = owner_cls;
                slots[1] = ID2SYM(name_sym);
                return korb_send(c, slots + 2, korb_intern(vm, "const_missing", 13), 0, 1);
            }
            RESULT nr = korb_raise(c, slots, KORB_E_NAME, 0, "uninitialized constant %s::%s", korb_sym_name(vm, owner_name), korb_sym_name(vm, name_sym));
            if (LIKELY(KORB_EXC_P(nr.value))) {          /* NameError#name = the missing constant symbol */
                slots[0] = nr.value;
                korb_exc_ivar_set(c, slots + 1, VALUE_REF_AT(&slots[0]), ID2SYM(korb_intern(vm, "@__name", 7)), ID2SYM(name_sym));
                nr.value = slots[0];
            }
            return nr;
        }
        {   /* Top-level miss: CRuby fires Object.const_missing(:Name) here too —
             * that is how a top-level `autoload` gets its chance to require the
             * file.  The prelude default re-raises the same NameError. */
            const VALUE objc = korb_const_get(vm, korb_intern(vm, "Object", 6));
            if (KORB_CLASS_P(objc)) {
                slots[0] = objc;
                slots[1] = ID2SYM(name_sym);
                return korb_send(c, slots + 2, korb_intern(vm, "const_missing", 13), 0, 1);
            }
        }
        RESULT nr = korb_raise(c, slots, KORB_E_NAME, 0, "uninitialized constant %s", korb_sym_name(vm, name_sym));
        if (LIKELY(KORB_EXC_P(nr.value))) {              /* NameError#name = the missing constant symbol */
            slots[0] = nr.value;
            korb_exc_ivar_set(c, slots + 1, VALUE_REF_AT(&slots[0]), ID2SYM(korb_intern(vm, "@__name", 7)), ID2SYM(name_sym));
            korb_exc_ivar_set(c, slots + 1, VALUE_REF_AT(&slots[0]), ID2SYM(korb_intern(vm, "@__receiver", 11)), korb_const_get(vm, korb_intern(vm, "Object", 6)));   /* top-level lookup target is Object */
            korb_exc_ivar_set(c, slots + 1, VALUE_REF_AT(&slots[0]), ID2SYM(korb_intern(vm, "@__has_recv", 11)), KORB_TRUE);
            nr.value = slots[0];
        }
        return nr;
    }
    if (LIKELY(c->eval_cref == KORB_NIL)) {            /* eval-scoped answers are context-dependent */
        cache->idx_plus1 = idx + 1;
        cache->serial = vm->const_serial;
    }
    return RESULT_OK(vm->const_vals[idx]);
}

// `defined?(expr)` → a description String or nil (expr is NOT evaluated).
// kind: 0=method-on-self, 1=constant, 2=@ivar, 3=$global, 4="local-variable",
// 5="expression", 6="self", 7="method"(fixed, receiver call), 8="nil",
// 9="true", 10="false".  Fixed kinds ignore id/self_off.
NODE_DEF
node_defined(CTX *c, NODE *n, VALUE *slots, uint32_t kind, uint32_t id@sym, int32_t self_off)
{
    (void)n;
    struct korb_vm *const vm = c->vm;
    const char *res = NULL;
    switch (kind) {
      case 0:
        if (korb_responds_to(c, slots[self_off], id)) { res = "method"; break; }
        for (uint32_t i = 0; i < vm->method_cnt; i++)            /* top-level / global function table */
            if (vm->methods[i]->mid == id) { res = "method"; break; }
        break;
      case 1: { uint32_t i = korb_const_index(vm, id);                                          /* nil-valued constant still counts */
                if (i != UINT32_MAX) { res = "constant"; break; }
                /* inside a module body self IS the module: a pending autoload
                 * there is already "constant" (and must not be loaded to say so) */
                if (korb_autoload_registered_p(c, slots[self_off], id)) res = "constant";
                break; }
      case 2: if (korb_ivar_defined(c, slots[self_off], ID2SYM(id))) res = "instance-variable"; break;   /* membership, not value (nil counts) */
      case 3: { uint32_t i = korb_const_index(vm, id); if (i != UINT32_MAX) res = "global-variable"; break; }   /* a global assigned nil is still defined */
      case 4: res = "local-variable"; break;
      case 5: res = "expression"; break;
      case 6: res = "self"; break;
      case 7: res = "method"; break;
      case 8: res = "nil"; break;
      case 9: res = "true"; break;
      case 10: res = "false"; break;
      case 11: res = "assignment"; break;
      case 12:                                                  /* regexp match global */
        if (id == 200) { res = "global-variable"; break; }      /* $~ is always defined */
        { RESULT br = korb_backref(c, slots, (int)id);          /* $&/$`/$'/$+ (0..3) or $N (100+N) */
          if (br.state == KORB_NORMAL && br.value != KORB_NIL) res = "global-variable"; }
        break;
    }
    if (!res) return RESULT_OK(KORB_NIL);
    RESULT dr = korb_str_new(c, slots, res, (uint32_t)strlen(res));   /* defined? returns a frozen String */
    if (LIKELY(dr.state == KORB_NORMAL) && AROH_IS_GC_OBJECT(dr.value))
        ((AroObjectHeader *)(uintptr_t)dr.value)->flags |= KORB_FL_FROZEN;
    return dr;
}

// defined?(recv.meth): evaluate the receiver (nil if it raises), then report
// "method" only when the receiver actually responds to the method.
NODE_DEF
node_defined_call(CTX *c, NODE *n, VALUE *slots, NODE *recv, uint32_t mid@sym, int32_t self_off)
{
    (void)n;
    RESULT rr = EVAL_ARG(c, recv);
    if (rr.state != KORB_NORMAL) return RESULT_OK(KORB_NIL);   /* receiver raised → nil */
    slots[0] = rr.value;
    if (!korb_defined_call_p(c, slots, mid, self_off)) return RESULT_OK(KORB_NIL);
    RESULT dr = korb_str_new(c, slots + 1, "method", 6);
    if (LIKELY(dr.state == KORB_NORMAL) && AROH_IS_GC_OBJECT(dr.value))
        ((AroObjectHeader *)(uintptr_t)dr.value)->flags |= KORB_FL_FROZEN;
    return dr;
}

// defined?(@@x): "class variable" iff the name is present in the cref's class-
// variable chain (a nil-valued one still counts); nil at toplevel.
NODE_DEF
node_defined_cvar(CTX *c, NODE *n, VALUE *slots, int32_t self_off, int32_t dc_off, uint32_t name@sym)
{
    (void)n;
    const VALUE cref = korb_cvar_cref(slots[self_off], slots[dc_off]);
    if (!KORB_CLASS_P(cref)) return RESULT_OK(KORB_NIL);
    int32_t idx;
    if (korb_cvar_owner(cref, ID2SYM(name), &idx) == KORB_NIL) return RESULT_OK(KORB_NIL);
    RESULT dr = korb_str_new(c, slots, "class variable", 14);
    if (LIKELY(dr.state == KORB_NORMAL) && AROH_IS_GC_OBJECT(dr.value))
        ((AroObjectHeader *)(uintptr_t)dr.value)->flags |= KORB_FL_FROZEN;
    return dr;
}

// defined?(super): "super" iff the enclosing method has an MRO successor of the
// same name — resolved exactly as `super` would, but without calling it.
NODE_DEF
node_defined_super(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, int32_t self_off, int32_t dc_off)
{
    (void)n;
    if (korb_super_find(c, mid, slots[dc_off], slots[self_off], NULL) == NULL) return RESULT_OK(KORB_NIL);
    RESULT dr = korb_str_new(c, slots, "super", 5);
    if (LIKELY(dr.state == KORB_NORMAL) && AROH_IS_GC_OBJECT(dr.value))
        ((AroObjectHeader *)(uintptr_t)dr.value)->flags |= KORB_FL_FROZEN;
    return dr;
}

// `A::B` — evaluate the parent namespace expression, then look B up in it and
// its ancestors (never in the parent's lexical surroundings, and never by bare
// name).  A miss goes through const_missing, which is what fires an autoload.
NODE_DEF @noinline
node_const_path(CTX *c, NODE *n, VALUE *slots, uint32_t name@sym, NODE *parent)
{
    (void)n;
    const RESULT pr = EVAL_ARG(c, parent);
    if (UNLIKELY(pr.state != KORB_NORMAL)) return pr;
    slots[0] = pr.value;                                  /* the namespace (rooted for const_missing) */
    struct korb_vm *const vm = c->vm;
    if (UNLIKELY(!KORB_CLASS_P(slots[0]))) {           /* `13::X` — CRuby names the VALUE, not its class */
        char *ib = NULL; size_t iz = 0;
        FILE *const ims = open_memstream(&ib, &iz);
        if (ims) { korb_fprint_inspect_s(c, slots + 1, ims, slots[0]); fclose(ims); }
        RESULT tr = korb_raise(c, slots + 1, KORB_E_TYPE, 0, "%s is not a class/module", ib ? ib : "value");
        free(ib);
        return tr;
    }
    uint32_t idx = korb_const_index_owned(vm, name, slots[0]);
    if (idx == UINT32_MAX) idx = korb_const_in_ancestry(vm, slots[0], name);
    if (idx == UINT32_MAX)                                /* then top-level / builtin constants (owner nil) */
        idx = korb_const_index_owned(vm, name, KORB_NIL);
    if (UNLIKELY(vm->privconst_cnt != 0) &&               /* private_constant: unreachable as Owner::NAME */
        (idx != UINT32_MAX || korb_autoload_registered_p(c, slots[0], name)) &&
        korb_const_private_p(vm, slots[0], name))
        return korb_raise(c, slots + 1, KORB_E_NAME, 0, "private constant %s::%s referenced",
                          korb_sym_name(vm, VAL2CLASS(slots[0])->name_sym), korb_sym_name(vm, name));
    if (LIKELY(idx != UINT32_MAX)) return RESULT_OK(vm->const_vals[idx]);
    slots[1] = ID2SYM(name);                              /* <owner>.const_missing(:name) — autoload's entry point */
    return korb_send(c, slots + 2, korb_intern(vm, "const_missing", 13), 0, 1);
}

// defined?(A::B::C) — a nested (or otherwise non-bare) parent: evaluate the parent
// path (nil if it raises, i.e. any segment is undefined), then run the same
// owner-aware membership test as the static two-segment form.
NODE_DEF
node_defined_cpath_dyn(CTX *c, NODE *n, VALUE *slots, NODE *parent, uint32_t name@sym)
{
    (void)n;
    const RESULT pr = EVAL_ARG(c, parent);
    if (pr.state != KORB_NORMAL) return RESULT_OK(KORB_NIL);      /* parent undefined → nil */
    if (!KORB_CLASS_P(pr.value)) return RESULT_OK(KORB_NIL);
    struct korb_vm *const vm = c->vm;
    uint32_t idx = korb_const_index_owned(vm, name, pr.value);
    if (idx == UINT32_MAX) idx = korb_const_in_ancestry(vm, pr.value, name);   /* inherited counts */
    if (idx == UINT32_MAX && !korb_autoload_registered_p(c, pr.value, name))   /* a pending autoload counts too */
        return RESULT_OK(KORB_NIL);
    RESULT dr = korb_str_new(c, slots, "constant", 8);
    if (LIKELY(dr.state == KORB_NORMAL) && AROH_IS_GC_OBJECT(dr.value))
        ((AroObjectHeader *)(uintptr_t)dr.value)->flags |= KORB_FL_FROZEN;
    return dr;
}

// defined?(A::B): owner-aware — nil when the parent module A is undefined or B is
// not a constant of A (or its ancestors); "constant" otherwise.  A is resolved by
// its (rightmost) name from the flat table, so top-level `M::X` works; a lexically
// scoped or dynamic parent falls back to the flat probe (node_defined kind 1).
NODE_DEF
node_defined_cpath(CTX *c, NODE *n, VALUE *slots, uint32_t owner_name@sym, uint32_t name@sym)
{
    (void)n;
    struct korb_vm *const vm = c->vm;
    const VALUE owner = korb_const_get(vm, owner_name);
    if (!KORB_CLASS_P(owner)) return RESULT_OK(KORB_NIL);         /* parent undefined / not a module */
    uint32_t idx = korb_const_index_owned(vm, name, owner);
    if (idx == UINT32_MAX) idx = korb_const_in_ancestry(vm, owner, name);   /* inherited constants count */
    if (idx == UINT32_MAX && !korb_autoload_registered_p(c, owner, name))   /* a pending autoload counts too */
        return RESULT_OK(KORB_NIL);                                          /* nil-valued constant still counts as defined */
    RESULT dr = korb_str_new(c, slots, "constant", 8);
    if (LIKELY(dr.state == KORB_NORMAL) && AROH_IS_GC_OBJECT(dr.value))
        ((AroObjectHeader *)(uintptr_t)dr.value)->flags |= KORB_FL_FROZEN;
    return dr;
}

// defined?(yield): "yield" iff a block was passed to the enclosing method.
NODE_DEF @nogc
node_defined_yield(CTX *c, NODE *n, VALUE *slots, int32_t biseq_off)
{
    (void)n;
    if (!((uintptr_t)slots[biseq_off] & 1u)) return RESULT_OK(KORB_NIL);
    RESULT dr = korb_str_new(c, slots, "yield", 5);
    if (LIKELY(dr.state == KORB_NORMAL) && AROH_IS_GC_OBJECT(dr.value))
        ((AroObjectHeader *)(uintptr_t)dr.value)->flags |= KORB_FL_FROZEN;
    return dr;
}

// constant write (`FOO = expr`) — stores into the VM const table (libc-backed,
// root-scanned), returns the value.
NODE_DEF
node_const_set(CTX *c, NODE *n, VALUE *slots, uint32_t name_sym@sym, uint32_t owner_name@sym, int32_t self_off, struct korb_constcache *cache@ref, VALUE val@child)
{
    (void)n; (void)slots;
    /* owner_name = the lexically-enclosing module's const name, baked at parse
     * time (0 = top-level / global var); the baked chain pins WHICH module of
     * that name, so a write inside `M2::A` never lands in an earlier `M1::A`.
     * Only real classes/modules count as an owner. */
    const VALUE owner = owner_name ? korb_cref_resolve(c->vm, cache->owner_chain, cache->chain_len, owner_name) : KORB_NIL;
    /* an unnamed cref (`class << obj`) can only be named by the running self;
     * inside an eval'd string the cref the eval was given wins (CRuby) */
    /* a global ($x) shares this table but is never owned by a module */
    const bool is_gvar = korb_sym_name(c->vm, name_sym)[0] == '$';
    const VALUE ownc = is_gvar ? KORB_NIL
                     : KORB_CLASS_P(owner) ? owner
                     : KORB_CLASS_P(c->eval_cref) ? c->eval_cref
                     : (self_off != INT32_MIN && KORB_CLASS_P(slots[self_off]) ? slots[self_off] : KORB_NIL);
    /* the typed predefined globals are checked on assignment (CRuby) */
    { const char *const gn = korb_sym_name(c->vm, name_sym);
      if (UNLIKELY(gn[0] == '$')) {
          if ((strcmp(gn, "$stdout") == 0 || strcmp(gn, "$stderr") == 0) &&
              !korb_responds_to(c, val, korb_intern(c->vm, "write", 5)))
              return korb_raise(c, slots, KORB_E_TYPE, 0, "%s must have write method, %s given",
                                gn, korb_type_name(val));
          if (strcmp(gn, "$~") == 0 && val != KORB_NIL && !KORB_MATCHDATA_P(val))
              return korb_raise(c, slots, KORB_E_TYPE, 0, "wrong argument type %s (expected MatchData)",
                                korb_coerce_name(c, val));
          if (strcmp(gn, "$/") == 0 || strcmp(gn, "$-0") == 0 || strcmp(gn, "$\\") == 0) {
              /* the record separators take a String (no #to_str) or nil; `$/` also
               * freezes a copy, so a later mutation cannot change the separator */
              if (val != KORB_NIL) {
                  if (!KORB_STRING_P(val))
                      return korb_raise(c, slots, KORB_E_TYPE, 0, "value of %s must be String", gn);
                  if (gn[1] != '\\' && !(((const AroObjectHeader *)(uintptr_t)val)->flags & KORB_FL_FROZEN)) {
                      slots[0] = val;                     /* park: the copy allocates (the source can move) */
                      RESULT dup = korb_str_dup_pub(c, slots + 1, &slots[0]);
                      if (UNLIKELY(dup.state != KORB_NORMAL)) return dup;
                      ((AroObjectHeader *)(uintptr_t)dup.value)->flags |= KORB_FL_FROZEN;
                      val = dup.value;
                  }
              }
              if (strcmp(gn, "$/") == 0 || strcmp(gn, "$-0") == 0) {   /* the two names are one variable */
                  const uint32_t other = korb_intern(c->vm, gn[1] == '/' ? "$-0" : "$/", gn[1] == '/' ? 3 : 2);
                  korb_const_define_owned(c, other, val, KORB_NIL);
              }
          }
          if (strcmp(gn, "$.") == 0 && !FIXNUM_P(val)) {   /* the line counter takes any #to_int */
              VALUE iv = val;
              const char *const on = korb_coerce_name(c, iv);
              RESULT ir = korb_coerce_to_int_pub(c, slots, &iv);
              if (UNLIKELY(ir.state != KORB_NORMAL)) return ir;
              if (ir.value == KORB_FALSE)
                  return korb_raise(c, slots, KORB_E_TYPE, 0, "no implicit conversion of %s into Integer", on);
              val = iv;
          }
      } }
    /* reassigning an existing constant warns (the name table doubles as the
     * global-variable table — `$x = 1` is a plain assignment, never a warning) */
    if (UNLIKELY(korb_const_index_owned(c->vm, name_sym, ownc) != UINT32_MAX) &&
        korb_sym_name(c->vm, name_sym)[0] != '$')
        { uint32_t wf, wl;                                /* warn with this assignment's position */
          if (korb_get_srcloc(c->vm, n, &wf, &wl)) korb_warn_const_redef_at(c, slots, name_sym, ownc, korb_sym_name(c->vm, wf), wl);
          else korb_warn_const_redef(c, slots, name_sym, ownc); }
    korb_const_define_owned(c, name_sym, val, ownc);
    { uint32_t fsym, fline;                              /* Module#const_source_location */
      if (korb_get_srcloc(c->vm, n, &fsym, &fline)) korb_const_reg_loc(c->vm, name_sym, ownc, fsym, fline); }
    if (UNLIKELY(ownc != KORB_NIL)) {                     /* fire const_added(name) if the module defines the hook */
        const uint32_t ca = korb_intern(c->vm, "const_added", 11);
        if (UNLIKELY(korb_mod_hook_custom(c, ownc, ca))) {
            slots[0] = val;                              /* root val across the hook's GC */
            slots[1] = ownc; slots[2] = ID2SYM(name_sym);
            RESULT hr = korb_send(c, slots + 3, ca, 0, 1);
            if (UNLIKELY(hr.state != KORB_NORMAL)) return hr;
            return RESULT_OK(slots[0]);                  /* re-read (may have moved) */
        }
    }
    return RESULT_OK(val);
}

// Call nodes: argc staged children sit contiguously at slots[-argc..-1],
// which IS the callee's parameter window (frame base = slots - argc).
// korb_call positions the callee cursor at base + locals_cnt.

// `self_off` reads the CALLER's self cell (base[fs-1], baked -1-chain); a
// no-receiver call propagates it as the callee's self (Ruby implicit self).

// implicit-self call `mid(args...)` (any fixed arity).  argv@children stages the
// args (no recv — self is slots[self_off]); replaces the call0..3 family.
NODE_DEF @framehdr
node_call(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, struct korb_callcache *cc@ref, struct korb_inlcache *ic@ref, NODE **argv@children)
{
    (void)n;
    /* self is staged as the receiver (argv[0]) → base[-1], uniform with node_send.
     * Inline the cached simple-ISEQ fast path right here so the specialized
     * dispatcher (SD) avoids the cross-module call into korb_call_cached on the
     * hot recursive / implicit-self method-call path (fib/ackermann/method_call/
     * ivar/structacc...).  Mirrors korb_call_cached's two hot branches; anything
     * else (cache miss, CFUNC, attr, non-simple, main-global) falls through. */
    const uint32_t argc = argv_cnt - 1;
    const VALUE self = slots[-(korb_sword_t)argv_cnt];       /* base[-1] (the staged self receiver) */
    if (LIKELY(KORB_OBJECT_P(self))) {
        const VALUE klass = VAL2OBJ(self)->klass;
        if (LIKELY(klass != KORB_NIL)) {                     /* user-instance self-call */
            if (LIKELY(ic->serial == c->vm->method_serial && ic->klass == klass)) {
                struct korb_method *const m = ic->m;
                if (LIKELY(m->kind == KORB_METHOD_ISEQ && m->is_simple))
                    return korb_invoke_simple(c, slots, m, argc, line, mid, self, ic->def_class);
            }
        } else if (LIKELY(cc->serial == c->vm->method_serial && cc->m != NULL &&
                          cc->m->kind == KORB_METHOD_ISEQ && cc->m->is_simple)) {
            return korb_invoke_simple(c, slots, cc->m, argc, line, mid, self, KORB_NIL);   /* top-level global (fib) */
        }
    }
    return korb_call_cached(c, slots, mid, line, cc, ic, argc, self);
}

// Implicit-self call whose trailing arg is a keyword bundle carrying a **splat
// (`m(pos..., **h)` / `m(pos..., k: v, **h)`).  Identical to node_call except an
// empty kwargs Hash is elided (CRuby 3.0 empty-kwsplat rule) so the callee sees
// only the positionals — `m(**{})` reaches a 0-arg method, not a `{}` positional.
// The dropped Hash sits at slots[-1]; dispatching from cur=slots-1 with argc-1
// keeps `base` (and self at base[-1]) at the same absolute slots, so the empty
// Hash simply becomes callee scratch.
NODE_DEF @framehdr
node_call_kws(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, struct korb_callcache *cc@ref, struct korb_inlcache *ic@ref, NODE **argv@children)
{
    (void)n;
    uint32_t argc = argv_cnt - 1;
    VALUE *cur = slots;
    if (LIKELY(argc > 0) && KORB_HASH_P(slots[-1]) && VAL2HASH(slots[-1])->len == 0) { argc--; cur = slots - 1; }
    const VALUE self = slots[-(korb_sword_t)argv_cnt];       /* base[-1] (absolute slot; unchanged by the drop) */
    return korb_call_cached(c, cur, mid, line, cc, ic, argc, self);
}

// Implicit-self keyword call `f(pos..., k: v...)`.  @children stages the pos args
// then the keyword VALUES; `kw_syms` is a baked uint32_t[] of the keyword mids,
// `pos_argc` the positional count (kw count = argv_cnt - pos_argc).  Hash-free
// when the callee permits (korb_call_kw decides).  kw_syms is typed `const char *`
// so the specializer emits a runtime reference (read from `n`) rather than baking
// the per-process pointer — that keeps node_call_kw specializable (children get
// their own SDs) and AOT-safe (SDs sharing across keyword sets read n->kw_syms).
NODE_DEF @framehdr
node_call_kw(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, uint32_t pos_argc, const char *kw_syms, struct korb_callcache *cc@ref, struct korb_inlcache *ic@ref, NODE **argv@children)
{
    (void)n;
    /* self staged as receiver (argv[0]) → base[-1]; pos+kw args follow. */
    return korb_call_kw(c, slots, mid, line, cc, ic, pos_argc, (const uint32_t *)(const void *)kw_syms, argv_cnt - 1 - pos_argc, slots[-(korb_sword_t)argv_cnt]);
}

// ---- call-site splat: f(*arr) / f(a, *arr, b) ------------------------------
//
// `args` is the already-built arguments Array (parser uses the array-splat
// chain).  Spread its N elements into scratch [slots[0..N)] and dispatch with a
// runtime-computed argc.  The slots arena has ~1M cells of headroom above the
// cursor, so the dynamic spread is safe.
NODE_DEF
node_call_splat(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, struct korb_callcache *cc@ref, VALUE_REF args@child)
{
    (void)n; (void)args;
    VALUE self = slots[self_off];
    VALUE arr = slots[-1];                              /* the staged args array */
    uint32_t N = VAL2ARY(arr)->len;
    /* reserve the callee's bottom-header meta cells (base[-3]=magic, base[-2]=EP)
     * below self at base[-1]; korb_call's callee = slots+3+N - N = slots+3. */
    slots[0] = 0;                                       /* base[-3] (magic) */
    slots[1] = 0;                                       /* base[-2] (EP)    */
    slots[2] = self;                                    /* base[-1] (self)  */
    for (uint32_t i = 0; i < N; i++) slots[3 + i] = korb_items_data(VAL2ARY(arr)->items)[i];
    return korb_call(c, slots + 3 + N, mid, line, cc, N, self);
}

// ---- call-site splat WITH a literal/&:sym block: f(*arr) { ... } -----------
//
// Like node_call_splat, but threads a block (a node_entry).  `args` is the
// pre-built arguments Array; spread it above the callee's bottom-header cells
// and dispatch via korb_call_blk.  self_off reads the caller self (= callee
// self for an implicit call = the block's captured lexical self); def_env_off
// (tagged |1u) addresses the caller frame base where the block's free vars live.
// @noinline: the block operand is a per-process NODE pointer (not bakeable), so
// this stays interpreter-dispatched; the block body (node_entry) keeps its own
// AOT entry.
NODE_DEF @noinline
node_call_splat_blk(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, struct korb_callcache *cc@ref, NODE *block, int32_t def_env_off, VALUE_REF args@child)
{
    (void)n; (void)args; (void)block_dispatcher;
    const VALUE self = slots[self_off];
    const VALUE arr = slots[-1];                          /* the staged args array */
    const uint32_t N = VAL2ARY(arr)->len;
    slots[0] = 0;                                         /* base[-3] (magic) */
    slots[1] = 0;                                         /* base[-2] (EP)    */
    slots[2] = self;                                      /* base[-1] (self)  */
    for (uint32_t i = 0; i < N; i++) slots[3 + i] = korb_items_data(VAL2ARY(arr)->items)[i];
    return korb_call_blk(c, slots + 3 + N, mid, line, cc, N, self, block,
                         (VALUE *)((uintptr_t)&slots[def_env_off] | 1u), &slots[self_off]);
}

// `f(*arr, &proc)` (implicit self) — splat call forwarding a runtime Proc.
// Like node_call_blkproc but positionals come from the built Array.
NODE_DEF @noinline
node_call_splat_blkproc(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, int32_t proc_off, struct korb_callcache *cc@ref, VALUE_REF args@child)
{
    (void)n; (void)args;
    RESULT pr = korb_blockarg_to_proc(c, slots, &slots[proc_off], line);   /* &obj → obj.to_proc */
    if (UNLIKELY(pr.state != KORB_NORMAL)) return pr;
    const VALUE pv = slots[proc_off];
    const VALUE self = slots[self_off];
    const VALUE arr = slots[-1];
    const uint32_t N = VAL2ARY(arr)->len;
    slots[0] = 0;                                         /* base[-3] (magic) */
    slots[1] = 0;                                         /* base[-2] (EP)    */
    slots[2] = self;                                      /* base[-1] (self)  */
    for (uint32_t i = 0; i < N; i++) slots[3 + i] = korb_items_data(VAL2ARY(arr)->items)[i];
    if (pv == KORB_NIL) return korb_call(c, slots + 3 + N, mid, line, cc, N, self);   /* &nil → no block */
    NODE *iseq = VAL2PROC(pv)->iseq;
    if (iseq == NULL) iseq = KORB_BLK_CPROC;
    return korb_call_blk(c, slots + 3 + N, mid, line, cc, N, self, iseq, KORB_BLK_FWD, &slots[proc_off]);
}

// ---- receiver method dispatch (x.foo) — built-in methods on core types -----
//
// recv is staged first, then args: [recv | a0 | a1 ...] at slots[-(argc+1)..-1].
// korb_send resolves (class_of(recv), mid) → built-in method fn.

// Unified receiver send: `recv.mid(args...)` for any fixed arity.  `argv@children`
// stages [recv, arg0..arg_{n-1}] into consecutive slots (zero-alloc); the body
// gets only the count (argv_cnt).  Replaces the send0..3 family.  Per-call-site
// inline cache via ic@ref.  Actual `*splat` still uses node_send_splat.
NODE_DEF @framehdr
node_send(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, NODE **argv@children, struct korb_inlcache *ic@ref)
{
    (void)n;
    const uint32_t argc = argv_cnt - 1;
    /* Inline the cached plain-user-instance fast path so the SD skips the
     * cross-module korb_send_cached call for the two hottest method kinds:
     * a simple ISEQ (method_call/object) and an attr/struct reader (ivar/
     * structacc).  The ic->kind == INSTANCE guard is mandatory: a site whose
     * receiver flips class/instance must not reuse a class-method entry. */
    const VALUE recv = slots[-(korb_sword_t)argc - 1];
    if (LIKELY(KORB_OBJECT_P(recv) &&
               !(((const AroObjectHeader *)(uintptr_t)recv)->flags & KORB_FL_HAS_KLASS))) {
        const VALUE klass = VAL2OBJ(recv)->klass;
        if (LIKELY(klass != KORB_NIL && ic->kind == KORB_IC_INSTANCE &&
                   ic->serial == c->vm->method_serial && ic->klass == klass)) {
            struct korb_method *const m = ic->m;
            /* the ic caches only public methods as KORB_IC_INSTANCE (korb_send_cached
             * withholds private/protected), so this hot path needs no visibility
             * check — private/protected sites never satisfy the ic guard above. */
            if (LIKELY(m->kind == KORB_METHOD_ISEQ && m->is_simple))
                return korb_invoke_simple(c, slots, m, argc, line, mid, recv, ic->def_class);
            if (m->kind == KORB_METHOD_ATTR_R) {             /* attr/struct reader: inline shape walk, no cross-module hop */
                const KorbObject *const ob = VAL2OBJ(recv);
                const int32_t idx = korb_shape_index(c->vm, ob->shape_id, m->attr_ivar);
                return RESULT_OK(idx < 0 ? KORB_NIL : korb_items_data(ob->ivars)[idx]);
            }
        }
    }
    /* self_off == INT32_MIN → a synthetic send (op-assign/[]/=== desugar): public,
     * no visibility check.  Otherwise pass the caller's self (base[-1]) for the
     * private (self.foo only) / protected (is_a? owner) guard. */
    const VALUE caller_self = (self_off == INT32_MIN) ? KORB_UNDEF : slots[self_off];
    return korb_send_cached(c, slots, mid, line, argc, ic, caller_self);
}

// Receiver send whose trailing arg is a keyword bundle carrying a **splat
// (`recv.m(pos..., **h)`).  Like node_send but an empty kwargs Hash is elided
// (CRuby 3.0 empty-kwsplat rule): dispatching from cur=slots-1 with argc-1 keeps
// recv at base[-1] and the empty Hash becomes callee scratch.  caller_self is
// still read from the original `slots` (self_off indexes the caller frame).
NODE_DEF @framehdr
node_send_kws(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, NODE **argv@children, struct korb_inlcache *ic@ref)
{
    (void)n;
    uint32_t argc = argv_cnt - 1;
    VALUE *cur = slots;
    if (LIKELY(argc > 0) && KORB_HASH_P(slots[-1]) && VAL2HASH(slots[-1])->len == 0) { argc--; cur = slots - 1; }
    const VALUE caller_self = (self_off == INT32_MIN) ? KORB_UNDEF : slots[self_off];
    return korb_send_cached(c, cur, mid, line, argc, ic, caller_self);
}

// safe navigation `recv&.m(args)`: if recv is nil, yield nil without dispatch.
// (args are staged like a normal send; their evaluation on a nil recv is a
// minor, practically-unobservable deviation from CRuby's lazy arg eval.)
// safe navigation `recv&.m(args...)` (any fixed arity).  argv@children stages
// [recv, args...]; recv is at slots[-argv_cnt].  Replaces send_safe0..2.
NODE_DEF @framehdr
node_send_safe(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, NODE **argv@children)
{
    (void)n;
    if (slots[-(korb_sword_t)argv_cnt] == KORB_NIL) return RESULT_OK(KORB_NIL);
    return korb_send(c, slots, mid, line, argv_cnt - 1);
}

// receiver call with splat: recv.m(*arr).  Staged [recv | args_array] at
// slots[-2..-1]; re-lay out [recv | arg0..argN) at slots[0..N] and dispatch.
NODE_DEF
node_send_splat(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, VALUE_REF recv@child, VALUE_REF args@child)
{
    (void)n; (void)recv; (void)args;
    VALUE rv = slots[-2];
    VALUE arr = slots[-1];
    uint32_t N = VAL2ARY(arr)->len;
    slots[0] = rv;
    for (uint32_t i = 0; i < N; i++) slots[1 + i] = korb_items_data(VAL2ARY(arr)->items)[i];
    return korb_send(c, slots + N + 1, mid, line, N);
}

// receiver call with splat AND a literal/&:sym block: recv.m(*arr) { ... }.
// Like node_send_splat, but threads a block (node_entry) via korb_send_blk.
// self_off reads the caller self (block's captured lexical self); def_env_off
// (tagged |1u) is the caller frame base.  @noinline for the same reason as
// node_call_splat_blk (per-process block NODE pointer).
NODE_DEF @noinline
node_send_splat_blk(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, NODE *block, int32_t def_env_off, VALUE_REF recv@child, VALUE_REF args@child)
{
    (void)n; (void)recv; (void)args; (void)block_dispatcher;
    const VALUE rv = slots[-2];
    const VALUE arr = slots[-1];
    const uint32_t N = VAL2ARY(arr)->len;
    slots[0] = rv;
    for (uint32_t i = 0; i < N; i++) slots[1 + i] = korb_items_data(VAL2ARY(arr)->items)[i];
    return korb_send_blk(c, slots + N + 1, mid, line, N, block,
                         (VALUE *)((uintptr_t)&slots[def_env_off] | 1u), &slots[self_off]);
}

// `recv.m(*arr, &proc)` — receiver call with splat AND a forwarded runtime Proc.
// Like node_send_blkproc but the positional args come from the built Array.
// proc_off is a rooted caller-frame slot holding the &-expression; coerce it to
// a Proc, then dispatch with KORB_BLK_FWD (korb_block_yield re-reads proc->env
// per yield, so a moved escaped env is never stale).
NODE_DEF @noinline
node_send_splat_blkproc(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t proc_off, VALUE_REF recv@child, VALUE_REF args@child)
{
    (void)n; (void)recv; (void)args;
    RESULT pr = korb_blockarg_to_proc(c, slots, &slots[proc_off], line);   /* &obj → obj.to_proc */
    if (UNLIKELY(pr.state != KORB_NORMAL)) return pr;
    const VALUE pv = slots[proc_off];
    const VALUE rv = slots[-2];
    const VALUE arr = slots[-1];
    const uint32_t N = VAL2ARY(arr)->len;
    slots[0] = rv;
    for (uint32_t i = 0; i < N; i++) slots[1 + i] = korb_items_data(VAL2ARY(arr)->items)[i];
    if (pv == KORB_NIL) return korb_send(c, slots + N + 1, mid, line, N);   /* &nil → no block */
    NODE *iseq = VAL2PROC(pv)->iseq;
    if (iseq == NULL) iseq = KORB_BLK_CPROC;             /* Symbol/Method#to_proc: forward as a C-proc block */
    return korb_send_blk(c, slots + N + 1, mid, line, N, iseq, KORB_BLK_FWD, &slots[proc_off]);
}

// `recv[idx]` — type-fast-path for Array + fixnum index (the hot case); any
// other receiver / index kind (Hash, String, Range, 2-arg, user) or a redefined
// Array#[] deopts to a real `[]` send.
NODE_DEF
node_aref(CTX *c, NODE *n, VALUE *slots, uint32_t line, VALUE_REF recv@child, VALUE idx@child)
{
    (void)n;
    const VALUE r = VALUE_REF_GET(recv);
    if (LIKELY(KORB_ARRAY_P(r) && FIXNUM_P(idx) && !c->vm->aref_redefined)) {
        const KorbArray *const a = VAL2ARY(r);
        korb_sword_t i = FIX2LONG(idx);
        if (i < 0) i += (korb_sword_t)a->len;
        if (LIKELY((uintptr_t)i < a->len)) return RESULT_OK(korb_items_data(a->items)[i]);
        return RESULT_OK(KORB_NIL);
    }
    if (FIXNUM_P(r) && FIXNUM_P(idx) && !c->vm->int_aref_redefined) {   /* int[bit] = (n>>i)&1 single-bit test, skip send+dispatch+builtin (optcarrot ~5M/run) */
        const korb_sword_t n = FIX2LONG(r);
        const korb_sword_t i = FIX2LONG(idx);
        if (i < 0)   return RESULT_OK(LONG2FIX(0));            /* bits below 0 don't exist */
        if (i >= 63) return RESULT_OK(LONG2FIX(n < 0 ? 1 : 0));/* beyond Fixnum width = sign extension */
        return RESULT_OK(LONG2FIX((n >> i) & 1));
    }
    if (LIKELY(KORB_HASH_P(r) && !c->vm->hash_aref_redefined && !KORB_OBJECT_P(idx))) {   /* hash[key] → inline lookup, skip the send + dispatch (user-object key falls to the CTX-aware method for custom eql?/hash) */
        const KorbHash *const h = VAL2HASH(r);
        const int32_t hi = korb_hash_find(h, idx);
        if (hi >= 0) return RESULT_OK(korb_items_data(h->items)[2 * hi + 1]);
        if (LIKELY(h->default_proc == KORB_NIL)) return RESULT_OK(h->default_val);   /* miss → default (proc case falls to send) */
    }
    if (KORB_METHOD_P(r) && !c->vm->method_aref_redefined) {   /* meth[arg] = Method#[] = recv.mid(arg): collapse the [] + meth_call double dispatch (optcarrot @fetch[addr][addr], ~7M/run) */
        const KorbMethod *const m = VAL2METH(r);
        if (LIKELY(!m->unbound)) {
            slots[0] = m->recv;   /* new receiver (rooted in scratch across the send) */
            slots[1] = idx;       /* arg0 */
            return korb_send(c, slots + 2, m->mid, line, 1);
        }
    }
    slots[0] = idx;   /* recv already rooted at slots[-1]; stage only the index — deopt → [] send */
    return korb_send(c, slots + 1, c->vm->mid_aref, line, 1);
}

// `recv[idx] = val` — type-fast-path for Array + in-range fixnum index; growth /
// other receivers / redefined Array#[]= deopt to a real `[]=` send.
NODE_DEF
node_aset(CTX *c, NODE *n, VALUE *slots, uint32_t line, VALUE_REF recv@child, VALUE_REF idx@child, VALUE val@child)
{
    (void)n;
    const VALUE r = VALUE_REF_GET(recv);
    const VALUE iv = VALUE_REF_GET(idx);
    if (LIKELY(KORB_ARRAY_P(r) && FIXNUM_P(iv) && !c->vm->aref_redefined)) {
        KORB_CHECK_FROZEN_HEAP(c, slots, r, "Array");
        const KorbArray *const a = VAL2ARY(r);
        korb_sword_t i = FIX2LONG(iv);
        if (i < 0) i += (korb_sword_t)a->len;
        if (LIKELY(i >= 0 && (uintptr_t)i < a->len)) {     /* in-range: in-place store */
            korb_ary_store_at(c, r, (uint32_t)i, val);
            return RESULT_OK(val);
        }
        /* out of range (Ruby grows + nil-pads) → deopt to []= */
    }
    slots[0] = r; slots[1] = iv; slots[2] = val;           /* deopt → []= send */
    return korb_send(c, slots + 3, c->vm->mid_aset, line, 2);
}

// ---- array literals --------------------------------------------------------
//
// `[a, b, c]` lowers to a push chain: ary_push(ary_push(ary_push(new(3),a),b),c)
// (variadic @child is unsupported, so the literal is built inside-out).

NODE_DEF
node_array_new(CTX *c, NODE *n, VALUE *slots, uint32_t capa)
{
    (void)n;
    return korb_ary_new(c, slots, capa);
}

NODE_DEF
node_ary_push(CTX *c, NODE *n, VALUE *slots, VALUE_REF ary@child, VALUE elem@child)
{
    (void)n;
    KorbArray *const a = VAL2ARY(VALUE_REF_GET(ary));
    if (LIKELY(a->len < a->capa)) {            /* literal arrays are pre-sized → room guaranteed: small LTO-inlinable store */
        korb_ary_store_at(c, VALUE_REF_GET(ary), a->len, elem);
        a->len++;
        return RESULT_OK(VALUE_REF_GET(ary));
    }
    return korb_ary_push_val(c, slots, ary, elem);
}

// node_ary_push for a call-site trailing keyword bundle (`m(*a, **h)` staging):
// an EMPTY kwargs Hash is elided (CRuby 3.0 empty-kwsplat rule) so the splat
// dispatch sees only the positionals — `m(*a, **{})` must not grow a `{}` arg.
NODE_DEF
node_ary_push_kw(CTX *c, NODE *n, VALUE *slots, VALUE_REF ary@child, VALUE elem@child)
{
    (void)n;
    if (KORB_HASH_P(elem) && VAL2HASH(elem)->len == 0) return RESULT_OK(VALUE_REF_GET(ary));
    KorbArray *const a = VAL2ARY(VALUE_REF_GET(ary));
    if (LIKELY(a->len < a->capa)) {
        korb_ary_store_at(c, VALUE_REF_GET(ary), a->len, elem);
        a->len++;
        return RESULT_OK(VALUE_REF_GET(ary));
    }
    return korb_ary_push_val(c, slots, ary, elem);
}

NODE_DEF
node_ary_concat(CTX *c, NODE *n, VALUE *slots, VALUE_REF ary@child, VALUE elem@child)
{
    (void)n;
    return korb_ary_concat_val(c, slots, ary, elem);   /* splat: spread elem into ary */
}

// ---- hash literals ---------------------------------------------------------
//
// `{k => v, ...}` lowers to a set chain: hash_set(hash_set(hash_new(n),k0,v0)...).

NODE_DEF
node_hash_new(CTX *c, NODE *n, VALUE *slots, uint32_t capa)
{
    (void)n;
    return korb_hash_new(c, slots, capa);
}

NODE_DEF
node_hash_set(CTX *c, NODE *n, VALUE *slots, VALUE_REF hash@child, VALUE_REF key@child, VALUE val@child)
{
    (void)n;
    return korb_hash_set(c, slots, hash, key, val);
}

NODE_DEF
node_hash_merge(CTX *c, NODE *n, VALUE *slots, VALUE_REF hash@child, VALUE src@child)
{
    (void)n;
    return korb_hash_merge_val(c, slots, hash, src);   /* **src: merge src's pairs into hash */
}

// ---- range literals --------------------------------------------------------
//
// `b..e` / `b...e`.  begin staged (VALUE_REF), end in a register.

NODE_DEF
node_range_new(CTX *c, NODE *n, VALUE *slots, uint32_t exclude_end, VALUE_REF rbegin@child, VALUE rend@child)
{
    (void)n;
    return korb_range_new(c, slots, rbegin, rend, exclude_end);
}

// ---- string interpolation --------------------------------------------------
//
// `"a#{x}b"` lowers to a concat chain over the parts (same inside-out shape as
// array literals): dstr_concat(dstr_concat(str(""), "a"-or-x), ...).  `acc` is
// always a String; `part` is any value, appended via its to_s.

NODE_DEF
node_dstr_concat(CTX *c, NODE *n, VALUE *slots, VALUE_REF acc@child, VALUE part@child)
{
    (void)n;
    return korb_str_interp(c, slots, acc, part);
}

// ---- blocks / yield / closures (M1, docs/v2_blocks_design.md) ---------------

// Entry node: the dispatch root of a block (like a method body — registered
// in code_repo, its own AOT entry).  Carries the block's arity; `yield`
// reads params/locals off it (korb_entry_*) to size the block frame, then
// dispatches it (EVAL evaluates the body at the block-frame cursor).
NODE_DEF
node_entry(CTX *c, NODE *n, VALUE *slots, NODE *body, uint32_t params_cnt, uint32_t locals_cnt, uint32_t destructure_n, void *destructure_spec, uint32_t cap_depth, void *cap_ns, int32_t rest_slot, void *opt_defaults, uint32_t req_cnt, void *kw_info, void *param_info, int32_t blk_param_slot)
{
    (void)n; (void)params_cnt; (void)locals_cnt; (void)destructure_n; (void)destructure_spec; (void)cap_depth; (void)cap_ns; (void)rest_slot; (void)opt_defaults; (void)req_cnt; (void)kw_info; (void)param_info; (void)blk_param_slot;
    return EVAL_ARG(c, body);
}

// `alias new old` — copy the method `old` to `new` on the enclosing class
// (self at base[self_off]).  Bare names are interned to ids at parse time.
NODE_DEF
node_alias(CTX *c, NODE *n, VALUE *slots, uint32_t new_sym@sym, uint32_t old_sym@sym, int32_t self_off)
{
    (void)n;
    return korb_do_alias(c, slots, slots[self_off], new_sym, old_sym);
}

// `undef foo, bar` — retire the named instance methods on the enclosing class
// (self at base[self_off]).  `mids` is an immortal uint32 id array (runtime-ref so
// the SD stays shared).  Retiring a slot's mid lets lookup fall through; a name
// not defined on this class is tolerated (no NameError, eases drop-in loading).
NODE_DEF
node_undef(CTX *c, NODE *n, VALUE *slots, const char *mids, uint32_t cnt, int32_t self_off)
{
    (void)n;
    const VALUE cls = slots[self_off];
    if (UNLIKELY(!KORB_CLASS_P(cls)))
        return korb_raise(c, slots, KORB_E_TYPE, 0, "undef outside a class/module body");
    KorbClass *const k = VAL2CLASS(cls);
    const uint32_t *const ids = (const uint32_t *)(const void *)mids;
    for (uint32_t j = 0; j < cnt; j++)
        for (uint32_t i = 0; i < k->method_cnt; i++)
            if (k->methods[i]->mid == ids[j]) { k->methods[i]->mid = UINT32_MAX; break; }
    c->vm->method_serial++;                             /* method table changed → flush caches */
    return RESULT_OK(KORB_NIL);
}

// `Module.nesting` — build the lexical nesting array from parse-baked const
// names (innermost first), resolving each to its live class object.  Names that
// don't resolve to a class (anonymous / not yet defined) are skipped.
NODE_DEF
node_nesting(CTX *c, NODE *n, VALUE *slots, const char *name_syms, uint32_t name_cnt)
{
    (void)n;
    const uint32_t *const ids = (const uint32_t *)(const void *)name_syms;
    slots[0] = UNWRAP(korb_ary_new(c, slots, name_cnt));
    VALUE_REF arr = VALUE_REF_AT(&slots[0]);
    for (uint32_t i = 0; i < name_cnt; i++) {
        const VALUE cls = korb_const_get(c->vm, ids[i]);
        if (KORB_CLASS_P(cls)) CHECK(korb_ary_push_val(c, slots + 1, arr, cls));
    }
    return RESULT_OK(VALUE_REF_GET(arr));
}

// Call with a literal block.  `def_env_off` is parse-baked: &slots[def_env_off]
// is the CALLER's frame base = where the block's captured outer vars live.
// @noinline: the block operand is a per-process NODE pointer (not bakeable),
// so this stays interpreter-dispatched; the block body (node_entry) is its
// own AOT entry, so blocks are still specialized.
// `self_off` reads the caller's self cell — for a no-receiver call it is both
// the callee's self and the block's captured (lexical) self.
// implicit-self call with a literal block, any fixed arity.  argv@children stages
// the args (no recv).  Replaces call_blk0..1.
NODE_DEF @noinline @framehdr
node_call_blk(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, struct korb_callcache *cc@ref, NODE *block, int32_t def_env_off, NODE **argv@children)
{
    (void)n; (void)block_dispatcher;
    /* self staged as receiver (argv[0]) → base[-1]; it is also the block's captured
     * self.  def_env carries the raw PREV: tag the live slots base odd (eget path). */
    VALUE *const self_cell = &slots[-(korb_sword_t)argv_cnt];
    return korb_call_blk(c, slots, mid, line, cc, argv_cnt - 1, *self_cell, block,
                         (VALUE *)((uintptr_t)&slots[def_env_off] | 1u), self_cell);
}

// `m(args, &proc)` (implicit self) — forward a runtime Proc as the block.  Like
// node_send_blkproc but for an implicit-self call (no staged receiver).
NODE_DEF @noinline @framehdr
node_call_blkproc(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, struct korb_callcache *cc@ref, int32_t proc_off, NODE **argv@children)
{
    (void)n;
    RESULT pr = korb_blockarg_to_proc(c, slots, &slots[proc_off], line);   /* &obj → obj.to_proc (slots[0..] is free scratch) */
    if (UNLIKELY(pr.state != KORB_NORMAL)) return pr;
    const VALUE pv = slots[proc_off];
    NODE *iseq = NULL;
    if (pv != KORB_NIL) {                                /* coercion guaranteed a Proc (or nil) */
        iseq = VAL2PROC(pv)->iseq;
        if (iseq == NULL) iseq = KORB_BLK_CPROC;         /* Symbol/Method#to_proc: forward as a C-proc block */
    }
    /* self staged as receiver (argv[0]) → base[-1]. */
    return korb_call_blk(c, slots, mid, line, cc, argv_cnt - 1, slots[-(korb_sword_t)argv_cnt], iseq,
                         iseq ? KORB_BLK_FWD : NULL, &slots[proc_off]);
}

// `def m(&blk)` prologue: materialize the passed block into the &blk local as a
// Proc (or nil if no block given).  Reads the frame's block cells (biseq/def_env/
// cself); korb_make_proc handles escape if the block captures outer locals.
NODE_DEF
node_blkparam(CTX *c, NODE *n, VALUE *slots, int32_t dst_off, int32_t biseq_off, int32_t def_env_off, int32_t cself_off)
{
    (void)n;
    VALUE bi = slots[biseq_off];
    if (!(bi & 1u)) { slots[dst_off] = KORB_NIL; return RESULT_OK(KORB_NIL); }   /* no block given */
    NODE *iseq  = (NODE *)(uintptr_t)(bi & ~(uintptr_t)1u);
    if (iseq == KORB_BLK_CPROC) {                        /* &b of a forwarded Symbol/Method#to_proc: hand back the proc itself */
        slots[dst_off] = slots[cself_off];
        return RESULT_OK(slots[cself_off]);
    }
    VALUE *denv = (VALUE *)(uintptr_t)((uintptr_t)slots[def_env_off] & ~(uintptr_t)1u);
    if (denv == KORB_BLK_FWD) {                          /* &b of a forwarded runtime Proc: hand back the proc itself */
        slots[dst_off] = slots[cself_off];               /* cself holds the forwarded Proc */
        return RESULT_OK(slots[cself_off]);
    }
    VALUE cself = slots[cself_off];
    RESULT pr = korb_make_proc(c, slots, iseq, denv, cself, 0);
    if (UNLIKELY(pr.state != KORB_NORMAL)) return pr;
    slots[dst_off] = pr.value;
    return RESULT_OK(pr.value);
}

// proc { } / lambda { } / ->{ } — reify a literal block into a Proc object.
// `block` is the block's node_entry; def_env_off = the defining frame base
// (captured env), self_off = the lexical self.  Captures, does not invoke.
NODE_DEF @noinline
node_make_proc(CTX *c, NODE *n, VALUE *slots, NODE *block, int32_t def_env_off, int32_t self_off, uint32_t is_lambda)
{
    (void)n; (void)block_dispatcher;
    return korb_make_proc(c, slots, block, &slots[def_env_off], slots[self_off], is_lambda);
}

// Flip-flop (`if a..b`): a two-state sed/awk range condition, its state kept on
// the node.  Inclusive (`..`): once ON, the same evaluation also tests the right
// side, so a single line can turn it on and off again.  Exclusive (`...`): the
// right side is not tested until the next evaluation.
NODE_DEF @noinline
node_flipflop(CTX *c, NODE *n, VALUE *slots, NODE *lhs, NODE *rhs, uint32_t excl, struct korb_oncecell *st@ref)
{
    (void)n;
    if (!st->done) {
        const RESULT l = EVAL_ARG(c, lhs);
        if (UNLIKELY(l.state != KORB_NORMAL)) return l;
        if (!KORB_TRUTHY(l.value)) return RESULT_OK(KORB_FALSE);
        st->done = 1;
        if (!excl) {                                   /* `..`: the same pass may already close it */
            const RESULT r = EVAL_ARG(c, rhs);
            if (UNLIKELY(r.state != KORB_NORMAL)) return r;
            if (KORB_TRUTHY(r.value)) st->done = 0;
        }
        return RESULT_OK(KORB_TRUE);
    }
    const RESULT r = EVAL_ARG(c, rhs);
    if (UNLIKELY(r.state != KORB_NORMAL)) return r;
    if (KORB_TRUTHY(r.value)) st->done = 0;
    return RESULT_OK(KORB_TRUE);
}

// `END { }` — register the block as an at_exit handler.  CRuby registers each
// END site once however often it is reached, so the node carries a done flag.
NODE_DEF @noinline
node_end_block(CTX *c, NODE *n, VALUE *slots, NODE *block, int32_t def_env_off, int32_t self_off, struct korb_oncecell *once@ref)
{
    (void)n; (void)block_dispatcher;
    if (once->done) return RESULT_OK(KORB_NIL);
    once->done = 1;
    slots[0] = korb_const_get(c->vm, korb_intern(c->vm, "$__at_exit", 10));
    if (UNLIKELY(!KORB_ARRAY_P(slots[0]))) return RESULT_OK(KORB_NIL);
    const RESULT pr = korb_make_proc(c, slots + 1, block, &slots[def_env_off], slots[self_off], 0);
    if (UNLIKELY(pr.state != KORB_NORMAL)) return pr;
    slots[1] = pr.value;
    CHECK(korb_ary_push_val(c, slots + 2, VALUE_REF_AT(&slots[0]), slots[1]));
    return RESULT_OK(KORB_NIL);
}

// A call site's keyword-argument Hash: tagged so the callee binds it to keyword
// parameters (a plain trailing Hash argument stays positional, as in Ruby 3).
NODE_DEF
node_kwargs_mark(CTX *c, NODE *n, VALUE *slots, VALUE h@child)
{
    (void)c; (void)n; (void)slots;
    if (LIKELY(KORB_HASH_P(h))) ((AroObjectHeader *)(uintptr_t)h)->flags |= KORB_FL_KWARGS;
    return RESULT_OK(h);
}

// `binding` — capture the current frame's local scope into a Binding object.
// def_env_off = frame base (locals at base[0..name_cnt)), self_off = lexical self,
// name_syms = immortal sym table (a const char* runtime-ref so the SD stays shared).
NODE_DEF
node_binding(CTX *c, NODE *n, VALUE *slots, int32_t def_env_off, int32_t self_off, const char *name_syms, uint32_t name_cnt)
{
    RESULT r = korb_make_binding(c, slots, &slots[def_env_off], (const uint32_t *)(const void *)name_syms, name_cnt, slots[self_off]);
    if (LIKELY(r.state == KORB_NORMAL) && KORB_OBJ_TYPE(r.value) == KORB_OBJ_BINDING)
        VAL2BIND(r.value)->src_node = n;   /* record the call site for Binding#source_location */
    return r;
}

// Receiver method call with a literal block (arr.each { ... }), any fixed arity.
// argv@children stages [recv, args...]; korb_send_blk resolves the built-in and
// hands it the block (node_entry) + def_env so it can yield.  Replaces send_blk0..2.
// `self_off` = the caller's self = the block's captured (lexical) self.
NODE_DEF @noinline @framehdr
node_send_blk(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t self_off, NODE *block, int32_t def_env_off, NODE **argv@children)
{
    (void)n; (void)block_dispatcher;
    return korb_send_blk(c, slots, mid, line, argv_cnt - 1, block,
                         (VALUE *)((uintptr_t)&slots[def_env_off] | 1u), &slots[self_off]);
}

// `recv.mid(args, &proc)` — forward a runtime Proc as the block.  `proc_off` is a
// (rooted, caller-frame) slot holding the Proc; the block iseq is immortal, and
// korb_block_yield re-reads proc->env/self per yield (KORB_BLK_FWD), so a moved
// escaped env is never stale.  argv@children stages [recv, args...].
NODE_DEF @noinline @framehdr
node_send_blkproc(CTX *c, NODE *n, VALUE *slots, uint32_t mid@sym, uint32_t line, int32_t proc_off, NODE **argv@children)
{
    (void)n;
    RESULT pr = korb_blockarg_to_proc(c, slots, &slots[proc_off], line);   /* &obj → obj.to_proc (slots[0..] is free scratch) */
    if (UNLIKELY(pr.state != KORB_NORMAL)) return pr;
    const VALUE pv = slots[proc_off];
    if (pv == KORB_NIL) return korb_send(c, slots, mid, line, argv_cnt - 1);   /* &nil → no block */
    NODE *iseq = VAL2PROC(pv)->iseq;
    if (iseq == NULL) iseq = KORB_BLK_CPROC;             /* Symbol/Method#to_proc: forward as a C-proc block */
    return korb_send_blk(c, slots, mid, line, argv_cnt - 1, iseq, KORB_BLK_FWD, &slots[proc_off]);
}

// yield to the current method's block.  `biseq_off` / `def_env_off` /
// `cself_off` read the frame's reserved block cells (odd-tagged); korb_yield
// masks and sets up the block frame (incl. its captured self).
NODE_DEF
node_yield0(CTX *c, NODE *n, VALUE *slots, uint32_t line, int32_t biseq_off, int32_t def_env_off, int32_t cself_off)
{
    (void)n;
    return korb_yield(c, slots, 0, line, slots[biseq_off], slots[def_env_off], &slots[cself_off]);
}

NODE_DEF
node_yield1(CTX *c, NODE *n, VALUE *slots, uint32_t line, int32_t biseq_off, int32_t def_env_off, int32_t cself_off, VALUE_REF a0@child)
{
    (void)n; (void)a0;
    return korb_yield(c, slots, 1, line, slots[biseq_off], slots[def_env_off], &slots[cself_off]);
}

// `yield a, b, ...` (≥2 values): stage all via argv@children, then yield argc.
NODE_DEF
node_yield_n(CTX *c, NODE *n, VALUE *slots, uint32_t line, int32_t biseq_off, int32_t def_env_off, int32_t cself_off, NODE **argv@children)
{
    (void)n;
    return korb_yield(c, slots, argv_cnt, line, slots[biseq_off], slots[def_env_off], &slots[cself_off]);
}

// `yield(*arr)` / `yield a, *b` at method top-level: `args` is the built args
// Array; spread it above the cursor and yield with a runtime argc.  Stages one
// child (the array), so the trio offsets match node_yield1's.
NODE_DEF
node_yield_splat(CTX *c, NODE *n, VALUE *slots, uint32_t line, int32_t biseq_off, int32_t def_env_off, int32_t cself_off, VALUE_REF args@child)
{
    (void)n; (void)args;
    const VALUE arr = slots[-1];                          /* the staged args array */
    const VALUE biseq = slots[biseq_off];
    const VALUE denv  = slots[def_env_off];
    const uint32_t N = VAL2ARY(arr)->len;
    for (uint32_t i = 0; i < N; i++) slots[i] = korb_items_data(VAL2ARY(arr)->items)[i];
    return korb_yield(c, slots + N, N, line, biseq, denv, &slots[cself_off]);
}

// yield from INSIDE a block: `prev_off` reads this block frame's PREV handle;
// korb_yield_outer walks `depth` env links to the enclosing method frame and
// reads its block trio at node[trio_base..trio_base+2] (trio_base = method
// frame_size - 5, add-baked at the method's pop).  Unlocks Enumerable mixins
// (`def each; coll.each { yield }; end`).
NODE_DEF
node_yield_outer0(CTX *c, NODE *n, VALUE *slots, uint32_t line, int32_t prev_off, uint32_t depth, int32_t trio_base)
{
    (void)n;
    return korb_yield_outer(c, slots, 0, line, slots[prev_off], depth, trio_base);
}

NODE_DEF
node_yield_outer1(CTX *c, NODE *n, VALUE *slots, uint32_t line, int32_t prev_off, uint32_t depth, int32_t trio_base, VALUE_REF a0@child)
{
    (void)n; (void)a0;
    return korb_yield_outer(c, slots, 1, line, slots[prev_off], depth, trio_base);
}

// `yield a, b, ...` from inside a block (≥2 values).
NODE_DEF
node_yield_outer_n(CTX *c, NODE *n, VALUE *slots, uint32_t line, int32_t prev_off, uint32_t depth, int32_t trio_base, NODE **argv@children)
{
    (void)n;
    return korb_yield_outer(c, slots, argv_cnt, line, slots[prev_off], depth, trio_base);
}

// `yield(*arr)` from inside a block: spread the built args Array, then yield to
// the enclosing method's block (one staged child, like node_yield_outer1).
NODE_DEF
node_yield_outer_splat(CTX *c, NODE *n, VALUE *slots, uint32_t line, int32_t prev_off, uint32_t depth, int32_t trio_base, VALUE_REF args@child)
{
    (void)n; (void)args;
    const VALUE arr = slots[-1];
    const VALUE prev = slots[prev_off];
    const uint32_t N = VAL2ARY(arr)->len;
    for (uint32_t i = 0; i < N; i++) slots[i] = korb_items_data(VAL2ARY(arr)->items)[i];
    return korb_yield_outer(c, slots + N, N, line, prev, depth, trio_base);
}

// block_given? — reads the frame-top biseq cell (odd-tagged when a block was
// passed; nil when not).
NODE_DEF @nogc
node_block_given(CTX *c, NODE *n, VALUE *slots, int32_t biseq_off)
{
    (void)c; (void)n;
    return RESULT_OK(((uintptr_t)slots[biseq_off] & 1u) ? KORB_TRUE : KORB_FALSE);
}

// block_given? inside a block: block_given? reaches the enclosing METHOD's
// block, not a nested block's.  Walk `depth` env links (like korb_yield_outer)
// to the method frame and test its biseq presence bit; an escaped (KorbEnv)
// chain → no block.
NODE_DEF @nogc
node_block_given_outer(CTX *c, NODE *n, VALUE *slots, int32_t prev_off, uint32_t depth, int32_t trio_base)
{
    (void)c; (void)n;
    const VALUE *node = korb_outer_frame_base(slots[prev_off], depth);
    if (!node) return RESULT_OK(KORB_FALSE);
    return RESULT_OK(((uintptr_t)node[trio_base] & 1u) ? KORB_TRUE : KORB_FALSE);
}

// `next [v]` — early-return from a block; korb_yield catches KORB_NEXT.
NODE_DEF @nogc
node_next(CTX *c, NODE *n, VALUE *slots, VALUE v@child)
{
    (void)c; (void)n; (void)slots;
    return RESULT_NEXT_(v);
}

// ---- self / instance variables ---------------------------------------------
//
// `self_off` is parse-baked to the frame's self cell (base[fs-1], offset
// -1-chain).  Every frame (method, block, top-level) carries self there — the
// caller / korb_yield populate it — so `self`/@ivar read it directly.

NODE_DEF @nogc
node_self(CTX *c, NODE *n, VALUE *slots, int32_t self_off)
{
    (void)c; (void)n;
    return RESULT_OK(slots[self_off]);
}

NODE_DEF @nogc
node_ivar_get(CTX *c, NODE *n, VALUE *slots, int32_t self_off, uint32_t name@sym, struct korb_ivcache *ic@ref)
{
    (void)n;
    VALUE self = slots[self_off];
    if (LIKELY(KORB_OBJECT_P(self))) {
        const KorbObject *const o = VAL2OBJ(self);
        /* shape inline cache: a hit guarantees the slot is valid for this layout. */
        if (LIKELY(o->shape_id == ic->shape_id)) return RESULT_OK(korb_items_data(o->ivars)[ic->slot]);
        const int32_t idx = korb_shape_index(c->vm, o->shape_id, name);   /* miss → walk + refill */
        if (idx < 0) return RESULT_OK(KORB_NIL);
        ic->shape_id = o->shape_id; ic->slot = idx;
        return RESULT_OK(korb_items_data(o->ivars)[idx]);
    }
    if (AROH_IS_GC_OBJECT(self)) return RESULT_OK(korb_ivar_get(c, self, ID2SYM(name)));   /* class/exc/container side storage (cold, no alloc) */
    return RESULT_OK(KORB_NIL);   /* @x on an immediate self → nil */
}

NODE_DEF
node_ivar_set(CTX *c, NODE *n, VALUE *slots, int32_t self_off, uint32_t name@sym, VALUE val@child, struct korb_ivcache *ic@ref)
{
    (void)n;
    if (LIKELY(KORB_OBJECT_P(slots[self_off]))) {
        KorbObject *const o = VAL2OBJ(slots[self_off]);
        if (LIKELY(o->shape_id == ic->shape_id && !(o->head.flags & KORB_FL_FROZEN))) {   /* hit: existing ivar at known slot */
            ARO_STORE(c, o->ivars, &korb_items_data(o->ivars)[ic->slot], val);   /* inline WB fast path (no PLT call) */
            return RESULT_OK(val);
        }
        RESULT r = korb_ivar_set(c, slots, VALUE_REF_AT(&slots[self_off]), ID2SYM(name), val);  /* may transition/grow */
        if (LIKELY(r.state == KORB_NORMAL)) {             /* refill from the (re-read) object's new shape */
            const KorbObject *const o2 = VAL2OBJ(slots[self_off]);
            const int32_t idx = korb_shape_index(c->vm, o2->shape_id, name);
            if (idx >= 0) { ic->shape_id = o2->shape_id; ic->slot = idx; }
        }
        return r;
    }
    if (AROH_IS_GC_OBJECT(slots[self_off]))   /* class / exception / container / heap object → side storage (cold) */
        return korb_ivar_set(c, slots, VALUE_REF_AT(&slots[self_off]), ID2SYM(name), val);
    return korb_raise_frozen(c, slots, slots[self_off]);   /* immediates are frozen (CRuby's FrozenError) */
}

// ---- class variables (`@@x`) -----------------------------------------------
//
// `self_off`/`dc_off` read the frame's self + def_class cells; the cref is self
// when self is a class/module (class body / class method) else def_class (an
// instance method).  korb_cvar_{get,set} resolve up the superclass chain.

NODE_DEF
node_cvar_get(CTX *c, NODE *n, VALUE *slots, int32_t self_off, int32_t dc_off, uint32_t name@sym, uint32_t soft)
{
    (void)n;
    return korb_cvar_get(c, slots, slots[self_off], slots[dc_off], name, soft);
}

NODE_DEF
node_cvar_set(CTX *c, NODE *n, VALUE *slots, int32_t self_off, int32_t dc_off, uint32_t name@sym, VALUE val@child)
{
    (void)n;
    return korb_cvar_set(c, slots, slots[self_off], slots[dc_off], name, val);
}

// ---- outer-variable access (depth >= 1, docs/v2_blocks_design.md §3) --------
//
// `prev_off` is parse-baked: slots[prev_off] is the current (block) frame's
// PREV cell (bf[0]) — a tagged-odd pointer to the definer's locals-base.
// depth 1 reads that base directly; deeper levels walk node[-1] (the next
// frame's PREV cell, also tagged).  The odd tag makes the GC root scan skip
// these slots-internal pointers (they're not heap objects).

// Outer-variable read.  The PREV handle is either a tagged-odd live-slots
// region (the common yield/non-escape chain — direct access) or an even
// KorbEnv* (an escaped Proc's captured chain — access via loc when open /
// vals when the defining frame has returned).  A walk is homogeneous (B3).
NODE_DEF @nogc
node_eget(CTX *c, NODE *n, VALUE *slots, int32_t prev_off, uint32_t depth, uint32_t index)
{
    (void)c; (void)n;
    VALUE h = slots[prev_off];                            /* PREV link: odd=live base, even=KorbEnv (mixed walk) */
    /* A frame that created a closure has its OWN open env stored in its EP cell
     * (korb_make_proc, so a sibling closure finds it via korb_open_env_find);
     * loc==base marks it.  That env represents the SAME level as the base (level
     * 0 at the start, level k mid-walk), so step to its parent to keep `depth`
     * aligned with the live/odd case.  Must be applied at EVERY EP read (the
     * start cell + each korb_ep_get) — an intermediate promoted frame is the
     * nested-closure bug.  A proc.call EP (parent's env, loc!=base) is used
     * as-is; the materialized env chain (->prev) is already unambiguous. */
    {
        VALUE *const sb = slots + prev_off + 2;           /* this frame's base (EP cell is base[-2]) */
        if (!(h & 1u)) { const KorbEnv *const e0 = VAL2ENV(h); if (!e0->closed && e0->loc == sb) h = e0->prev; }
    }
    for (uint32_t k = 1; k < depth; k++) {
        if (h & 1u) {
            VALUE *const b = (VALUE *)(uintptr_t)(h & ~(uintptr_t)1u);
            VALUE pv = korb_ep_get(b);
            if (!(pv & 1u)) { const KorbEnv *const e1 = VAL2ENV(pv); if (!e1->closed && e1->loc == b) pv = e1->prev; }
            h = pv;
        } else h = VAL2ENV(h)->prev;
    }
    if (h & 1u) return RESULT_OK(((VALUE *)(uintptr_t)(h & ~(uintptr_t)1u))[index]);
    KorbEnv *e = VAL2ENV(h);
    return RESULT_OK((e->closed ?korb_items_data(((KorbArrayItems *)(uintptr_t)e->vals)) : e->loc)[index]);
}

// Outer-variable write.  Slots handles + open envs target the (non-moving)
// slots root range → plain store (no WB).  A closed env's vals is a heap
// VALUE_ARRAY → route through ARO_STORE for the generational backends.
NODE_DEF @nogc
node_eset(CTX *c, NODE *n, VALUE *slots, int32_t prev_off, uint32_t depth, uint32_t index, VALUE val@child)
{
    (void)c; (void)n;
    VALUE h = slots[prev_off];                            /* PREV link: odd=live base, even=KorbEnv (mixed walk) */
    /* See node_eget: normalize a self-promoted frame's own open env (loc==base)
     * to its parent at every EP read (start cell + each korb_ep_get). */
    {
        VALUE *const sb = slots + prev_off + 2;
        if (!(h & 1u)) { const KorbEnv *const e0 = VAL2ENV(h); if (!e0->closed && e0->loc == sb) h = e0->prev; }
    }
    for (uint32_t k = 1; k < depth; k++) {
        if (h & 1u) {
            VALUE *const b = (VALUE *)(uintptr_t)(h & ~(uintptr_t)1u);
            VALUE pv = korb_ep_get(b);
            if (!(pv & 1u)) { const KorbEnv *const e1 = VAL2ENV(pv); if (!e1->closed && e1->loc == b) pv = e1->prev; }
            h = pv;
        } else h = VAL2ENV(h)->prev;
    }
    if (h & 1u) { ((VALUE *)(uintptr_t)(h & ~(uintptr_t)1u))[index] = val; return RESULT_OK(val); }
    KorbEnv *e = VAL2ENV(h);
    if (e->closed) korb_env_store(c, e, index, val);       /* heap vals → WB-aware store */
    else e->loc[index] = val;
    return RESULT_OK(val);
}
