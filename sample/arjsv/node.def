// arjsv — JSON Schema (draft-07) validator nodes (Tier 1 / MVP).
//
// Result convention: 1 = valid, 0 = invalid.
//
// Each node returns int.  AND semantics across siblings is encoded as
// `node_seq(head, tail)` chains.  Property / required / enum lists are
// also chains terminated by `node_pass` (always-valid) or `node_fail`
// (always-invalid).
//
// `c->data` is the JSON value currently under examination.  Container
// nodes (property, items_uniform) save/restore around sub-schema
// recursion.  Number / string / type checks read it directly.

// ---- Structural ----------------------------------------------------------

// Top-level entry.  body is the lowered schema; receives initial c->data.
// NOT @noinline: validate_root is the SD specialisation root — the
// public-extern SD that astro_cs_load patches into head.dispatcher.
NODE_DEF
node_validate_root(CTX *c, NODE *n, NODE *body)
{
    return EVAL_ARG(c, body);
}

// Always-valid terminator (used as the tail of property / required / enum
// chains and as the body of `{}` / `true`-schemas).
NODE_DEF
node_pass(CTX *c, NODE *n)
{
    (void)c; (void)n;
    return 1;
}

// Always-invalid (used for `false`-schema and as the not-found tail of
// enum chains).
NODE_DEF
node_fail(CTX *c, NODE *n)
{
    (void)c; (void)n;
    return 0;
}

// AND.  Both children must validate.
NODE_DEF
node_seq(CTX *c, NODE *n, NODE *head, NODE *tail)
{
    if (!EVAL_ARG(c, head)) return 0;
    return EVAL_ARG(c, tail);
}

// ---- Type check ----------------------------------------------------------

// `type` keyword.  Mask is OR of ARJSV_T_* bits.  An integer-valued Float
// satisfies ARJSV_T_INTEGER (per draft-07: integers are JSON numbers with
// zero fractional part).
NODE_DEF
node_type_check(CTX *c, NODE *n, uint32_t mask)
{
    return (arjsv_value_types(c->data) & mask) != 0;
}

// ---- Object keywords -----------------------------------------------------

// One required-property check; recurses into `next` for the rest.
// If c->data is not a Hash, type-error responsibility lies with type_check
// (a parallel sibling); we return 1 here so the chain doesn't double-fail.
//
// The `key` C-string operand is content-hashed (FNV) so two `node_required`
// nodes with different keys produce distinct SDs.  The runtime lookup uses
// `c->consts[key_idx]` — a frozen Ruby string interned at schema-build time
// — so no `rb_str_new_cstr` allocation per call.
// String key first (the JSON Schema spec form, also `JSON.parse` default).
// Fall back to the Symbol version (consts[sym_idx]) only when the String
// lookup misses, so Hashes with String keys pay zero overhead and Hashes
// with Symbol keys (Rails-style) still validate correctly.
NODE_DEF
node_required(CTX *c, NODE *n, const char *key, uint32_t key_idx, uint32_t sym_idx, NODE *next)
{
    (void)key;
    if (RB_TYPE_P(c->data, T_HASH)) {
        VALUE v = rb_hash_lookup2(c->data, c->consts[key_idx], Qundef);
        if (v == Qundef) v = rb_hash_lookup2(c->data, c->consts[sym_idx], Qundef);
        if (v == Qundef) return 0;
    }
    return EVAL_ARG(c, next);
}

// Unsafe (type-guarded) variant — caller has asserted via `type:"object"`
// that c->data is a Hash, so skip the per-call RB_TYPE_P guard.
NODE_DEF
node_required_unsafe(CTX *c, NODE *n, const char *key, uint32_t key_idx, uint32_t sym_idx, NODE *next)
{
    (void)key;
    VALUE v = rb_hash_lookup2(c->data, c->consts[key_idx], Qundef);
    if (v == Qundef) v = rb_hash_lookup2(c->data, c->consts[sym_idx], Qundef);
    if (v == Qundef) return 0;
    return EVAL_ARG(c, next);
}

// One property's sub-schema check; recurses into `next`.  If the key is
// absent, skip (per JSON Schema: properties only constrain present keys).
// See node_required for the (key, key_idx) split rationale.
// See node_required for the String-then-Symbol fallback rationale.
// On a successful match, also records the key in c->eval_keys (for
// the surrounding `unevaluatedProperties` check, when one is in scope).
// Saves and resets c->eval_keys / eval_items around the sub-schema
// recursion so the inner schema starts with a fresh tracking context.
NODE_DEF
node_property(CTX *c, NODE *n, const char *key, uint32_t key_idx, uint32_t sym_idx, NODE *schema, NODE *next)
{
    (void)key;
    if (RB_TYPE_P(c->data, T_HASH)) {
        VALUE prop = rb_hash_lookup2(c->data, c->consts[key_idx], Qundef);
        if (prop == Qundef) prop = rb_hash_lookup2(c->data, c->consts[sym_idx], Qundef);
        if (prop != Qundef) {
            VALUE saved_data = c->data;
            VALUE saved_keys = c->eval_keys;
            int saved_items = c->eval_items;
            c->data = prop;
            c->eval_keys = Qnil;
            c->eval_items = -1;
            int ok = EVAL_ARG(c, schema);
            c->data = saved_data;
            c->eval_keys = saved_keys;
            c->eval_items = saved_items;
            if (!ok) return 0;
            arjsv_track_key(c, c->consts[key_idx]);
        }
    }
    return EVAL_ARG(c, next);
}

// Unsafe (type-guarded) variant of node_property.
NODE_DEF
node_property_unsafe(CTX *c, NODE *n, const char *key, uint32_t key_idx, uint32_t sym_idx, NODE *schema, NODE *next)
{
    (void)key;
    VALUE prop = rb_hash_lookup2(c->data, c->consts[key_idx], Qundef);
    if (prop == Qundef) prop = rb_hash_lookup2(c->data, c->consts[sym_idx], Qundef);
    if (prop != Qundef) {
        VALUE saved_data = c->data;
        VALUE saved_keys = c->eval_keys;
        int saved_items = c->eval_items;
        c->data = prop;
        c->eval_keys = Qnil;
        c->eval_items = -1;
        int ok = EVAL_ARG(c, schema);
        c->data = saved_data;
        c->eval_keys = saved_keys;
        c->eval_items = saved_items;
        if (!ok) return 0;
        arjsv_track_key(c, c->consts[key_idx]);
    }
    return EVAL_ARG(c, next);
}

// `insert_defaults` variant — when the property is absent, mutates
// c->data to insert the schema's `default` value (consts[default_idx])
// using the String key form, then validates the (now-present) value.
// Matches json_schemer's `insert_property_defaults: true` behaviour.
NODE_DEF
node_property_with_default(CTX *c, NODE *n, const char *key, uint32_t key_idx, uint32_t sym_idx, uint32_t default_idx, NODE *schema, NODE *next)
{
    (void)key;
    if (RB_TYPE_P(c->data, T_HASH)) {
        VALUE prop = rb_hash_lookup2(c->data, c->consts[key_idx], Qundef);
        if (prop == Qundef) prop = rb_hash_lookup2(c->data, c->consts[sym_idx], Qundef);
        if (prop == Qundef) {
            prop = c->consts[default_idx];
            rb_hash_aset(c->data, c->consts[key_idx], prop);
        }
        VALUE saved_data = c->data;
        VALUE saved_keys = c->eval_keys;
        int saved_items = c->eval_items;
        c->data = prop;
        c->eval_keys = Qnil;
        c->eval_items = -1;
        int ok = EVAL_ARG(c, schema);
        c->data = saved_data;
        c->eval_keys = saved_keys;
        c->eval_items = saved_items;
        if (!ok) return 0;
        arjsv_track_key(c, c->consts[key_idx]);
    }
    return EVAL_ARG(c, next);
}

// ---- Array keywords ------------------------------------------------------

// Single sub-schema applied to every array element.  No-op for non-arrays.
// On success, marks ALL elements as evaluated (eval_items = len).
NODE_DEF
node_items_uniform(CTX *c, NODE *n, NODE *schema)
{
    if (!RB_TYPE_P(c->data, T_ARRAY)) return 1;
    long len = RARRAY_LEN(c->data);
    VALUE saved_data = c->data;
    VALUE saved_keys = c->eval_keys;
    int saved_items = c->eval_items;
    for (long i = 0; i < len; i++) {
        c->data = RARRAY_AREF(saved_data, i);
        c->eval_keys = Qnil;
        c->eval_items = -1;
        int ok = EVAL_ARG(c, schema);
        if (!ok) {
            c->data = saved_data;
            c->eval_keys = saved_keys;
            c->eval_items = saved_items;
            return 0;
        }
    }
    c->data = saved_data;
    c->eval_keys = saved_keys;
    c->eval_items = saved_items;
    arjsv_track_items_count(c, len);
    return 1;
}

// Unsafe (type-guarded) variant — emitted when the schema's `type` is
// the single string "array" so the per-call RB_TYPE_P guard can be
// skipped.  See node_property_unsafe for the pattern.
NODE_DEF
node_items_uniform_unsafe(CTX *c, NODE *n, NODE *schema)
{
    long len = RARRAY_LEN(c->data);
    VALUE saved_data = c->data;
    VALUE saved_keys = c->eval_keys;
    int saved_items = c->eval_items;
    for (long i = 0; i < len; i++) {
        c->data = RARRAY_AREF(saved_data, i);
        c->eval_keys = Qnil;
        c->eval_items = -1;
        int ok = EVAL_ARG(c, schema);
        if (!ok) {
            c->data = saved_data;
            c->eval_keys = saved_keys;
            c->eval_items = saved_items;
            return 0;
        }
    }
    c->data = saved_data;
    c->eval_keys = saved_keys;
    c->eval_items = saved_items;
    arjsv_track_items_count(c, len);
    return 1;
}

// One step in tuple-form `items: [s0, s1, ...]`.  Validates data[index]
// against schema (if present); recurses to next step.
NODE_DEF
node_items_tuple(CTX *c, NODE *n, uint32_t index, NODE *schema, NODE *next)
{
    if (RB_TYPE_P(c->data, T_ARRAY)) {
        long len = RARRAY_LEN(c->data);
        if ((long)index < len) {
            VALUE saved_data = c->data;
            VALUE saved_keys = c->eval_keys;
            int saved_items = c->eval_items;
            c->data = RARRAY_AREF(saved_data, index);
            c->eval_keys = Qnil;
            c->eval_items = -1;
            int ok = EVAL_ARG(c, schema);
            c->data = saved_data;
            c->eval_keys = saved_keys;
            c->eval_items = saved_items;
            if (!ok) return 0;
            arjsv_track_item(c, index);
        }
    }
    return EVAL_ARG(c, next);
}

// `additionalItems: <schema>` — applies schema to data[start..end].
NODE_DEF
node_additional_items(CTX *c, NODE *n, uint32_t start, NODE *schema)
{
    if (!RB_TYPE_P(c->data, T_ARRAY)) return 1;
    long len = RARRAY_LEN(c->data);
    VALUE saved_data = c->data;
    VALUE saved_keys = c->eval_keys;
    int saved_items = c->eval_items;
    for (long i = start; i < len; i++) {
        c->data = RARRAY_AREF(saved_data, i);
        c->eval_keys = Qnil;
        c->eval_items = -1;
        int ok = EVAL_ARG(c, schema);
        if (!ok) {
            c->data = saved_data;
            c->eval_keys = saved_keys;
            c->eval_items = saved_items;
            return 0;
        }
    }
    c->data = saved_data;
    c->eval_keys = saved_keys;
    c->eval_items = saved_items;
    arjsv_track_items_count(c, len);
    return 1;
}

// `additionalItems: false` — array length must be <= prefix.
NODE_DEF
node_no_additional_items(CTX *c, NODE *n, uint32_t prefix_len)
{
    if (!RB_TYPE_P(c->data, T_ARRAY)) return 1;
    return RARRAY_LEN(c->data) <= (long)prefix_len;
}

NODE_DEF
node_min_items(CTX *c, NODE *n, int32_t min)
{
    if (!RB_TYPE_P(c->data, T_ARRAY)) return 1;
    return RARRAY_LEN(c->data) >= min;
}

NODE_DEF
node_max_items(CTX *c, NODE *n, int32_t max)
{
    if (!RB_TYPE_P(c->data, T_ARRAY)) return 1;
    return RARRAY_LEN(c->data) <= max;
}

// `uniqueItems: true` — every pair must compare unequal under JSON
// equality.  O(N²) deep compare; acceptable for the small arrays
// typical in JSON Schema use.
NODE_DEF
node_unique_items(CTX *c, NODE *n)
{
    if (!RB_TYPE_P(c->data, T_ARRAY)) return 1;
    long len = RARRAY_LEN(c->data);
    for (long i = 0; i < len; i++) {
        VALUE a = RARRAY_AREF(c->data, i);
        for (long j = i + 1; j < len; j++) {
            VALUE b = RARRAY_AREF(c->data, j);
            // Per JSON Schema: bool != number, even if numerically equal.
            if (rb_equal(a, b) == Qtrue && rb_obj_class(a) == rb_obj_class(b)) {
                return 0;
            }
        }
    }
    return 1;
}

// ---- Number keywords -----------------------------------------------------

NODE_DEF
node_minimum(CTX *c, NODE *n, double threshold, uint32_t exclusive)
{
    if (!arjsv_value_is_number(c->data)) return 1;
    double d = arjsv_value_to_double(c->data);
    return exclusive ? (d > threshold) : (d >= threshold);
}

NODE_DEF
node_maximum(CTX *c, NODE *n, double threshold, uint32_t exclusive)
{
    if (!arjsv_value_is_number(c->data)) return 1;
    double d = arjsv_value_to_double(c->data);
    return exclusive ? (d < threshold) : (d <= threshold);
}

// `multipleOf: divisor` — value / divisor must be an integer.
NODE_DEF
node_multiple_of(CTX *c, NODE *n, double divisor)
{
    if (!arjsv_value_is_number(c->data)) return 1;
    if (divisor == 0.0) return 0;
    double v = arjsv_value_to_double(c->data);
    double q = v / divisor;
    // Overflow path: v/divisor doesn't fit in a double.  Defer to the
    // Ruby-side rational check (`Rational(v) % Rational(d) == 0`) which
    // gets the precise answer.  Slow, but only triggered on extreme
    // values like 1e308.
    if (!isfinite(q)) {
        return arjsv_rational_multiple_of(c->data, divisor);
    }
    return q == floor(q);
}

// ---- String keywords -----------------------------------------------------

NODE_DEF
node_min_length(CTX *c, NODE *n, int32_t min)
{
    if (!RB_TYPE_P(c->data, T_STRING)) return 1;
    return rb_str_strlen(c->data) >= min;
}

NODE_DEF
node_max_length(CTX *c, NODE *n, int32_t max)
{
    if (!RB_TYPE_P(c->data, T_STRING)) return 1;
    return rb_str_strlen(c->data) <= max;
}

// `pattern: <regex>` — applies a precompiled Ruby Regexp (stored in
// consts) to the string.  Non-strings pass.
NODE_DEF
node_pattern(CTX *c, NODE *n, const char *pattern, uint32_t consts_idx)
{
    (void)pattern;
    if (!RB_TYPE_P(c->data, T_STRING)) return 1;
    return rb_reg_match(c->consts[consts_idx], c->data) != Qnil;
}

// `format` (assertion mode).  The checker is a Ruby Proc stored in consts;
// it returns true / false (or anything truthy / falsy).  Non-strings pass.
NODE_DEF
node_format(CTX *c, NODE *n, const char *format_name, uint32_t checker_idx)
{
    (void)format_name;
    if (!RB_TYPE_P(c->data, T_STRING)) return 1;
    VALUE r = rb_funcall(c->consts[checker_idx], rb_intern("call"), 1, c->data);
    return RTEST(r) ? 1 : 0;
}

// `contentEncoding` / `contentMediaType` (draft-07 assertion mode).  The
// checker is a Proc receiving the candidate String and returning truthy
// when valid.  Non-strings pass (per spec — these only constrain strings).
NODE_DEF
node_content_check(CTX *c, NODE *n, const char *tag, uint32_t checker_idx)
{
    (void)tag;
    if (!RB_TYPE_P(c->data, T_STRING)) return 1;
    VALUE r = rb_funcall(c->consts[checker_idx], rb_intern("call"), 1, c->data);
    return RTEST(r) ? 1 : 0;
}

// ---- enum / const --------------------------------------------------------

// `const v`.  consts_idx points into the schema's constants array; the
// `canonical` C-string captures content for hashing (so two `const` nodes
// with different values get distinct SDs even though both go through the
// same consts indirection at runtime).
NODE_DEF
node_const(CTX *c, NODE *n, const char *canonical, uint32_t consts_idx)
{
    (void)canonical;
    return rb_equal(c->data, c->consts[consts_idx]) == Qtrue;
}

// One enum candidate; recurses into `next` if no match.  Chain terminates
// with `node_fail` (= no match found, invalid).
NODE_DEF
node_enum(CTX *c, NODE *n, const char *canonical, uint32_t consts_idx, NODE *next)
{
    (void)canonical;
    if (rb_equal(c->data, c->consts[consts_idx]) == Qtrue) return 1;
    return EVAL_ARG(c, next);
}

// ---- Object size --------------------------------------------------------

NODE_DEF
node_min_properties(CTX *c, NODE *n, int32_t min)
{
    if (!RB_TYPE_P(c->data, T_HASH)) return 1;
    return (int32_t)RHASH_SIZE(c->data) >= min;
}

NODE_DEF
node_max_properties(CTX *c, NODE *n, int32_t max)
{
    if (!RB_TYPE_P(c->data, T_HASH)) return 1;
    return (int32_t)RHASH_SIZE(c->data) <= max;
}

// ---- Combinators --------------------------------------------------------

// `not`.  Per spec, `not` does NOT propagate evaluation annotations to
// the surrounding `unevaluated_*` check — suppress tracking inside.
NODE_DEF
node_not(CTX *c, NODE *n, NODE *schema)
{
    VALUE saved_keys = c->eval_keys;
    int saved_items = c->eval_items;
    c->eval_keys = Qnil;
    c->eval_items = -1;
    int ok = !EVAL_ARG(c, schema);
    c->eval_keys = saved_keys;
    c->eval_items = saved_items;
    return ok;
}

// `if/then/else`.  if-fail does not propagate as failure; the else branch
// (or pass when else is absent) takes over.  Per spec, when `if` fails,
// its evaluation contributions are rolled back before running `else`.
NODE_DEF
node_if_then_else(CTX *c, NODE *n, NODE *if_schema, NODE *then_schema, NODE *else_schema)
{
    VALUE saved_keys = (c->eval_keys != Qnil) ? rb_hash_dup(c->eval_keys) : Qnil;
    int saved_items = c->eval_items;
    if (EVAL_ARG(c, if_schema)) {
        return EVAL_ARG(c, then_schema);
    } else {
        c->eval_keys = saved_keys;
        c->eval_items = saved_items;
        return EVAL_ARG(c, else_schema);
    }
}

// `anyOf` chain step — runs the branch, then `next`, returning success
// if either matches.  We do NOT short-circuit on first match because
// per spec the matched branches' evaluation annotations all apply
// (matters for `unevaluated_*`).  When the branch fails, its
// contributions are rolled back so only matched branches contribute.
NODE_DEF
node_any_of(CTX *c, NODE *n, NODE *branch, NODE *next)
{
    VALUE saved_keys = (c->eval_keys != Qnil) ? rb_hash_dup(c->eval_keys) : Qnil;
    int saved_items = c->eval_items;
    int matched = EVAL_ARG(c, branch);
    if (!matched) {
        c->eval_keys = saved_keys;
        c->eval_items = saved_items;
    }
    int next_matched = EVAL_ARG(c, next);
    return matched || next_matched;
}

// `oneOf` is implemented as a counter walk.  `node_one_of` is the root
// that resets / restores the counter; `node_one_of_step` walks each branch
// and increments on match (no early exit so we can detect 2+ matches and
// fail).  Chain terminates with `node_pass` (counter check happens in the root).
NODE_DEF
node_one_of(CTX *c, NODE *n, NODE *chain)
{
    VALUE saved_keys = (c->eval_keys != Qnil) ? rb_hash_dup(c->eval_keys) : Qnil;
    int saved_items = c->eval_items;
    int saved_count = c->one_of_count;
    int saved_active = c->one_of_active;
    VALUE saved_match_keys = c->one_of_match_keys;
    int saved_match_items = c->one_of_match_items;
    c->one_of_count = 0;
    c->one_of_active = 1;
    c->one_of_match_keys = Qundef;          // "no match yet"
    c->one_of_match_items = -1;
    EVAL_ARG(c, chain);
    int ok = (c->one_of_count == 1);
    if (ok && c->one_of_match_keys != Qundef) {
        // Restore the single match's contributions.
        c->eval_keys = c->one_of_match_keys;
        c->eval_items = c->one_of_match_items;
    } else {
        // 0 matches or 2+ matches → restore initial state.
        c->eval_keys = saved_keys;
        c->eval_items = saved_items;
    }
    c->one_of_count = saved_count;
    c->one_of_active = saved_active;
    c->one_of_match_keys = saved_match_keys;
    c->one_of_match_items = saved_match_items;
    return ok;
}

NODE_DEF
node_one_of_step(CTX *c, NODE *n, NODE *branch, NODE *next)
{
    VALUE pre_keys = (c->eval_keys != Qnil) ? rb_hash_dup(c->eval_keys) : Qnil;
    int pre_items = c->eval_items;
    if (EVAL_ARG(c, branch)) {
        if (c->one_of_count == 0) {
            // First match — snapshot the contributions for later
            // restoration if no further branches match.
            c->one_of_match_keys = (c->eval_keys != Qnil) ? rb_hash_dup(c->eval_keys) : Qnil;
            c->one_of_match_items = c->eval_items;
        } else {
            // Second+ match — invalidate the captured state.
            c->one_of_match_keys = Qundef;
        }
        c->one_of_count++;
    }
    // Roll back so the next branch sees the pre-step state.
    c->eval_keys = pre_keys;
    c->eval_items = pre_items;
    return EVAL_ARG(c, next);
}

// ---- patternProperties / additionalProperties --------------------------
//
// These nodes iterate the data Hash via `rb_hash_foreach`, which only takes
// a `VALUE arg` user pointer.  We pass the necessary context (CTX *,
// dispatchers, regex / consts pointers) through that arg via small structs.

struct arjsv_pp_iter_ctx {
    CTX *c;
    VALUE regex;
    NODE *schema;
    node_dispatcher_func_t schema_dispatcher;
    int valid;
};

static int
arjsv_pp_iter(VALUE key, VALUE val, VALUE arg)
{
    struct arjsv_pp_iter_ctx *pc = (struct arjsv_pp_iter_ctx *)arg;
    if (!RB_TYPE_P(key, T_STRING) && !RB_TYPE_P(key, T_SYMBOL)) return ST_CONTINUE;
    VALUE key_str = RB_TYPE_P(key, T_SYMBOL) ? rb_sym2str(key) : key;
    if (rb_reg_match(pc->regex, key_str) == Qnil) return ST_CONTINUE;
    VALUE saved_data = pc->c->data;
    VALUE saved_keys = pc->c->eval_keys;
    int saved_items = pc->c->eval_items;
    pc->c->data = val;
    pc->c->eval_keys = Qnil;
    pc->c->eval_items = -1;
    int ok = (*pc->schema_dispatcher)(pc->c, pc->schema);
    pc->c->data = saved_data;
    pc->c->eval_keys = saved_keys;
    pc->c->eval_items = saved_items;
    if (!ok) {
        pc->valid = 0;
        return ST_STOP;
    }
    arjsv_track_key(pc->c, key);
    return ST_CONTINUE;
}

// `patternProperties`: one (regex, schema) entry; chain via `next`.
NODE_DEF
node_pattern_property(CTX *c, NODE *n, uint32_t regex_idx, NODE *schema, NODE *next)
{
    if (RB_TYPE_P(c->data, T_HASH)) {
        struct arjsv_pp_iter_ctx pc = {
            .c = c,
            .regex = c->consts[regex_idx],
            .schema = schema,
            .schema_dispatcher = schema_dispatcher,
            .valid = 1,
        };
        rb_hash_foreach(c->data, arjsv_pp_iter, (VALUE)&pc);
        if (!pc.valid) return 0;
    }
    return EVAL_ARG(c, next);
}

struct arjsv_ap_iter_ctx {
    CTX *c;
    const VALUE *known_keys;
    uint32_t known_keys_count;
    const VALUE *known_patterns;
    uint32_t known_patterns_count;
    NODE *additional_schema;
    node_dispatcher_func_t additional_dispatcher;
    int valid;
};

static int
arjsv_ap_iter(VALUE key, VALUE val, VALUE arg)
{
    struct arjsv_ap_iter_ctx *ap = (struct arjsv_ap_iter_ctx *)arg;
    for (uint32_t i = 0; i < ap->known_keys_count; i++) {
        if (rb_equal(key, ap->known_keys[i]) == Qtrue) return ST_CONTINUE;
    }
    if (RB_TYPE_P(key, T_STRING) || RB_TYPE_P(key, T_SYMBOL)) {
        VALUE key_str = RB_TYPE_P(key, T_SYMBOL) ? rb_sym2str(key) : key;
        for (uint32_t i = 0; i < ap->known_patterns_count; i++) {
            if (rb_reg_match(ap->known_patterns[i], key_str) != Qnil) return ST_CONTINUE;
        }
    }
    // Unknown key — additionalProperties decides.
    if (ap->additional_schema == NULL) {
        ap->valid = 0;
        return ST_STOP;
    }
    VALUE saved_data = ap->c->data;
    VALUE saved_keys = ap->c->eval_keys;
    int saved_items = ap->c->eval_items;
    ap->c->data = val;
    ap->c->eval_keys = Qnil;
    ap->c->eval_items = -1;
    int ok = (*ap->additional_dispatcher)(ap->c, ap->additional_schema);
    ap->c->data = saved_data;
    ap->c->eval_keys = saved_keys;
    ap->c->eval_items = saved_items;
    if (!ok) {
        ap->valid = 0;
        return ST_STOP;
    }
    arjsv_track_key(ap->c, key);
    return ST_CONTINUE;
}

// `additionalProperties: <schema>` — applies schema to keys not covered by
// `properties` (known_keys) and `patternProperties` (known_patterns).
NODE_DEF
node_additional_properties_schema(CTX *c, NODE *n, uint32_t known_keys_idx, uint32_t known_keys_count, uint32_t known_patterns_idx, uint32_t known_patterns_count, NODE *additional_schema)
{
    if (!RB_TYPE_P(c->data, T_HASH)) return 1;
    struct arjsv_ap_iter_ctx ap = {
        .c = c,
        .known_keys = known_keys_count ? &c->consts[known_keys_idx] : NULL,
        .known_keys_count = known_keys_count,
        .known_patterns = known_patterns_count ? &c->consts[known_patterns_idx] : NULL,
        .known_patterns_count = known_patterns_count,
        .additional_schema = additional_schema,
        .additional_dispatcher = additional_schema_dispatcher,
        .valid = 1,
    };
    rb_hash_foreach(c->data, arjsv_ap_iter, (VALUE)&ap);
    return ap.valid;
}

// `additionalProperties: false` — fails on any key not covered.  No
// schema operand → no separate-entry registration needed.
NODE_DEF
node_no_additional_properties(CTX *c, NODE *n, uint32_t known_keys_idx, uint32_t known_keys_count, uint32_t known_patterns_idx, uint32_t known_patterns_count)
{
    if (!RB_TYPE_P(c->data, T_HASH)) return 1;
    struct arjsv_ap_iter_ctx ap = {
        .c = c,
        .known_keys = known_keys_count ? &c->consts[known_keys_idx] : NULL,
        .known_keys_count = known_keys_count,
        .known_patterns = known_patterns_count ? &c->consts[known_patterns_idx] : NULL,
        .known_patterns_count = known_patterns_count,
        .additional_schema = NULL,
        .additional_dispatcher = NULL,
        .valid = 1,
    };
    rb_hash_foreach(c->data, arjsv_ap_iter, (VALUE)&ap);
    return ap.valid;
}

// `propertyNames: <schema>` — every key (as a string) must validate
// against schema.
struct arjsv_pn_iter_ctx {
    CTX *c;
    NODE *schema;
    node_dispatcher_func_t schema_dispatcher;
    int valid;
};

static int
arjsv_pn_iter(VALUE key, VALUE val, VALUE arg)
{
    (void)val;
    struct arjsv_pn_iter_ctx *pc = (struct arjsv_pn_iter_ctx *)arg;
    VALUE saved_data = pc->c->data;
    VALUE saved_keys = pc->c->eval_keys;
    int saved_items = pc->c->eval_items;
    pc->c->data = RB_TYPE_P(key, T_SYMBOL) ? rb_sym2str(key) : key;
    pc->c->eval_keys = Qnil;
    pc->c->eval_items = -1;
    int ok = (*pc->schema_dispatcher)(pc->c, pc->schema);
    pc->c->data = saved_data;
    pc->c->eval_keys = saved_keys;
    pc->c->eval_items = saved_items;
    if (!ok) {
        pc->valid = 0;
        return ST_STOP;
    }
    return ST_CONTINUE;
}

NODE_DEF
node_property_names(CTX *c, NODE *n, NODE *schema)
{
    if (!RB_TYPE_P(c->data, T_HASH)) return 1;
    struct arjsv_pn_iter_ctx pc = {
        .c = c,
        .schema = schema,
        .schema_dispatcher = schema_dispatcher,
        .valid = 1,
    };
    rb_hash_foreach(c->data, arjsv_pn_iter, (VALUE)&pc);
    return pc.valid;
}

// ---- $ref --------------------------------------------------------------

// ---- unevaluatedProperties / unevaluatedItems --------------------------

// `eval_scope` — establishes a fresh annotation-tracking context for
// the body it wraps.  Builder emits this at every schema position that
// declares `unevaluatedProperties` / `unevaluatedItems`.  The body is
// the regular keyword sequence including the unevaluated_* node at the
// end.  Outer eval state is saved on entry and restored on exit so
// inner contributions don't leak to enclosing scopes.
// Helper: copy every key from src hash into dst hash (used by eval_scope
// to propagate inner-scope annotations to the outer scope on success).
static int
arjsv_merge_keys_iter(VALUE key, VALUE val, VALUE dst)
{
    rb_hash_aset(dst, key, val);
    return ST_CONTINUE;
}

NODE_DEF
node_eval_scope(CTX *c, NODE *n, NODE *body)
{
    VALUE saved_keys = c->eval_keys;
    int saved_items = c->eval_items;
    c->eval_keys = rb_hash_new();
    c->eval_items = 0;
    int ok = EVAL_ARG(c, body);
    if (ok) {
        // Aggregate inner scope's annotations into the outer scope so
        // an enclosing unevaluatedProperties / unevaluatedItems can see
        // contributions from this in-place applicator (allOf member,
        // $ref body, etc.).  On failure the inner annotations are
        // discarded — the failing sub-schema didn't evaluate cleanly.
        if (saved_keys != Qnil) {
            rb_hash_foreach(c->eval_keys, arjsv_merge_keys_iter, saved_keys);
        }
        if (saved_items != -1 && c->eval_items > saved_items) {
            saved_items = c->eval_items;
        }
    }
    c->eval_keys = saved_keys;
    c->eval_items = saved_items;
    return ok;
}

// `unevaluatedProperties: false` — fail if any data key is not in
// c->eval_keys (= wasn't evaluated by adjacent properties /
// patternProperties / additionalProperties / in-place applicators).
struct arjsv_unp_iter_ctx {
    CTX *c;
    NODE *schema;
    node_dispatcher_func_t schema_dispatcher;  // NULL for the false form
    int valid;
};

static int
arjsv_unp_iter(VALUE key, VALUE val, VALUE arg)
{
    struct arjsv_unp_iter_ctx *up = (struct arjsv_unp_iter_ctx *)arg;
    if (up->c->eval_keys != Qnil &&
        rb_hash_lookup2(up->c->eval_keys, key, Qundef) != Qundef) {
        return ST_CONTINUE;
    }
    if (up->schema == NULL) {
        // false form — any unevaluated key is a fail.
        up->valid = 0;
        return ST_STOP;
    }
    VALUE saved_data = up->c->data;
    VALUE saved_keys = up->c->eval_keys;
    int saved_items = up->c->eval_items;
    up->c->data = val;
    up->c->eval_keys = Qnil;
    up->c->eval_items = -1;
    int ok = (*up->schema_dispatcher)(up->c, up->schema);
    up->c->data = saved_data;
    up->c->eval_keys = saved_keys;
    up->c->eval_items = saved_items;
    if (!ok) {
        up->valid = 0;
        return ST_STOP;
    }
    arjsv_track_key(up->c, key);
    return ST_CONTINUE;
}

NODE_DEF
node_unevaluated_properties_schema(CTX *c, NODE *n, NODE *schema)
{
    if (!RB_TYPE_P(c->data, T_HASH)) return 1;
    struct arjsv_unp_iter_ctx up = {
        .c = c,
        .schema = schema,
        .schema_dispatcher = schema_dispatcher,
        .valid = 1,
    };
    rb_hash_foreach(c->data, arjsv_unp_iter, (VALUE)&up);
    return up.valid;
}

NODE_DEF
node_no_unevaluated_properties(CTX *c, NODE *n)
{
    if (!RB_TYPE_P(c->data, T_HASH)) return 1;
    struct arjsv_unp_iter_ctx up = {
        .c = c,
        .schema = NULL,
        .schema_dispatcher = NULL,
        .valid = 1,
    };
    rb_hash_foreach(c->data, arjsv_unp_iter, (VALUE)&up);
    return up.valid;
}

// `unevaluatedItems: <schema>` — validate items at indices >= eval_items
// against the schema.  On success, marks them all as evaluated so any
// outer scope's check sees the full prefix.
NODE_DEF
node_unevaluated_items_schema(CTX *c, NODE *n, NODE *schema)
{
    if (!RB_TYPE_P(c->data, T_ARRAY)) return 1;
    long len = RARRAY_LEN(c->data);
    long start = (c->eval_items >= 0) ? c->eval_items : 0;
    if (start >= len) return 1;
    VALUE saved_data = c->data;
    VALUE saved_keys = c->eval_keys;
    int saved_items = c->eval_items;
    for (long i = start; i < len; i++) {
        c->data = RARRAY_AREF(saved_data, i);
        c->eval_keys = Qnil;
        c->eval_items = -1;
        int ok = EVAL_ARG(c, schema);
        if (!ok) {
            c->data = saved_data;
            c->eval_keys = saved_keys;
            c->eval_items = saved_items;
            return 0;
        }
    }
    c->data = saved_data;
    c->eval_keys = saved_keys;
    c->eval_items = saved_items;
    arjsv_track_items_count(c, len);
    return 1;
}

// `unevaluatedItems: false` — fail if any items at indices >= eval_items
// remain.
NODE_DEF
node_no_unevaluated_items(CTX *c, NODE *n)
{
    if (!RB_TYPE_P(c->data, T_ARRAY)) return 1;
    long len = RARRAY_LEN(c->data);
    long start = (c->eval_items >= 0) ? c->eval_items : 0;
    return len <= start;
}

// `dependencies` (draft-07): if `key` is present in the data hash, the
// data must validate against `dep_schema`.  `dep_schema` is either a
// required-list (chain of node_required) or a regular sub-schema, both
// lowered to NODE on the Ruby side.  See node_required for the
// String-then-Symbol fallback rationale.
NODE_DEF
node_dependency(CTX *c, NODE *n, const char *key, uint32_t key_idx, uint32_t sym_idx, NODE *dep_schema, NODE *next)
{
    (void)key;
    if (RB_TYPE_P(c->data, T_HASH)) {
        VALUE v = rb_hash_lookup2(c->data, c->consts[key_idx], Qundef);
        if (v == Qundef) v = rb_hash_lookup2(c->data, c->consts[sym_idx], Qundef);
        if (v != Qundef) {
            if (!EVAL_ARG(c, dep_schema)) return 0;
        }
    }
    return EVAL_ARG(c, next);
}

// `contains: <schema>` (+ optional minContains / maxContains).  Array must
// have a count of matching elements within [min, max].  On a non-array,
// the keyword is a no-op (pass).  Each MATCHING element is recorded as
// "evaluated" for the surrounding `unevaluatedItems` check (per spec).
//
// `min` defaults to 1 when only `contains` is given.  `min == 0` means
// even an empty array passes.  `max == -1` means unbounded.
NODE_DEF
node_contains(CTX *c, NODE *n, int32_t min, int32_t max, NODE *schema)
{
    if (!RB_TYPE_P(c->data, T_ARRAY)) return 1;
    long len = RARRAY_LEN(c->data);
    int32_t count = 0;
    VALUE saved_data = c->data;
    VALUE saved_keys = c->eval_keys;
    int saved_items = c->eval_items;
    long max_matched_idx = -1;
    for (long i = 0; i < len; i++) {
        c->data = RARRAY_AREF(saved_data, i);
        c->eval_keys = Qnil;
        c->eval_items = -1;
        if (EVAL_ARG(c, schema)) {
            count++;
            max_matched_idx = i;
        }
        // Early exit when max-bounded and exceeded.
        if (max >= 0 && count > max) {
            c->data = saved_data;
            c->eval_keys = saved_keys;
            c->eval_items = saved_items;
            return 0;
        }
    }
    c->data = saved_data;
    c->eval_keys = saved_keys;
    c->eval_items = saved_items;
    if (count < min) return 0;
    // Track items up to the last match (matched indices contribute to
    // evaluation; non-matching indices in between are also already
    // covered by the array prefix because contains-evaluation is "array
    // up to last match").
    if (max_matched_idx >= 0) arjsv_track_item(c, max_matched_idx);
    return 1;
}

// `$ref: "#/$defs/<name>"`.  The target is an independently-compiled entry
// node; its wrapper VALUE lives in consts so the Schema's GC mark keeps it
// alive.  We dispatch through `target->head.dispatcher` (runtime read) so
// SPECIALIZE doesn't recurse into the target — astro_cs_load patches the
// target's head.dispatcher independently.
NODE_DEF
node_ref(CTX *c, NODE *n, const char *defs_name, uint32_t consts_idx)
{
    (void)defs_name;
    NODE *target = arjsv_unwrap_node(c->consts[consts_idx]);
    return (*target->head.dispatcher)(c, target);
}
