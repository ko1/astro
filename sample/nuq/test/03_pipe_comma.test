# Pipe

. | .
42
42

.foo | .bar
{"foo":{"bar":42}}
42

.[] | .a
[{"a":1},{"a":2}]
1
2

# Comma

1,2,3
null
1
2
3

.foo, .bar
{"foo":1,"bar":2}
1
2

# Pipe + comma

(1,2) | . + 1
null
2
3

(1,2,3) | . * 10
null
10
20
30

# Array constructor with pipe

[.[] | . * 2]
[1,2,3]
[2,4,6]

# Nested

[(1,2), (3,4)]
null
[1,2,3,4]
