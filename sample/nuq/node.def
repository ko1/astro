/* Assignment: `lhs OP= rhs`.  op_kind values are NUQ_ASSIGN_*.
 *   = (PLAIN):   replace value at path-of(lhs) with rhs(.)
 *   |=  (UPDATE): replace with rhs applied to current value
 *   += -= *= /= %= //=: corresponding op of current with rhs
 *
 * Path of `lhs` is statically extracted at parse time when possible
 * (chains of `.foo` / `.[i]` / `.[]?` / `.[N:M]`).  Patterns we don't
 * handle yet (full `.[]` iteration, `.foo[0:].bar`) raise an error
 * at eval. */
NODE_DEF
node_assign(CTX *c, NODE *n, NODE *lhs, NODE *rhs, uint32_t op_kind)
{
    return nuq_assign_eval(c, lhs, rhs, op_kind);
}

NODE_DEF
node_b_delpaths(CTX *c, NODE *n, NODE *paths)
{
    return nuq_delpaths_eval(c, paths);
}

/* `del(path-expr)` — sugar for `delpaths([path(path-expr)])`.  Since
 * we don't have generic path mode in accessors yet, we lift the path
 * statically using `extract_path` (same as for assignments).  Works
 * for `.foo` / `.foo.bar` / `.[N]` chains. */
NODE_DEF
node_b_del(CTX *c, NODE *n, NODE *path_expr)
{
    return nuq_del_eval(c, path_expr);
}

NODE_DEF
node_b_limit(CTX *c, NODE *n, NODE *cnt, NODE *body)
