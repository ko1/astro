/*
 * nuq filter language — AST node definitions (VALUE-return form).
 *
 * Every NODE_DEF returns a VALUE that is a `nuq_array` of emits.
 * `EVAL_ARG(c, child)` returns the child's emit array directly — no
 * shared `c->emit_buf`, no CPS continuation.  Errors propagate via
 * `c->error` (non-NULL means in flight); break via `c->break_label`.
 *
 * Pipe `f | g` IS a node (`node_pipe`).  It evaluates `f` ONCE (so
 * shared sub-expressions don't re-run for every comma branch in `g`),
 * iterates the emits, and runs `g` per emit with `c->input` set.
 * This matches jq's "evaluate LHS once, run RHS per emit" semantics.
 *
 * Most other filter nodes (`length`, `.foo`, `.[]`, etc.) just read
 * `c->input` — they don't carry an input operand.  Pipe is the
 * iteration point.
 *
 * Comma `f, g`, binops `f + g`, etc. have lhs/rhs sub-chains that
 * each run with the *outer* `c->input`.
 *
 * Array `[body]`, object `{...}`, builtins with a filter argument
 * (`map(f)`, `select(f)`) have a `body` operand.  Body runs with
 * c->input set appropriately (outer for `[...]`, per-elem for
 * `map`).
 */

/* ===== identity / literals ===== */

/* `.` — emit the current `c->input`. */
NODE_DEF
node_identity(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, c->input);
    return r;
}

/* `..` — emit input plus all sub-values recursively. */
NODE_DEF
node_recurse(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(0);
    nuq_recurse_collect(r, c->input);
    return r;
}

NODE_DEF
node_null(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, NUQ_NULL);
    return r;
}

NODE_DEF
node_true(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, NUQ_TRUE);
    return r;
}

NODE_DEF
node_false(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, NUQ_FALSE);
    return r;
}

NODE_DEF
node_int(CTX *c, NODE *n, int32_t v)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, NUQ_FIX(v));
    return r;
}

NODE_DEF
node_lit(CTX *c, NODE *n, uint32_t lit_id)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_lit_get(lit_id));
    return r;
}

NODE_DEF
node_str(CTX *c, NODE *n, const char *s)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_make_string(s, strlen(s)));
    return r;
}

NODE_DEF
node_interp(CTX *c, NODE *n, uint32_t parts_id)
{
    return nuq_interp_eval(c, parts_id);
}

NODE_DEF
node_format(CTX *c, NODE *n, uint32_t fmt_id, NODE *body)
{
    return nuq_format_eval(c, fmt_id, body);
}

/* ===== access ===== */

NODE_DEF
node_field(CTX *c, NODE *n, const char *name)
{
    VALUE v;
    if (UNLIKELY(!nuq_field_lookup(c->input, name, false, &v))) {
        c->error = nuq_make_string("type error", 10);
        return nuq_make_array(0);
    }
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, v);
    return r;
}

NODE_DEF
node_field_opt(CTX *c, NODE *n, const char *name)
{
    VALUE v;
    if (!nuq_field_lookup(c->input, name, true, &v)) return nuq_make_array(0);
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, v);
    return r;
}

NODE_DEF
node_index(CTX *c, NODE *n, NODE *expr)
{
    VALUE in = c->input;
    VALUE keys = EVAL_ARG(c, expr);
    if (UNLIKELY(c->error != NUQ_NULL)) return keys;
    struct nuq_obj *ko = NUQ_PTR(keys);
    VALUE r = nuq_make_array(ko->arr.len);
    for (size_t i = 0; i < ko->arr.len; i++) {
        VALUE k = ko->arr.items[i];
        if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_NULL) {
            nuq_array_push(r, NUQ_NULL); continue;
        }
        if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_OBJECT) {
            if (NUQ_IS_PTR(k) && NUQ_PTR(k)->type == NUQ_T_STRING)
                nuq_array_push(r, nuq_object_get(in, k));
            else { c->error = nuq_make_string("object index must be string", 28); return r; }
            continue;
        }
        if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_ARRAY) {
            int64_t idx;
            if (NUQ_IS_FIX(k)) idx = NUQ_FIX_VAL(k);
            else if (NUQ_IS_PTR(k) && NUQ_PTR(k)->type == NUQ_T_DOUBLE) idx = (int64_t)NUQ_PTR(k)->dbl;
            else { c->error = nuq_make_string("array index must be number", 27); return r; }
            nuq_array_push(r, nuq_array_get(in, idx));
            continue;
        }
        c->error = nuq_make_string("type error: cannot index", 25);
        return r;
    }
    return r;
}

NODE_DEF
node_index_opt(CTX *c, NODE *n, NODE *expr)
{
    VALUE in = c->input;
    VALUE keys = EVAL_ARG(c, expr);
    if (UNLIKELY(c->error != NUQ_NULL)) return keys;
    struct nuq_obj *ko = NUQ_PTR(keys);
    VALUE r = nuq_make_array(0);
    for (size_t i = 0; i < ko->arr.len; i++) {
        VALUE k = ko->arr.items[i];
        if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_OBJECT) {
            if (NUQ_IS_PTR(k) && NUQ_PTR(k)->type == NUQ_T_STRING)
                nuq_array_push(r, nuq_object_get(in, k));
        } else if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_ARRAY) {
            int64_t idx;
            if (NUQ_IS_FIX(k)) idx = NUQ_FIX_VAL(k);
            else if (NUQ_IS_PTR(k) && NUQ_PTR(k)->type == NUQ_T_DOUBLE) idx = (int64_t)NUQ_PTR(k)->dbl;
            else continue;
            nuq_array_push(r, nuq_array_get(in, idx));
        }
    }
    return r;
}

NODE_DEF
node_iter(CTX *c, NODE *n)
{
    VALUE in = c->input;
    if (LIKELY(NUQ_IS_PTR(in))) {
        struct nuq_obj *o = NUQ_PTR(in);
        if (LIKELY(o->type == NUQ_T_ARRAY)) {
            VALUE r = nuq_make_array(o->arr.len);
            for (size_t i = 0; i < o->arr.len; i++) nuq_array_push(r, o->arr.items[i]);
            return r;
        }
        if (o->type == NUQ_T_OBJECT) {
            VALUE r = nuq_make_array(o->obj.len);
            for (size_t i = 0; i < o->obj.len; i++) nuq_array_push(r, o->obj.vals[i]);
            return r;
        }
    }
    fprintf(stderr, "nuq error: Cannot iterate over %s\n", nuq_type_name(in));
    c->error = nuq_make_string("Cannot iterate", 14);
    return nuq_make_array(0);
}

NODE_DEF
node_iter_opt(CTX *c, NODE *n)
{
    VALUE in = c->input;
    if (NUQ_IS_PTR(in)) {
        struct nuq_obj *o = NUQ_PTR(in);
        if (o->type == NUQ_T_ARRAY) {
            VALUE r = nuq_make_array(o->arr.len);
            for (size_t i = 0; i < o->arr.len; i++) nuq_array_push(r, o->arr.items[i]);
            return r;
        }
        if (o->type == NUQ_T_OBJECT) {
            VALUE r = nuq_make_array(o->obj.len);
            for (size_t i = 0; i < o->obj.len; i++) nuq_array_push(r, o->obj.vals[i]);
            return r;
        }
    }
    return nuq_make_array(0);
}

NODE_DEF
node_slice(CTX *c, NODE *n, NODE *startn, NODE *stopn, uint32_t flags)
{
    return nuq_slice_eval(c, startn, stopn, flags, false);
}

NODE_DEF
node_slice_opt(CTX *c, NODE *n, NODE *startn, NODE *stopn, uint32_t flags)
{
    return nuq_slice_eval(c, startn, stopn, flags, true);
}

/* ===== composition ===== */

/* pipe `lhs | rhs`: evaluate lhs ONCE, iterate emits, run rhs per
 * emit with c->input set to that emit.  Result is concat of rhs
 * outputs. */
NODE_DEF
node_pipe(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL || c->break_label != 0)) return l;
    struct nuq_obj *lo = NUQ_PTR(l);
    VALUE r = nuq_make_array(0);
    VALUE saved = c->input;
    for (size_t i = 0; i < lo->arr.len; i++) {
        c->input = lo->arr.items[i];
        VALUE rv = EVAL_ARG(c, rhs);
        if (UNLIKELY(c->error != NUQ_NULL || c->break_label != 0)) { c->input = saved; return r; }
        struct nuq_obj *ro = NUQ_PTR(rv);
        for (size_t j = 0; j < ro->arr.len; j++) nuq_array_push(r, ro->arr.items[j]);
    }
    c->input = saved;
    return r;
}

/* comma: both branches run with same outer input; concat outputs.
 * When rhs errors mid-stream, we still return the LHS emits — caller
 * (typically `try`) needs them: `try (1, error, 3) catch h` should
 * emit 1, then h's output. */
NODE_DEF
node_comma(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL || c->break_label != 0)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    /* Even on rhs error, concat what we have so far with whatever rhs
     * managed to produce before the error.  This is what jq does. */
    struct nuq_obj *lo = NUQ_PTR(l);
    struct nuq_obj *ro = NUQ_PTR(rv);
    VALUE r = nuq_make_array(lo->arr.len + ro->arr.len);
    for (size_t i = 0; i < lo->arr.len; i++) nuq_array_push(r, lo->arr.items[i]);
    for (size_t i = 0; i < ro->arr.len; i++) nuq_array_push(r, ro->arr.items[i]);
    return r;
}

/* ===== arithmetic =====
 *
 * Each binop evaluates lhs and rhs (both are sub-chains run with the
 * outer c->input), then cartesian-products their emits.  The body is
 * inlined in node.def (rather than dispatching to a runtime helper)
 * so the SD specializer can fold lhs/rhs's chains directly into this
 * node's SD via EVAL_ARG.
 *
 * `nuq_binop_apply_inline` is `static inline` in node.h — it takes
 * already-evaluated emit arrays + an op code and produces the cross
 * product.  gcc folds it through to per-op nuq_op_*. */

NODE_DEF
node_add(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_binop_apply_inline(l, rv, NUQ_OP_ADD_K);
}

NODE_DEF
node_sub(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_binop_apply_inline(l, rv, NUQ_OP_SUB_K);
}

NODE_DEF
node_mul(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_binop_apply_inline(l, rv, NUQ_OP_MUL_K);
}

NODE_DEF
node_div(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_binop_apply_inline(l, rv, NUQ_OP_DIV_K);
}

NODE_DEF
node_mod(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_binop_apply_inline(l, rv, NUQ_OP_MOD_K);
}

NODE_DEF
node_neg(CTX *c, NODE *n, NODE *expr)
{
    VALUE v = EVAL_ARG(c, expr);
    if (UNLIKELY(c->error != NUQ_NULL)) return v;
    struct nuq_obj *vo = NUQ_PTR(v);
    VALUE r = nuq_make_array(vo->arr.len);
    for (size_t i = 0; i < vo->arr.len; i++) nuq_array_push(r, nuq_op_neg(vo->arr.items[i]));
    return r;
}

/* ===== comparisons / logic ===== */

NODE_DEF
node_eq(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_cmpop_apply_inline(l, rv, NUQ_CMP_EQ_K);
}

NODE_DEF
node_ne(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_cmpop_apply_inline(l, rv, NUQ_CMP_NE_K);
}

NODE_DEF
node_lt(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_cmpop_apply_inline(l, rv, NUQ_CMP_LT_K);
}

NODE_DEF
node_le(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_cmpop_apply_inline(l, rv, NUQ_CMP_LE_K);
}

NODE_DEF
node_gt(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_cmpop_apply_inline(l, rv, NUQ_CMP_GT_K);
}

NODE_DEF
node_ge(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_cmpop_apply_inline(l, rv, NUQ_CMP_GE_K);
}

NODE_DEF
node_and(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    struct nuq_obj *lo = NUQ_PTR(l);
    VALUE r = nuq_make_array(0);
    for (size_t i = 0; i < lo->arr.len; i++) {
        if (!nuq_truthy(lo->arr.items[i])) {
            nuq_array_push(r, NUQ_FALSE); continue;
        }
        VALUE rv = EVAL_ARG(c, rhs);
        if (UNLIKELY(c->error != NUQ_NULL)) return rv;
        struct nuq_obj *ro = NUQ_PTR(rv);
        for (size_t j = 0; j < ro->arr.len; j++)
            nuq_array_push(r, nuq_truthy(ro->arr.items[j]) ? NUQ_TRUE : NUQ_FALSE);
    }
    return r;
}

NODE_DEF
node_or(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    struct nuq_obj *lo = NUQ_PTR(l);
    VALUE r = nuq_make_array(0);
    for (size_t i = 0; i < lo->arr.len; i++) {
        if (nuq_truthy(lo->arr.items[i])) {
            nuq_array_push(r, NUQ_TRUE); continue;
        }
        VALUE rv = EVAL_ARG(c, rhs);
        if (UNLIKELY(c->error != NUQ_NULL)) return rv;
        struct nuq_obj *ro = NUQ_PTR(rv);
        for (size_t j = 0; j < ro->arr.len; j++)
            nuq_array_push(r, nuq_truthy(ro->arr.items[j]) ? NUQ_TRUE : NUQ_FALSE);
    }
    return r;
}

NODE_DEF
node_not(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_truthy(c->input) ? NUQ_FALSE : NUQ_TRUE);
    return r;
}

NODE_DEF
node_alt(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    VALUE saved_err = c->error;
    VALUE l = EVAL_ARG(c, lhs);
    if (c->error != NUQ_NULL) {
        c->error = saved_err;
        return EVAL_ARG(c, rhs);
    }
    struct nuq_obj *lo = NUQ_PTR(l);
    bool any_truthy = false;
    VALUE r = nuq_make_array(lo->arr.len);
    for (size_t i = 0; i < lo->arr.len; i++) {
        if (nuq_truthy(lo->arr.items[i])) {
            any_truthy = true;
            nuq_array_push(r, lo->arr.items[i]);
        }
    }
    if (!any_truthy) return EVAL_ARG(c, rhs);
    return r;
}

/* ===== array / object construction ===== */

/* `[body]` — body runs with current c->input; its emits become elements
 * of the resulting array.  Emits 1 array. */
NODE_DEF
node_array(CTX *c, NODE *n, NODE *body)
{
    VALUE inner = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return inner;
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, inner);
    return r;
}

NODE_DEF
node_array_empty(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_make_array(0));
    return r;
}

NODE_DEF
node_object(CTX *c, NODE *n, uint32_t entries_id)
{
    return nuq_object_eval(c, entries_id);
}

/* ===== control ===== */

NODE_DEF
node_if(CTX *c, NODE *n, NODE *cond, NODE *thn, NODE *els)
{
    VALUE cs = EVAL_ARG(c, cond);
    if (UNLIKELY(c->error != NUQ_NULL)) return cs;
    struct nuq_obj *co = NUQ_PTR(cs);
    VALUE r = nuq_make_array(0);
    for (size_t i = 0; i < co->arr.len; i++) {
        if (nuq_truthy(co->arr.items[i])) {
            if (thn) {
                VALUE bo = EVAL_ARG(c, thn);
                if (UNLIKELY(c->error != NUQ_NULL)) return bo;
                struct nuq_obj *bv = NUQ_PTR(bo);
                for (size_t j = 0; j < bv->arr.len; j++) nuq_array_push(r, bv->arr.items[j]);
            } else {
                nuq_array_push(r, c->input);
            }
        } else {
            if (els) {
                VALUE bo = EVAL_ARG(c, els);
                if (UNLIKELY(c->error != NUQ_NULL)) return bo;
                struct nuq_obj *bv = NUQ_PTR(bo);
                for (size_t j = 0; j < bv->arr.len; j++) nuq_array_push(r, bv->arr.items[j]);
            } else {
                nuq_array_push(r, c->input);
            }
        }
    }
    return r;
}

NODE_DEF
node_try(CTX *c, NODE *n, NODE *body, NODE *handler)
{
    VALUE saved_err = c->error;
    VALUE bo = EVAL_ARG(c, body);
    if (c->error != NUQ_NULL) {
        VALUE err = c->error;
        c->error = saved_err;
        VALUE saved = c->input;
        c->input = err;
        VALUE rh = EVAL_ARG(c, handler);
        c->input = saved;
        /* Concat partial body emits + handler emits (jq semantics). */
        struct nuq_obj *bv = NUQ_PTR(bo);
        struct nuq_obj *rv = NUQ_PTR(rh);
        VALUE r = nuq_make_array(bv->arr.len + rv->arr.len);
        for (size_t i = 0; i < bv->arr.len; i++) nuq_array_push(r, bv->arr.items[i]);
        for (size_t i = 0; i < rv->arr.len; i++) nuq_array_push(r, rv->arr.items[i]);
        return r;
    }
    return bo;
}

NODE_DEF
node_as(CTX *c, NODE *n, NODE *src, uint32_t var_id, NODE *body)
{
    VALUE bs = EVAL_ARG(c, src);
    if (UNLIKELY(c->error != NUQ_NULL)) return bs;
    struct nuq_obj *bo = NUQ_PTR(bs);
    VALUE r = nuq_make_array(0);
    for (size_t i = 0; i < bo->arr.len; i++) {
        size_t top = c->var_top;
        nuq_var_push(c, var_id, bo->arr.items[i]);
        VALUE rv = EVAL_ARG(c, body);
        nuq_var_pop(c, top);
        if (UNLIKELY(c->error != NUQ_NULL)) return rv;
        struct nuq_obj *ro = NUQ_PTR(rv);
        for (size_t j = 0; j < ro->arr.len; j++) nuq_array_push(r, ro->arr.items[j]);
    }
    return r;
}

NODE_DEF
node_var(CTX *c, NODE *n, uint32_t var_id)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_var_get(c, var_id));
    return r;
}

NODE_DEF
node_label(CTX *c, NODE *n, uint32_t var_id, NODE *body)
{
    VALUE r = EVAL_ARG(c, body);
    if (c->break_label == var_id) c->break_label = 0;
    return r;
}

NODE_DEF
node_break(CTX *c, NODE *n, uint32_t var_id)
{
