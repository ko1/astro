}

/* `reduce SRC as PAT (INIT; UPDATE)` / `foreach SRC as PAT (INIT;
 * UPDATE; EXTRACT)` — destructuring variants.  Pattern walks the
 * value and binds vars before each iteration's UPDATE / EXTRACT. */
NODE_DEF
node_reduce_pat(CTX *c, NODE *n, NODE *src, uint32_t pat_id, NODE *init, NODE *update)
{
    return nuq_reduce_pat_eval(c, src, pat_id, init, update);
}

NODE_DEF
