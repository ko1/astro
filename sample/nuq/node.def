NODE_DEF
node_b_strindices(CTX *c, NODE *n, NODE *pat)
{
    /* jq's private `_strindices/1`: input must be string, pat must be string. */
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING)) {
        char d[80], msg[160];
        nuq_value_descr(c->input, d, sizeof(d));
        int w = snprintf(msg, sizeof(msg), "%s cannot be searched, as it is not a string", d);
        c->error = nuq_make_string(msg, (size_t)w);
        return EMIT_EMPTY;
    }
    size_t outer = c->pool_top;
    EMIT pe = EVAL(c, pat);
    if (c->error != NUQ_NULL) return EMIT_EMPTY;
    if (pe.count == 0) { c->pool_top = outer; return EMIT_EMPTY; }
    VALUE p = pe.items[0];
    c->pool_top = outer;
    if (!(NUQ_IS_PTR(p) && NUQ_PTR(p)->type == NUQ_T_STRING)) {
        char d[80], msg[160];
        nuq_value_descr(p, d, sizeof(d));
        int w = snprintf(msg, sizeof(msg), "%s is not a string", d);
        c->error = nuq_make_string(msg, (size_t)w);
        return EMIT_EMPTY;
    }
    return nuq_indices_eval(c, pat);
}

