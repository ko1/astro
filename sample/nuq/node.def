NODE_DEF
node_b_first1(CTX *c, NODE *n, NODE *body)
{
    size_t top0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    if (bo.count == 0) { c->pool_top = top0; return EMIT_EMPTY; }
    VALUE first = bo.items[0];
    c->pool_top = top0;
    return nuq_emit_one(c, first);
}

NODE_DEF
node_b_last1(CTX *c, NODE *n, NODE *body)
{
    size_t top0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    if (bo.count == 0) { c->pool_top = top0; return EMIT_EMPTY; }
    VALUE last = bo.items[bo.count - 1];
    c->pool_top = top0;
    return nuq_emit_one(c, last);
}

