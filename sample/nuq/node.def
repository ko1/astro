/* Numeric specials. */
NODE_DEF
node_b_nan(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_make_double(nan("")));
}

NODE_DEF
node_b_infinite(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_make_double(INFINITY));
}

NODE_DEF
node_b_isnan(CTX *c, NODE *n)
{
    bool b = NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_DOUBLE
             && isnan(NUQ_PTR(c->input)->dbl);
    return nuq_emit_one(c, b ? NUQ_TRUE : NUQ_FALSE);
}

NODE_DEF
node_b_isinfinite(CTX *c, NODE *n)
{
    bool b = NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_DOUBLE
             && isinf(NUQ_PTR(c->input)->dbl);
    return nuq_emit_one(c, b ? NUQ_TRUE : NUQ_FALSE);
}

/* Math wrappers — input is numeric, output is double of <math.h> fn.
 * ASTroGen needs each NODE_DEF as its own multi-line block (no macros),
 * so we generate via a Ruby script and paste; here they're written
 * out in long form. */
NODE_DEF
node_b_sin(CTX *c, NODE *n)
{
    double d;
    if (NUQ_IS_FIX(c->input)) d = (double)NUQ_FIX_VAL(c->input);
    else if (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_DOUBLE)
        d = NUQ_PTR(c->input)->dbl;
    else { c->error = nuq_make_string("sin: not number", 3+12); return EMIT_EMPTY; }
    return nuq_emit_one(c, nuq_make_double(sin(d)));
}

