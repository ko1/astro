    VALUE l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return l;
    VALUE rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return rv;
    return nuq_cmpop_apply_inline(l, rv, NUQ_CMP_NE_K);
