/* --- 1-arg built-ins (with sub-expression body) --- */

NODE_DEF
node_b_select(CTX *c, NODE *n, NODE *body)
{
    VALUE bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return bo;
    struct nuq_obj *boo = NUQ_PTR(bo);
    for (size_t i = 0; i < boo->arr.len; i++) {
        if (nuq_truthy(boo->arr.items[i])) {
            VALUE r = nuq_make_array(1);
            nuq_array_push(r, c->input);
            return r;
        }
    }
    return nuq_make_array(0);
}

NODE_DEF
node_b_map(CTX *c, NODE *n, NODE *body)
{
    /* `map(f)` ≡ `[.[] | f]`.  Body inlined here so SD specialiser
     * can fold `f` into this node's SD. */
    if (UNLIKELY(!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))) {
        c->error = nuq_make_string("map: not array", 15);
        return nuq_make_array(0);
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    VALUE result = nuq_make_array(o->arr.len);
    VALUE saved = c->input;
    for (size_t i = 0; i < o->arr.len; i++) {
        c->input = o->arr.items[i];
        VALUE bo = EVAL_ARG(c, body);
        if (UNLIKELY(c->error != NUQ_NULL)) { c->input = saved; return nuq_make_array(0); }
        struct nuq_obj *bv = NUQ_PTR(bo);
        for (size_t j = 0; j < bv->arr.len; j++) nuq_array_push(result, bv->arr.items[j]);
    }
    c->input = saved;
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, result);
    return r;
}

NODE_DEF
node_b_map_values(CTX *c, NODE *n, NODE *body)
{
    return nuq_map_values_eval(c, body);
}

NODE_DEF
node_b_with_entries(CTX *c, NODE *n, NODE *body)
{
    return nuq_with_entries_eval(c, body);
}

NODE_DEF
node_b_range1(CTX *c, NODE *n, NODE *to)
{
    VALUE buf = EVAL_ARG(c, to);
    if (UNLIKELY(c->error != NUQ_NULL)) return buf;
    struct nuq_obj *bo = NUQ_PTR(buf);
    VALUE r = nuq_make_array(0);
    for (size_t k = 0; k < bo->arr.len; k++) {
        VALUE v = bo->arr.items[k];
        int64_t n_val;
        if (NUQ_IS_FIX(v)) n_val = NUQ_FIX_VAL(v);
        else if (NUQ_IS_PTR(v) && NUQ_PTR(v)->type == NUQ_T_DOUBLE) n_val = (int64_t)NUQ_PTR(v)->dbl;
        else continue;
        for (int64_t i = 0; i < n_val; i++) nuq_array_push(r, nuq_make_int(i));
    }
    return r;
}

NODE_DEF
node_b_range2(CTX *c, NODE *n, NODE *from, NODE *to)
{
    VALUE m = EVAL_ARG(c, from);
    if (UNLIKELY(c->error != NUQ_NULL)) return m;
    VALUE nv = EVAL_ARG(c, to);
    if (UNLIKELY(c->error != NUQ_NULL)) return nv;
    struct nuq_obj *mo = NUQ_PTR(m), *no = NUQ_PTR(nv);
    VALUE r = nuq_make_array(0);
    for (size_t i = 0; i < mo->arr.len; i++)
    for (size_t j = 0; j < no->arr.len; j++) {
        VALUE va = mo->arr.items[i], vb = no->arr.items[j];
        int64_t lo = NUQ_IS_FIX(va) ? NUQ_FIX_VAL(va) :
                     (NUQ_IS_PTR(va) && NUQ_PTR(va)->type == NUQ_T_DOUBLE) ? (int64_t)NUQ_PTR(va)->dbl : 0;
        int64_t hi = NUQ_IS_FIX(vb) ? NUQ_FIX_VAL(vb) :
                     (NUQ_IS_PTR(vb) && NUQ_PTR(vb)->type == NUQ_T_DOUBLE) ? (int64_t)NUQ_PTR(vb)->dbl : 0;
        for (int64_t k = lo; k < hi; k++) nuq_array_push(r, nuq_make_int(k));
    }
    return r;
}

NODE_DEF
node_b_range3(CTX *c, NODE *n, NODE *from, NODE *to, NODE *step)
{
    VALUE m = EVAL_ARG(c, from);
    if (UNLIKELY(c->error != NUQ_NULL)) return m;
    VALUE nv = EVAL_ARG(c, to);
    if (UNLIKELY(c->error != NUQ_NULL)) return nv;
    VALUE s = EVAL_ARG(c, step);
    if (UNLIKELY(c->error != NUQ_NULL)) return s;
    struct nuq_obj *mo = NUQ_PTR(m), *no = NUQ_PTR(nv), *so = NUQ_PTR(s);
    VALUE r = nuq_make_array(0);
    for (size_t i = 0; i < mo->arr.len; i++)
    for (size_t j = 0; j < no->arr.len; j++)
    for (size_t k = 0; k < so->arr.len; k++) {
        VALUE va = mo->arr.items[i], vb = no->arr.items[j], vc = so->arr.items[k];
        int64_t lo = NUQ_IS_FIX(va) ? NUQ_FIX_VAL(va) : (int64_t)NUQ_PTR(va)->dbl;
        int64_t hi = NUQ_IS_FIX(vb) ? NUQ_FIX_VAL(vb) : (int64_t)NUQ_PTR(vb)->dbl;
        int64_t st = NUQ_IS_FIX(vc) ? NUQ_FIX_VAL(vc) : (int64_t)NUQ_PTR(vc)->dbl;
        if (st == 0) continue;
        if (st > 0) for (int64_t x = lo; x < hi; x += st) nuq_array_push(r, nuq_make_int(x));
        else        for (int64_t x = lo; x > hi; x += st) nuq_array_push(r, nuq_make_int(x));
    }
    return r;
}

