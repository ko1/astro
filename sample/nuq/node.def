    nuq_paths_collect_pool(c, c->input);
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_b_floor(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_builtin_floor(c->input));
}

NODE_DEF
node_b_ceil(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_builtin_ceil(c->input));
