NODE_DEF
node_b_pow(CTX *c, NODE *n, NODE *base_n, NODE *exp_n)
{
    size_t t0 = c->pool_top;
    EMIT b = EVAL_ARG(c, base_n);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    EMIT e = EVAL_ARG(c, exp_n);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    if (b.count == 0 || e.count == 0) { c->pool_top = t0; return EMIT_EMPTY; }
    double bv = NUQ_IS_FIX(b.items[0]) ? (double)NUQ_FIX_VAL(b.items[0])
                                       : NUQ_PTR(b.items[0])->dbl;
    double ev = NUQ_IS_FIX(e.items[0]) ? (double)NUQ_FIX_VAL(e.items[0])
                                       : NUQ_PTR(e.items[0])->dbl;
    c->pool_top = t0;
    return nuq_emit_one(c, nuq_make_double(pow(bv, ev)));
}

/* `trim` — strip leading and trailing ASCII whitespace. */
NODE_DEF
node_b_trim(CTX *c, NODE *n)
{
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING))
        { c->error = nuq_make_string("trim input must be a string", 27); return EMIT_EMPTY; }
    struct nuq_obj *o = NUQ_PTR(c->input);
    size_t lo = 0, hi = o->str.len;
    while (lo < hi && (o->str.bytes[lo] == ' ' || o->str.bytes[lo] == '\t' ||
                       o->str.bytes[lo] == '\n' || o->str.bytes[lo] == '\r')) lo++;
    while (hi > lo && (o->str.bytes[hi-1] == ' ' || o->str.bytes[hi-1] == '\t' ||
                       o->str.bytes[hi-1] == '\n' || o->str.bytes[hi-1] == '\r')) hi--;
    return nuq_emit_one(c, nuq_make_string(o->str.bytes + lo, hi - lo));
}

/* `transpose` — matrix transpose: `[[1,2],[3,4]] | transpose ⇒ [[1,3],[2,4]]`.
 * Handles ragged rows by treating missing entries as null. */
NODE_DEF
node_b_transpose(CTX *c, NODE *n)
{
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))
        { c->error = nuq_make_string("transpose: not array", 20); return EMIT_EMPTY; }
    struct nuq_obj *o = NUQ_PTR(c->input);
    size_t maxlen = 0;
    for (size_t i = 0; i < o->arr.len; i++) {
        VALUE row = o->arr.items[i];
        if (NUQ_IS_PTR(row) && NUQ_PTR(row)->type == NUQ_T_ARRAY) {
            size_t l = NUQ_PTR(row)->arr.len;
            if (l > maxlen) maxlen = l;
        }
    }
    VALUE out = nuq_make_array(maxlen);
    for (size_t j = 0; j < maxlen; j++) {
        VALUE col = nuq_make_array(o->arr.len);
        for (size_t i = 0; i < o->arr.len; i++) {
            VALUE row = o->arr.items[i];
            if (NUQ_IS_PTR(row) && NUQ_PTR(row)->type == NUQ_T_ARRAY &&
                j < NUQ_PTR(row)->arr.len)
                nuq_array_push(col, NUQ_PTR(row)->arr.items[j]);
            else
                nuq_array_push(col, NUQ_NULL);
        }
        nuq_array_push(out, col);
    }
    return nuq_emit_one(c, out);
}

/* `isempty(f)` — true if `f` emits nothing on input, else false.
 * Note: per jq, errors in `f` propagate (NOT caught). */
NODE_DEF
node_b_isempty(CTX *c, NODE *n, NODE *body)
{
    size_t t0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    bool empty = (bo.count == 0);
    c->pool_top = t0;
    return nuq_emit_one(c, empty ? NUQ_TRUE : NUQ_FALSE);
}

/* `add(f)` — like `add` but applies `f` to each element first.
 * jq def: `def add(f): reduce .[] as $x (null; . + ($x|f))`. */
NODE_DEF
node_b_add1(CTX *c, NODE *n, NODE *body)
{
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))
        { c->error = nuq_make_string("add: not array", 14); return EMIT_EMPTY; }
    struct nuq_obj *o = NUQ_PTR(c->input);
    VALUE saved = c->input;
    VALUE acc = NUQ_NULL;
    for (size_t i = 0; i < o->arr.len; i++) {
        c->input = o->arr.items[i];
        size_t t0 = c->pool_top;
        EMIT bo = EVAL_ARG(c, body);
        if (UNLIKELY(c->error != NUQ_NULL)) { c->input = saved; return EMIT_EMPTY; }
        VALUE v = bo.count > 0 ? bo.items[0] : NUQ_NULL;
        c->pool_top = t0;
        acc = (i == 0) ? v : nuq_op_add(acc, v);
        if (UNLIKELY(c->error != NUQ_NULL)) { c->input = saved; return EMIT_EMPTY; }
    }
    c->input = saved;
    return nuq_emit_one(c, acc);
}

/* `all(gen; cond)` / `any(gen; cond)` — 2-arg variant that runs `gen`
 * to produce the values, then tests each against `cond`. */
NODE_DEF
node_b_all2(CTX *c, NODE *n, NODE *gen, NODE *cond)
{
    size_t t0 = c->pool_top;
    EMIT vs = EVAL_ARG(c, gen);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t cnt = vs.count;
    VALUE small[16];
    VALUE *local = (cnt <= 16) ? small : (VALUE *)GC_malloc(cnt * sizeof(VALUE));
    memcpy(local, vs.items, cnt * sizeof(VALUE));
    c->pool_top = t0;
    VALUE saved = c->input;
    bool all = true;
    for (uint32_t i = 0; i < cnt && all; i++) {
        c->input = local[i];
        size_t tt = c->pool_top;
        EMIT co = EVAL_ARG(c, cond);
        if (UNLIKELY(c->error != NUQ_NULL)) { c->input = saved; return EMIT_EMPTY; }
        bool any_truthy = false;
        for (uint32_t j = 0; j < co.count; j++)
            if (nuq_truthy(co.items[j])) { any_truthy = true; break; }
        c->pool_top = tt;
        if (!any_truthy) all = false;
    }
    c->input = saved;
    return nuq_emit_one(c, all ? NUQ_TRUE : NUQ_FALSE);
}

/* `ltrim` / `rtrim` — one-sided whitespace strip. */
NODE_DEF
node_b_ltrim(CTX *c, NODE *n)
{
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING)) {
        c->error = nuq_make_string("trim input must be a string", 27);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    size_t lo = 0;
    while (lo < o->str.len && (o->str.bytes[lo] == ' ' || o->str.bytes[lo] == '\t' ||
                                o->str.bytes[lo] == '\n' || o->str.bytes[lo] == '\r')) lo++;
    return nuq_emit_one(c, nuq_make_string(o->str.bytes + lo, o->str.len - lo));
}

NODE_DEF
node_b_rtrim(CTX *c, NODE *n)
{
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING)) {
        c->error = nuq_make_string("trim input must be a string", 27);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    size_t hi = o->str.len;
    while (hi > 0 && (o->str.bytes[hi-1] == ' ' || o->str.bytes[hi-1] == '\t' ||
                       o->str.bytes[hi-1] == '\n' || o->str.bytes[hi-1] == '\r')) hi--;
    return nuq_emit_one(c, nuq_make_string(o->str.bytes, hi));
}

NODE_DEF
node_b_toboolean(CTX *c, NODE *n)
{
    if (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_BOOL)
        return nuq_emit_one(c, c->input);
    if (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING) {
        struct nuq_obj *o = NUQ_PTR(c->input);
        if (o->str.len == 4 && memcmp(o->str.bytes, "true", 4) == 0)
            return nuq_emit_one(c, NUQ_TRUE);
        if (o->str.len == 5 && memcmp(o->str.bytes, "false", 5) == 0)
            return nuq_emit_one(c, NUQ_FALSE);
    }
    {
        char d[80], msg[160];
        nuq_value_descr(c->input, d, sizeof(d));
        int w = snprintf(msg, sizeof(msg), "%s cannot be parsed as a boolean", d);
        c->error = nuq_make_string(msg, (size_t)w);
    }
    return EMIT_EMPTY;
}

/* `builtins` — list of all known builtin names with their arity, e.g.
 * `["length/0", "map/1", ...]`.  We hardcode the list here since nuq's
 * registration is in filter.c via macros (not introspectable). */
/* `path(f)` — extracts the path expression `f` would visit.  We
 * support the static-accessor case (chains of identity / pipe /
 * field / index / iter); for those we run walk_path with a custom
 * leaf that records the current path, then emit each path.
 *
 * Implementation strategy: maintain a "current path" array as we
 * descend; at each leaf, push a CLONE of the current path into the
 * pool slice.  Return the slice. */
NODE_DEF
node_b_path(CTX *c, NODE *n, NODE *body)
{
    return nuq_path_eval(c, body);
}

/* `debug` — print `["DEBUG:", input]` to stderr and pass input through. */
NODE_DEF
node_b_debug(CTX *c, NODE *n)
{
    fprintf(stderr, "[\"DEBUG:\",");
    nuq_json_print(stderr, c->input, 0);
    fprintf(stderr, "]\n");
    return nuq_emit_one(c, c->input);
}

/* `stderr` — print input to stderr (no newline) in jq form, pass through. */
NODE_DEF
node_b_stderr(CTX *c, NODE *n)
{
    nuq_json_print(stderr, c->input, 0);
    return nuq_emit_one(c, c->input);
}

/* Date / time builtins.  All use the host's <time.h>; jq compatibility
 * for niche cases (timezones, locales) is best-effort. */

NODE_DEF
node_b_now(CTX *c, NODE *n)
{
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    return nuq_emit_one(c, nuq_make_double((double)ts.tv_sec + ts.tv_nsec / 1e9));
}

NODE_DEF
node_b_gmtime(CTX *c, NODE *n)
{
    if (!(NUQ_IS_FIX(c->input) ||
          (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_DOUBLE))) {
        c->error = nuq_make_string("gmtime: not number", 18);
        return EMIT_EMPTY;
    }
    double d = NUQ_IS_FIX(c->input) ? (double)NUQ_FIX_VAL(c->input)
                                    : NUQ_PTR(c->input)->dbl;
    time_t t = (time_t)d;
    struct tm tm;
    if (!gmtime_r(&t, &tm)) {
        c->error = nuq_make_string("gmtime: out of range", 20);
        return EMIT_EMPTY;
    }
    /* jq returns broken-down array: [Y-1900, M-1, D, H, M, S, wday, yday] */
    VALUE arr = nuq_make_array(8);
    nuq_array_push(arr, nuq_make_int(tm.tm_year + 1900));
    nuq_array_push(arr, nuq_make_int(tm.tm_mon));
    nuq_array_push(arr, nuq_make_int(tm.tm_mday));
    nuq_array_push(arr, nuq_make_int(tm.tm_hour));
    nuq_array_push(arr, nuq_make_int(tm.tm_min));
    nuq_array_push(arr, nuq_make_double((double)tm.tm_sec + (d - (double)t)));
    nuq_array_push(arr, nuq_make_int(tm.tm_wday));
    nuq_array_push(arr, nuq_make_int(tm.tm_yday));
    return nuq_emit_one(c, arr);
}

NODE_DEF
node_b_localtime(CTX *c, NODE *n)
{
    if (!(NUQ_IS_FIX(c->input) ||
          (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_DOUBLE))) {
        c->error = nuq_make_string("localtime: not number", 21);
        return EMIT_EMPTY;
    }
    double d = NUQ_IS_FIX(c->input) ? (double)NUQ_FIX_VAL(c->input)
                                    : NUQ_PTR(c->input)->dbl;
    time_t t = (time_t)d;
    struct tm tm;
    if (!localtime_r(&t, &tm)) {
        c->error = nuq_make_string("localtime: out of range", 23);
        return EMIT_EMPTY;
    }
    VALUE arr = nuq_make_array(8);
    nuq_array_push(arr, nuq_make_int(tm.tm_year + 1900));
    nuq_array_push(arr, nuq_make_int(tm.tm_mon));
    nuq_array_push(arr, nuq_make_int(tm.tm_mday));
    nuq_array_push(arr, nuq_make_int(tm.tm_hour));
    nuq_array_push(arr, nuq_make_int(tm.tm_min));
    nuq_array_push(arr, nuq_make_double((double)tm.tm_sec + (d - (double)t)));
    nuq_array_push(arr, nuq_make_int(tm.tm_wday));
    nuq_array_push(arr, nuq_make_int(tm.tm_yday));
    return nuq_emit_one(c, arr);
}

NODE_DEF
node_b_mktime(CTX *c, NODE *n)
{
    /* Input is a broken-down array as from gmtime. */
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY)) {
        c->error = nuq_make_string("mktime: not array", 17);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    if (o->arr.len < 6) {
        c->error = nuq_make_string("mktime requires parsed datetime inputs", 38);
        return EMIT_EMPTY;
    }
    /* Validate every element is numeric — jq emits "mktime requires
     * parsed datetime inputs" for non-numeric components. */
    for (size_t i = 0; i < 6 && i < o->arr.len; i++) {
        VALUE e = o->arr.items[i];
        if (!(NUQ_IS_FIX(e) || (NUQ_IS_PTR(e) && NUQ_PTR(e)->type == NUQ_T_DOUBLE))) {
            c->error = nuq_make_string("mktime requires parsed datetime inputs", 38);
            return EMIT_EMPTY;
        }
    }
    struct tm tm = {0};
    tm.tm_year = (int)NUQ_FIX_VAL(o->arr.items[0]) - 1900;
    tm.tm_mon  = (int)NUQ_FIX_VAL(o->arr.items[1]);
    tm.tm_mday = (int)NUQ_FIX_VAL(o->arr.items[2]);
    tm.tm_hour = (int)NUQ_FIX_VAL(o->arr.items[3]);
    tm.tm_min  = (int)NUQ_FIX_VAL(o->arr.items[4]);
    VALUE sec = o->arr.items[5];
    double secd = NUQ_IS_FIX(sec) ? (double)NUQ_FIX_VAL(sec) : NUQ_PTR(sec)->dbl;
    tm.tm_sec = (int)secd;
    time_t t = timegm(&tm);
    if (t == (time_t)-1) {
        c->error = nuq_make_string("mktime: out of range", 20);
        return EMIT_EMPTY;
    }
    return nuq_emit_one(c, nuq_make_double((double)t + (secd - (int)secd)));
}

NODE_DEF
node_b_strftime(CTX *c, NODE *n, NODE *fmt_n)
{
    /* Input must be broken-down (array) like gmtime output. */
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY)) {
        c->error = nuq_make_string("strftime: not array", 19);
        return EMIT_EMPTY;
    }
    size_t t0 = c->pool_top;
    EMIT fb = EVAL_ARG(c, fmt_n);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    if (fb.count == 0 || !(NUQ_IS_PTR(fb.items[0]) && NUQ_PTR(fb.items[0])->type == NUQ_T_STRING)) {
        c->pool_top = t0;
        c->error = nuq_make_string("strftime: format not string", 27);
        return EMIT_EMPTY;
    }
    struct nuq_obj *fo = NUQ_PTR(fb.items[0]);
    char fmt_buf[256];
    size_t fl = fo->str.len < sizeof(fmt_buf)-1 ? fo->str.len : sizeof(fmt_buf)-1;
    memcpy(fmt_buf, fo->str.bytes, fl);
    fmt_buf[fl] = 0;
    c->pool_top = t0;

    struct nuq_obj *o = NUQ_PTR(c->input);
    struct tm tm = {0};
    /* Validate: every element must be numeric (jq's "broken down time"
     * is an array of ints).  Reject string-in-position cases. */
    for (size_t i = 0; i < o->arr.len; i++) {
        VALUE e = o->arr.items[i];
        if (!(NUQ_IS_FIX(e) || (NUQ_IS_PTR(e) && NUQ_PTR(e)->type == NUQ_T_DOUBLE))) {
            c->error = nuq_make_string("strftime/1 requires parsed datetime inputs", 42);
            return EMIT_EMPTY;
        }
    }
    if (o->arr.len >= 1) tm.tm_year = (int)NUQ_FIX_VAL(o->arr.items[0]) - 1900;
    if (o->arr.len >= 2) tm.tm_mon  = (int)NUQ_FIX_VAL(o->arr.items[1]);
    if (o->arr.len >= 3) tm.tm_mday = (int)NUQ_FIX_VAL(o->arr.items[2]);
    if (o->arr.len >= 4) tm.tm_hour = (int)NUQ_FIX_VAL(o->arr.items[3]);
    if (o->arr.len >= 5) tm.tm_min  = (int)NUQ_FIX_VAL(o->arr.items[4]);
    if (o->arr.len >= 6) {
        VALUE sec = o->arr.items[5];
        tm.tm_sec = (int)(NUQ_IS_FIX(sec) ? NUQ_FIX_VAL(sec) : NUQ_PTR(sec)->dbl);
    }
    if (o->arr.len >= 7) tm.tm_wday = (int)NUQ_FIX_VAL(o->arr.items[6]);
    if (o->arr.len >= 8) tm.tm_yday = (int)NUQ_FIX_VAL(o->arr.items[7]);
    /* If only Y/M/D supplied, jq normalizes via mktime — we don't, but
     * for strftime that's fine: the format string controls output. */
    char out[1024];
    size_t n_out = strftime(out, sizeof(out), fmt_buf, &tm);
    return nuq_emit_one(c, nuq_make_string(out, n_out));
}

NODE_DEF
node_b_strptime(CTX *c, NODE *n, NODE *fmt_n)
{
    /* Input is a string; parse with format. */
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING)) {
        c->error = nuq_make_string("strptime: not string", 20);
        return EMIT_EMPTY;
    }
    size_t t0 = c->pool_top;
    EMIT fb = EVAL_ARG(c, fmt_n);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    if (fb.count == 0 || !(NUQ_IS_PTR(fb.items[0]) && NUQ_PTR(fb.items[0])->type == NUQ_T_STRING)) {
        c->pool_top = t0;
        c->error = nuq_make_string("strptime: format not string", 27);
        return EMIT_EMPTY;
    }
    char fmt_buf[256];
    struct nuq_obj *fo = NUQ_PTR(fb.items[0]);
    size_t fl = fo->str.len < sizeof(fmt_buf)-1 ? fo->str.len : sizeof(fmt_buf)-1;
    memcpy(fmt_buf, fo->str.bytes, fl);
    fmt_buf[fl] = 0;
    c->pool_top = t0;

    struct nuq_obj *io = NUQ_PTR(c->input);
    char in_buf[1024];
    size_t il = io->str.len < sizeof(in_buf)-1 ? io->str.len : sizeof(in_buf)-1;
    memcpy(in_buf, io->str.bytes, il);
    in_buf[il] = 0;
    struct tm tm = {0};
    if (!strptime(in_buf, fmt_buf, &tm)) {
        c->error = nuq_make_string("strptime: parse failed", 22);
        return EMIT_EMPTY;
    }
    VALUE arr = nuq_make_array(8);
    nuq_array_push(arr, nuq_make_int(tm.tm_year + 1900));
    nuq_array_push(arr, nuq_make_int(tm.tm_mon));
    nuq_array_push(arr, nuq_make_int(tm.tm_mday));
    nuq_array_push(arr, nuq_make_int(tm.tm_hour));
    nuq_array_push(arr, nuq_make_int(tm.tm_min));
    nuq_array_push(arr, nuq_make_int(tm.tm_sec));
    nuq_array_push(arr, nuq_make_int(tm.tm_wday));
    nuq_array_push(arr, nuq_make_int(tm.tm_yday));
    return nuq_emit_one(c, arr);
}

NODE_DEF
node_b_builtins(CTX *c, NODE *n)
{
    static const char *names[] = {
        "length/0","utf8bytelength/0","type/0","keys/0","keys_unsorted/0",
        "values/0","empty/0","not/0","tostring/0","to_string/0",
        "tonumber/0","tojson/0","fromjson/0","add/0","min/0","max/0",
        "sort/0","reverse/0","unique/0","to_entries/0","from_entries/0",
        "paths/0","leaf_paths/0","floor/0","ceil/0","round/0","fabs/0",
        "abs/0","sqrt/0","first/0","last/0","any/0","all/0","input/0",
        "inputs/0","nulls/0","booleans/0","numbers/0","strings/0",
        "arrays/0","objects/0","iterables/0","scalars/0","isnan/0",
        "isinfinite/0","infinite/0","nan/0","isnull/0","now/0","env/0",
        "input_filename/0","error/0","recurse/0","explode/0","implode/0",
        "ascii_upcase/0","ascii_downcase/0","tojson/0","trim/0","ltrim/0",
        "rtrim/0","transpose/0","flatten/0","sin/0","cos/0","tan/0",
        "asin/0","acos/0","atan/0","sinh/0","cosh/0","tanh/0","exp/0",
        "exp2/0","exp10/0","log/0","log2/0","log10/0","cbrt/0","gamma/0",
        "tgamma/0","logb/0","significand/0","j0/0","j1/0","y0/0","y1/0",
        "toboolean/0","builtins/0",
        "select/1","map/1","map_values/1","with_entries/1","walk/1",
        "recurse/1","has/1","in/1","contains/1","range/1","split/1",
        "splits/1","join/1","startswith/1","endswith/1","ltrimstr/1",
        "rtrimstr/1","first/1","last/1","any/1","all/1","sort_by/1",
        "group_by/1","unique_by/1","min_by/1","max_by/1","getpath/1",
        "delpaths/1","del/1","indices/1","index/1","rindex/1","test/1",
        "ascii/1","flatten/1","isvalid/1","IN/1","isempty/1","error/1",
        "bsearch/1",
        "range/2","limit/2","nth/2","skip/2","recurse/2","while/2",
        "until/2","setpath/2","gsub/2","sub/2","all/2","any/2","pow/2",
        "range/3",
    };
    size_t cnt = sizeof(names) / sizeof(names[0]);
    VALUE arr = nuq_make_array(cnt);
    for (size_t i = 0; i < cnt; i++)
        nuq_array_push(arr, nuq_make_string(names[i], strlen(names[i])));
    return nuq_emit_one(c, arr);
}

NODE_DEF
node_b_bsearch(CTX *c, NODE *n, NODE *needle_n)
{
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY)) {
        c->error = nuq_make_string("bsearch: not array", 18);
        return EMIT_EMPTY;
    }
    size_t t0 = c->pool_top;
    EMIT vs = EVAL_ARG(c, needle_n);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    if (vs.count == 0) { c->pool_top = t0; return EMIT_EMPTY; }
    VALUE needle = vs.items[0];
    c->pool_top = t0;
    struct nuq_obj *o = NUQ_PTR(c->input);
    int64_t lo = 0, hi = (int64_t)o->arr.len;
    while (lo < hi) {
        int64_t mid = (lo + hi) / 2;
        int cmp = nuq_cmp(o->arr.items[mid], needle);
        if (cmp < 0) lo = mid + 1;
        else hi = mid;
    }
    if (lo < (int64_t)o->arr.len && nuq_eq(o->arr.items[lo], needle))
        return nuq_emit_one(c, nuq_make_int(lo));
    return nuq_emit_one(c, nuq_make_int(-(lo + 1)));
}

NODE_DEF
node_b_any2(CTX *c, NODE *n, NODE *gen, NODE *cond)
{
    size_t t0 = c->pool_top;
    EMIT vs = EVAL_ARG(c, gen);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t cnt = vs.count;
    VALUE small[16];
    VALUE *local = (cnt <= 16) ? small : (VALUE *)GC_malloc(cnt * sizeof(VALUE));
    memcpy(local, vs.items, cnt * sizeof(VALUE));
    c->pool_top = t0;
    VALUE saved = c->input;
    bool any = false;
    for (uint32_t i = 0; i < cnt && !any; i++) {
        c->input = local[i];
        size_t tt = c->pool_top;
        EMIT co = EVAL_ARG(c, cond);
        if (UNLIKELY(c->error != NUQ_NULL)) { c->input = saved; return EMIT_EMPTY; }
        for (uint32_t j = 0; j < co.count; j++)
            if (nuq_truthy(co.items[j])) { any = true; break; }
        c->pool_top = tt;
    }
    c->input = saved;
    return nuq_emit_one(c, any ? NUQ_TRUE : NUQ_FALSE);
}

/* `input` — pull next pending JSON input from the queue.  Errors if
 * the queue is empty (jq raises "No more inputs"). */
NODE_DEF
node_b_input(CTX *c, NODE *n)
{
    VALUE v;
    if (!nuq_input_pull(&v)) {
        c->error = nuq_make_string("No more inputs", 14);
        return EMIT_EMPTY;
    }
    return nuq_emit_one(c, v);
}

/* `inputs` — emit all remaining pending inputs as a stream. */
NODE_DEF
node_b_inputs(CTX *c, NODE *n)
{
    size_t outer = c->pool_top;
    VALUE v;
    while (nuq_input_pull(&v)) nuq_pool_push(c, v);
    return nuq_emit_slice(c, outer);
}

/* `env` — environment variables as an object. */
NODE_DEF
node_b_env(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_env_object());
}

/* `isvalid(f)` — true if f doesn't error on input, false otherwise.
 * jq: `def isvalid(f): . as $i | try (f|true) catch false | . == true`. */
NODE_DEF
node_b_isvalid(CTX *c, NODE *n, NODE *body)
{
    VALUE saved_err = c->error;
    c->error = NUQ_NULL;
    size_t t0 = c->pool_top;
    nuq_suppress_error_print++;
    (void)EVAL_ARG(c, body);
    nuq_suppress_error_print--;
    bool ok = (c->error == NUQ_NULL);
    c->error = saved_err;
    c->pool_top = t0;
    return nuq_emit_one(c, ok ? NUQ_TRUE : NUQ_FALSE);
}

/* `IN(values…)` — emit true if input equals any value of the
 * comma-separated stream.  jq's `IN(s)` is `def IN(s): . as $x | first((s == $x) // false)`. */
NODE_DEF
node_b_IN1(CTX *c, NODE *n, NODE *body)
{
    VALUE saved = c->input;
    size_t t0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    bool found = false;
    for (uint32_t i = 0; i < bo.count; i++) {
        if (nuq_eq(saved, bo.items[i])) { found = true; break; }
    }
    c->pool_top = t0;
    return nuq_emit_one(c, found ? NUQ_TRUE : NUQ_FALSE);
}

/* `gsub(s; r)` — replace all non-overlapping occurrences of substring
 * `s` with `r`.  Without regex this is plain substring replace
 * (jq's `gsub` is regex-based but our subset stays substring-only;
 * documented in todo). */
NODE_DEF
node_b_gsub(CTX *c, NODE *n, NODE *pat, NODE *repl)
{
    return nuq_gsub_eval(c, pat, repl);
}

NODE_DEF
node_b_sub(CTX *c, NODE *n, NODE *pat, NODE *repl)
{
    return nuq_sub_eval(c, pat, repl);
}

/* Type-predicate filters: `nulls`, `booleans`, `numbers`, `strings`,
 * `arrays`, `objects`, `iterables`, `scalars`.
 * Each emits `.` iff its type matches, else empty.  Mirrors jq's
 * `def nulls: select(type=="null")`-style sugar. */
NODE_DEF
node_b_nulls(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_NULL)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_booleans(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_BOOL)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_numbers(CTX *c, NODE *n)
{
    if (NUQ_IS_FIX(c->input)) return nuq_emit_one(c, c->input);
    if (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_DOUBLE)
        return nuq_emit_one(c, c->input);
    return EMIT_EMPTY;
}

NODE_DEF
node_b_strings(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_arrays(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_objects(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_OBJECT)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_iterables(CTX *c, NODE *n)
{
    if (!NUQ_IS_PTR(c->input)) return EMIT_EMPTY;
    enum nuq_type t = NUQ_PTR(c->input)->type;
    return (t == NUQ_T_ARRAY || t == NUQ_T_OBJECT)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_scalars(CTX *c, NODE *n)
{
    if (NUQ_IS_FIX(c->input)) return nuq_emit_one(c, c->input);
    enum nuq_type t = NUQ_PTR(c->input)->type;
    return (t == NUQ_T_ARRAY || t == NUQ_T_OBJECT)
        ? EMIT_EMPTY : nuq_emit_one(c, c->input);
}

/* `utf8bytelength` — same as length on strings since nuq stores raw bytes.
 * jq distinguishes char-length (length) from byte-length here, but our
 * length is already byte-counting. */
NODE_DEF
node_b_utf8bytelength(CTX *c, NODE *n)
{
    if (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING)
        return nuq_emit_one(c, nuq_make_int((int64_t)NUQ_PTR(c->input)->str.len));
    {
        char d[80], msg[160];
        nuq_value_descr(c->input, d, sizeof(d));
        int w = snprintf(msg, sizeof(msg), "%s only strings have UTF-8 byte length", d);
        c->error = nuq_make_string(msg, (size_t)w);
    }
    return EMIT_EMPTY;
}

/* `flatten` — full recursive array flatten (matches jq 1.7's `flatten`).
 * Use `flatten(1)` for single-level. */
NODE_DEF
node_b_flatten(CTX *c, NODE *n)
{
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY)) {
        c->error = nuq_make_string("flatten: not array", 18);
        return EMIT_EMPTY;
    }
    /* INT_MAX-ish depth = full flatten. */
    return nuq_emit_one(c, nuq_flatten_eval(c->input, 1<<30));
}

/* `flatten(N)` — flatten N levels deep (N must be a non-negative int). */
NODE_DEF
node_b_flatten_n(CTX *c, NODE *n, NODE *depth)
{
    return nuq_flatten1_eval(c, depth);
}

/* `while(cond; update)` — emit . while cond(.) is truthy, then iterate. */
NODE_DEF
node_b_while(CTX *c, NODE *n, NODE *cond, NODE *update)
{
    return nuq_while_eval(c, cond, update);
}

/* `until(cond; update)` — apply update until cond(.) is truthy, emit final. */
NODE_DEF
node_b_until(CTX *c, NODE *n, NODE *cond, NODE *update)
{
    return nuq_until_eval(c, cond, update);
}

NODE_DEF
node_b_recurse0(CTX *c, NODE *n)
{
    size_t top0 = c->pool_top;
    nuq_recurse_collect_pool(c, c->input);
    return nuq_emit_slice(c, top0);
}

/* --- 1-arg built-ins (with sub-expression body) --- */

NODE_DEF
node_b_select(CTX *c, NODE *n, NODE *body)
{
    size_t top0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    bool any = false;
    for (uint32_t i = 0; i < bo.count; i++)
        if (nuq_truthy(bo.items[i])) { any = true; break; }
    c->pool_top = top0;       /* release body's emits */
    if (any) return nuq_emit_one(c, c->input);
    return EMIT_EMPTY;
}

NODE_DEF
node_b_map(CTX *c, NODE *n, NODE *body)
{
    if (UNLIKELY(!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))) {
        c->error = nuq_make_string("map: not array", 15);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    VALUE result = nuq_make_array(o->arr.len);
    VALUE saved = c->input;
    for (size_t i = 0; i < o->arr.len; i++) {
        c->input = o->arr.items[i];
        size_t top0 = c->pool_top;
        EMIT bo = EVAL_ARG(c, body);
        if (UNLIKELY(c->error != NUQ_NULL)) { c->input = saved; return EMIT_EMPTY; }
        for (uint32_t j = 0; j < bo.count; j++) nuq_array_push(result, bo.items[j]);
        c->pool_top = top0;
    }
    c->input = saved;
    return nuq_emit_one(c, result);
}

NODE_DEF
node_b_map_values(CTX *c, NODE *n, NODE *body)
{
    return nuq_map_values_eval(c, body);
}

NODE_DEF
node_b_with_entries(CTX *c, NODE *n, NODE *body)
{
    return nuq_with_entries_eval(c, body);
}

/* walk(f) — bottom-up transform.  jq defines it as:
 *   def walk(f):
 *     . as $in |
 *     if type == "object" then
 *       reduce keys[] as $key ({}; . + { ($key): ($in[$key] | walk(f)) }) | f
 *     elif type == "array" then map(walk(f)) | f
 *     else f end;
 * We hand-roll the recursion in C so we don't need to translate
 * complex jq defs at parse time.  body is invoked once per node. */
NODE_DEF
node_b_walk(CTX *c, NODE *n, NODE *body)
{
    return nuq_walk_eval(c, body);
}

NODE_DEF
node_b_range1(CTX *c, NODE *n, NODE *to)
{
    size_t top0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, to);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    /* Snapshot bo because we'll grow pool below. */
    uint32_t cnt = bo.count;
    VALUE small[16];
    VALUE *local = (cnt <= 16) ? small : (VALUE *)GC_malloc(cnt * sizeof(VALUE));
    memcpy(local, bo.items, cnt * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t k = 0; k < cnt; k++) {
        VALUE v = local[k];
        int64_t n_val;
        if (NUQ_IS_FIX(v)) n_val = NUQ_FIX_VAL(v);
        else if (NUQ_IS_PTR(v) && NUQ_PTR(v)->type == NUQ_T_DOUBLE) n_val = (int64_t)NUQ_PTR(v)->dbl;
        else continue;
        for (int64_t i = 0; i < n_val; i++) nuq_pool_push(c, nuq_make_int(i));
    }
    return nuq_emit_slice(c, top0);
}

