/*
 * nuq filter language — AST node definitions (EMIT-return form).
 *
 * Each NODE_DEF returns an EMIT (= slice of c->pool) instead of
 * allocating a fresh nuq_array.  Hot path:
 *   size_t top0 = c->pool_top;
 *   ... nuq_pool_push(c, v) for each emit ...
 *   return nuq_emit_slice(c, top0);
 *
 * No per-call nuq_obj allocation — the pool is a single growable
 * buffer that's released by callers via `c->pool_top = saved_top`
 * after consuming the child's EMIT.  See docs/runtime.md for the
 * stack discipline.
 *
 * Errors propagate via c->error (return EMIT_EMPTY when in flight).
 */

/* ===== identity / literals ===== */

NODE_DEF
node_identity(CTX *c, NODE *n)
{
    return nuq_emit_one(c, c->input);
}

NODE_DEF
node_recurse(CTX *c, NODE *n)
{
    size_t top0 = c->pool_top;
    nuq_recurse_collect_pool(c, c->input);
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_null(CTX *c, NODE *n)
{
    return nuq_emit_one(c, NUQ_NULL);
}

NODE_DEF
node_true(CTX *c, NODE *n)
{
    return nuq_emit_one(c, NUQ_TRUE);
}

NODE_DEF
node_false(CTX *c, NODE *n)
{
    return nuq_emit_one(c, NUQ_FALSE);
}

NODE_DEF
node_int(CTX *c, NODE *n, int32_t v)
{
    return nuq_emit_one(c, NUQ_FIX(v));
}

NODE_DEF
node_lit(CTX *c, NODE *n, uint32_t lit_id)
{
    return nuq_emit_one(c, nuq_lit_get(lit_id));
}

NODE_DEF
node_str(CTX *c, NODE *n, const char *s)
{
    return nuq_emit_one(c, nuq_make_string(s, strlen(s)));
}

NODE_DEF
node_interp(CTX *c, NODE *n, uint32_t parts_id)
{
    return nuq_interp_eval(c, parts_id);
}

NODE_DEF
node_format(CTX *c, NODE *n, uint32_t fmt_id, NODE *body)
{
    return nuq_format_eval(c, fmt_id, body);
}

/* ===== access ===== */

NODE_DEF
node_field(CTX *c, NODE *n, const char *name)
{
    VALUE v;
    if (UNLIKELY(!nuq_field_lookup(c->input, name, false, &v))) {
        c->error = nuq_make_string("type error", 10);
        return EMIT_EMPTY;
    }
    return nuq_emit_one(c, v);
}

NODE_DEF
node_field_opt(CTX *c, NODE *n, const char *name)
{
    VALUE v;
    if (!nuq_field_lookup(c->input, name, true, &v)) return EMIT_EMPTY;
    return nuq_emit_one(c, v);
}

NODE_DEF
node_index(CTX *c, NODE *n, NODE *expr)
{
    size_t top0 = c->pool_top;
    VALUE in = c->input;
    EMIT keys = EVAL_ARG(c, expr);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    /* Snapshot keys to alloca because pool may realloc during pushes. */
    uint32_t kc = keys.count;
    VALUE local_keys[kc < 32 ? kc : 1];
    VALUE *kp = local_keys;
    if (kc >= 32) kp = (VALUE *)GC_malloc(kc * sizeof(VALUE));
    memcpy(kp, keys.items, kc * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t i = 0; i < kc; i++) {
        VALUE k = kp[i];
        if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_NULL) { nuq_pool_push(c, NUQ_NULL); continue; }
        if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_OBJECT) {
            if (NUQ_IS_PTR(k) && NUQ_PTR(k)->type == NUQ_T_STRING)
                nuq_pool_push(c, nuq_object_get(in, k));
            else { c->error = nuq_make_string("object index must be string", 28); return EMIT_EMPTY; }
            continue;
        }
        if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_ARRAY) {
            int64_t idx;
            if (NUQ_IS_FIX(k)) idx = NUQ_FIX_VAL(k);
            else if (NUQ_IS_PTR(k) && NUQ_PTR(k)->type == NUQ_T_DOUBLE) idx = (int64_t)NUQ_PTR(k)->dbl;
            else { c->error = nuq_make_string("array index must be number", 27); return EMIT_EMPTY; }
            nuq_pool_push(c, nuq_array_get(in, idx));
            continue;
        }
        c->error = nuq_make_string("type error: cannot index", 25);
        return EMIT_EMPTY;
    }
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_index_opt(CTX *c, NODE *n, NODE *expr)
{
    size_t top0 = c->pool_top;
    VALUE in = c->input;
    EMIT keys = EVAL_ARG(c, expr);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t kc = keys.count;
    VALUE local_keys[kc < 32 ? kc : 1];
    VALUE *kp = local_keys;
    if (kc >= 32) kp = (VALUE *)GC_malloc(kc * sizeof(VALUE));
    memcpy(kp, keys.items, kc * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t i = 0; i < kc; i++) {
        VALUE k = kp[i];
        if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_OBJECT) {
            if (NUQ_IS_PTR(k) && NUQ_PTR(k)->type == NUQ_T_STRING)
                nuq_pool_push(c, nuq_object_get(in, k));
        } else if (NUQ_IS_PTR(in) && NUQ_PTR(in)->type == NUQ_T_ARRAY) {
            int64_t idx;
            if (NUQ_IS_FIX(k)) idx = NUQ_FIX_VAL(k);
            else if (NUQ_IS_PTR(k) && NUQ_PTR(k)->type == NUQ_T_DOUBLE) idx = (int64_t)NUQ_PTR(k)->dbl;
            else continue;
            nuq_pool_push(c, nuq_array_get(in, idx));
        }
    }
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_iter(CTX *c, NODE *n)
{
    size_t top0 = c->pool_top;
    VALUE in = c->input;
    if (LIKELY(NUQ_IS_PTR(in))) {
        struct nuq_obj *o = NUQ_PTR(in);
        if (LIKELY(o->type == NUQ_T_ARRAY)) {
            for (size_t i = 0; i < o->arr.len; i++) nuq_pool_push(c, o->arr.items[i]);
            return nuq_emit_slice(c, top0);
        }
        if (o->type == NUQ_T_OBJECT) {
            for (size_t i = 0; i < o->obj.len; i++) nuq_pool_push(c, o->obj.vals[i]);
            return nuq_emit_slice(c, top0);
        }
    }
    fprintf(stderr, "nuq error: Cannot iterate over %s\n", nuq_type_name(in));
    c->error = nuq_make_string("Cannot iterate", 14);
    return EMIT_EMPTY;
}

NODE_DEF
node_iter_opt(CTX *c, NODE *n)
{
    size_t top0 = c->pool_top;
    VALUE in = c->input;
    if (NUQ_IS_PTR(in)) {
        struct nuq_obj *o = NUQ_PTR(in);
        if (o->type == NUQ_T_ARRAY) {
            for (size_t i = 0; i < o->arr.len; i++) nuq_pool_push(c, o->arr.items[i]);
        } else if (o->type == NUQ_T_OBJECT) {
            for (size_t i = 0; i < o->obj.len; i++) nuq_pool_push(c, o->obj.vals[i]);
        }
    }
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_slice(CTX *c, NODE *n, NODE *startn, NODE *stopn, uint32_t flags)
{
    return nuq_slice_eval(c, startn, stopn, flags, false);
}

NODE_DEF
node_slice_opt(CTX *c, NODE *n, NODE *startn, NODE *stopn, uint32_t flags)
{
    return nuq_slice_eval(c, startn, stopn, flags, true);
}

/* ===== composition ===== */

/* pipe: lhs once, then rhs per emit.  After lhs eval, copy emits to a
 * local buffer (because pool will realloc as rhs pushes), reset
 * pool_top, then iterate. */
NODE_DEF
node_pipe(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    size_t top0 = c->pool_top;
    EMIT le = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL || c->break_label != 0)) return EMIT_EMPTY;
    uint32_t cnt = le.count;
    /* Copy out — alloca for small, GC heap for large. */
    VALUE local_small[16];
    VALUE *local = (cnt <= 16) ? local_small : (VALUE *)GC_malloc(cnt * sizeof(VALUE));
    memcpy(local, le.items, cnt * sizeof(VALUE));
    c->pool_top = top0;

    VALUE saved = c->input;
    for (uint32_t i = 0; i < cnt; i++) {
        c->input = local[i];
        (void)EVAL_ARG(c, rhs);   /* pushes rhs emits onto pool */
        if (UNLIKELY(c->error != NUQ_NULL || c->break_label != 0)) {
            c->input = saved;
            return EMIT_EMPTY;
        }
    }
    c->input = saved;
    return nuq_emit_slice(c, top0);
}

/* comma: both branches use SAME outer input; concat outputs.
 * Both sides push into pool sequentially → result is the union slice. */
NODE_DEF
node_comma(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    size_t top0 = c->pool_top;
    (void)EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL || c->break_label != 0))
        return nuq_emit_slice(c, top0);    /* keep partial lhs (jq's try-comma) */
    (void)EVAL_ARG(c, rhs);
    /* On rhs error too, we keep whatever was pushed so far. */
    return nuq_emit_slice(c, top0);
}

/* ===== arithmetic ===== */

NODE_DEF
node_add(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    size_t top0 = c->pool_top;
    EMIT l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    /* RHS may grow pool — snapshot l.items pointer. */
    uint32_t lc = l.count;
    VALUE local_small[16];
    VALUE *local = (lc <= 16) ? local_small : (VALUE *)GC_malloc(lc * sizeof(VALUE));
    memcpy(local, l.items, lc * sizeof(VALUE));
    c->pool_top = top0;
    EMIT rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    /* RHS slice is at pool[top0..top0+rv.count]; we need cartesian
     * (l × rv), then return slice [top0..pool_top]. */
    uint32_t rc = rv.count;
    VALUE rsmall[16];
    VALUE *rlocal = (rc <= 16) ? rsmall : (VALUE *)GC_malloc(rc * sizeof(VALUE));
    memcpy(rlocal, rv.items, rc * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t i = 0; i < lc; i++)
        for (uint32_t j = 0; j < rc; j++)
            nuq_pool_push(c, nuq_op_add(local[i], rlocal[j]));
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_sub(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    size_t top0 = c->pool_top;
    EMIT l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t lc = l.count;
    VALUE local_small[16];
    VALUE *local = (lc <= 16) ? local_small : (VALUE *)GC_malloc(lc * sizeof(VALUE));
    memcpy(local, l.items, lc * sizeof(VALUE));
    c->pool_top = top0;
    EMIT rv = EVAL_ARG(c, rhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t rc = rv.count;
    VALUE rsmall[16];
    VALUE *rlocal = (rc <= 16) ? rsmall : (VALUE *)GC_malloc(rc * sizeof(VALUE));
    memcpy(rlocal, rv.items, rc * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t i = 0; i < lc; i++)
        for (uint32_t j = 0; j < rc; j++)
            nuq_pool_push(c, nuq_op_sub(local[i], rlocal[j]));
    return nuq_emit_slice(c, top0);
}

