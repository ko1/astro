NODE_DEF
node_b_round(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_builtin_round(c->input));
}

NODE_DEF
node_b_fabs(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_builtin_fabs(c->input));
}

NODE_DEF
node_b_sqrt(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_builtin_sqrt(c->input));
}

NODE_DEF
node_b_first0(CTX *c, NODE *n)
{
    if (UNLIKELY(!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))) {
        c->error = nuq_make_string("first: not array", 17);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    return nuq_emit_one(c, o->arr.len > 0 ? o->arr.items[0] : NUQ_NULL);
}

NODE_DEF
node_b_last0(CTX *c, NODE *n)
{
    if (UNLIKELY(!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))) {
        c->error = nuq_make_string("last: not array", 16);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    return nuq_emit_one(c, o->arr.len > 0 ? o->arr.items[o->arr.len - 1] : NUQ_NULL);
}

NODE_DEF
node_b_any0(CTX *c, NODE *n)
{
    if (UNLIKELY(!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))) {
        c->error = nuq_make_string("any: not array", 15);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    bool any = false;
    for (size_t i = 0; i < o->arr.len && !any; i++)
        if (nuq_truthy(o->arr.items[i])) any = true;
    return nuq_emit_one(c, any ? NUQ_TRUE : NUQ_FALSE);
}

NODE_DEF
node_b_all0(CTX *c, NODE *n)
{
    if (UNLIKELY(!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))) {
        c->error = nuq_make_string("all: not array", 15);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    bool all = true;
    for (size_t i = 0; i < o->arr.len && all; i++)
        if (!nuq_truthy(o->arr.items[i])) all = false;
    return nuq_emit_one(c, all ? NUQ_TRUE : NUQ_FALSE);
}

/* `any(f)` / `all(f)` — like the 0-arg versions but applying `f` to
 * each element of the input array, then aggregating. */
NODE_DEF
node_b_any1(CTX *c, NODE *n, NODE *body)
{
    if (UNLIKELY(!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))) {
        c->error = nuq_make_string("any: not array", 14);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    VALUE saved = c->input;
    bool any = false;
    for (size_t i = 0; i < o->arr.len && !any; i++) {
        c->input = o->arr.items[i];
        size_t t0 = c->pool_top;
        EMIT bo = EVAL_ARG(c, body);
        if (UNLIKELY(c->error != NUQ_NULL)) { c->input = saved; return EMIT_EMPTY; }
        for (uint32_t j = 0; j < bo.count; j++)
            if (nuq_truthy(bo.items[j])) { any = true; break; }
        c->pool_top = t0;
    }
    c->input = saved;
    return nuq_emit_one(c, any ? NUQ_TRUE : NUQ_FALSE);
}

NODE_DEF
node_b_all1(CTX *c, NODE *n, NODE *body)
{
    if (UNLIKELY(!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))) {
        c->error = nuq_make_string("all: not array", 14);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    VALUE saved = c->input;
    bool all = true;
    for (size_t i = 0; i < o->arr.len && all; i++) {
        c->input = o->arr.items[i];
        size_t t0 = c->pool_top;
        EMIT bo = EVAL_ARG(c, body);
        if (UNLIKELY(c->error != NUQ_NULL)) { c->input = saved; return EMIT_EMPTY; }
        bool any_truthy = false;
        for (uint32_t j = 0; j < bo.count; j++)
            if (nuq_truthy(bo.items[j])) { any_truthy = true; break; }
        c->pool_top = t0;
        if (!any_truthy) all = false;
    }
    c->input = saved;
    return nuq_emit_one(c, all ? NUQ_TRUE : NUQ_FALSE);
}

/* `ascii(N)` — single-char string from codepoint (ASCII range only). */
NODE_DEF
node_b_ascii(CTX *c, NODE *n, NODE *codepoint)
{
    size_t t0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, codepoint);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    if (bo.count == 0) { c->pool_top = t0; return EMIT_EMPTY; }
    VALUE v = bo.items[0];
    c->pool_top = t0;
    if (!NUQ_IS_FIX(v)) {
        c->error = nuq_make_string("ascii: not int", 14);
        return EMIT_EMPTY;
    }
    int64_t cp = NUQ_FIX_VAL(v);
    if (cp < 0 || cp > 0x10FFFF) {
        c->error = nuq_make_string("ascii: codepoint out of range", 29);
        return EMIT_EMPTY;
    }
    /* Encode as UTF-8 (1-4 bytes). */
    char buf[5];
    int n_bytes;
    if (cp < 0x80)        { buf[0] = (char)cp; n_bytes = 1; }
    else if (cp < 0x800)  { buf[0] = 0xC0 | (cp >> 6); buf[1] = 0x80 | (cp & 0x3F); n_bytes = 2; }
    else if (cp < 0x10000){ buf[0] = 0xE0 | (cp >> 12); buf[1] = 0x80 | ((cp >> 6) & 0x3F); buf[2] = 0x80 | (cp & 0x3F); n_bytes = 3; }
    else                  { buf[0] = 0xF0 | (cp >> 18); buf[1] = 0x80 | ((cp >> 12) & 0x3F); buf[2] = 0x80 | ((cp >> 6) & 0x3F); buf[3] = 0x80 | (cp & 0x3F); n_bytes = 4; }
    return nuq_emit_one(c, nuq_make_string(buf, n_bytes));
}

NODE_DEF
node_b_isnull(CTX *c, NODE *n)
{
    bool b = NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_NULL;
    return nuq_emit_one(c, b ? NUQ_TRUE : NUQ_FALSE);
}

NODE_DEF
node_b_explode(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_builtin_explode(c->input));
}

NODE_DEF
node_b_implode(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_builtin_implode(c->input));
}

NODE_DEF
node_b_ascii_upcase(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_builtin_ascii_upcase(c->input));
}

NODE_DEF
node_b_ascii_downcase(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_builtin_ascii_downcase(c->input));
}

NODE_DEF
node_b_tojson(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_to_json_string(c->input));
}

NODE_DEF
node_b_fromjson(CTX *c, NODE *n)
{
    VALUE v;
    if (UNLIKELY(!nuq_builtin_fromjson(c->input, &v))) {
        c->error = nuq_make_string("fromjson failed", 16);
        return EMIT_EMPTY;
    }
    return nuq_emit_one(c, v);
}

NODE_DEF
node_b_recurse1(CTX *c, NODE *n, NODE *body)
{
    return nuq_recurse_eval(c, body, NULL);
}

NODE_DEF
node_b_recurse2(CTX *c, NODE *n, NODE *body, NODE *cond)
{
    return nuq_recurse_eval(c, body, cond);
}

NODE_DEF
node_b_skip(CTX *c, NODE *n, NODE *cnt, NODE *body)
{
    return nuq_skip_eval(c, cnt, body);
}

/* `input` — pull next pending JSON input from the queue.  Errors if
 * the queue is empty (jq raises "No more inputs"). */
NODE_DEF
node_b_input(CTX *c, NODE *n)
{
    VALUE v;
    if (!nuq_input_pull(&v)) {
        c->error = nuq_make_string("No more inputs", 14);
        return EMIT_EMPTY;
    }
    return nuq_emit_one(c, v);
}

/* `inputs` — emit all remaining pending inputs as a stream. */
NODE_DEF
node_b_inputs(CTX *c, NODE *n)
{
    size_t outer = c->pool_top;
    VALUE v;
    while (nuq_input_pull(&v)) nuq_pool_push(c, v);
    return nuq_emit_slice(c, outer);
}

/* `env` — environment variables as an object. */
NODE_DEF
node_b_env(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_env_object());
}

/* `isvalid(f)` — true if f doesn't error on input, false otherwise.
 * jq: `def isvalid(f): . as $i | try (f|true) catch false | . == true`. */
NODE_DEF
node_b_isvalid(CTX *c, NODE *n, NODE *body)
{
    VALUE saved_err = c->error;
    c->error = NUQ_NULL;
    size_t t0 = c->pool_top;
    nuq_suppress_error_print++;
    (void)EVAL_ARG(c, body);
    nuq_suppress_error_print--;
    bool ok = (c->error == NUQ_NULL);
    c->error = saved_err;
    c->pool_top = t0;
    return nuq_emit_one(c, ok ? NUQ_TRUE : NUQ_FALSE);
}

/* `IN(values…)` — emit true if input equals any value of the
 * comma-separated stream.  jq's `IN(s)` is `def IN(s): . as $x | first((s == $x) // false)`. */
NODE_DEF
node_b_IN1(CTX *c, NODE *n, NODE *body)
{
    VALUE saved = c->input;
    size_t t0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    bool found = false;
    for (uint32_t i = 0; i < bo.count; i++) {
        if (nuq_eq(saved, bo.items[i])) { found = true; break; }
    }
    c->pool_top = t0;
    return nuq_emit_one(c, found ? NUQ_TRUE : NUQ_FALSE);
}

/* `gsub(s; r)` — replace all non-overlapping occurrences of substring
 * `s` with `r`.  Without regex this is plain substring replace
 * (jq's `gsub` is regex-based but our subset stays substring-only;
 * documented in todo). */
NODE_DEF
node_b_gsub(CTX *c, NODE *n, NODE *pat, NODE *repl)
{
    return nuq_gsub_eval(c, pat, repl);
}

NODE_DEF
node_b_sub(CTX *c, NODE *n, NODE *pat, NODE *repl)
{
    return nuq_sub_eval(c, pat, repl);
}

/* Type-predicate filters: `nulls`, `booleans`, `numbers`, `strings`,
 * `arrays`, `objects`, `iterables`, `scalars`.
 * Each emits `.` iff its type matches, else empty.  Mirrors jq's
 * `def nulls: select(type=="null")`-style sugar. */
NODE_DEF
node_b_nulls(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_NULL)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_booleans(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_BOOL)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_numbers(CTX *c, NODE *n)
{
    if (NUQ_IS_FIX(c->input)) return nuq_emit_one(c, c->input);
    if (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_DOUBLE)
        return nuq_emit_one(c, c->input);
    return EMIT_EMPTY;
}

NODE_DEF
node_b_strings(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_arrays(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_objects(CTX *c, NODE *n)
{
    return (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_OBJECT)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_iterables(CTX *c, NODE *n)
{
    if (!NUQ_IS_PTR(c->input)) return EMIT_EMPTY;
    enum nuq_type t = NUQ_PTR(c->input)->type;
    return (t == NUQ_T_ARRAY || t == NUQ_T_OBJECT)
        ? nuq_emit_one(c, c->input) : EMIT_EMPTY;
}

NODE_DEF
node_b_scalars(CTX *c, NODE *n)
{
    if (NUQ_IS_FIX(c->input)) return nuq_emit_one(c, c->input);
    enum nuq_type t = NUQ_PTR(c->input)->type;
    return (t == NUQ_T_ARRAY || t == NUQ_T_OBJECT)
        ? EMIT_EMPTY : nuq_emit_one(c, c->input);
}

/* `utf8bytelength` — same as length on strings since nuq stores raw bytes.
 * jq distinguishes char-length (length) from byte-length here, but our
 * length is already byte-counting. */
NODE_DEF
node_b_utf8bytelength(CTX *c, NODE *n)
{
    if (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_STRING)
        return nuq_emit_one(c, nuq_make_int((int64_t)NUQ_PTR(c->input)->str.len));
    c->error = nuq_make_string("utf8bytelength: not string", 26);
    return EMIT_EMPTY;
}

/* `flatten` — full recursive array flatten (matches jq 1.7's `flatten`).
 * Use `flatten(1)` for single-level. */
NODE_DEF
node_b_flatten(CTX *c, NODE *n)
{
    if (!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY)) {
        c->error = nuq_make_string("flatten: not array", 18);
        return EMIT_EMPTY;
    }
    /* INT_MAX-ish depth = full flatten. */
    return nuq_emit_one(c, nuq_flatten_eval(c->input, 1<<30));
}

/* `flatten(N)` — flatten N levels deep (N must be a non-negative int). */
NODE_DEF
node_b_flatten_n(CTX *c, NODE *n, NODE *depth)
{
    return nuq_flatten1_eval(c, depth);
}

/* `while(cond; update)` — emit . while cond(.) is truthy, then iterate. */
NODE_DEF
node_b_while(CTX *c, NODE *n, NODE *cond, NODE *update)
{
    return nuq_while_eval(c, cond, update);
}

/* `until(cond; update)` — apply update until cond(.) is truthy, emit final. */
NODE_DEF
node_b_until(CTX *c, NODE *n, NODE *cond, NODE *update)
{
    return nuq_until_eval(c, cond, update);
}

NODE_DEF
node_b_recurse0(CTX *c, NODE *n)
{
    size_t top0 = c->pool_top;
    nuq_recurse_collect_pool(c, c->input);
    return nuq_emit_slice(c, top0);
}

/* --- 1-arg built-ins (with sub-expression body) --- */

NODE_DEF
node_b_select(CTX *c, NODE *n, NODE *body)
{
    size_t top0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    bool any = false;
    for (uint32_t i = 0; i < bo.count; i++)
        if (nuq_truthy(bo.items[i])) { any = true; break; }
    c->pool_top = top0;       /* release body's emits */
    if (any) return nuq_emit_one(c, c->input);
    return EMIT_EMPTY;
}

NODE_DEF
node_b_map(CTX *c, NODE *n, NODE *body)
{
    if (UNLIKELY(!(NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_ARRAY))) {
        c->error = nuq_make_string("map: not array", 15);
        return EMIT_EMPTY;
    }
    struct nuq_obj *o = NUQ_PTR(c->input);
    VALUE result = nuq_make_array(o->arr.len);
    VALUE saved = c->input;
    for (size_t i = 0; i < o->arr.len; i++) {
        c->input = o->arr.items[i];
        size_t top0 = c->pool_top;
        EMIT bo = EVAL_ARG(c, body);
        if (UNLIKELY(c->error != NUQ_NULL)) { c->input = saved; return EMIT_EMPTY; }
        for (uint32_t j = 0; j < bo.count; j++) nuq_array_push(result, bo.items[j]);
        c->pool_top = top0;
    }
    c->input = saved;
    return nuq_emit_one(c, result);
}

NODE_DEF
node_b_map_values(CTX *c, NODE *n, NODE *body)
{
    return nuq_map_values_eval(c, body);
}

NODE_DEF
node_b_with_entries(CTX *c, NODE *n, NODE *body)
{
    return nuq_with_entries_eval(c, body);
}

/* walk(f) — bottom-up transform.  jq defines it as:
 *   def walk(f):
 *     . as $in |
 *     if type == "object" then
 *       reduce keys[] as $key ({}; . + { ($key): ($in[$key] | walk(f)) }) | f
 *     elif type == "array" then map(walk(f)) | f
 *     else f end;
 * We hand-roll the recursion in C so we don't need to translate
 * complex jq defs at parse time.  body is invoked once per node. */
NODE_DEF
node_b_walk(CTX *c, NODE *n, NODE *body)
{
    return nuq_walk_eval(c, body);
}

NODE_DEF
node_b_range1(CTX *c, NODE *n, NODE *to)
{
    size_t top0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, to);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    /* Snapshot bo because we'll grow pool below. */
    uint32_t cnt = bo.count;
    VALUE small[16];
    VALUE *local = (cnt <= 16) ? small : (VALUE *)GC_malloc(cnt * sizeof(VALUE));
    memcpy(local, bo.items, cnt * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t k = 0; k < cnt; k++) {
        VALUE v = local[k];
        int64_t n_val;
        if (NUQ_IS_FIX(v)) n_val = NUQ_FIX_VAL(v);
        else if (NUQ_IS_PTR(v) && NUQ_PTR(v)->type == NUQ_T_DOUBLE) n_val = (int64_t)NUQ_PTR(v)->dbl;
        else continue;
        for (int64_t i = 0; i < n_val; i++) nuq_pool_push(c, nuq_make_int(i));
    }
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_b_range2(CTX *c, NODE *n, NODE *from, NODE *to)
{
    return nuq_range2_eval(c, from, to);
}

NODE_DEF
node_b_range3(CTX *c, NODE *n, NODE *from, NODE *to, NODE *step)
{
    return nuq_range3_eval(c, from, to, step);
}

