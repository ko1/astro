NODE_DEF
node_b_first1(CTX *c, NODE *n, NODE *body)
{
    VALUE bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return bo;
    struct nuq_obj *boo = NUQ_PTR(bo);
    if (boo->arr.len == 0) return nuq_make_array(0);
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, boo->arr.items[0]);
    return r;
}

NODE_DEF
node_b_last1(CTX *c, NODE *n, NODE *body)
{
    VALUE bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return bo;
    struct nuq_obj *boo = NUQ_PTR(bo);
    if (boo->arr.len == 0) return nuq_make_array(0);
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, boo->arr.items[boo->arr.len - 1]);
    return r;
}

