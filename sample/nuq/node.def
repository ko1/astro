NODE_DEF
node_and(CTX *c, NODE *n, NODE *lhs, NODE *rhs) { return nuq_andor_eval(c, lhs, rhs, true); }
NODE_DEF
node_or(CTX *c, NODE *n, NODE *lhs, NODE *rhs)  { return nuq_andor_eval(c, lhs, rhs, false); }

NODE_DEF
node_not(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_truthy(c->input) ? NUQ_FALSE : NUQ_TRUE);
    return r;
}

NODE_DEF
node_alt(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    return nuq_alt_eval(c, lhs, rhs);
}

/* ===== array / object construction ===== */

/* `[body]` — body runs with current c->input; its emits become elements
 * of the resulting array.  Emits 1 array. */
NODE_DEF
node_array(CTX *c, NODE *n, NODE *body)
{
    VALUE inner = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return inner;
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, inner);
    return r;
}

NODE_DEF
node_array_empty(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_make_array(0));
    return r;
}

NODE_DEF
node_object(CTX *c, NODE *n, uint32_t entries_id)
{
    return nuq_object_eval(c, entries_id);
}

/* ===== control ===== */

NODE_DEF
node_if(CTX *c, NODE *n, NODE *cond, NODE *thn, NODE *els)
{
    return nuq_if_eval(c, cond, thn, els);
}

NODE_DEF
node_try(CTX *c, NODE *n, NODE *body, NODE *handler)
{
    return nuq_try_eval(c, body, handler);
}

NODE_DEF
node_as(CTX *c, NODE *n, NODE *src, uint32_t var_id, NODE *body)
{
    return nuq_as_eval(c, src, var_id, body);
}

NODE_DEF
node_var(CTX *c, NODE *n, uint32_t var_id)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_var_get(c, var_id));
    return r;
}

NODE_DEF
node_label(CTX *c, NODE *n, uint32_t var_id, NODE *body)
{
    VALUE r = EVAL_ARG(c, body);
    if (c->break_label == var_id) c->break_label = 0;
    return r;
}

NODE_DEF
node_break(CTX *c, NODE *n, uint32_t var_id)
{
    c->break_label = var_id;
    return nuq_make_array(0);
}

NODE_DEF
node_empty(CTX *c, NODE *n)
{
    return nuq_make_array(0);
}

NODE_DEF
node_error0(CTX *c, NODE *n)
{
    c->error = c->input;
    return nuq_make_array(0);
}

NODE_DEF
node_error1(CTX *c, NODE *n, NODE *expr)
{
    return nuq_error_eval(c, expr);
}

/* ===== user-def calls ===== */

NODE_DEF
node_call(CTX *c, NODE *n, uint32_t name_id, uint32_t arity, uint32_t args_id)
{
    return nuq_user_call(c, name_id, arity, args_id);
}

NODE_DEF
node_defs(CTX *c, NODE *n, uint32_t defs_id, NODE *body)
{
    return nuq_defs_eval(c, defs_id, body);
}

NODE_DEF
node_reduce(CTX *c, NODE *n, NODE *src, uint32_t var_id, NODE *init, NODE *update)
{
    return nuq_reduce_eval(c, src, var_id, init, update);
}

NODE_DEF
node_foreach(CTX *c, NODE *n, NODE *src, uint32_t var_id, NODE *init, NODE *update, NODE *extract)
{
    return nuq_foreach_eval(c, src, var_id, init, update, extract);
}

/* ============= built-ins as dedicated nodes ====================== */

NODE_DEF
node_b_length(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_length(c->input));
    return r;
}

NODE_DEF
node_b_type(CTX *c, NODE *n)
{
    const char *t = nuq_type_name(c->input);
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_make_string(t, strlen(t)));
    return r;
}

NODE_DEF
node_b_keys(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_keys(c->input, true));
    return r;
}

NODE_DEF
node_b_keys_unsorted(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_keys(c->input, false));
    return r;
}

/* `values` in jq = `select(. != null)`. */
NODE_DEF
node_b_values(CTX *c, NODE *n)
{
    if (NUQ_IS_PTR(c->input) && NUQ_PTR(c->input)->type == NUQ_T_NULL)
        return nuq_make_array(0);
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, c->input);
    return r;
}

NODE_DEF
node_b_to_string(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_to_json_string(c->input));
    return r;
}

NODE_DEF
node_b_tonumber(CTX *c, NODE *n)
{
    VALUE v;
    if (UNLIKELY(!nuq_to_number(c->input, &v))) {
        c->error = nuq_make_string("tonumber failed", 16);
        return nuq_make_array(0);
    }
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, v);
    return r;
}

NODE_DEF
node_b_add(CTX *c, NODE *n)
{
    VALUE r = nuq_make_array(1);
    nuq_array_push(r, nuq_builtin_add(c->input));
    return r;
}

