}

NODE_DEF
node_neg(CTX *c, NODE *n, NODE *expr)
{
    size_t top0 = c->pool_top;
    EMIT v = EVAL_ARG(c, expr);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    /* In-place transform: read pool[top0..top0+v.count], negate, write
     * back (read-then-write same pool location is fine since count
     * doesn't change). */
    uint32_t cnt = v.count;
    for (uint32_t i = 0; i < cnt; i++)
        c->pool[top0 + i] = nuq_op_neg(c->pool[top0 + i]);
    if (UNLIKELY(c->error != NUQ_NULL)) { c->pool_top = top0; return EMIT_EMPTY; }
    return nuq_emit_slice(c, top0);
}

/* ===== comparisons / logic ===== */

#define CMP_BODY(OP_K)                                                    \
    size_t top0 = c->pool_top;                                            \
    EMIT l = EVAL_ARG(c, lhs);                                            \
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;                \
    uint32_t lc = l.count;                                                \
    VALUE lsmall[16];                                                     \
    VALUE *llocal = (lc <= 16) ? lsmall : (VALUE *)GC_malloc(lc * sizeof(VALUE)); \
    memcpy(llocal, l.items, lc * sizeof(VALUE));                          \
    c->pool_top = top0;                                                   \
    EMIT rv = EVAL_ARG(c, rhs);                                           \
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;                \
    uint32_t rc = rv.count;                                               \
    VALUE rsmall[16];                                                     \
    VALUE *rlocal = (rc <= 16) ? rsmall : (VALUE *)GC_malloc(rc * sizeof(VALUE)); \
    memcpy(rlocal, rv.items, rc * sizeof(VALUE));                         \
    c->pool_top = top0;                                                   \
    for (uint32_t i = 0; i < lc; i++)                                     \
        for (uint32_t j = 0; j < rc; j++) {                               \
            VALUE a = llocal[i], b = rlocal[j];                           \
            bool t;                                                       \
            switch (OP_K) {                                               \
              case NUQ_CMP_EQ_K: t = nuq_eq(a, b); break;                 \
              case NUQ_CMP_NE_K: t = !nuq_eq(a, b); break;                \
              case NUQ_CMP_LT_K: t = nuq_cmp(a, b) <  0; break;           \
              case NUQ_CMP_LE_K: t = nuq_cmp(a, b) <= 0; break;           \
              case NUQ_CMP_GT_K: t = nuq_cmp(a, b) >  0; break;           \
              case NUQ_CMP_GE_K: t = nuq_cmp(a, b) >= 0; break;           \
              default:           t = false; break;                        \
            }                                                             \
            nuq_pool_push(c, t ? NUQ_TRUE : NUQ_FALSE);                   \
        }                                                                 \
    return nuq_emit_slice(c, top0)

NODE_DEF
node_eq(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    CMP_BODY(NUQ_CMP_EQ_K);
}

NODE_DEF
node_ne(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    CMP_BODY(NUQ_CMP_NE_K);
}

NODE_DEF
node_lt(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    CMP_BODY(NUQ_CMP_LT_K);
}

NODE_DEF
node_le(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    CMP_BODY(NUQ_CMP_LE_K);
}

NODE_DEF
node_gt(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    CMP_BODY(NUQ_CMP_GT_K);
}

NODE_DEF
node_ge(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    CMP_BODY(NUQ_CMP_GE_K);
}

NODE_DEF
node_and(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    size_t top0 = c->pool_top;
    EMIT l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t lc = l.count;
    VALUE lsmall[16];
    VALUE *llocal = (lc <= 16) ? lsmall : (VALUE *)GC_malloc(lc * sizeof(VALUE));
    memcpy(llocal, l.items, lc * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t i = 0; i < lc; i++) {
        if (!nuq_truthy(llocal[i])) {
            nuq_pool_push(c, NUQ_FALSE);
            continue;
        }
        size_t mid = c->pool_top;
        EMIT rv = EVAL_ARG(c, rhs);
        if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
        uint32_t rc = rv.count;
        VALUE rsmall[16];
        VALUE *rlocal = (rc <= 16) ? rsmall : (VALUE *)GC_malloc(rc * sizeof(VALUE));
        memcpy(rlocal, rv.items, rc * sizeof(VALUE));
        c->pool_top = mid;
        for (uint32_t j = 0; j < rc; j++)
            nuq_pool_push(c, nuq_truthy(rlocal[j]) ? NUQ_TRUE : NUQ_FALSE);
    }
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_or(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    size_t top0 = c->pool_top;
    EMIT l = EVAL_ARG(c, lhs);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t lc = l.count;
    VALUE lsmall[16];
    VALUE *llocal = (lc <= 16) ? lsmall : (VALUE *)GC_malloc(lc * sizeof(VALUE));
    memcpy(llocal, l.items, lc * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t i = 0; i < lc; i++) {
        if (nuq_truthy(llocal[i])) {
            nuq_pool_push(c, NUQ_TRUE);
            continue;
        }
        size_t mid = c->pool_top;
        EMIT rv = EVAL_ARG(c, rhs);
        if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
        uint32_t rc = rv.count;
        VALUE rsmall[16];
        VALUE *rlocal = (rc <= 16) ? rsmall : (VALUE *)GC_malloc(rc * sizeof(VALUE));
        memcpy(rlocal, rv.items, rc * sizeof(VALUE));
        c->pool_top = mid;
        for (uint32_t j = 0; j < rc; j++)
            nuq_pool_push(c, nuq_truthy(rlocal[j]) ? NUQ_TRUE : NUQ_FALSE);
    }
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_not(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_truthy(c->input) ? NUQ_FALSE : NUQ_TRUE);
}

NODE_DEF
node_alt(CTX *c, NODE *n, NODE *lhs, NODE *rhs)
{
    size_t top0 = c->pool_top;
    VALUE saved_err = c->error;
    EMIT l = EVAL_ARG(c, lhs);
    if (c->error != NUQ_NULL) {
        c->error = saved_err;
        c->pool_top = top0;
        return EVAL_ARG(c, rhs);
    }
    /* Keep only truthy emits.  We need to compact in-place: scan
     * pool[top0..top0+l.count], move truthy values to the front. */
    uint32_t lc = l.count;
    bool any_truthy = false;
    size_t write = top0;
    for (uint32_t i = 0; i < lc; i++) {
        VALUE v = c->pool[top0 + i];
        if (nuq_truthy(v)) {
            c->pool[write++] = v;
            any_truthy = true;
        }
    }
    c->pool_top = write;
    if (!any_truthy) {
        c->pool_top = top0;
        return EVAL_ARG(c, rhs);
    }
    return nuq_emit_slice(c, top0);
}

/* ===== array / object construction ===== */

NODE_DEF
node_array(CTX *c, NODE *n, NODE *body)
{
    size_t top0 = c->pool_top;
    EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) {
        /* Array construction is atomic: any partial emits in the pool
         * should be discarded so the surrounding `try` doesn't leak
         * them.  jq has the same behavior — `try [..., error(..)]`
         * discards the partial array. */
        c->pool_top = top0;
        return EMIT_EMPTY;
    }
    /* Build a real heap array from the pool slice, release pool, emit. */
    VALUE arr = nuq_make_array(bo.count);
    for (uint32_t i = 0; i < bo.count; i++) nuq_array_push(arr, bo.items[i]);
    c->pool_top = top0;
    return nuq_emit_one(c, arr);
}

NODE_DEF
node_array_empty(CTX *c, NODE *n)
{
    return nuq_emit_one(c, nuq_make_array(0));
}

/* Fusion of `[body] | length` — counts body's emits without
 * materializing the intermediate array.  Semantically equal because
 * `[E] | length` only inspects |E.emits|; the array is an artifact.
 * (Errors during body propagate the same way as non-fused: c->error
 * is set, we abort and emit nothing.) */
NODE_DEF
node_emit_count(CTX *c, NODE *n, NODE *body)
{
    const size_t top0 = c->pool_top;
    const EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    const uint32_t cnt = bo.count;
    c->pool_top = top0;
    return nuq_emit_one(c, nuq_make_int((int64_t)cnt));
}

/* Fusion of `[body] | add` — runs body's emits straight into the
 * type-dispatch kernel of `add` (`nuq_add_fold_items`), skipping the
 * outer array build.  Result identical to `[body] | add`:
 *   - empty emits → null   (matches `add` of [])
 *   - all arrays  → flatten concat
 *   - all strings → byte concat
 *   - all objects → key-merge (later keys win, matching jq)
 *   - mixed       → pairwise nuq_op_add fold */
NODE_DEF
node_emit_fold_add(CTX *c, NODE *n, NODE *body)
{
    const size_t top0 = c->pool_top;
    const EMIT bo = EVAL_ARG(c, body);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    const VALUE r = nuq_add_fold_items(bo.items, bo.count);
    c->pool_top = top0;
    return nuq_emit_one(c, r);
}

NODE_DEF
node_object(CTX *c, NODE *n, uint32_t entries_id)
{
    return nuq_object_eval(c, entries_id);
}

/* ===== control ===== */

NODE_DEF
node_if(CTX *c, NODE *n, NODE *cond, NODE *thn, NODE *els)
{
    size_t top0 = c->pool_top;
    EMIT cs = EVAL_ARG(c, cond);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t cc = cs.count;
    VALUE csmall[16];
    VALUE *clocal = (cc <= 16) ? csmall : (VALUE *)GC_malloc(cc * sizeof(VALUE));
    memcpy(clocal, cs.items, cc * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t i = 0; i < cc; i++) {
        if (nuq_truthy(clocal[i])) {
            (void)EVAL_ARG(c, thn);
        } else {
            (void)EVAL_ARG(c, els);
        }
        if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    }
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_try(CTX *c, NODE *n, NODE *body, NODE *handler)
{
    size_t top0 = c->pool_top;
    VALUE saved_err = c->error;
    nuq_suppress_error_print++;
    (void)EVAL_ARG(c, body);
    nuq_suppress_error_print--;
    if (c->error != NUQ_NULL) {
        VALUE err = c->error;
        c->error = saved_err;
        VALUE saved = c->input;
        c->input = err;
        (void)EVAL_ARG(c, handler);
        c->input = saved;
    }
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_as(CTX *c, NODE *n, NODE *src, uint32_t var_id, NODE *body)
{
    size_t top0 = c->pool_top;
    EMIT bs = EVAL_ARG(c, src);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t sc = bs.count;
    VALUE ssmall[16];
    VALUE *slocal = (sc <= 16) ? ssmall : (VALUE *)GC_malloc(sc * sizeof(VALUE));
    memcpy(slocal, bs.items, sc * sizeof(VALUE));
    c->pool_top = top0;
    for (uint32_t i = 0; i < sc; i++) {
        size_t var_top = c->var_top;
        nuq_var_push(c, var_id, slocal[i]);
        (void)EVAL_ARG(c, body);
        nuq_var_pop(c, var_top);
        if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    }
    return nuq_emit_slice(c, top0);
}

/* Destructuring `as` — `EXPR as PAT | BODY`.  PAT is one of:
 *   $name                    (simple var)
 *   [PAT, PAT, ...]          (array — index-by-index, missing → null)
 *   {key: PAT, key2: PAT2}   (object — project field-by-field)
 *   {$a, $b}                 (shorthand for {a: $a, b: $b})
 * Pattern is interned at parse time as `pat_id`.  At eval, walk
 * pattern + value pairwise pushing each $var on var_stack. */
NODE_DEF
node_as_pattern(CTX *c, NODE *n, NODE *src, uint32_t pat_id, NODE *body)
{
    size_t top0 = c->pool_top;
    EMIT bs = EVAL_ARG(c, src);
    if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    uint32_t sc = bs.count;
    VALUE ssmall[16];
    VALUE *slocal = (sc <= 16) ? ssmall : (VALUE *)GC_malloc(sc * sizeof(VALUE));
    memcpy(slocal, bs.items, sc * sizeof(VALUE));
    c->pool_top = top0;
    struct nuq_pat *pat = nuq_pat_get(pat_id);
    for (uint32_t i = 0; i < sc; i++) {
        size_t var_top = nuq_pat_bind(c, pat, slocal[i]);
        (void)EVAL_ARG(c, body);
        nuq_var_pop(c, var_top);
        if (UNLIKELY(c->error != NUQ_NULL)) return EMIT_EMPTY;
    }
    return nuq_emit_slice(c, top0);
}

/* `lhs as PAT1 ?// PAT2 ?// ... | body` — try alternatives in order. */
NODE_DEF
node_as_alt_pattern(CTX *c, NODE *n, NODE *lhs, uint32_t alt_id, NODE *body)
{
    return nuq_as_alt_eval(c, lhs, alt_id, body);
}

NODE_DEF
node_var(CTX *c, NODE *n, uint32_t var_id)
{
    return nuq_emit_one(c, nuq_var_get(c, var_id));
}

NODE_DEF
node_label(CTX *c, NODE *n, uint32_t var_id, NODE *body)
{
    size_t top0 = c->pool_top;
    (void)EVAL_ARG(c, body);
    if (c->break_label == var_id) c->break_label = 0;
    return nuq_emit_slice(c, top0);
}

NODE_DEF
node_break(CTX *c, NODE *n, uint32_t var_id)
{
    c->break_label = var_id;
    return EMIT_EMPTY;
}

NODE_DEF
node_empty(CTX *c, NODE *n)
{
    return EMIT_EMPTY;
}

NODE_DEF
node_error0(CTX *c, NODE *n)
{
    /* `null` raised as error must still trip the c->error gate, so we
     * use a distinct null-typed sentinel.  catch handlers see a value
     * that compares/serialises identically to null. */
    c->error = (c->input == NUQ_NULL) ? NUQ_NULL_ERR : c->input;
    return EMIT_EMPTY;
}

NODE_DEF
node_error1(CTX *c, NODE *n, NODE *expr)
{
    return nuq_error_eval(c, expr);
}

