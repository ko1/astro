// -*- mode: c -*-
// ascheme — R5RS Scheme on ASTro.
//
// Tree-walking interpreter; lexical envs are heap-allocated `sframe`
// chains, closures hold (body, env), tail calls re-enter via the CTX
// trampoline (`tail_call_pending` + `next_body` + `next_env`).  Most
// helpers live in main.c so the EVAL bodies stay short.

// ---------------------------------------------------------------------------
// Constants.
// ---------------------------------------------------------------------------

NODE_DEF
node_const_int(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, int32_t v)
{
    (void)c; (void)n;
    return SCM_FIX(v);
}

NODE_DEF
node_const_int64(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint64_t v)
{
    (void)c; (void)n;
    return (VALUE)v;
}

NODE_DEF
node_const_double(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, double v)
{
    (void)n;
    return scm_make_double(c, v);
}

NODE_DEF
node_const_str(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *s)
{
    (void)n;
    return scm_make_string(c, s, strlen(s));
}

NODE_DEF
node_const_sym(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *s)
{
    (void)c; (void)n;
    return scm_intern(c, s);
}

NODE_DEF
node_const_char(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t cp)
{
    (void)c; (void)n;
    return scm_make_char(c, cp);
}

NODE_DEF
node_const_bool(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t v)
{
    (void)c; (void)n;
    return v ? SCM_TRUE : SCM_FALSE;
}

NODE_DEF
node_const_nil(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    (void)c; (void)n;
    return SCM_NIL;
}

NODE_DEF
node_const_unspec(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    (void)c; (void)n;
    return SCM_UNSPEC;
}

// Pre-built data structure (list/vector/string built at parse time).
// Stored inline as the bit-pattern of a heap pointer (uint64_t).  The
// hash factors in the address bits, so cross-run hashing isn't stable —
// fine for the plain interpreter.
NODE_DEF
node_quote(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint64_t v)
{
    (void)c; (void)n;
    return (VALUE)v;
}

// ---------------------------------------------------------------------------
// Lexical / global variable access.
// ---------------------------------------------------------------------------

// Resolve the frame at `depth` levels up the parent chain.  Inlined helper
// shared by node_lref and node_lset.  ASTroGen specializes `depth` as a
// literal, so gcc selects a single branch per call site:
//   depth=0   → c->env                     (1 reg load)
//   depth=1   → c->env->parent             (2 chained loads)
//   2..LREF_CACHE_SIZE-1 → lazy cache keyed on env_serial (~5 loads warm,
//             vs `depth+1` chained loads with a plain walk — cache wins
//             starting at depth 2)
//   depth>=LREF_CACHE_SIZE → plain walk (out of cache range; rare)
static inline struct sframe *
ascheme_env_at(CTX *c, uint32_t depth)
{
    if (depth == 0) return c->env;
    if (depth == 1) return c->env->parent;
    if (depth < ASCHEME_LREF_CACHE_SIZE) {
        if (UNLIKELY(c->env_cache_serial != c->env_serial)) {
            c->env_cache_serial = c->env_serial;
            c->env_chain[0] = c->env;
            c->env_chain_filled = 0;
        }
        while (c->env_chain_filled < depth) {
            c->env_chain[c->env_chain_filled + 1] =
                c->env_chain[c->env_chain_filled]->parent;
            c->env_chain_filled++;
        }
        return c->env_chain[depth];
    }
    struct sframe *e = c->env;
    for (uint32_t i = 0; i < depth; i++) e = e->parent;
    return e;
}

// `sp_offset` is parse-time baked: for depth=0, sp_offset = idx - locals_cnt
// (= access via sp[sp_offset]).  For depth>=1, sp_offset is unused (= 0)
// and the env-chain walk is used.
NODE_DEF
node_lref(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t depth, uint32_t idx, int32_t sp_offset)
{
    (void)n; (void)sp_offset;
    return ascheme_env_at(c, depth)->slots[idx];
}

NODE_DEF
node_lset(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t depth, uint32_t idx, int32_t sp_offset, NODE *val)
{
    (void)n; (void)sp_offset;
    VALUE v = EVAL_ARG(c, val);
    /* The resolved frame is an OBJ_FRAME heap object — could be OLD (=
     * a captured closure env) while v is freshly young.  WB is required
     * so the next minor scans this frame's slots[]. */
    struct sframe *f = ascheme_env_at(c, depth);
    ARO_STORE(c, f, &f->slots[idx], v);
    return SCM_UNSPEC;
}

// node_lref_sp / node_lset_sp: sp[] frame variants.  Emitted by compile_lambda
// (= via dispatcher patching) when body is no_capture.  Body's lref reads
// **c->frame_sp[sp_offset]** — NOT the dispatcher's `sp` param, because
// nested SP_PUSH within the body advances `sp` past the body's own slots.
// c->frame_sp is pinned at body entry by node_call_K's fast path.
// Operand layout matches node_lref / node_lset so the parser can swap by
// patching head.dispatcher / head.kind only.
NODE_DEF
node_lref_sp(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t depth, uint32_t idx, int32_t sp_offset)
{
    (void)n; (void)sp; (void)depth; (void)idx;
    return c->frame_sp[sp_offset];
}

NODE_DEF
node_lset_sp(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t depth, uint32_t idx, int32_t sp_offset, NODE *val)
{
    (void)n; (void)depth; (void)idx;
    VALUE v = EVAL_ARG(c, val);
    c->frame_sp[sp_offset] = v;
    return SCM_UNSPEC;
}

NODE_DEF
node_gref(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *name, struct gref_cache *cache@ref)
{
    (void)n;
    // Hot path: serial matches → cached value is still current.  Two
    // 8-byte loads + a compare; no array-indirection through globals.
    if (LIKELY(cache->serial == c->globals_serial)) return cache->value;
    // Cold path: refresh.  scm_global_ref does the linear scan and
    // raises on undefined; we just snapshot the result.
    cache->value = scm_global_ref(c, name);
    cache->serial = c->globals_serial;
    return cache->value;
}

NODE_DEF
node_gset(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *name, NODE *val)
{
    (void)n;
    VALUE v = EVAL_ARG(c, val);
    scm_global_set(c, name, v);
    return SCM_UNSPEC;
}

NODE_DEF
node_gdef(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *name, NODE *val)
{
    (void)n;
    VALUE v = EVAL_ARG(c, val);
    scm_global_define(c, name, v);
    return SCM_UNSPEC;
}

// ---------------------------------------------------------------------------
// Control flow.
// ---------------------------------------------------------------------------

NODE_DEF
node_if(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *cond, NODE *thn, NODE *els)
{
    (void)n;
    VALUE cv = EVAL_ARG(c, cond);
    if (scm_is_true(cv)) {
        return EVAL_ARG(c, thn);
    } else {
        return EVAL_ARG(c, els);
    }
}

NODE_DEF
node_seq(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *first, NODE *rest)
{
    (void)n;
    EVAL_ARG(c, first);
    return EVAL_ARG(c, rest);
}

NODE_DEF @noinline
node_lambda(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t nparams, uint32_t has_rest, uint32_t nlocals, uint32_t leaf, uint32_t no_capture, NODE *body)
{
    (void)n; (void)nlocals;
    // `leaf` is set by the compiler iff the body contains no inner
    // `lambda` form.  scm_apply_tail uses it to enable frame reuse on
    // self-tail-calls without risking a captured-frame corruption.
    //
    // `no_capture` is set iff the body has no lref/lset crossing this
    // lambda's boundary (= self-contained body, locals can live on sp[]
    // without a heap sframe).  Used by the sp[] fast path to skip sframe
    // alloc on closure call.
    VALUE cl = scm_make_closure(c, body, c->env, (int)nparams, (int)has_rest);
    SCM_PTR(cl)->closure.leaf = leaf ? true : false;
    SCM_PTR(cl)->closure.no_capture = no_capture ? true : false;
    return cl;
}

// ---------------------------------------------------------------------------
// Calls.  Each fixed-arity kind has tail / non-tail behaviour selected by
// the `is_tail` field stamped at parse time.  `call_lambda_body` is the
// trampoline for non-tail invocations.
// ---------------------------------------------------------------------------

// Inlinable: SPECIALIZE bakes the children's dispatchers into direct calls,
// so the C compiler can fold every EVAL_ARG into the SD body.
NODE_DEF
node_call_0(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t is_tail, NODE *fn)
{
    (void)n;
    SP_PUSH(c, sp, 1);
    sp[0] = (*fn_dispatcher)(c, fn, sp + (1));
    if (!is_tail && LIKELY(scm_is_closure(sp[0]))) {
        struct sobj *cl = SCM_PTR(sp[0]);
        if (LIKELY(cl->closure.no_capture && cl->closure.nparams == 0 && !cl->closure.has_rest)) {
            NODE *body = cl->closure.body;
            VALUE *saved_frame_sp = c->frame_sp;
            sp[0] = (VALUE)c->env;
            c->frame_sp = c->sp;
            VALUE v;
            for (;;) {
                if (UNLIKELY(ASCHEME_PROFILING)) body->head.dispatch_cnt++;
                v = EVAL(c, body, c->sp);
                if (!c->tail_call_pending) break;
                c->tail_call_pending = 0;
                body = c->next_body;
                if (c->next_no_capture) {
                    uint16_t np = c->next_nparams;
                    VALUE *args_base = sp + 1;
                    ASTRO_ASSERT(args_base + np <= g_sp_scratch + ASCHEME_SP_SCRATCH_SIZE);
                    for (uint16_t i = 0; i < np; i++) args_base[i] = c->next_env->slots[i];
                    c->sp = args_base + np;
                    c->frame_sp = c->sp;
                } else {
                    if (c->next_env != c->env) CTX_SET_ENV(c, c->next_env);
                    c->frame_sp = c->sp;
                }
            }
            c->frame_sp = saved_frame_sp;
            struct sframe *restore_env = (struct sframe *)sp[0];
            if (c->env != restore_env) CTX_SET_ENV(c, restore_env);
            SP_POP(c, sp);
            return v;
        }
    }
    VALUE r = scm_apply_tail(c, sp[0], 0, NULL, is_tail);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_call_1(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t is_tail, NODE *fn, NODE *a0)
{
    (void)n;
    /* Park `f` on c->sp across the arg eval — argc>0 means a0's eval
     * may trigger GC and a moving backend would relocate f's referent. */
    SP_PUSH(c, sp, 2);
    sp[0] = (*fn_dispatcher)(c, fn, sp + (2));            /* f */
    sp[1] = (*a0_dispatcher)(c, a0, sp + (2));            /* av[0] */
    /* no_capture fast path: skip sframe alloc.  body_sp = c->sp = sp + 2
     * = past (fn, arg0); body's lref_sp(-1) reads sp + 1 = arg0.
     *
     * Restricted to is_tail==0 (= non-tail) so that mutual tail recursion
     * (e.g., m-even?/m-odd?) propagates tail_call_pending upward to a
     * single enclosing trampoline instead of growing the C stack one
     * level per recursive hop.  Tail calls fall through to
     * scm_apply_tail, which the outer fast path's trampoline catches.
     *
     * Within this fast path we run an inline trampoline that observes
     * tail_call_pending.  We park `c->env` at sp[0] (= overwriting fn,
     * which body doesn't need) so a moving GC during body forwards it
     * via the sp[] root scan — a C-local `saved_env` would be stale. */
    if (!is_tail && LIKELY(scm_is_closure(sp[0]))) {
        struct sobj *cl = SCM_PTR(sp[0]);
        if (LIKELY(cl->closure.no_capture && cl->closure.nparams == 1 && !cl->closure.has_rest)) {
            NODE *body = cl->closure.body;
            VALUE *saved_frame_sp = c->frame_sp;
            sp[0] = (VALUE)c->env;       /* park saved env at fn slot */
            c->frame_sp = c->sp;
            VALUE v;
            for (;;) {
                if (UNLIKELY(ASCHEME_PROFILING)) body->head.dispatch_cnt++;
                v = EVAL(c, body, c->sp);
                if (!c->tail_call_pending) break;
                c->tail_call_pending = 0;
                body = c->next_body;
                if (c->next_no_capture) {
                    /* no_capture next body: env doesn't matter (body uses
                     * frame_sp[] only); just refresh args + frame_sp on
                     * sp[].  Skip CTX_SET_ENV so c->env stays at caller's
                     * env for cheap restore at exit.  Args live in
                     * c->next_env->slots (the heap frame build_frame_for
                     * just populated); c->next_env is rooted via
                     * aro_scheme_visit_roots. */
                    uint16_t np = c->next_nparams;
                    VALUE *args_base = sp + 1;
                    ASTRO_ASSERT(args_base + np <= g_sp_scratch + ASCHEME_SP_SCRATCH_SIZE);
                    for (uint16_t i = 0; i < np; i++) args_base[i] = c->next_env->slots[i];
                    c->sp = args_base + np;
                    c->frame_sp = c->sp;
                } else {
                    if (c->next_env != c->env) CTX_SET_ENV(c, c->next_env);
                    c->frame_sp = c->sp;
                }
            }
            c->frame_sp = saved_frame_sp;
            struct sframe *restore_env = (struct sframe *)sp[0];
            if (c->env != restore_env) CTX_SET_ENV(c, restore_env);
            SP_POP(c, sp);
            return v;
        }
    }
    VALUE r = scm_apply_tail(c, sp[0], 1, sp + 1, is_tail);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_call_2(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t is_tail, NODE *fn, NODE *a0, NODE *a1)
{
    (void)n;
    SP_PUSH(c, sp, 3);                  /* f, av[0], av[1] */
    sp[0] = (*fn_dispatcher)(c, fn, sp + (3));
    sp[1] = (*a0_dispatcher)(c, a0, sp + (3));
    sp[2] = (*a1_dispatcher)(c, a1, sp + (3));
    if (!is_tail && LIKELY(scm_is_closure(sp[0]))) {
        struct sobj *cl = SCM_PTR(sp[0]);
        if (LIKELY(cl->closure.no_capture && cl->closure.nparams == 2 && !cl->closure.has_rest)) {
            NODE *body = cl->closure.body;
            VALUE *saved_frame_sp = c->frame_sp;
            sp[0] = (VALUE)c->env;
            c->frame_sp = c->sp;
            VALUE v;
            for (;;) {
                if (UNLIKELY(ASCHEME_PROFILING)) body->head.dispatch_cnt++;
                v = EVAL(c, body, c->sp);
                if (!c->tail_call_pending) break;
                c->tail_call_pending = 0;
                body = c->next_body;
                if (c->next_no_capture) {
                    uint16_t np = c->next_nparams;
                    VALUE *args_base = sp + 1;
                    ASTRO_ASSERT(args_base + np <= g_sp_scratch + ASCHEME_SP_SCRATCH_SIZE);
                    for (uint16_t i = 0; i < np; i++) args_base[i] = c->next_env->slots[i];
                    c->sp = args_base + np;
                    c->frame_sp = c->sp;
                } else {
                    if (c->next_env != c->env) CTX_SET_ENV(c, c->next_env);
                    c->frame_sp = c->sp;
                }
            }
            c->frame_sp = saved_frame_sp;
            struct sframe *restore_env = (struct sframe *)sp[0];
            if (c->env != restore_env) CTX_SET_ENV(c, restore_env);
            SP_POP(c, sp);
            return v;
        }
    }
    VALUE r = scm_apply_tail(c, sp[0], 2, sp + 1, is_tail);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_call_3(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t is_tail, NODE *fn, NODE *a0, NODE *a1, NODE *a2)
{
    (void)n;
    SP_PUSH(c, sp, 4);
    sp[0] = (*fn_dispatcher)(c, fn, sp + (4));
    sp[1] = (*a0_dispatcher)(c, a0, sp + (4));
    sp[2] = (*a1_dispatcher)(c, a1, sp + (4));
    sp[3] = (*a2_dispatcher)(c, a2, sp + (4));
    if (!is_tail && LIKELY(scm_is_closure(sp[0]))) {
        struct sobj *cl = SCM_PTR(sp[0]);
        if (LIKELY(cl->closure.no_capture && cl->closure.nparams == 3 && !cl->closure.has_rest)) {
            NODE *body = cl->closure.body;
            VALUE *saved_frame_sp = c->frame_sp;
            sp[0] = (VALUE)c->env;
            c->frame_sp = c->sp;
            VALUE v;
            for (;;) {
                if (UNLIKELY(ASCHEME_PROFILING)) body->head.dispatch_cnt++;
                v = EVAL(c, body, c->sp);
                if (!c->tail_call_pending) break;
                c->tail_call_pending = 0;
                body = c->next_body;
                if (c->next_no_capture) {
                    uint16_t np = c->next_nparams;
                    VALUE *args_base = sp + 1;
                    ASTRO_ASSERT(args_base + np <= g_sp_scratch + ASCHEME_SP_SCRATCH_SIZE);
                    for (uint16_t i = 0; i < np; i++) args_base[i] = c->next_env->slots[i];
                    c->sp = args_base + np;
                    c->frame_sp = c->sp;
                } else {
                    if (c->next_env != c->env) CTX_SET_ENV(c, c->next_env);
                    c->frame_sp = c->sp;
                }
            }
            c->frame_sp = saved_frame_sp;
            struct sframe *restore_env = (struct sframe *)sp[0];
            if (c->env != restore_env) CTX_SET_ENV(c, restore_env);
            SP_POP(c, sp);
            return v;
        }
    }
    VALUE r = scm_apply_tail(c, sp[0], 3, sp + 1, is_tail);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_call_4(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t is_tail, NODE *fn, NODE *a0, NODE *a1, NODE *a2, NODE *a3)
{
    (void)n;
    SP_PUSH(c, sp, 5);
    sp[0] = (*fn_dispatcher)(c, fn, sp + (5));
    sp[1] = (*a0_dispatcher)(c, a0, sp + (5));
    sp[2] = (*a1_dispatcher)(c, a1, sp + (5));
    sp[3] = (*a2_dispatcher)(c, a2, sp + (5));
    sp[4] = (*a3_dispatcher)(c, a3, sp + (5));
    if (!is_tail && LIKELY(scm_is_closure(sp[0]))) {
        struct sobj *cl = SCM_PTR(sp[0]);
        if (LIKELY(cl->closure.no_capture && cl->closure.nparams == 4 && !cl->closure.has_rest)) {
            NODE *body = cl->closure.body;
            VALUE *saved_frame_sp = c->frame_sp;
            sp[0] = (VALUE)c->env;
            c->frame_sp = c->sp;
            VALUE v;
            for (;;) {
                if (UNLIKELY(ASCHEME_PROFILING)) body->head.dispatch_cnt++;
                v = EVAL(c, body, c->sp);
                if (!c->tail_call_pending) break;
                c->tail_call_pending = 0;
                body = c->next_body;
                if (c->next_no_capture) {
                    uint16_t np = c->next_nparams;
                    VALUE *args_base = sp + 1;
                    ASTRO_ASSERT(args_base + np <= g_sp_scratch + ASCHEME_SP_SCRATCH_SIZE);
                    for (uint16_t i = 0; i < np; i++) args_base[i] = c->next_env->slots[i];
                    c->sp = args_base + np;
                    c->frame_sp = c->sp;
                } else {
                    if (c->next_env != c->env) CTX_SET_ENV(c, c->next_env);
                    c->frame_sp = c->sp;
                }
            }
            c->frame_sp = saved_frame_sp;
            struct sframe *restore_env = (struct sframe *)sp[0];
            if (c->env != restore_env) CTX_SET_ENV(c, restore_env);
            SP_POP(c, sp);
            return v;
        }
    }
    VALUE r = scm_apply_tail(c, sp[0], 4, sp + 1, is_tail);
    SP_POP(c, sp);
    return r;
}

// Variable arity: arg sub-trees live in a global table (ASCHEME_CALL_ARGS),
// indexed by (args_idx .. args_idx + argc).  Stays @noinline because the
// arg dispatch goes through `arg->head.dispatcher` (a runtime read of the
// child node), which the specializer can't bake to a static SD call.
NODE_DEF @noinline
node_call_n(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, uint32_t is_tail, NODE *fn, uint32_t args_idx, uint32_t argc)
{
    (void)n;
    extern NODE **ASCHEME_CALL_ARGS;
    /* Stack-rooted: sp[0]=f, sp[1..1+argc]=av[].  scm_apply_tail accepts a
     * VALUE* argv, so we hand it sp + 1 directly. */
    SP_PUSH(c, sp, 1 + (int)argc);
    sp[0] = (*fn_dispatcher)(c, fn, sp + (1 + (int)argc));
    for (uint32_t i = 0; i < argc; i++) {
        NODE *arg = ASCHEME_CALL_ARGS[args_idx + i];
        sp[1 + i] = (*arg->head.dispatcher)(c, arg, sp + (1 + (int)argc));
    }
    VALUE r = scm_apply_tail(c, sp[0], (int)argc, sp + 1, is_tail);
    SP_POP(c, sp);
    return r;
}

// call/cc — captures an escape continuation (one-shot, downward only).
NODE_DEF @noinline
node_callcc(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *fn)
{
    (void)n;
    /* Park f across the scm_callcc call which allocates internally. */
    SP_PUSH(c, sp, 1);
    sp[0] = (*fn_dispatcher)(c, fn, sp + (1));
    VALUE r = scm_callcc(c, sp[0]);
    SP_POP(c, sp);
    return r;
}

// ---------------------------------------------------------------------------
// Self-tail-call loop (parser-emitted for `(let NAME (...) BODY)` and
// single-binding letrec patterns).  When the parser proves that NAME is
// bound exactly once (the implementation-internal `set!` from the named-
// let desugaring) and that all tail-position calls to NAME have matching
// arity, it lowers the lambda body to:
//
//     node_loop(real_body, nparams)
//
// and rewrites every `(call_K NAME args...)` in tail position to
// `node_self_tail_call_K(args...)`.  At runtime the call node evaluates
// args into c->loop_args[] and sets c->loop_continue=1; the enclosing
// node_loop catches the flag, copies args back into c->env->slots, and
// re-enters the body.  No scm_apply_tail dispatch, no trampoline
// indirection — a tight C for(;;) inside the SD function.
// ---------------------------------------------------------------------------

NODE_DEF
node_loop(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *body, uint32_t nparams, uint32_t no_capture, uint32_t leaf)
{
    (void)n;
    /* Bump node_loop's own dispatch counter per iteration so
     * --pg-compile profiles self-tail-call loops correctly.  scm_apply
     * only bumps the counter once at closure entry; without this the
     * entry would count 1 (= entry) for a million-iter `let loop`, sit
     * below the AOT threshold, and never get SD-compiled. */
    for (;;) {
        if (UNLIKELY(ASCHEME_PROFILING)) n->head.dispatch_cnt++;
        VALUE v = EVAL_ARG(c, body);
        if (LIKELY(!c->loop_continue)) return v;
        c->loop_continue = 0;
        if (no_capture) {
            /* no_capture body reads via c->frame_sp[idx - nparams].  Mirror
             * loop_args into that window.  No WB needed — sp[] entries
             * aren't heap objects; GC scans c->sp directly. */
            for (uint32_t i = 0; i < nparams; i++) {
                c->frame_sp[(int32_t)i - (int32_t)nparams] = c->loop_args[i];
            }
        } else if (leaf) {
            /* leaf body: no inner closure can capture this frame, so in-place
             * slot overwrite is semantically safe and an alloc-free win.
             * c->env may be OLD (= long-lived loop frame); loop_args slots
             * are fresh young values from the just-evaluated tail-call. */
            for (uint32_t i = 0; i < nparams; i++) {
                ARO_STORE(c, c->env, &c->env->slots[i], c->loop_args[i]);
            }
        } else {
            /* Non-leaf body: an inner lambda may have captured the current
             * frame and stored the closure where it outlives this loop
             * iteration (e.g., `(vector-set! v i (lambda () i))`).  R5RS
             * semantics demand a FRESH binding per loop iteration, so we
             * allocate a new sframe and switch c->env to it.  The captured
             * closure keeps pointing at the OLD frame (= each iteration's
             * own copy of i). */
            VALUE *sp_inner = c->sp;
            ASTRO_ASSERT(sp_inner + nparams <= g_sp_scratch + ASCHEME_SP_SCRATCH_SIZE);
            for (uint32_t i = 0; i < nparams; i++) sp_inner[i] = c->loop_args[i];
            c->sp = sp_inner + nparams;
            struct sframe *new_env = scm_new_frame(c, c->env->parent, (int)nparams);
            for (uint32_t i = 0; i < nparams; i++) {
                ARO_STORE(c, new_env, &new_env->slots[i], sp_inner[i]);
            }
            c->sp = sp_inner;
            CTX_SET_ENV(c, new_env);
        }
    }
}

NODE_DEF
node_self_tail_call_0(CTX * restrict c, NODE * restrict n, VALUE * restrict sp)
{
    (void)n;
    c->loop_continue = 1;
    return SCM_UNSPEC;
}

NODE_DEF
node_self_tail_call_1(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a0)
{
    (void)n;
    /* Park v0 on c->sp across the (none here) extra evals — and to
     * survive any GC after the assignment to loop_args[].  loop_args[]
     * is also rooted but the inner-call write hazard means we eval
     * into temporary sp slots first, then commit atomically. */
    SP_PUSH(c, sp, 1);
    sp[0] = (*a0_dispatcher)(c, a0, sp + (1));
    c->loop_args[0] = sp[0];
    c->loop_continue = 1;
    SP_POP(c, sp);
    return SCM_UNSPEC;
}

NODE_DEF
node_self_tail_call_2(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a0, NODE *a1)
{
    (void)n;
    /* Evaluate args into sp scratch, then commit to loop_args atomically.
     * Direct loop_args[i] = EVAL_ARG would let an inner-call write to
     * loop_args clobber the just-set slot. */
    SP_PUSH(c, sp, 2);
    sp[0] = (*a0_dispatcher)(c, a0, sp + (2));
    sp[1] = (*a1_dispatcher)(c, a1, sp + (2));
    c->loop_args[0] = sp[0];
    c->loop_args[1] = sp[1];
    c->loop_continue = 1;
    SP_POP(c, sp);
    return SCM_UNSPEC;
}

NODE_DEF
node_self_tail_call_3(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a0, NODE *a1, NODE *a2)
{
    (void)n;
    SP_PUSH(c, sp, 3);
    sp[0] = (*a0_dispatcher)(c, a0, sp + (3));
    sp[1] = (*a1_dispatcher)(c, a1, sp + (3));
    sp[2] = (*a2_dispatcher)(c, a2, sp + (3));
    c->loop_args[0] = sp[0];
    c->loop_args[1] = sp[1];
    c->loop_args[2] = sp[2];
    c->loop_continue = 1;
    SP_POP(c, sp);
    return SCM_UNSPEC;
}

NODE_DEF
node_self_tail_call_4(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a0, NODE *a1, NODE *a2, NODE *a3)
{
    (void)n;
    SP_PUSH(c, sp, 4);
    sp[0] = (*a0_dispatcher)(c, a0, sp + (4));
    sp[1] = (*a1_dispatcher)(c, a1, sp + (4));
    sp[2] = (*a2_dispatcher)(c, a2, sp + (4));
    sp[3] = (*a3_dispatcher)(c, a3, sp + (4));
    c->loop_args[0] = sp[0];
    c->loop_args[1] = sp[1];
    c->loop_args[2] = sp[2];
    c->loop_args[3] = sp[3];
    c->loop_continue = 1;
    SP_POP(c, sp);
    return SCM_UNSPEC;
}

// ---------------------------------------------------------------------------
// Global self-tail-call.  Parser-emitted for top-level
// `(define (f params) body)` forms whose body contains tail-position
// calls back to f via the global name (a gref).  The lambda body is
// wrapped in node_loop, and each `(call_K (gref f) args)` in tail
// position becomes a node_self_tail_call_global_K — same loop_args /
// loop_continue protocol as the named-let case (§18), but with a
// gref_cache so a subsequent `(set! f g)` (which bumps globals_serial)
// invalidates the loop and falls through to `scm_apply_tail` against
// the rebound closure.  Until any rebinding happens, the recursion
// stays inside the lambda body's SD with no scm_apply re-entry.
// ---------------------------------------------------------------------------

NODE_DEF
node_self_tail_call_global_0(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *name, struct gref_cache *cache@ref)
{
    (void)n;
    if (LIKELY(cache->serial == c->globals_serial)) {
        c->loop_continue = 1;
        return SCM_UNSPEC;
    }
    cache->value = scm_global_ref(c, name);
    cache->serial = c->globals_serial;
    return scm_apply_tail(c, cache->value, 0, NULL, 1);
}

NODE_DEF
node_self_tail_call_global_1(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *name, NODE *a0, struct gref_cache *cache@ref)
{
    (void)n;
    /* Eval into sp scratch, commit to loop_args atomically — see
     * node_self_tail_call_2 for the inner-call clobber rationale. */
    SP_PUSH(c, sp, 1);
    sp[0] = (*a0_dispatcher)(c, a0, sp + (1));
    if (LIKELY(cache->serial == c->globals_serial)) {
        c->loop_args[0] = sp[0];
        c->loop_continue = 1;
        SP_POP(c, sp);
        return SCM_UNSPEC;
    }
    cache->value = scm_global_ref(c, name);
    cache->serial = c->globals_serial;
    VALUE r = scm_apply_tail(c, cache->value, 1, &sp[0], 1);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_self_tail_call_global_2(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *name, NODE *a0, NODE *a1, struct gref_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a0_dispatcher)(c, a0, sp + (2));
    sp[1] = (*a1_dispatcher)(c, a1, sp + (2));
    if (LIKELY(cache->serial == c->globals_serial)) {
        c->loop_args[0] = sp[0];
        c->loop_args[1] = sp[1];
        c->loop_continue = 1;
        SP_POP(c, sp);
        return SCM_UNSPEC;
    }
    cache->value = scm_global_ref(c, name);
    cache->serial = c->globals_serial;
    VALUE r = scm_apply_tail(c, cache->value, 2, &sp[0], 1);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_self_tail_call_global_3(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *name, NODE *a0, NODE *a1, NODE *a2, struct gref_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 3);
    sp[0] = (*a0_dispatcher)(c, a0, sp + (3));
    sp[1] = (*a1_dispatcher)(c, a1, sp + (3));
    sp[2] = (*a2_dispatcher)(c, a2, sp + (3));
    if (LIKELY(cache->serial == c->globals_serial)) {
        c->loop_args[0] = sp[0];
        c->loop_args[1] = sp[1];
        c->loop_args[2] = sp[2];
        c->loop_continue = 1;
        SP_POP(c, sp);
        return SCM_UNSPEC;
    }
    cache->value = scm_global_ref(c, name);
    cache->serial = c->globals_serial;
    VALUE r = scm_apply_tail(c, cache->value, 3, &sp[0], 1);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_self_tail_call_global_4(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, const char *name, NODE *a0, NODE *a1, NODE *a2, NODE *a3, struct gref_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 4);
    sp[0] = (*a0_dispatcher)(c, a0, sp + (4));
    sp[1] = (*a1_dispatcher)(c, a1, sp + (4));
    sp[2] = (*a2_dispatcher)(c, a2, sp + (4));
    sp[3] = (*a3_dispatcher)(c, a3, sp + (4));
    if (LIKELY(cache->serial == c->globals_serial)) {
        c->loop_args[0] = sp[0];
        c->loop_args[1] = sp[1];
        c->loop_args[2] = sp[2];
        c->loop_args[3] = sp[3];
        c->loop_continue = 1;
        SP_POP(c, sp);
        return SCM_UNSPEC;
    }
    cache->value = scm_global_ref(c, name);
    cache->serial = c->globals_serial;
    VALUE r = scm_apply_tail(c, cache->value, 4, &sp[0], 1);
    SP_POP(c, sp);
    return r;
}

// ---------------------------------------------------------------------------
// Specialized arithmetic + comparison.  Compiled when the parser sees
// `(<op> a b)` with op ∈ {+,-,*,<,=,<=,>,>=} and the op symbol is not
// shadowed by a lexical binding.
//
// R5RS allows redefining arithmetic operators (`(set! + my+)`).  We
// preserve that semantics: each node carries an `arith_cache @ref` whose
// `index` points at the operator's slot in `c->globals`, and the EVAL
// body checks `c->globals[index].value == PRIM_<op>_VAL` (the snapshot
// install_prims took) before the fast path runs.  When the user rebinds
// the operator, that check fails and we fall through `arith_dispatch`
// (a regular `scm_apply` against the new binding).
//
// Hot path: 2-fixnum check + overflow check, ~5 instructions after AOT
// specialization folds the children's dispatchers in.  Off the hot path,
// non-fixnum operands flow through the numeric tower (add2/sub2/...);
// rebound operators flow through the general dispatch.

extern VALUE arith_dispatch(CTX *c, struct arith_cache *cache, const char *opname, VALUE expected, VALUE av, VALUE bv);

// Two-operand arith / cmp nodes evaluate `a` then `b`; either eval may
// trigger GC and relocate previously-computed VALUEs (= bignum operands
// are heap-allocated, as are heap-typed sub-expression results).  We
// park both intermediate VALUEs on c->sp so the precise root scanner
// updates them across the second eval and the subsequent add2 / cmp2 /
// arith_dispatch call (which itself may allocate).  Fixnum operands are
// LSB-tagged immediates so storing them through sp[] is a no-op for the
// fast path.
NODE_DEF
node_arith_add(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(SCM_IS_FIXNUM(sp[0]) & SCM_IS_FIXNUM(sp[1]))) {
            int64_t v;
            if (LIKELY(!__builtin_add_overflow((int64_t)SCM_FIXVAL(sp[0]),
                                               (int64_t)SCM_FIXVAL(sp[1]), &v) &&
                        v >= SCM_FIXNUM_MIN && v <= SCM_FIXNUM_MAX)) {
                SP_POP(c, sp);
                return SCM_FIX(v);
            }
        }
        r = add2(c, sp[0], sp[1]);
    } else {
        r = arith_dispatch(c, cache, "+", PRIM_PLUS_VAL, sp[0], sp[1]);
    }
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_arith_sub(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(SCM_IS_FIXNUM(sp[0]) & SCM_IS_FIXNUM(sp[1]))) {
            int64_t v;
            if (LIKELY(!__builtin_sub_overflow((int64_t)SCM_FIXVAL(sp[0]),
                                               (int64_t)SCM_FIXVAL(sp[1]), &v) &&
                        v >= SCM_FIXNUM_MIN && v <= SCM_FIXNUM_MAX)) {
                SP_POP(c, sp);
                return SCM_FIX(v);
            }
        }
        r = sub2(c, sp[0], sp[1]);
    } else {
        r = arith_dispatch(c, cache, "-", PRIM_MINUS_VAL, sp[0], sp[1]);
    }
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_arith_mul(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(SCM_IS_FIXNUM(sp[0]) & SCM_IS_FIXNUM(sp[1]))) {
            int64_t v;
            if (LIKELY(!__builtin_mul_overflow((int64_t)SCM_FIXVAL(sp[0]),
                                               (int64_t)SCM_FIXVAL(sp[1]), &v) &&
                        v >= SCM_FIXNUM_MIN && v <= SCM_FIXNUM_MAX)) {
                SP_POP(c, sp);
                return SCM_FIX(v);
            }
        }
        r = mul2(c, sp[0], sp[1]);
    } else {
        r = arith_dispatch(c, cache, "*", PRIM_MUL_VAL, sp[0], sp[1]);
    }
    SP_POP(c, sp);
    return r;
}

// astrogen scans `NODE_DEF` lines literally — preprocessor macros aren't
// expanded — so we write the five comparators out longhand.

NODE_DEF
node_arith_lt(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(SCM_IS_FIXNUM(sp[0]) & SCM_IS_FIXNUM(sp[1]))) {
            r = ((int64_t)SCM_FIXVAL(sp[0]) < (int64_t)SCM_FIXVAL(sp[1])) ? SCM_TRUE : SCM_FALSE;
        } else {
            r = cmp2(c, sp[0], sp[1]) < 0 ? SCM_TRUE : SCM_FALSE;
        }
    } else {
        r = arith_dispatch(c, cache, "<", PRIM_NUM_LT_VAL, sp[0], sp[1]);
    }
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_arith_le(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(SCM_IS_FIXNUM(sp[0]) & SCM_IS_FIXNUM(sp[1]))) {
            r = ((int64_t)SCM_FIXVAL(sp[0]) <= (int64_t)SCM_FIXVAL(sp[1])) ? SCM_TRUE : SCM_FALSE;
        } else {
            r = cmp2(c, sp[0], sp[1]) <= 0 ? SCM_TRUE : SCM_FALSE;
        }
    } else {
        r = arith_dispatch(c, cache, "<=", PRIM_NUM_LE_VAL, sp[0], sp[1]);
    }
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_arith_gt(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(SCM_IS_FIXNUM(sp[0]) & SCM_IS_FIXNUM(sp[1]))) {
            r = ((int64_t)SCM_FIXVAL(sp[0]) > (int64_t)SCM_FIXVAL(sp[1])) ? SCM_TRUE : SCM_FALSE;
        } else {
            r = cmp2(c, sp[0], sp[1]) > 0 ? SCM_TRUE : SCM_FALSE;
        }
    } else {
        r = arith_dispatch(c, cache, ">", PRIM_NUM_GT_VAL, sp[0], sp[1]);
    }
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_arith_ge(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(SCM_IS_FIXNUM(sp[0]) & SCM_IS_FIXNUM(sp[1]))) {
            r = ((int64_t)SCM_FIXVAL(sp[0]) >= (int64_t)SCM_FIXVAL(sp[1])) ? SCM_TRUE : SCM_FALSE;
        } else {
            r = cmp2(c, sp[0], sp[1]) >= 0 ? SCM_TRUE : SCM_FALSE;
        }
    } else {
        r = arith_dispatch(c, cache, ">=", PRIM_NUM_GE_VAL, sp[0], sp[1]);
    }
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_arith_eq(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(SCM_IS_FIXNUM(sp[0]) & SCM_IS_FIXNUM(sp[1]))) {
            r = ((int64_t)SCM_FIXVAL(sp[0]) == (int64_t)SCM_FIXVAL(sp[1])) ? SCM_TRUE : SCM_FALSE;
        } else {
            r = cmp2(c, sp[0], sp[1]) == 0 ? SCM_TRUE : SCM_FALSE;
        }
    } else {
        r = arith_dispatch(c, cache, "=", PRIM_NUM_EQ_VAL, sp[0], sp[1]);
    }
    SP_POP(c, sp);
    return r;
}

// ---------------------------------------------------------------------------
// Specialized 1-arg predicates: null? / pair? / car / cdr / not.  Hot path
// dispatches inline; off the hot path (or after a redefine) we go through
// `arith_dispatch` reusing the same cache layout — its 1-arg form only
// touches `argv[0]`.

extern VALUE arith_dispatch1(CTX *c, struct arith_cache *cache, const char *opname, VALUE expected, VALUE av);

NODE_DEF
node_pred_null(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, struct arith_cache *cache@ref)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (LIKELY(cache->serial == c->globals_serial))
        return av == SCM_NIL ? SCM_TRUE : SCM_FALSE;
    return arith_dispatch1(c, cache, "null?", PRIM_NULL_P_VAL, av);
}

NODE_DEF
node_pred_pair(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, struct arith_cache *cache@ref)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (LIKELY(cache->serial == c->globals_serial))
        return scm_is_pair(av) ? SCM_TRUE : SCM_FALSE;
    return arith_dispatch1(c, cache, "pair?", PRIM_PAIR_P_VAL, av);
}

NODE_DEF
node_pred_car(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, struct arith_cache *cache@ref)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(scm_is_pair(av))) return SCM_PTR(av)->pair.car;
        scm_error(c, "car: not a pair");
    }
    return arith_dispatch1(c, cache, "car", PRIM_CAR_VAL, av);
}

NODE_DEF
node_pred_cdr(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, struct arith_cache *cache@ref)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(scm_is_pair(av))) return SCM_PTR(av)->pair.cdr;
        scm_error(c, "cdr: not a pair");
    }
    return arith_dispatch1(c, cache, "cdr", PRIM_CDR_VAL, av);
}

NODE_DEF
node_pred_not(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, struct arith_cache *cache@ref)
{
    (void)n;
    VALUE av = EVAL_ARG(c, a);
    if (LIKELY(cache->serial == c->globals_serial))
        return av == SCM_FALSE ? SCM_TRUE : SCM_FALSE;
    return arith_dispatch1(c, cache, "not", PRIM_NOT_VAL, av);
}

// ---------------------------------------------------------------------------
// Specialized vector ops: vector-ref / vector-set!.  Skip the prim entry
// + dispatch to do the bounds check inline.

NODE_DEF
node_vec_ref(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *vec, NODE *idx, struct arith_cache *cache@ref)
{
    (void)n;
    /* Park `vec` across `idx` eval — vec is always heap-typed (an OBJ_VECTOR
     * sobj) and the idx eval may allocate (e.g. bignum operand).  Without
     * rooting, a moving GC would invalidate vv and the subsequent
     * SCM_PTR(vv)->vec.items access would dereference a stale page. */
    SP_PUSH(c, sp, 2);
    sp[0] = (*vec_dispatcher)(c, vec, sp + (2));
    sp[1] = (*idx_dispatcher)(c, idx, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(scm_is_vector(sp[0]) && SCM_IS_FIXNUM(sp[1]))) {
            size_t i = (size_t)SCM_FIXVAL(sp[1]);
            if (LIKELY(i < SCM_PTR(sp[0])->vec.len)) {
                r = SCM_PTR(sp[0])->vec.items[i];
                SP_POP(c, sp);
                return r;
            }
        }
        SP_POP(c, sp);
        scm_error(c, "vector-ref: type or range error");
    }
    r = arith_dispatch(c, cache, "vector-ref", PRIM_VECTOR_REF_VAL, sp[0], sp[1]);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_cons_op(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    /* Park both operands across the second eval AND across scm_cons /
     * arith_dispatch (= both allocate).  `av` and `bv` are typically
     * heap-typed in real code (the consing patterns that exercise this
     * node), so without sp[] rooting their referents go stale under a
     * moving collector. */
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial))
        r = scm_cons(c, sp[0], sp[1]);
    else
        r = arith_dispatch(c, cache, "cons", PRIM_CONS_VAL, sp[0], sp[1]);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_eq_op(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    /* Park across the second eval — `av` may be a heap object whose
     * referent shifts during EVAL_ARG(b).  Pointer-identity (sp[0] ==
     * sp[1]) compares stable post-move bits because both slots are
     * relocated coherently by the precise root scanner. */
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial))
        r = sp[0] == sp[1] ? SCM_TRUE : SCM_FALSE;
    else
        r = arith_dispatch(c, cache, "eq?", PRIM_EQ_P_VAL, sp[0], sp[1]);
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_eqv_op(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *a, NODE *b, struct arith_cache *cache@ref)
{
    (void)n;
    SP_PUSH(c, sp, 2);
    sp[0] = (*a_dispatcher)(c, a, sp + (2));
    sp[1] = (*b_dispatcher)(c, b, sp + (2));
    VALUE r;
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (sp[0] == sp[1]) {
            r = SCM_TRUE;
        } else if (scm_is_double(sp[0]) && scm_is_double(sp[1])) {
            r = scm_get_double(sp[0]) == scm_get_double(sp[1]) ? SCM_TRUE : SCM_FALSE;
        } else if (scm_is_char(sp[0]) && scm_is_char(sp[1])) {
            r = SCM_PTR(sp[0])->ch == SCM_PTR(sp[1])->ch ? SCM_TRUE : SCM_FALSE;
        } else {
            r = SCM_FALSE;
        }
    } else {
        r = arith_dispatch(c, cache, "eqv?", PRIM_EQV_P_VAL, sp[0], sp[1]);
    }
    SP_POP(c, sp);
    return r;
}

NODE_DEF
node_vec_set(CTX * restrict c, NODE * restrict n, VALUE * restrict sp, NODE *vec, NODE *idx, NODE *val, struct arith_cache *cache@ref)
{
    (void)n;
    /* Park all three operands across the subsequent evals + the
     * arith_dispatch3 path.  `vv` (vec) MUST survive both `idx` and
     * `val` evals — any of those may alloc.  `xv` survives across the
     * SCM_PTR(vv)->vec.items[i] = sp[2] write (no further alloc, so
     * the parked value reads back fresh post-relocate). */
    SP_PUSH(c, sp, 3);
    sp[0] = (*vec_dispatcher)(c, vec, sp + (3));
    sp[1] = (*idx_dispatcher)(c, idx, sp + (3));
    sp[2] = (*val_dispatcher)(c, val, sp + (3));
    if (LIKELY(cache->serial == c->globals_serial)) {
        if (LIKELY(scm_is_vector(sp[0]) && SCM_IS_FIXNUM(sp[1]))) {
            size_t i = (size_t)SCM_FIXVAL(sp[1]);
            struct sobj *vobj = SCM_PTR(sp[0]);
            if (LIKELY(i < vobj->vec.len)) {
                /* items[] backing is the WB holder.  vobj may be OLD (=
                 * long-lived vector), sp[2] may be a young VALUE. */
                char *items_base = (char *)vobj->vec.items - sizeof(AroObjectHeader);
                ARO_STORE(c, items_base, &vobj->vec.items[i], sp[2]);
                SP_POP(c, sp);
                return SCM_UNSPEC;
            }
        }
        SP_POP(c, sp);
        scm_error(c, "vector-set!: type or range error");
    }
    // 3-arg slow path: build a generic apply
    extern VALUE arith_dispatch3(CTX *c, struct arith_cache *cache, const char *opname, VALUE expected, VALUE a, VALUE b, VALUE d);
    VALUE r = arith_dispatch3(c, cache, "vector-set!", PRIM_VECTOR_SET_VAL, sp[0], sp[1], sp[2]);
    SP_POP(c, sp);
    return r;
}
