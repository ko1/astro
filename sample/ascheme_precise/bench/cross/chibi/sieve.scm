(import (scheme base) (scheme write))
(define (length lst) (if (null? lst) 0 (+ 1 (length (cdr lst)))))
(define (range a b) (if (>= a b) '() (cons a (range (+ a 1) b))))
(define (filter p lst)
  (cond ((null? lst) '())
        ((p (car lst)) (cons (car lst) (filter p (cdr lst))))
        (else (filter p (cdr lst)))))
(define (sieve lst)
  (if (null? lst) '()
      (cons (car lst)
            (sieve (filter (lambda (x) (not (= 0 (modulo x (car lst))))) (cdr lst))))))
(display (length (sieve (range 2 50000)))) (newline)
