// --- casts ---------------------------------------------------------

NODE_DEF
node_cast_id(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *e)
{
    return RESULT_OK((VALUE){.d = (double)UNWRAP(EVAL_ARG(c, e)).i});
}

NODE_DEF
node_cast_di(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *e)
{
    return RESULT_OK((VALUE){.i = (int64_t)UNWRAP(EVAL_ARG(c, e)).d});
}

// --- function call -------------------------------------------------
//
// Calls in C are resolved at parse time: parse.rb assigns each
// function_definition a stable index into `c->func_bodies[]`, and the
// IR just carries that index.  No name lookup, no inline cache, no
// setjmp.
//
// At the function boundary we **catch** `RESULT_RETURN` — that's the
// callee's normal "I'm finished, here's my value" — and demote it to
// `RESULT_NORMAL` so the caller proceeds.  Other states (BREAK /
// CONTINUE / GOTO escaping a function) shouldn't happen in valid C
// but are propagated as-is if they do.
//
// (We tried lifting the callee resolution into a `NODE *callee` child
// operand patched in by load_program.  Conceptually cleaner, but in
// practice slower: `n->u.node_call.callee` requires the SD to chase
// through the inlined AST tree at runtime, while
// `c->func_bodies[FUNC_IDX]` keeps `func_idx` baked as a uint32_t
// immediate at SPECIALIZE time → single indexed load against `c`,
// which is a register parameter.  Determinism across runs also
// favours an integer index over a heap pointer.)

// Caller-allocates the callee's frame as `_Alignas(8) char F[frame_bytes]`
// — byte-precise layout: args start at byte 0 (each padded to 8 so the
// generic slot copy works regardless of the arg's natural size), locals
// follow at their byte-aligned offsets.  parse.rb computes
// `frame_bytes` from the callee's signature + declared locals.
//
// `arg_count` is in 8-byte slot units (= the number of args; each lives
// in an 8-byte slot in the caller's staging area and the callee's F[0..]
// region).  `arg_off` is the byte offset of that staging area inside
// the caller's frame.
//
// When the parent SD chain is fully `static inline always_inline`,
// `&F` never escapes and gcc's SROA register-promotes each scalar
// inside F just as it did with the old `VALUE F[local_cnt]` model.

NODE_DEF
node_call(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, uint32_t func_idx, uint32_t arg_count, uint32_t arg_off, uint32_t frame_bytes)
{
    NODE *body = c->func_bodies[func_idx];
    _Alignas(8) char F[frame_bytes];
    // Args at byte 0..arg_count*8-1 of F.  Source is caller's fp at
    // byte offset `arg_off`.  memcpy avoids the strict-aliasing
    // pessimisation between a VALUE-typed write here and the typed
    // (int32_t / etc.) read at the callee's load site.
    if (arg_count) __builtin_memcpy(F, (char *)fp + arg_off, arg_count * 8);
    if (frame_bytes > arg_count * 8) {
        __builtin_memset(F + arg_count * 8, 0, frame_bytes - arg_count * 8);
    }
    RESULT r = (*body->head.dispatcher)(c, body, (VALUE *)F);
    return RESULT_OK(r.value);
}

NODE_DEF
node_call_static(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *callee, uint32_t arg_count, uint32_t arg_off, uint32_t frame_bytes)
{
    _Alignas(8) char F[frame_bytes];
    if (arg_count) __builtin_memcpy(F, (char *)fp + arg_off, arg_count * 8);
    if (frame_bytes > arg_count * 8) {
        __builtin_memset(F + arg_count * 8, 0, frame_bytes - arg_count * 8);
    }
    fp = (VALUE *)F;
    RESULT r = EVAL_ARG(c, callee);
    return RESULT_OK(r.value);
}

// --- specialized call forms with N inline arg expressions ----------
//
// The generic node_call / node_call_static stages args via the caller's
// fp[arg_index..arg_index+arg_count]: parse.rb emits a `seq` of
// `lset arg_idx+i (rhs)` per arg, then the call dispatcher reads
// fp[arg_idx..] and copies into F[0..arg_count].  That's a double-copy
// (writes to caller fp + reads-and-writes to F), which on tak shows up
// as ~600M extra instructions vs gcc -O1 (per-call setup is the hot
// path in deep-recursion benchmarks).
//
// node_callN_recursive / _static skip the staging entirely: each arg
// is a child NODE*, evaluated at SPECIALIZE-time directly into F[i].
// Same calling convention for the callee SD; only the arg-eval path
// changes.  parse.rb emits these for ≤3-arg calls.
//
// _recursive variant uses func_idx → c->func_bodies[idx] (matches
// node_call's runtime resolution; needed for self/mutual recursion
// where the callee body is in a cycle).
// _static variant carries the callee NODE* directly (matches
// node_call_static; works only for non-recursive callees).

NODE_DEF
node_call0_recursive(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, uint32_t func_idx, uint32_t frame_bytes)
{
    NODE *body = c->func_bodies[func_idx];
    _Alignas(8) char F[frame_bytes];
    RESULT r = (*body->head.dispatcher)(c, body, (VALUE *)F);
    return RESULT_OK(r.value);
}

// callN_recursive / _static: each arg evaluated directly into F[i] as
// an 8-byte VALUE (lower bytes hold the actual typed value).  Same
// "args at slot offsets, locals byte-precise" layout as `node_call`.

NODE_DEF
node_call1_recursive(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, uint32_t func_idx, uint32_t frame_bytes, NODE *a0)
{
    NODE *body = c->func_bodies[func_idx];
    _Alignas(8) char F[frame_bytes];
    VALUE __a0 = UNWRAP(EVAL_ARG(c, a0));
    __builtin_memcpy(F + 0, &__a0, 8);
    RESULT r = (*body->head.dispatcher)(c, body, (VALUE *)F);
    return RESULT_OK(r.value);
}

NODE_DEF
node_call2_recursive(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, uint32_t func_idx, uint32_t frame_bytes, NODE *a0, NODE *a1)
{
    NODE *body = c->func_bodies[func_idx];
    _Alignas(8) char F[frame_bytes];
    VALUE __a0 = UNWRAP(EVAL_ARG(c, a0));
    VALUE __a1 = UNWRAP(EVAL_ARG(c, a1));
    __builtin_memcpy(F + 0, &__a0, 8);
    __builtin_memcpy(F + 8, &__a1, 8);
    RESULT r = (*body->head.dispatcher)(c, body, (VALUE *)F);
    return RESULT_OK(r.value);
}

NODE_DEF
node_call3_recursive(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, uint32_t func_idx, uint32_t frame_bytes, NODE *a0, NODE *a1, NODE *a2)
{
    NODE *body = c->func_bodies[func_idx];
    _Alignas(8) char F[frame_bytes];
    VALUE __a0 = UNWRAP(EVAL_ARG(c, a0));
    VALUE __a1 = UNWRAP(EVAL_ARG(c, a1));
    VALUE __a2 = UNWRAP(EVAL_ARG(c, a2));
    __builtin_memcpy(F + 0,  &__a0, 8);
    __builtin_memcpy(F + 8,  &__a1, 8);
    __builtin_memcpy(F + 16, &__a2, 8);
    RESULT r = (*body->head.dispatcher)(c, body, (VALUE *)F);
    return RESULT_OK(r.value);
}

NODE_DEF
node_call0_static(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *callee, uint32_t frame_bytes)
{
    _Alignas(8) char F[frame_bytes];
    fp = (VALUE *)F;
    RESULT r = EVAL_ARG(c, callee);
    return RESULT_OK(r.value);
}

NODE_DEF
node_call1_static(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *callee, uint32_t frame_bytes, NODE *a0)
{
    _Alignas(8) char F[frame_bytes];
    VALUE __a0 = UNWRAP(EVAL_ARG(c, a0));
    __builtin_memcpy(F + 0, &__a0, 8);
    fp = (VALUE *)F;
    RESULT r = EVAL_ARG(c, callee);
    return RESULT_OK(r.value);
}

NODE_DEF
node_call2_static(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *callee, uint32_t frame_bytes, NODE *a0, NODE *a1)
{
    _Alignas(8) char F[frame_bytes];
    VALUE __a0 = UNWRAP(EVAL_ARG(c, a0));
    VALUE __a1 = UNWRAP(EVAL_ARG(c, a1));
    __builtin_memcpy(F + 0, &__a0, 8);
    __builtin_memcpy(F + 8, &__a1, 8);
    fp = (VALUE *)F;
    RESULT r = EVAL_ARG(c, callee);
    return RESULT_OK(r.value);
}

NODE_DEF
node_call3_static(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *callee, uint32_t frame_bytes, NODE *a0, NODE *a1, NODE *a2)
{
    _Alignas(8) char F[frame_bytes];
    VALUE __a0 = UNWRAP(EVAL_ARG(c, a0));
    VALUE __a1 = UNWRAP(EVAL_ARG(c, a1));
    VALUE __a2 = UNWRAP(EVAL_ARG(c, a2));
    __builtin_memcpy(F + 0,  &__a0, 8);
    __builtin_memcpy(F + 8,  &__a1, 8);
    __builtin_memcpy(F + 16, &__a2, 8);
    fp = (VALUE *)F;
    RESULT r = EVAL_ARG(c, callee);
    return RESULT_OK(r.value);
}

// --- builtin: printf / putchar / puts -----------------------------
//
// printf-family is variadic; each typed arg is read from the caller's
// frame at fp[arg_index..arg_index+arg_count-1].  The format string is
// fp[arg_index].p; subsequent slots carry typed values selected per
// conversion specifier.  See castro_run_printf in main.c.

extern int castro_run_printf(const char *fmt, VALUE *args, uint32_t arg_count);

NODE_DEF @noinline
node_printf(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, uint32_t arg_count, uint32_t arg_off)
{
    // Args are staged in caller's frame at byte offset `arg_off`,
    // each occupying an 8-byte slot.  arg 0 is the format string ptr.
    VALUE *args = (VALUE *)((char *)fp + arg_off);
    const char *fmt = (const char *)args[0].p;
    int r = castro_run_printf(fmt, &args[1], arg_count - 1);
    return RESULT_OK((VALUE){.i = r});
}

NODE_DEF
node_putchar(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *e)
{
    int ch = (int)UNWRAP(EVAL_ARG(c, e)).i;
    return RESULT_OK((VALUE){.i = putchar(ch)});
}

NODE_DEF
node_puts(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *e)
{
    return RESULT_OK((VALUE){.i = puts((const char *)UNWRAP(EVAL_ARG(c, e)).p)});
}

// --- function pointer ----------------------------------------------
//
// Taking a function's address: parse.rb gives us the index, runtime
// returns the matching body NODE * in the .p slot of VALUE.  An
// indirect call dereferences the pointer, sets up the frame, and
// dispatches.  No struct in between — the body NODE is enough.

NODE_DEF
node_func_addr(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, uint32_t func_idx)
{
    return RESULT_OK((VALUE){.p = c->func_bodies[func_idx]});
}

NODE_DEF
node_call_indirect(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *fn_expr, uint32_t arg_count, uint32_t arg_off)
{
    NODE *body = (NODE *)UNWRAP(EVAL_ARG(c, fn_expr)).p;
    (void)arg_count;
    if (UNLIKELY(body == NULL)) {
        fprintf(stderr, "castro: NULL function pointer\n");
        exit(1);
    }
    // arg staging area starts at byte `arg_off` in caller's frame —
    // pass it directly as the callee's fp (= same byte offsets as
    // the callee's args region).
    RESULT r = (*body->head.dispatcher)(c, body, (VALUE *)((char *)fp + arg_off));
    return RESULT_OK(r.value);
}

// --- goto / labels --------------------------------------------------
//
// parse.rb compiles a function with goto into:
//   while (1) { switch (label) { case 0: stmts; goto N1; case 1: ...; } }
// `node_goto LABEL` returns RESULT_GOTO carrying the label in
// .value.i; the enclosing `node_goto_dispatch` loop catches GOTO,
// stores the new target into c->goto_target, and re-evaluates the
// body so the inner switch picks the matching segment.

NODE_DEF
node_goto(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, int32_t label)
{
    return (RESULT){{.i = (int64_t)label}, RESULT_GOTO};
}

NODE_DEF
node_goto_dispatch(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *body)
{
    c->goto_target = 0;
    for (;;) {
        RESULT r = EVAL_ARG(c, body);
        if (r.state == RESULT_GOTO) {
            c->goto_target = (int32_t)r.value.i;
            continue;
        }
        return r;
    }
}

NODE_DEF
node_goto_target(CTX * restrict c, NODE * restrict n, VALUE * restrict fp)
{
    return RESULT_OK((VALUE){.i = c->goto_target});
}

// (No statement-level node_def: function definitions are registered
// by load_program in main.c at SX-load time, not as evaluatable AST
// nodes.  The previous `node_def` was a runtime-defining hook left
