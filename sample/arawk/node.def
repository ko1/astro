// `split(s, arr)` — uses FS.
NODE_DEF
arawk_node_split2(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *s, uint32_t arr_slot)
{
    (void)n;
    VALUE sv = UNWRAP(EVAL_ARG(c, s));
    if (fp[arr_slot] == AWK_UNINIT) fp[arr_slot] = awk_make_array();
    return RESULT_OK(AWK_FIX(awk_split(sv, fp[arr_slot], c->env[AWK_GLOB_FS])));
}

NODE_DEF
arawk_node_split3(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *s, uint32_t arr_slot, NODE *sep)
{
    (void)n;
    VALUE sv  = UNWRAP(EVAL_ARG(c, s));
    VALUE sep_v = UNWRAP(EVAL_ARG(c, sep));
    if (fp[arr_slot] == AWK_UNINIT) fp[arr_slot] = awk_make_array();
    return RESULT_OK(AWK_FIX(awk_split(sv, fp[arr_slot], sep_v)));
}

// Math: each builtin wraps libm.  Awk's math is double-only.
NODE_DEF
arawk_node_sin(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *a)
{
    (void)n;
    return RESULT_OK(awk_make_float(sin(awk_to_num(UNWRAP(EVAL_ARG(c, a))))));
}

NODE_DEF
arawk_node_cos(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *a)
{
    (void)n;
    return RESULT_OK(awk_make_float(cos(awk_to_num(UNWRAP(EVAL_ARG(c, a))))));
}

NODE_DEF
arawk_node_sqrt(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *a)
{
    (void)n;
    return RESULT_OK(awk_make_float(sqrt(awk_to_num(UNWRAP(EVAL_ARG(c, a))))));
}

NODE_DEF
arawk_node_exp(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *a)
{
    (void)n;
    return RESULT_OK(awk_make_float(exp(awk_to_num(UNWRAP(EVAL_ARG(c, a))))));
}

NODE_DEF
arawk_node_log(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *a)
{
    (void)n;
    return RESULT_OK(awk_make_float(log(awk_to_num(UNWRAP(EVAL_ARG(c, a))))));
}

NODE_DEF
arawk_node_atan2(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *a, NODE *b)
{
    (void)n;
    double y = awk_to_num(UNWRAP(EVAL_ARG(c, a)));
    double x = awk_to_num(UNWRAP(EVAL_ARG(c, b)));
    return RESULT_OK(awk_make_float(atan2(y, x)));
}

// rand / srand — process-global state.  POSIX awk: rand() returns a
// double in [0, 1).  srand() seeds (time(NULL) if no arg) and returns
// the previous seed.
NODE_DEF
arawk_node_rand(CTX * restrict c, NODE * restrict n, VALUE * restrict fp)
{
    (void)c; (void)n; (void)fp;
    extern double awk_rand(void);
    return RESULT_OK(awk_make_float(awk_rand()));
}

NODE_DEF
arawk_node_srand0(CTX * restrict c, NODE * restrict n, VALUE * restrict fp)
{
    (void)c; (void)n; (void)fp;
    extern int64_t awk_srand_time(void);
    return RESULT_OK(AWK_FIX(awk_srand_time()));
}

NODE_DEF
arawk_node_srand1(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *a)
{
    (void)n;
    extern int64_t awk_srand(int64_t seed);
    int64_t s = (int64_t)awk_to_num(UNWRAP(EVAL_ARG(c, a)));
    return RESULT_OK(AWK_FIX(awk_srand(s)));
}

// ---------------------------------------------------------------------------
// I/O builtins — close / fflush / system (Phase 1.11).
// ---------------------------------------------------------------------------

NODE_DEF
arawk_node_close(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *dest)
{
    (void)n;
    VALUE dv = UNWRAP(EVAL_ARG(c, dest));
    return RESULT_OK(AWK_FIX(awk_close_stream(dv)));
}

NODE_DEF
arawk_node_fflush_0(CTX * restrict c, NODE * restrict n, VALUE * restrict fp)
{
    (void)c; (void)n; (void)fp;
    return RESULT_OK(AWK_FIX(awk_fflush_all()));
}

NODE_DEF
arawk_node_fflush_1(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *dest)
{
    (void)n;
    VALUE dv = UNWRAP(EVAL_ARG(c, dest));
    return RESULT_OK(AWK_FIX(awk_fflush_stream(dv)));
}

NODE_DEF
arawk_node_system(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, NODE *cmd)
{
    (void)n;
    VALUE cv = UNWRAP(EVAL_ARG(c, cmd));
    char buf[1024]; size_t len;
    const char *s = awk_to_cstr(cv, buf, sizeof buf, &len);
    // Ensure NUL-terminated for system().
    char *path = (char *)alloca(len + 1);
    memcpy(path, s, len); path[len] = '\0';
    // Flush stdout first so awk's prior output appears before the
    // child's — POSIX awk requires this ordering.
    fflush(stdout);
    int rc = system(path);
    // POSIX: return the wait status as encoded by `system(3)`.  awk
    // historically reports it as-is (high byte is exit code).
    return RESULT_OK(AWK_FIX(rc));
}

// ---------------------------------------------------------------------------
// getline (Phase 1.12) — 6 forms.  Each returns 1 (read), 0 (EOF),
// -1 (I/O error).  The runtime helpers in runtime.c manage the
// per-source FILE * cache so repeated getline against the same
// file / command continues from where it left off.
// ---------------------------------------------------------------------------

NODE_DEF
arawk_node_getline_cur(CTX * restrict c, NODE * restrict n, VALUE * restrict fp)
{
    (void)n; (void)fp;
    return RESULT_OK(AWK_FIX(awk_getline_cur(c, NULL)));
}

NODE_DEF
arawk_node_getline_cur_l(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, uint32_t index)
{
    (void)n;
    VALUE line;
    int rc = awk_getline_cur_var(c, &line);
    if (rc == 1) fp[index] = line;
    return RESULT_OK(AWK_FIX(rc));
}

NODE_DEF
arawk_node_getline_cur_g(CTX * restrict c, NODE * restrict n, VALUE * restrict fp, uint32_t index)
{
    (void)n; (void)fp;
    VALUE line;
    int rc = awk_getline_cur_var(c, &line);
    if (rc == 1) c->env[index] = line;
    return RESULT_OK(AWK_FIX(rc));
}

