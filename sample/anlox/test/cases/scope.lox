var a = "global";
{
  var a = "outer";
  {
    var a = "inner";
    print a;   // expect: inner
  }
  print a;     // expect: outer
}
print a;       // expect: global

// assignment resolves to the nearest binding
var x = 1;
{
  x = 2;       // assigns the global x (no local x here)
  print x;     // expect: 2
}
print x;       // expect: 2
