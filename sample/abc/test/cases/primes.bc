/* Sieve-ish prime printer using trial division */
define isprime(n) {
    auto i
    if (n < 2) return(0)
    for (i = 2; i * i <= n; i++) {
        if (n % i == 0) return(0)
    }
    return(1)
}
count = 0
for (k = 2; k <= 50; k++) {
    if (isprime(k)) {
        print k, " "
        count += 1
    }
}
print "\n"
count
